      "linkLibraries": []
    },
    {
      "name": "libuni-ai-md_bridge.so",
      "compatibleSdkVersion": 17,
      "compatibleSdkType": "HarmonyOS",
      "linkLibraries": ["libuni-ai-md.so"]
    }
  ]
}
