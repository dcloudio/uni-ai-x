import bridge from 'libuni-ai-md_bridge.so'

// 平台入口内直接定义类型：仅放在 interface.uts 的类型不会参与本平台编译。
export type UniAiMdOp = {
	op: number
	kind: string
	content: string
	index: number
	unchanged: boolean
}

export type UniAiMdEvent = {
	ops: UniAiMdOp[]
}

/**
 * 创建一个 progressive session。
 * 桥接库内部完成 runtime 创建、render/math 注册、seal 和 session 创建。
 * mode 为 "ast" 时只交付 AST（无 HTML、无 DATA），省略或 "html" 时交付 HTML 与 DATA。
 * languageTags 为宿主给出的语言偏好（BCP-47，可为逗号分隔的优先级列表），
 * 用于在集合字体里挑 face；HarmonyOS 候选字体本身是单面 SC 字体。
 * darkMode 决定 mermaid、math 插件的默认前景色（省略按浅色）；
 * background 是宿主显式给出的画布底色（#rrggbb），省略或格式不对时按浅色底兜底。
 */
export function createSession(mode?: string, languageTags?: string, darkMode?: boolean,
	background?: string): object {
	return bridge.createSession(mode, languageTags, darkMode, background)
}

/**
 * 提交一段 Markdown chunk，返回本次产生的块级操作集合；
 * 没有事件产生时返回 undefined。
 */
export function feedChunk(handle: object, chunk: string): UniAiMdEvent | undefined {
	return bridge.feedChunk(handle, chunk) as UniAiMdEvent | undefined
}

/**
 * 结束 session，返回收尾的块级操作集合；
 * 没有事件产生时返回 undefined。
 */
export function finishSession(handle: object): UniAiMdEvent | undefined {
	return bridge.finishSession(handle) as UniAiMdEvent | undefined
}

/** 销毁 session 及其 runtime。 */
export function destroySession(handle: object): void {
	bridge.destroySession(handle)
}
