/**
 * uni-ai-md UTS 插件对外接口。
 *
 * 协议与 native/harmony/uni_ai_md_bridge.cpp 的 N-API 输出保持一致：
 * feedChunk/finishSession 返回一组块级操作，页面按顺序应用。
 */

/**
 * 1=追加块 2=更新未闭合块 3=提交未闭合块 4=清空块列表。
 * kind 为 html/data/ast；index 是该事件对应的顶层块序号，三种通道按同一序号对齐。
 * unchanged 为 true 表示这次 tail 提交的内容没有变化（content 是原内容，不是新载荷）。
 */
export type UniAiMdOp = {
	op: number
	kind: string
	content: string
	index: number
	unchanged: boolean
}

/** 一次 feed 的块级操作集合 */
export type UniAiMdEvent = {
	ops: UniAiMdOp[]
}

export const OP_APPEND: number = 1
export const OP_TAIL: number = 2
export const OP_COMMIT: number = 3
export const OP_RESET: number = 4

export const KIND_HTML: string = 'html'
export const KIND_DATA: string = 'data'
export const KIND_AST: string = 'ast'
