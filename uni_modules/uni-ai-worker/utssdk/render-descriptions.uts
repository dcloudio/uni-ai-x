import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import {
	markdownBlockquoteTokenToRichTextNodes,
	markdownTokensToRichTextNodes
} from './markdown-rich-text.uts'

export type MarkdownRenderKind = 'rich' | 'quote' | 'divider' | 'table' | 'code' | 'mermaid' | 'math'

export type MarkdownRenderDescription = {
	kind: MarkdownRenderKind
	key: string
	tokenStart: number
	tokenCount: number
	nodes: UTSJSONObject[]
}

export function markdownRenderKind(token: MarkdownToken): MarkdownRenderKind {
	const type = token.type ?? 'text'
	if (type == 'code_block') {
		const language = (token.lang ?? '').toLowerCase()
		if (language == 'mermaid') return 'mermaid'
		if (language == 'math' || language == 'math-pending') return 'math'
		return 'code'
	}
	if (type == 'math') return 'math'
	if (type == 'block_quote') return 'quote'
	if (type == 'thematic_break') return 'divider'
	if (type == 'table') return 'table'
	return 'rich'
}

export function assignMarkdownRootTokenIds(tokens: MarkdownToken[]): void {
	for (let index = 0; index < tokens.length; index++) {
		tokens[index].uniqueId = 'u' + index.toString()
	}
}

function descriptionNodes(kind: MarkdownRenderKind, tokens: MarkdownToken[]): UTSJSONObject[] {
	if (kind == 'rich') return markdownTokensToRichTextNodes(tokens)
	if (kind == 'quote' && tokens.length > 0) return markdownBlockquoteTokenToRichTextNodes(tokens[0])
	return [] as UTSJSONObject[]
}

export function buildMarkdownRenderDescriptions(tokens: MarkdownToken[]): MarkdownRenderDescription[] {
	assignMarkdownRootTokenIds(tokens)
	const descriptions = [] as MarkdownRenderDescription[]
	for (let index = 0; index < tokens.length; index++) {
		const token = tokens[index]
		const kind = markdownRenderKind(token)
		const previous = descriptions.length > 0 ? descriptions[descriptions.length - 1] : null
		if (kind == 'rich' && previous != null && previous.kind == 'rich') {
			previous.tokenCount += 1
			continue
		}
		descriptions.push({
			kind: kind,
			key: token.uniqueId!,
			tokenStart: index,
			tokenCount: 1,
			nodes: [] as UTSJSONObject[]
		} as MarkdownRenderDescription)
	}
	for (let index = 0; index < descriptions.length; index++) {
		const description = descriptions[index]
		if (description.kind != 'rich' && description.kind != 'quote') continue
		const blockTokens = tokens.slice(description.tokenStart, description.tokenStart + description.tokenCount)
		description.nodes = descriptionNodes(description.kind, blockTokens)
	}
	return descriptions
}
