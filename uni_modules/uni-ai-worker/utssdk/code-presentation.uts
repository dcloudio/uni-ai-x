import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import type { MarkdownTextRenderBlock, CodePresentationLine } from './native-presentation.uts'
import { markdownCodeTokenToRichTextNodes } from './markdown-rich-text.uts'
import { requestCachedCodeText, ParseCodeTextRes } from './code-highlight.uts'

function escapeCodeHtml(text: string): string {
	return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;')
}

function codeNodeHtml(node: UTSJSONObject): string {
	if (node['type'] == 'text') return escapeCodeHtml((node['text'] as string | null) ?? '')
	const name = node['name'] as string | null
	if (name == 'br') return '<br/>'
	if (name == null) return ''
	let html = '<' + name
	const attrs = node['attrs'] as UTSJSONObject | null
	if (attrs != null) {
		const style = attrs['style'] as string | null
		if (style != null) html += ' style="' + escapeCodeHtml(style) + '"'
	}
	html += '>'
	const children = node['children'] as UTSJSONObject[] | null
	if (children != null) for (let i = 0; i < children.length; i++) html += codeNodeHtml(children[i])
	return html + '</' + name + '>'
}

export function buildCodeLineHtml(text: string, language: string, tokens: MarkdownToken[][]): string {
	// 原生 rich-text 会折叠空块，用占位空格保留空行；源码仍保存在 line.text。
	const token: MarkdownToken = {
		type: 'code_block', lang: language,
		text: text.length == 0 ? '\u00A0' : text,
		codeTokens: text.length == 0 ? [] as MarkdownToken[][] : tokens
	}
	const nodes = markdownCodeTokenToRichTextNodes(token)
	let html = ''
	for (let i = 0; i < nodes.length; i++) html += codeNodeHtml(nodes[i])
	return html
}

export type CodeHtmlPatch = { prefixLength: number, html: string }

// Boundaries are complete prepared lines, so replacements never cut HTML tags.
export function buildCodeHtmlPatch(lines: CodePresentationLine[], previous: CodePresentationLine[]): CodeHtmlPatch {
	const open = '<div style="height:22px;line-height:22px;white-space:pre;">'
	const close = '</div>'
	let stable = 0
	let prefixLength = 0
	while (stable < lines.length && stable < previous.length &&
		(lines[stable] === previous[stable] || lines[stable].html == previous[stable].html)) {
		prefixLength += open.length + lines[stable].html.length + close.length
		stable++
	}
	const parts: string[] = []
	for (let i = stable; i < lines.length; i++) parts.push(open + lines[i].html + close)
	return { prefixLength: prefixLength, html: parts.join('') }
}

// Publish source immediately; highlighting replaces the same blocks asynchronously.
export function prepareCodeBlocks(messageId: string, blocks: MarkdownTextRenderBlock[],
	ready: (blocks: MarkdownTextRenderBlock[]) => void, previous: MarkdownTextRenderBlock[] = []) {
	const codeBlocks = blocks.filter((block: MarkdownTextRenderBlock): boolean => block.kind == 'code')
	const previousByKey = new Map<string, MarkdownTextRenderBlock>()
	for (let i = 0; i < previous.length; i++) previousByKey.set(previous[i].key, previous[i])
	const unchanged = new Set<string>()
	const publish = () => {
		// Snapshot identity must change for row caches; unchanged line objects stay shared.
		ready(blocks.map((block: MarkdownTextRenderBlock): MarkdownTextRenderBlock => {
			// Typed native object spread uses reflective assign. Copy display fields
			// explicitly so token/line arrays remain shared immutable snapshots.
			return block.kind == 'code' ? {
				kind: block.kind, key: block.key, html: block.html, text: block.text,
				language: block.language, isComplete: block.isComplete,
				columnWidths: block.columnWidths, rowTextWidths: block.rowTextWidths,
				codeTokens: block.codeTokens, codeLines: block.codeLines,
				codeHighlightedText: block.codeHighlightedText, codeCompleteLines: block.codeCompleteLines,
				codeHeight: block.codeHeight, codeHtml: block.codeHtml, codeContentHeight: block.codeContentHeight,
				level: block.level, indent: block.indent, marker: block.marker, quoteDepth: block.quoteDepth,
				mermaidImageSource: block.mermaidImageSource, mermaidRenderTheme: block.mermaidRenderTheme,
				table: block.table, math: block.math,
				svgSource: block.svgSource, svgWidth: block.svgWidth, svgHeight: block.svgHeight
			} as MarkdownTextRenderBlock : block
		}))
	}
	codeBlocks.forEach((block: MarkdownTextRenderBlock) => {
		const old = previousByKey.get(block.key)
		if (old != null && old.language == block.language && old.text == block.text && old.isComplete == block.isComplete &&
			old.codeCompleteLines == block.codeCompleteLines && old.codeLines != null &&
			(old.isComplete ? old.codeHighlightedText == old.text : old.codeHighlightedText == old.text.slice(0, old.text.lastIndexOf('\n')))) {
			block.codeTokens = old.codeTokens
			block.codeLines = old.codeLines
			block.codeHighlightedText = old.codeHighlightedText
			block.codeHeight = old.codeHeight
			unchanged.add(block.key)
			return
		}
		if (!block.isComplete) block.codeTokens = [] as MarkdownToken[][]
		const matchingOld = old?.language == block.language ? old : null
		const oldLines = matchingOld?.codeLines ?? [] as CodePresentationLine[]
		const oldHighlighted = matchingOld?.codeHighlightedText ?? ''
		block.codeHighlightedText = block.text == oldHighlighted || block.text.startsWith(oldHighlighted + '\n') ? oldHighlighted : ''
		if (block.codeHighlightedText.length > 0) block.codeTokens = old?.codeTokens ?? [] as MarkdownToken[][]
		const texts = block.text.replace(/\r\n/g, '\n').split('\n')
		const lines = [] as CodePresentationLine[]
		let samePrefix = true
		for (let i = 0; i < texts.length; i++) {
			if (i >= oldLines.length || oldLines[i].text != texts[i]) samePrefix = false
			if (samePrefix) {
				lines.push(oldLines[i])
			} else {
				const tokens = i < block.codeTokens.length ? [block.codeTokens[i]] : [] as MarkdownToken[][]
				lines.push({ text: texts[i], html: buildCodeLineHtml(texts[i], block.language, tokens) })
			}
		}
		block.codeLines = lines
		block.codeHeight = (Math.max(1, texts.length) * 22 + 16).toString() + 'px'
	})
	publish()
	codeBlocks.forEach((block: MarkdownTextRenderBlock) => {
		if (unchanged.has(block.key)) return
		const texts = block.text.replace(/\r\n/g, '\n').split('\n')
		const count = block.isComplete ? texts.length : Math.min(texts.length, block.codeCompleteLines ?? texts.length - 1)
		const completedText = texts.slice(0, count).join('\n')
		if (completedText.length == 0 || completedText == block.codeHighlightedText) return
		const highlightedText = block.codeHighlightedText ?? ''
		const highlightedCount = highlightedText.length == 0 ? 0 : highlightedText.split('\n').length
		const unchangedCount = completedText.startsWith(highlightedText + '\n') ? highlightedCount : 0
		requestCachedCodeText((result: ParseCodeTextRes) => {
			if (result.error != null) return
			block.codeTokens = result.lines
			block.codeHighlightedText = completedText
			const lines = (block.codeLines ?? [] as CodePresentationLine[]).slice()
			for (let i = unchangedCount; i < count; i++) {
				const tokens = i < result.lines.length ? [result.lines[i]] : [] as MarkdownToken[][]
				const html = buildCodeLineHtml(lines[i].text, block.language, tokens)
				if (html != lines[i].html) lines[i] = { text: lines[i].text, html: html }
			}
			block.codeLines = lines
			publish()
		}, messageId, block.key, completedText, block.language)
	})
}
