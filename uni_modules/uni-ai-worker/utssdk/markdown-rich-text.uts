import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'

// Theme colors belong on the rich-text root so theme switches do not rebuild nodes.
const INLINE_CODE_STYLE = 'background-color:rgba(127,127,127,0.18);'
const LIST_STYLE = 'margin:4px 0;padding-left:24px;'
const NESTED_LIST_STYLE = 'margin:2px 0;padding-left:22px;'
const LIST_ITEM_STYLE = 'margin:2px 0;line-height:26px;'
const TASK_LIST_STYLE = 'margin:4px 0;padding-left:0;list-style-type:none;'
const NESTED_TASK_LIST_STYLE = 'margin:2px 0;padding-left:22px;list-style-type:none;'
const TASK_ITEM_STYLE = 'margin:2px 0;line-height:26px;list-style-type:none;'
const TASK_MARKER_STYLE = 'color:rgba(127,127,127,0.82);font-size:17px;font-weight:400;'
const CHECKED_TASK_MARKER_STYLE = 'color:#3478f6;font-size:17px;font-weight:700;'
const TABLE_STYLE = 'border-collapse:collapse;margin:0;'
const TABLE_CELL_STYLE = 'border:1px solid rgba(127,127,127,0.38);padding:6px 8px;font-size:14px;line-height:22px;'
const TABLE_HEAD_STYLE = TABLE_CELL_STYLE + 'font-weight:700;background-color:rgba(127,127,127,0.14);'

function richNode(name: string, children: UTSJSONObject[] = [] as UTSJSONObject[], attrs: UTSJSONObject | null = null): UTSJSONObject {
	const node = { name } as UTSJSONObject
	if (attrs != null) node['attrs'] = attrs
	if (children.length > 0) node['children'] = children
	return node
}

function textNode(text: string): UTSJSONObject {
	return { type: 'text', text } as UTSJSONObject
}

function codeTextNode(text: string): UTSJSONObject {
	const preservedText = text
		.replace(/\t/g, '\u00A0\u00A0\u00A0\u00A0')
		.replace(/ /g, '\u00A0')
	return textNode(preservedText)
}

function styleAttrs(style: string): UTSJSONObject {
	return { style } as UTSJSONObject
}

function emptyTokens(): MarkdownToken[] {
	return [] as MarkdownToken[]
}

function emptyCodeLines(): MarkdownToken[][] {
	return [] as MarkdownToken[][]
}

function emptyAligns(): string[] {
	return [] as string[]
}

function childrenOf(token: MarkdownToken | null): MarkdownToken[] {
	if (token == null) return emptyTokens()
	if (token.tokens != null) return token.tokens!
	if (token.items != null) return token.items!
	return emptyTokens()
}

function codeLinesOf(token: MarkdownToken | null): MarkdownToken[][] {
	if (token == null) return emptyCodeLines()
	if (token.codeTokens != null) return token.codeTokens!
	return emptyCodeLines()
}

function tokenText(token: MarkdownToken | null): string {
	if (token == null) return ''
	if (token.text != null) return token.text!
	let text = ''
	const children = childrenOf(token)
	for (let i = 0; i < children.length; i++) {
		if (children[i] != null) text += tokenText(children[i])
	}
	return text
}

function inlineChildren(token: MarkdownToken | null): UTSJSONObject[] {
	if (token == null) return [] as UTSJSONObject[]
	const children = childrenOf(token)
	if (children.length == 0) return [textNode(token.text ?? '')] as UTSJSONObject[]
	const result = [] as UTSJSONObject[]
	for (let i = 0; i < children.length; i++) {
		if (children[i] == null) continue
		const node = inlineNode(children[i])
		if (node != null) result.push(node)
	}
	return result
}

function inlineNode(token: MarkdownToken | null): UTSJSONObject | null {
	if (token == null) return null
	const type = token.type ?? 'text'
	if (type == 'text' || type == 'escape') return textNode(token.text ?? '')
	if (type == 'strong') return richNode('strong', inlineChildren(token))
	if (type == 'em' || type == 'emph') return richNode('i', inlineChildren(token))
	if (type == 'del' || type == 'strikethrough') return richNode('del', inlineChildren(token))
	if (type == 'codespan' || type == 'code') return richNode('span', [textNode(token.text ?? '')] as UTSJSONObject[], styleAttrs(INLINE_CODE_STYLE))
	if (type == 'br' || type == 'linebreak') return richNode('br')
	if (type == 'softbreak') return richNode('br')
	if (type == 'link') return richNode('a', inlineChildren(token), { href: token.href ?? '' } as UTSJSONObject)
	if (type == 'image') return richNode('img', [] as UTSJSONObject[], imageAttrs(token))
	if (type == 'html' || type == 'html_inline' || type == 'custom_inline') return textNode(token.html ?? token.text ?? token.raw ?? '')
	return textNode(tokenText(token))
}

function imageAttrs(token: MarkdownToken | null): UTSJSONObject {
	if (token == null) return { src: '' } as UTSJSONObject
	const attrs = { src: token.href ?? token.text ?? '' } as UTSJSONObject
	if ((token.width ?? 0) > 0) attrs['width'] = (token.width ?? 0).toString()
	if ((token.height ?? 0) > 0) attrs['height'] = (token.height ?? 0).toString()
	return attrs
}

function isTaskListToken(token: MarkdownToken | null): boolean {
	return token != null && (token.type == 'tasklist' || token.task == 1 || token.checked != null)
}

function listItemInlineChildren(item: MarkdownToken | null): UTSJSONObject[] {
	const children = [] as UTSJSONObject[]
	const itemChildren = childrenOf(item)
	for (let i = 0; i < itemChildren.length; i++) {
		const child = itemChildren[i]
		if (child == null) continue
		if (child.type == 'paragraph' || child.type == 'text') {
			const inlines = inlineChildren(child)
			for (let j = 0; j < inlines.length; j++) children.push(inlines[j])
			continue
		}
		if (child.type == 'list' || child.type == 'tasklist') continue
		const text = tokenText(child)
		if (text.length > 0) children.push(textNode(text))
	}
	return children
}

function isTaskList(token: MarkdownToken): boolean {
	if (isTaskListToken(token)) return true
	const items = childrenOf(token)
	for (let i = 0; i < items.length; i++) {
		if (isTaskListToken(items[i])) return true
	}
	return false
}

function taskMarkerNode(checked: boolean): UTSJSONObject {
	return richNode('span', [textNode((checked ? '▣' : '□') + '\u00a0')] as UTSJSONObject[],
		styleAttrs(checked ? CHECKED_TASK_MARKER_STYLE : TASK_MARKER_STYLE))
}

function listNode(token: MarkdownToken, nested: boolean): UTSJSONObject {
	const taskList = isTaskList(token)
	const ordered = !taskList && token.ordered == 1
	const items = childrenOf(token)
	const itemNodes = [] as UTSJSONObject[]
	for (let i = 0; i < items.length; i++) {
		const item = items[i]
		if (item == null) continue
		const taskItem = taskList || isTaskListToken(item)
		const children = [] as UTSJSONObject[]
		if (taskItem) children.push(taskMarkerNode(item.checked == 1))
		const itemChildren = listItemInlineChildren(item)
		for (let j = 0; j < itemChildren.length; j++) children.push(itemChildren[j])
		const rawChildren = childrenOf(item)
		for (let j = 0; j < rawChildren.length; j++) {
			const child = rawChildren[j]
			if (child == null || (child.type != 'list' && child.type != 'tasklist')) continue
			children.push(listNode(child, true))
		}
		itemNodes.push(richNode('li', children, styleAttrs(taskItem ? TASK_ITEM_STYLE : LIST_ITEM_STYLE)))
	}
	let listStyle = nested ? NESTED_LIST_STYLE : LIST_STYLE
	if (taskList) listStyle = nested ? NESTED_TASK_LIST_STYLE : TASK_LIST_STYLE
	const attrs = styleAttrs(listStyle)
	if (ordered && token.start != null) {
		const start = token.start!
		attrs['start'] = typeof start == 'number' ? (start as number).toString() : start as string
	}
	return richNode(ordered ? 'ol' : 'ul', itemNodes, attrs)
}

function listNodes(token: MarkdownToken): UTSJSONObject[] {
	return [listNode(token, false)] as UTSJSONObject[]
}

function blockquoteNodes(token: MarkdownToken): UTSJSONObject[] {
	const nodes = [] as UTSJSONObject[]
	const children = childrenOf(token)
	for (let i = 0; i < children.length; i++) {
		const child = children[i]
		if (child == null) continue
		if (child.type == 'paragraph' || child.type == 'text') {
			nodes.push(richNode('p', inlineChildren(child)))
			continue
		}
		if (child.type == 'block_quote') {
			const nestedNodes = blockquoteNodes(child)
			for (let j = 0; j < nestedNodes.length; j++) nodes.push(nestedNodes[j])
			continue
		}
		const text = tokenText(child)
		if (text.length > 0) nodes.push(richNode('p', [textNode(text)] as UTSJSONObject[]))
	}
	if (nodes.length == 0) nodes.push(richNode('p', [textNode(tokenText(token))] as UTSJSONObject[]))
	return nodes
}

function tableCellNode(cell: MarkdownToken | null, header: boolean, align: string, width: number,
	rowIndex: number, rowCount: number, cellIndex: number, cellCount: number): UTSJSONObject {
	let style = (header ? TABLE_HEAD_STYLE : TABLE_CELL_STYLE) + 'text-align:' + align + ';'
	if (rowIndex == 0) style += 'border-top-width:0;'
	if (rowIndex == rowCount - 1) style += 'border-bottom-width:0;'
	if (cellIndex == 0) style += 'border-left-width:0;'
	if (cellIndex == cellCount - 1) style += 'border-right-width:0;'
	if (width > 0) style += 'width:' + width.toString() + 'px;'
	return richNode(header ? 'th' : 'td', inlineChildren(cell), styleAttrs(style))
}

export function markdownTableColumnWidths(token: MarkdownToken | null): number[] {
	const widths = [] as number[]
	if (token == null) return widths
	const rows = token.tokens ?? emptyTokens()
	if (rows.length == 0) return widths
	const firstRowCells = rows[0].tokens ?? emptyTokens()
	for (let cellIndex = 0; cellIndex < firstRowCells.length; cellIndex++) {
		let columnWidth = 80
		for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
			const cells = rows[rowIndex].tokens ?? emptyTokens()
			if (cellIndex >= cells.length) continue
			columnWidth = Math.max(columnWidth, Math.min((cells[cellIndex].width ?? 0) + 16, 320))
		}
		widths.push(columnWidth)
	}
	return widths
}

function markdownTableRenderColumnWidths(token: MarkdownToken | null, minimumTableWidth: number): number[] {
	const widths = markdownTableColumnWidths(token)
	if (widths.length == 0 || minimumTableWidth <= 0) return widths
	const naturalWidth = widths.reduce((sum: number, width: number): number => sum + width, 0)
	if (naturalWidth >= minimumTableWidth) return widths
	const equalWidth = minimumTableWidth / widths.length
	const expandedWidths = [] as number[]
	for (let i = 0; i < widths.length; i++) expandedWidths.push(equalWidth)
	return expandedWidths
}

function webTableNode(token: MarkdownToken, minimumTableWidth: number): UTSJSONObject {
	const rows = token.tokens != null ? token.tokens! : emptyTokens()
	const aligns = token.align != null ? token.align! : emptyAligns()
	const columnWidths = markdownTableRenderColumnWidths(token, minimumTableWidth)
	const trNodes = [] as UTSJSONObject[]
	const tableWidth = columnWidths.reduce((sum: number, width: number): number => sum + width, 0)
	for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
		if (rows[rowIndex] == null) continue
		const cells = rows[rowIndex].tokens != null ? rows[rowIndex].tokens! : emptyTokens()
		const cellNodes = [] as UTSJSONObject[]
		for (let cellIndex = 0; cellIndex < cells.length; cellIndex++) {
			if (cells[cellIndex] == null) continue
			const width = cellIndex < columnWidths.length ? columnWidths[cellIndex] : 80
			const align = cellIndex < aligns.length && aligns[cellIndex] != null ? aligns[cellIndex] as string : 'left'
			cellNodes.push(tableCellNode(cells[cellIndex], rowIndex == 0, align.length > 0 ? align : 'left', width,
				rowIndex, rows.length as number, cellIndex, cells.length as number))
		}
		trNodes.push(richNode('tr', cellNodes))
	}
	return richNode('table', trNodes, styleAttrs(TABLE_STYLE + 'width:' + tableWidth.toString() + 'px;'))
}

export function markdownTableContentWidth(token: MarkdownToken | null, minimumTableWidth: number = 0): number {
	return markdownTableRenderColumnWidths(token, minimumTableWidth).reduce((sum: number, width: number): number => sum + width, 0)
}

function tableCellContentWidth(cell: MarkdownToken | null): number {
	if (cell == null) return 0
	const measuredWidth = cell.width ?? 0
	if (measuredWidth > 0) return measuredWidth
	return (tokenText(cell).length as number) * 14
}

function markdownTableRowContentHeight(row: MarkdownToken | null, columnWidths: number[], isHeader: boolean): number {
	if (row == null) return 0
	const cells = row.tokens ?? emptyTokens()
	let maxLineCount = 1
	const renderWidthScale = isHeader ? 1 : 14 / 13
	for (let cellIndex = 0; cellIndex < cells.length; cellIndex++) {
		const columnWidth = cellIndex < columnWidths.length ? columnWidths[cellIndex] : 80
		const availableTextWidth = Math.max(1, columnWidth - 16)
		const renderedTextWidth = tableCellContentWidth(cells[cellIndex]) * renderWidthScale
		const lineCount = Math.max(1, Math.ceil(renderedTextWidth / availableTextWidth))
		maxLineCount = Math.max(maxLineCount, lineCount)
	}
	return maxLineCount * 22 + 12
}

export function markdownTableContentHeight(token: MarkdownToken | null, minimumTableWidth: number = 0): number {
	if (token == null) return 1
	const rows = token.tokens ?? emptyTokens()
	const columnWidths = markdownTableRenderColumnWidths(token, minimumTableWidth)
	let height = 0
	for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
		height += markdownTableRowContentHeight(rows[rowIndex], columnWidths, rowIndex == 0)
		if (rowIndex < rows.length - 1) height += 1
	}
	return Math.max(1, height)
}


function codeColor(className: string): string {
	if (className == 'keyword' || className == 'storage') return '#7dd3fc'
	if (className == 'string') return '#fda4af'
	if (className == 'comment') return '#98a2b3'
	if (className == 'constant') return '#86efac'
	if (className == 'function') return '#fde68a'
	if (className == 'variable') return '#bfdbfe'
	if (className == 'entity' || className == 'support') return '#67e8f9'
	if (className == 'meta') return '#e9d5ff'
	if (className == 'punctuation') return '#f9fafb'
	return '#d1fae5'
}

function codeText(token: MarkdownToken | null): string {
	if (token == null) return ''
	if (token.text != null) return token.text!
	const codeTokens = codeLinesOf(token)
	let text = ''
	for (let i = 0; i < codeTokens.length; i++) {
		const line = codeTokens[i] != null ? codeTokens[i] : emptyTokens()
		for (let j = 0; j < line.length; j++) text += line[j].text ?? ''
		if (i < codeTokens.length - 1) text += '\n'
	}
	return text
}

function codeChildren(token: MarkdownToken | null): UTSJSONObject[] {
	const codeTokens = codeLinesOf(token)
	const children = [] as UTSJSONObject[]
	if (codeTokens.length == 0) {
		const lines = codeText(token).replace(/\r\n/g, '\n').split('\n')
		for (let lineIndex = 0; lineIndex < lines.length; lineIndex++) {
			children.push(codeTextNode(lines[lineIndex]))
			if (lineIndex < lines.length - 1) children.push(richNode('br'))
		}
		return children
	}
	for (let lineIndex = 0; lineIndex < codeTokens.length; lineIndex++) {
		const line = codeTokens[lineIndex] != null ? codeTokens[lineIndex] : emptyTokens()
		for (let tokenIndex = 0; tokenIndex < line.length; tokenIndex++) {
			const item = line[tokenIndex]
			if (item == null) continue
			children.push(richNode('span', [codeTextNode(item.text ?? '')] as UTSJSONObject[], styleAttrs('color:' + codeColor(item.className ?? '') + ';')))
		}
		if (lineIndex < codeTokens.length - 1) children.push(richNode('br'))
	}
	return children
}

function codeBlockNode(token: MarkdownToken | null): UTSJSONObject {
	return richNode('span', codeChildren(token))
}

function codeContentNode(token: MarkdownToken | null): UTSJSONObject {
	return richNode('span', codeChildren(token))
}

function tokenToNodes(token: MarkdownToken | null): UTSJSONObject[] {
	if (token == null) return [] as UTSJSONObject[]
	const type = token.type ?? 'text'
	if (type == 'heading') {
		const depth = Math.max(1, Math.min(token.depth ?? 1, 6))
		return [richNode('h' + depth.toString(), inlineChildren(token))] as UTSJSONObject[]
	}
	if (type == 'paragraph') return [richNode('p', inlineChildren(token))] as UTSJSONObject[]
	if (type == 'text') return [richNode('p', inlineChildren(token))] as UTSJSONObject[]
	if (type == 'block_quote') return blockquoteNodes(token)
	if (type == 'list' || type == 'tasklist') return listNodes(token)
	if (type == 'code_block') return [codeBlockNode(token)] as UTSJSONObject[]
	if (type == 'math') {
		return [richNode('p', [textNode(token.text ?? '')] as UTSJSONObject[])] as UTSJSONObject[]
	}
	if (type == 'thematic_break') return [] as UTSJSONObject[]
	if (type == 'html' || type == 'html_block' || type == 'custom_block') return [textNode(token.html ?? token.text ?? token.raw ?? '')] as UTSJSONObject[]
	return [richNode('p', [inlineNode(token) ?? textNode(tokenText(token))] as UTSJSONObject[])] as UTSJSONObject[]
}

export function markdownTokensToRichTextNodes(tokens: MarkdownToken[] | null): UTSJSONObject[] {
	const nodes = [] as UTSJSONObject[]
	if (tokens == null) return nodes
	for (let i = 0; i < tokens.length; i++) {
		if (tokens[i] == null) continue
		const blockNodes = tokenToNodes(tokens[i])
		for (let j = 0; j < blockNodes.length; j++) nodes.push(blockNodes[j])
	}
	return nodes
}

export function markdownCodeTokenToRichTextNodes(token: MarkdownToken | null): UTSJSONObject[] {
	if (token == null) return [] as UTSJSONObject[]
	return [codeContentNode(token)] as UTSJSONObject[]
}

export function markdownBlockquoteTokenToRichTextNodes(token: MarkdownToken | null): UTSJSONObject[] {
	if (token == null) return [] as UTSJSONObject[]
	return blockquoteNodes(token)
}

export function markdownTableTokenToRichTextNodes(token: MarkdownToken | null, minimumTableWidth: number = 0): UTSJSONObject[] {
	if (token == null) return [] as UTSJSONObject[]
	return [webTableNode(token, minimumTableWidth)] as UTSJSONObject[]
}
