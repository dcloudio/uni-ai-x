<template>
	<view class="uni-ai-page-root">
		<view class="uni-ai-page uni-theme-root" ref="uni-ai-page"
			:class="showMenu ? 'uni-ai-page-showMenu' : ''"
			:style="{transform: `translateX(${translateX}px)`}">
			<uni-ai-menu @close-menu="closeMenu" @open-setting="openSetting"></uni-ai-menu>
			<uni-ai-chat :show-menu="showMenu" :translate-x="translateX" @change-menu="changeMenu" @close-menu="closeMenu" @source="openSource"></uni-ai-chat>
			<fps v-if="showFps" />
			<!-- #ifndef MP-WEIXIN -->
			<web-view class="uni-ai-proxy-web" id="proxy-web"
				src="/uni_modules/uni-ai-x/static/proxy-web/proxy-web.html"
				@load="proxyWebLoad" @message="proxyWebMsg"></web-view>
			<!-- #endif -->
		</view>
		<uni-ai-x-setting ref="uniAiXSettingRef"></uni-ai-x-setting>
		<uni-ai-source-sheet v-if="sourceMessageId.length > 0" :sources="selectedSources" :selected-id="selectedSourceId" @close="closeSources" />
	</view>
</template>

<script lang="uts" setup>
	import uniAiMenu from '@/uni_modules/uni-ai-x/components/uni-ai-menu.uvue'
	import uniAiChat from '@/uni_modules/uni-ai-x/components/uni-ai-chat.uvue'
	import fps from '@/uni_modules/uni-ai-x/components/fps/fps.uvue'
	import { uniAi } from '@/uni_modules/uni-ai-x/sdk'
	import { initMermaidLayout, updateMermaidLayout } from '@/uni_modules/uni-ai-x/sdk/mermaid-presentation.uts'
	import { updateMathLayout } from '@/uni_modules/uni-ai-x/sdk/math-presentation.uts'
	import { MsgItem, SearchSource } from '@/uni_modules/uni-ai-x/types.uts'
	import uniAiSourceSheet from '@/uni_modules/uni-ai-x/components/uni-ai-source-sheet.uvue'
	const sourceMessageId = ref('')
	const selectedSourceId = ref(0)
	const selectedSources = computed<SearchSource[]>(() => {
		const message = uniAi.currentChat?.msgList.find((item: MsgItem): boolean => item._id == sourceMessageId.value)
		return message?.search?.sources ?? [] as SearchSource[]
	})
	function openSource(messageId: string, id: number) {
		const message = uniAi.currentChat?.msgList.find((item: MsgItem): boolean => item._id == messageId)
		if (message?.search == null || message.search!.sources.length == 0) return
		if (id > 0 && !message.search!.sources.some((source: SearchSource): boolean => source.id == id)) return
		sourceMessageId.value = messageId
		selectedSourceId.value = id
	}
	function closeSources() { sourceMessageId.value = '' }
	watch(() => uniAi.currentChat?.id, () => { closeSources() })
	onResize((event: OnResizeOptions) => {
		updateMermaidLayout(event.size.windowWidth)
		updateMathLayout(event.size.windowWidth)
	})
	// #ifdef APP
	import checkUpdate from '@/uni_modules/uni-upgrade-center-app/utils/check-update'
	// #endif
	// #ifndef MP-WEIXIN
	import proxyWeb from '@/uni_modules/uni-ai-x/sdk/proxy-web.uts'
	// #endif
	const MENU_WIDTH = 260

	const translateX = ref<number>(-MENU_WIDTH)
	const showMenu = ref<boolean>(false)
	const showFps: boolean = false
	const uniAiXSettingRef = ref<ComponentPublicInstance | null>(null)
	onBackPress((): boolean => {
		if (sourceMessageId.value.length > 0) {
			closeSources()
			return true
		}
		return false
	})

	const setMenu = (show: boolean) => {
		showMenu.value = show
		translateX.value = show ? 0 : -MENU_WIDTH
	}

	const changeMenu = () => {
		setMenu(!showMenu.value)
	}

	const closeMenu = () => {
		setMenu(false)
	}

	const openSetting = () => {
		uniAiXSettingRef.value?.$callMethod('open')
	}

	// 模型不支持图像理解时，点击"去设置"直接打开模型选择弹窗
	const openModelPopup = () => {
		uniAiXSettingRef.value?.$callMethod('openModelPopup')
	}

	onMounted(() => {
		uniAi.onOpenSetting(openModelPopup)
		const notices = uniAi.consumeSettingNotices()
		if (notices.length > 0) {
			setTimeout(() => {
				uni.showModal({
					title: '模型设置已调整',
					content: notices.join('\n'),
					showCancel: false,
					confirmText: '知道了'
				})
			}, 300)
		}
	})

	onReady(() => {
		initMermaidLayout()
		// #ifdef APP
		checkUpdate().catch((error) => {
			const result = error as any
			if (result == null || (result.code != 0 && result.code != -101)) {
				console.error('检查应用更新失败', error)
			}
		})
		// #endif
	})

	onUnmounted(() => {
		uniAi.offOpenSetting(openModelPopup)
	})

	// #ifndef MP-WEIXIN
	const proxyWebMsg = (e: UniWebViewMessageEvent) => {
		proxyWeb.onWebMsg(e)
	}

	const proxyWebLoad = (_e: UniWebViewLoadEvent) => {
		// #ifdef WEB
		const proxyWebContext = document.getElementById('proxy-web')
		// #endif
		// #ifdef APP
		const proxyWebContext = uni.getElementById('proxy-web') as UniWebViewElement
		// #endif
		proxyWeb.init(proxyWebContext!)
		proxyWeb.markReady()
	}
	// #endif

	onMounted(() => {
		// #ifdef WEB
		window.addEventListener('resize', () => {
			setMenu(window.innerWidth > 960)
		})
		setMenu(window.innerWidth > 960)
		const proxyWebContext = document.getElementById('proxy-web')
		// #endif
		// #ifdef APP
		const proxyWebContext = uni.getElementById('proxy-web')
		// #endif
		// #ifndef MP-WEIXIN
		proxyWeb.init(proxyWebContext!)
		// #endif
	})
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.uni-ai-page-root {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	overflow: hidden;
}

.uni-ai-proxy-web {
	position: fixed;
	top: -1100px;
	right: 0;
	width: 100%;
	height: 400px;
	z-index: 100;
}

.uni-ai-page {
	position: absolute;	
	// #ifdef H5
	width: calc(100% + 260px);
	// #endif
	transform: translateX(-260px);
	height: 100%;
	flex-direction: row;
	background-color: var(--bg-primary);
	transition: transform 0.3s;
}

.uni-ai-page-showMenu {
	transform: translateX(0) !important;
}

/* #ifdef H5 */
@media screen and (min-device-width:960px){
	.uni-ai-page {
		transition: transform 0.3s, width 0.3s;
	}
	.uni-ai-page-showMenu {
		width: 100%;
	}
}
/* #endif */
</style>
