<template>
	<scroll-view direction="vertical" class="select-text-scroll-view"
		:class="uiTheme == 'dark' ? 'select-text-scroll-view-dark' : 'select-text-scroll-view-light'">
		<rich-text id="richtext" class="select-text-richtext"
			:style="richTextStyle" :selectable="true" :nodes="text"
			mode="native"
		></rich-text>
	</scroll-view>
</template>

<script lang="uts" setup>
	import {uniAi, MsgItem, uiTheme} from '@/uni_modules/uni-ai-x/sdk/'
	import { ref, onMounted } from 'vue'
	
	type SelectTextProps = {
		msgId?: string
	}
	
	const props = withDefaults(defineProps<SelectTextProps>(), {
		msgId: ''
	})
	
	const text = ref<string>("加载中...")

	const richTextStyle = computed<string>(() => {
		const color = uiTheme.value == 'dark' ? '#ffffff' : '#333333'
		const backgroundColor = uiTheme.value == 'dark' ? '#25282c' : '#ffffff'
		return 'color:' + color + ';background-color:' + backgroundColor + ';'
	})

	function escapeHtmlText(content: string): string {
		return content
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;')
			.replace(/'/g, '&#39;')
	}

	function plainTextHtml(content: string): string {
		const escapedContent = escapeHtmlText(content)
			.replace(/\r\n/g, '\n')
			.replace(/\r/g, '\n')
			.replace(/\n/g, '<br/>')
		return '<p>' + escapedContent + '</p>'
	}
	
	onMounted(() => {
		const msg = uniAi.currentChat?.msgList.find((item: MsgItem) => item._id == props.msgId)
		const textContent = msg?.body ?? '没有数据'
		text.value = plainTextHtml(textContent)
	})
</script>

<style lang="scss">
	.select-text-scroll-view {
		height: 100%;
		width: 100%;
		padding: 10px;
	}

	.select-text-scroll-view-light {
		background-color: #ffffff;
	}

	.select-text-scroll-view-dark {
		background-color: #25282c;
	}
</style>
