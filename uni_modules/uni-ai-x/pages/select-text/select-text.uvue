<template>
	<scroll-view direction="vertical" class="select-text-scroll-view uni-theme-root">
		<text id="select-text" class="select-text-content" :selectable="true">{{text}}</text>
	</scroll-view>
</template>

<script lang="uts" setup>
	import {uniAi, MsgItem} from '@/uni_modules/uni-ai-x/sdk/'
	import { ref, onMounted } from 'vue'
	
	type SelectTextProps = {
		msgId?: string
	}
	
	const props = withDefaults(defineProps<SelectTextProps>(), {
		msgId: ''
	})
	
	const text = ref<string>("加载中...")
	
	onMounted(() => {
		const msg = uniAi.currentChat?.msgList.find((item: MsgItem) => item._id == props.msgId)
		text.value = msg?.body ?? '没有数据'
	})
</script>

<style lang="scss">
	@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

	.select-text-scroll-view {
		height: 100%;
		width: 100%;
		padding: 10px;
		background-color: var(--bg-primary);
	}

	.select-text-content {
		width: 100%;
		white-space: pre-wrap;
		line-height: 24px;
		color: var(--text-primary);
	}
</style>
