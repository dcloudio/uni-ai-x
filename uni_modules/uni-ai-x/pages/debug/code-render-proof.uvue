<template>
	<scroll-view class="proof-page" direction="vertical">
		<view class="proof-toolbar">
			<text class="proof-toolbar-btn" @click="restartReplay">重新播放动态更新</text>
			<text class="proof-toolbar-text">当前字符：{{revealCount}} / {{fullCodeText.length}}</text>
		</view>

		<view class="proof-section">
			<text class="proof-title">单段原文动态渲染</text>
			<scroll-view class="proof-code-box" direction="horizontal" :style="{height: proofScrollHeight}">
				<text class="proof-line proof-line-fixed" v-for="(lineText, lineIndex) in displayCodeLines" :key="'raw-' + lineIndex" :style="{width: proofLineWidth}">
					<text class="proof-code proof-code-system">{{lineText}}</text>
				</text>
			</scroll-view>
		</view>

		<view class="proof-section">
			<text class="proof-title">分段 Token 动态渲染（当前可疑实现）</text>
			<scroll-view class="proof-code-box" direction="horizontal">
				<text class="proof-line" v-for="(tokens, lineIndex) in displayedTokenLines" :key="lineIndex">
					<text
						v-for="(token, tokenIndex) in tokens"
						:key="lineIndex + '-' + tokenIndex + '-' + token.text"
						:class="'proof-code proof-code-fira proof-token-' + token.className"
					>{{token.text}}</text>
				</text>
			</scroll-view>
		</view>

		<view class="proof-section">
			<text class="proof-title">分段 Token 动态渲染（系统 monospace）</text>
			<scroll-view class="proof-code-box" direction="horizontal">
				<text class="proof-line" v-for="(tokens, lineIndex) in displayedTokenLines" :key="'sys-' + lineIndex">
					<text
						v-for="(token, tokenIndex) in tokens"
						:key="'sys-' + lineIndex + '-' + tokenIndex + '-' + token.text"
						:class="'proof-code proof-code-system proof-token-' + token.className"
					>{{token.text}}</text>
				</text>
			</scroll-view>
		</view>

		<view class="proof-section">
			<text class="proof-title">分段 Token 动态渲染（显式行宽修复）</text>
			<scroll-view class="proof-code-box" direction="horizontal" :style="{height: proofScrollHeight}">
				<text class="proof-line proof-line-fixed" v-for="(tokens, lineIndex) in displayedTokenLines" :key="'fixed-' + lineIndex" :style="{width: proofLineWidth}">
					<text
						v-for="(token, tokenIndex) in tokens"
						:key="'fixed-' + lineIndex + '-' + tokenIndex + '-' + token.text"
						:class="'proof-code proof-code-system proof-token-' + token.className"
					>{{token.text}}</text>
				</text>
			</scroll-view>
		</view>

		<view class="proof-section">
			<text class="proof-title">真实组件渲染（uni-ai-msg-code）</text>
			<uni-ai-msg-code
				class="proof-real-component"
				:codeText="fullCodeText"
				:codeTokens="displayedComponentTokens"
				language="javascript"
			/>
		</view>

		<view class="proof-section">
			<text class="proof-title">真实组件渲染（短行不溢出）</text>
			<uni-ai-msg-code
				class="proof-real-component"
				:codeText="compactCodeText"
				:codeTokens="compactTokenLines"
				language="javascript"
			/>
		</view>
	</scroll-view>
</template>

<script lang="uts" setup>
	import uniAiMsgCode from '@/uni_modules/uni-ai-x/components/uni-ai-msg-code/uni-ai-msg-code.uvue'

	type CodeToken = {
		text: string
		className: string
	}

	const sourceTokenLines = [
		[
			{ text: 'function', className: 'keyword' },
			{ text: ' ', className: '' },
			{ text: 'renderCompleteText', className: 'function' },
			{ text: '(input) {', className: 'punctuation' }
		],
		[
			{ text: '  const', className: 'keyword' },
			{ text: ' greeting ', className: '' },
			{ text: '=', className: 'punctuation' },
			{ text: ' "Hello, Android code block 1234567890"', className: 'string' },
			{ text: ';', className: 'punctuation' }
		],
		[
			{ text: '  const', className: 'keyword' },
			{ text: ' result ', className: '' },
			{ text: '=', className: 'punctuation' },
			{ text: ' input ', className: '' },
			{ text: '+', className: 'punctuation' },
			{ text: ' " => " ', className: 'string' },
			{ text: '+', className: 'punctuation' },
			{ text: ' greeting ', className: '' },
			{ text: '+', className: 'punctuation' },
			{ text: ' " // keep every char"', className: 'string' },
			{ text: ';', className: 'punctuation' }
		],
		[
			{ text: '  return', className: 'keyword' },
			{ text: ' result;', className: '' }
		],
		[
			{ text: '}', className: 'punctuation' }
		]
	] as CodeToken[][]

	const compactTokenLines = [
		[
			{ text: 'function', className: 'keyword' },
			{ text: ' ', className: '' },
			{ text: 'ok', className: 'function' },
			{ text: '() {', className: 'punctuation' }
		],
		[
			{ text: '  const', className: 'keyword' },
			{ text: ' msg ', className: '' },
			{ text: '=', className: 'punctuation' },
			{ text: ' "abc123"', className: 'string' },
			{ text: ';', className: 'punctuation' }
		],
		[
			{ text: '  return', className: 'keyword' },
			{ text: ' msg;', className: '' }
		],
		[
			{ text: '}', className: 'punctuation' }
		]
	] as CodeToken[][]

	function buildCodeText(lines: CodeToken[][]): string {
		return lines.map((line: CodeToken[]) => {
			return line.map((token: CodeToken) => token.text).join('')
		}).join('\n')
	}

	function sliceTokenLines(lines: CodeToken[][], visibleChars: number): CodeToken[][] {
		let remaining = visibleChars
		const result = [] as CodeToken[][]
		for (let lineIndex = 0; lineIndex < lines.length; lineIndex++) {
			if (remaining <= 0) break
			const sourceLine = lines[lineIndex]
			const nextLine = [] as CodeToken[]
			for (let tokenIndex = 0; tokenIndex < sourceLine.length; tokenIndex++) {
				if (remaining <= 0) break
				const sourceToken = sourceLine[tokenIndex]
				const tokenText = sourceToken.text
				if (remaining >= tokenText.length) {
					nextLine.push({
						text: tokenText,
						className: sourceToken.className
					} as CodeToken)
					remaining -= tokenText.length
				} else {
					nextLine.push({
						text: tokenText.slice(0, remaining),
						className: sourceToken.className
					} as CodeToken)
					remaining = 0
				}
			}
			result.push(nextLine)
			if (remaining > 0 && lineIndex < lines.length - 1) {
				remaining -= 1
			}
		}
		return result
	}

	const fullCodeText = buildCodeText(sourceTokenLines)
	const compactCodeText = buildCodeText(compactTokenLines)
	const revealCount = ref<number>(0)
	const displayCodeText = computed<string>(() => {
		return fullCodeText.slice(0, revealCount.value)
	})
	const displayCodeLines = computed<string[]>(() => {
		return displayCodeText.value.split('\n').map((line: string) => line.length > 0 ? line : ' ')
	})
	const displayedTokenLines = computed<CodeToken[][]>(() => {
		return sliceTokenLines(sourceTokenLines, revealCount.value)
	})
	const displayedComponentTokens = computed<CodeToken[][]>(() => {
		return displayedTokenLines.value
	})
	const proofLineWidth = computed<string>(() => {
		let maxLineSize = 1
		for (let i = 0; i < sourceTokenLines.length; i++) {
			let lineSize = 0
			for (let j = 0; j < sourceTokenLines[i].length; j++) {
				lineSize += sourceTokenLines[i][j].text.length
			}
			maxLineSize = Math.max(maxLineSize, lineSize)
		}
		return `${maxLineSize * 16}px`
	})
	const proofScrollHeight = computed<string>(() => {
		return `${sourceTokenLines.length * 22 + 20}px`
	})
	let replayTimer = 0
	const replayStep = 3
	const replayDelay = 80

	function clearReplayTimer() {
		if (replayTimer != 0) {
			clearInterval(replayTimer)
			replayTimer = 0
		}
	}

	function restartReplay() {
		clearReplayTimer()
		revealCount.value = 0
		replayTimer = setInterval(() => {
			if (revealCount.value >= fullCodeText.length) {
				clearReplayTimer()
				return
			}
			revealCount.value = Math.min(fullCodeText.length, revealCount.value + replayStep)
		}, replayDelay)
	}

	onMounted(() => {
		restartReplay()
	})

	onBeforeUnmount(() => {
		clearReplayTimer()
	})
</script>

<style lang="scss">
@font-face {
	// #ifdef WEB
	font-display: swap;
	// #endif
	font-family: CodeFontFamily;
	// #ifndef MP-WEIXIN
	src: url('/uni_modules/uni-ai-x/static/font/FiraCode-Regular.ttf') format('truetype');
	// #endif
}

.proof-page {
	height: 100%;
	background-color: #f5f7fa;
	padding: 20px;
	box-sizing: border-box;
	flex-direction: column;
}

.proof-toolbar {
	margin-bottom: 18px;
	padding: 14px;
	border-radius: 10px;
	background-color: #0f172a;
	flex-direction: column;
}

.proof-toolbar-btn {
	font-size: 14px;
	font-weight: 700;
	color: #f8fafc;
}

.proof-toolbar-text {
	margin-top: 8px;
	font-size: 12px;
	color: #cbd5e1;
}

.proof-section {
	margin-bottom: 18px;
	padding: 14px;
	border-radius: 10px;
	background-color: #ffffff;
	border: 1px solid #d8dee9;
	flex-direction: column;
}

.proof-title {
	font-size: 15px;
	font-weight: 700;
	color: #222222;
	margin-bottom: 10px;
}

.proof-code-box {
	width: 100%;
	padding: 10px 0;
	background-color: #111827;
	border-radius: 8px;
	flex-direction: column;
}

.proof-line,
.proof-code {
	padding: 0 12px;
}

.proof-line {
	height: 22px;
	white-space: nowrap;
	align-self: flex-start;
}

.proof-line-fixed {
	padding: 0 12px;
}

.proof-code {
	font-size: 14px;
	line-height: 22px;
	white-space: pre;
	color: #f9fafb;
	align-self: flex-start;
}

.proof-code-fira {
	font-family: CodeFontFamily;
}

.proof-code-system {
	font-family: monospace;
}

.proof-token-keyword { color: #60a5fa; }
.proof-token-function { color: #fbbf24; }
.proof-token-string { color: #86efac; }
.proof-token-punctuation { color: #cbd5e1; }
</style>
