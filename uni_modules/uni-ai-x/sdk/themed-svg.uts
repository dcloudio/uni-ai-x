import proxyWeb from '@/uni_modules/uni-ai-x/sdk/proxy-web.uts'
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'
import { getHarmonySvgWorkaroundConfig, prepareHarmonySvgImageSource } from '@/uni_modules/uni-ai-x/sdk/harmony-svg-workaround.uts'

export type ThemedSvgResult = {
	imageSource: string
	width: number
	height: number
	theme: string
}

type ThemedSvgCallback = (result: ThemedSvgResult) => void

const mathCache = new Map<string, ThemedSvgResult>()
const mermaidCache = new Map<string, ThemedSvgResult>()
type PendingMermaidRender = {
	callbacks: ThemedSvgCallback[]
	timer: number
}
const pendingMermaidRenders = new Map<string, PendingMermaidRender>()
const MERMAID_CACHE_STORAGE_PREFIX = 'uni-ai-mermaid-cache-'
const MERMAID_RENDER_TIMEOUT = 15000

function persistentCacheKey(key: string): string {
	let hash = 7
	for (let index = 0; index < key.length; index++) {
		hash = (hash * 31 + key.charCodeAt(index)) % 2147483647
	}
	return MERMAID_CACHE_STORAGE_PREFIX + hash.toString(16) + '-' + key.length.toString()
}

function readPersistentMermaidCache(key: string): ThemedSvgResult | null {
	try {
		const value = uni.getStorageSync(persistentCacheKey(key)) as string
		if (value.length == 0) return null
		const result = JSON.parse<ThemedSvgResult>(value) as ThemedSvgResult
		return result.imageSource.length > 0 ? result : null
	} catch (_error) {
		return null
	}
}

function writePersistentMermaidCache(key: string, result: ThemedSvgResult) {
	try {
		uni.setStorageSync(persistentCacheKey(key), JSON.stringify(result))
	} catch (error) {
		console.warn('[SvgCache] persist Mermaid cache failed: ' + error)
	}
}

function normalizedTheme(theme: string): string {
	return theme == 'dark' ? 'dark' : 'light'
}

function cacheKey(theme: string, source: string, workaroundVariant: string): string {
	return normalizedTheme(theme) + '\n' + workaroundVariant + '\n' + source
}

function shouldInlineMermaidComputedStyles(): boolean {
	let enabled = false
	// #ifdef APP-IOS || APP-HARMONY
	enabled = true
	// #endif
	return enabled
}

function shouldNormalizeMermaidNodeText(): boolean {
	let enabled = false
	// #ifdef APP-HARMONY
	enabled = true
	// #endif
	return enabled
}

function shouldNormalizeMermaidEdgeLabels(): boolean {
	let enabled = false
	// #ifdef APP-HARMONY
	enabled = true
	// #endif
	return enabled
}

function shouldMaterializeMermaidPointEndMarkers(): boolean {
	let enabled = false
	// #ifdef APP-IOS || APP-HARMONY
	enabled = true
	// #endif
	return enabled
}

function shouldApplyIOSCoreSvgCompatibility(): boolean {
	let enabled = false
	// #ifdef APP-IOS
	enabled = true
	// #endif
	return enabled
}

function shouldUseFileSourceForSvg(hasTextElements: boolean): boolean {
	const workaround = getHarmonySvgWorkaroundConfig()
	if (!workaround.useFileSource) return false
	let ignoreTextCheck = false
	// #ifdef APP-ANDROID
	ignoreTextCheck = true
	// #endif
	return ignoreTextCheck || !hasTextElements
}

function deliverResult(callback: ThemedSvgCallback, result: ThemedSvgResult) {
	utils.runOnDispatcher('main', () => {
		callback(result)
	})
}

export function renderMathSvgForTheme(mathText: string, theme: string, callback: ThemedSvgCallback) {
	const renderTheme = normalizedTheme(theme)
	const workaround = getHarmonySvgWorkaroundConfig()
	const renderVariant = workaround.cacheVariant + ':opaque-theme-background-v1'
	const key = cacheKey(renderTheme, mathText, renderVariant)
	const cached = mathCache.get(key)
	if (cached != null) {
		deliverResult(callback, cached)
		return
	}
	proxyWeb.callMethod({
		action: 'mathSvgRender',
		pureMathText: mathText,
		theme: renderTheme,
		rasterScale: workaround.rasterScale
	}, (param: UTSJSONObject) => {
		const hasTextElements = (param['hasTextElements'] as boolean | null) ?? false
		prepareHarmonySvgImageSource(param['imageDataURL'] as string,
			shouldUseFileSourceForSvg(hasTextElements),
			(imageSource: string, cacheable: boolean) => {
				const result: ThemedSvgResult = {
					imageSource,
					width: (param['width'] as number | null) ?? 0,
					height: (param['height'] as number | null) ?? 0,
					theme: (param['theme'] as string | null) ?? renderTheme
				}
				if (cacheable && result.imageSource.length > 0) mathCache.set(key, result)
				deliverResult(callback, result)
			})
	})
}

export function renderMermaidSvgForTheme(mermaidText: string, theme: string, callback: ThemedSvgCallback) {
	const renderTheme = normalizedTheme(theme)
	const workaround = getHarmonySvgWorkaroundConfig()
	const inlineComputedStyles = shouldInlineMermaidComputedStyles()
	const normalizeMermaidNodeText = shouldNormalizeMermaidNodeText()
	const normalizeMermaidEdgeLabels = shouldNormalizeMermaidEdgeLabels()
	const materializeMermaidPointEndMarkers = shouldMaterializeMermaidPointEndMarkers()
	const iosCoreSvgCompatibility = shouldApplyIOSCoreSvgCompatibility()
	const renderVariant = workaround.cacheVariant + ':' + (inlineComputedStyles ? 'inline-styles' : 'external-styles')
		+ ':' + (normalizeMermaidNodeText ? 'semantic-node-text-v1' : 'native-node-text')
		+ ':' + (normalizeMermaidEdgeLabels ? 'semantic-edge-label-v1' : 'native-edge-label')
		+ ':' + (materializeMermaidPointEndMarkers ? 'materialized-point-end-v2' : 'native-point-end')
		+ ':' + (iosCoreSvgCompatibility ? 'ios-coresvg-v5' : 'native-coresvg')
		+ ':opaque-theme-background-v1'
	const key = cacheKey(renderTheme, mermaidText, renderVariant)
	const cached = mermaidCache.get(key)
	if (cached != null) {
		deliverResult(callback, cached)
		return
	}
	const persisted = readPersistentMermaidCache(key)
	if (persisted != null) {
		mermaidCache.set(key, persisted)
		deliverResult(callback, persisted)
		return
	}
	const pendingKey = proxyWeb.getGeneration().toString() + ':' + key
	const pending = pendingMermaidRenders.get(pendingKey)
	if (pending != null) {
		proxyWeb.notifyRequest()
		pending.callbacks.push(callback)
		return
	}
	const request: PendingMermaidRender = {
		callbacks: [callback],
		timer: 0
	}
	pendingMermaidRenders.set(pendingKey, request)
	const finish = (result: ThemedSvgResult, cacheable: boolean) => {
		const active = pendingMermaidRenders.get(pendingKey)
		if (active == null) return
		clearTimeout(active.timer)
		pendingMermaidRenders.delete(pendingKey)
		if (cacheable && result.imageSource.length > 0) {
			mermaidCache.set(key, result)
			writePersistentMermaidCache(key, result)
		}
		for (let index = 0; index < active.callbacks.length; index++) {
			deliverResult(active.callbacks[index], result)
		}
	}
	request.timer = setTimeout(() => {
		finish({ imageSource: '', width: 0, height: 0, theme: renderTheme } as ThemedSvgResult, false)
	}, MERMAID_RENDER_TIMEOUT)
	proxyWeb.callMethod({
		action: 'renderMermaid',
		mermaidText,
		theme: renderTheme,
		rasterScale: workaround.rasterScale,
		inlineComputedStyles,
		normalizeMermaidNodeText,
		normalizeMermaidEdgeLabels,
		materializeMermaidPointEndMarkers,
		iosCoreSvgCompatibility,
		harmonyWorkaround: workaround.enabled
	}, (param: UTSJSONObject) => {
		const hasTextElements = (param['hasTextElements'] as boolean | null) ?? false
		prepareHarmonySvgImageSource(param['imageDataURL'] as string,
			shouldUseFileSourceForSvg(hasTextElements),
			(imageSource: string, cacheable: boolean) => {
				const result: ThemedSvgResult = {
					imageSource,
					width: (param['width'] as number | null) ?? 0,
					height: (param['height'] as number | null) ?? 0,
					theme: (param['theme'] as string | null) ?? renderTheme
				}
				finish(result, cacheable)
			})
	})
}
