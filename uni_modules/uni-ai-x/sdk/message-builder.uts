import { ChatItem, RequestAiCoMessage, MultiModalContent, ImgParse } from '@/uni_modules/uni-ai-x/types.uts'

function buildMultimodalContent(body: string, imgUrlList: string[]): MultiModalContent {
	const content = [] as MultiModalContent
	imgUrlList.forEach((url: string) => {
		const imageContent: ImgParse = {
			type: 'image_url',
			image_url: {
				url
			}
		}
		content.push(imageContent)
	})
	content.push({
		type: 'text',
		text: body
	})
	return content
}

export function buildAiMessages(chatItem: ChatItem): RequestAiCoMessage[] {
	const messages: RequestAiCoMessage[] = []
	chatItem.msgList.forEach((item) => {
		const body = item.from_uid == 'uni-ai' && (item.toolResultText ?? '').length > 0
			? item.body + '\n' + item.toolResultText! : item.body
		let content: string | MultiModalContent = body
		if (item.from_uid != 'uni-ai' && (item.img_url_list?.length ?? 0) > 0) {
			content = buildMultimodalContent(item.body, item.img_url_list!)
		}
		if (item.from_uid != 'uni-ai' && (item.file_list?.length ?? 0) > 0) {
			const parts: MultiModalContent = typeof content == 'string' ? [{ type: 'text', text: body }] : content as MultiModalContent
			item.file_list!.forEach((file) => { parts.push({ type: 'file', file_id: file.id }) })
			content = parts
		}
		messages.push({
			role: item.from_uid == 'uni-ai' ? 'assistant' : 'user',
			content,
			server_tool_calls: item.from_uid == 'uni-ai' ? item.serverToolCalls : undefined
		})
	})
	return messages
}

// Never send official server tool signatures to another provider.
export function prepareProviderMessages(messages: RequestAiCoMessage[], official: boolean): RequestAiCoMessage[] {
	if (official) return messages
	return messages.map((message): RequestAiCoMessage => ({ role: message.role, content: message.content }))
}
