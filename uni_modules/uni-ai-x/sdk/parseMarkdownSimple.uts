import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
// #ifndef APP
import { md2json } from '@/uni_modules/uni-cmark'
// #endif
import { parseLineCode, ParseLineCodeRes } from '@/uni_modules/uni-ai-x/sdk/parseCode.uts'
import proxyWeb from '@/uni_modules/uni-ai-x/sdk/proxy-web.uts'
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'

type ParseDone = (markdownTokenList: MarkdownToken[], isParseDone: boolean) => void
type Md2JsonCallBack = (markdownTokenList: MarkdownToken[]) => void
type CallBack = () => void

type PendingTask = {
	text: string
	isDone: boolean
}

type MathStart = {
	index: number
	startToken: string
	endToken: string
}

function findMathStart(text: string): MathStart | null {
	const pattern = /\$\$|\$|\\\[|\\\(|\\begin\{[a-zA-Z*]+\}/
	const index = text.search(pattern)
	if (index == -1) return null
	const match = text.match(pattern)![0]!
	let endToken = match
	if (match == '\\[') endToken = '\\]'
	if (match == '\\(') endToken = '\\)'
	if (match.startsWith('\\begin{')) endToken = '\\end{' + match.slice(7)
	return { index, startToken: match, endToken } as MathStart
}

function preprocessMathText(markdownText: string): string {
	const parts = markdownText.split('```')
	let result = ''
	for (let i = 0; i < parts.length; i++) {
		if (i % 2 == 1) {
			result += '```' + parts[i]
			continue
		}
		let text = parts[i]
		let output = ''
		while (text.length > 0) {
			const start = findMathStart(text)
			if (start == null) {
				output += text
				break
			}
			const index = start.index
			const startToken = start.startToken
			const endToken = start.endToken
			const contentStart = index + startToken.length
			const rest = text.slice(contentStart)
			const endIndex = rest.indexOf(endToken)
			if (endIndex == -1) {
				output += text
				break
			}
			const mathText = rest.slice(0, endIndex)
			output += text.slice(0, index) + "\n```math\n" + mathText + "\n```\n"
			text = rest.slice(endIndex + endToken.length)
		}
		result += (i == 0 ? '' : '```') + output
	}
	return result
}

export default class ParseMarkdownSimple {
	updateCallBack: ParseDone
	parseLock: boolean = false
	pendingTask: PendingTask | null = null
	parseTimer: number = 0
	userAbort: boolean = false
	msgReceiveDone: boolean = false
	parseInterval: number
	lastParseTime: number = 0
	private seq: number = 0
	private cacheMap: Map<string, MarkdownToken> = new Map()

	constructor(updateCallBack: ParseDone, parseInterval: number = 180) {
		this.updateCallBack = updateCallBack
		this.parseInterval = parseInterval
	}

	runTask(msgBody: string) {
		this.scheduleParse(msgBody, this.msgReceiveDone)
	}

	flush(msgBody: string) {
		this.scheduleParse(msgBody, true, true)
	}

	private scheduleParse(msgBody: string, isDone: boolean, immediate: boolean = false) {
		if (this.userAbort) return
		if (this.pendingTask == null) {
			this.pendingTask = { text: msgBody, isDone }
		} else {
			this.pendingTask.text = msgBody
			this.pendingTask.isDone = this.pendingTask.isDone || isDone
		}
		if (immediate) {
			if (this.parseTimer != 0) {
				clearTimeout(this.parseTimer)
				this.parseTimer = 0
			}
			this.consumePending()
			return
		}
		if (this.parseLock) return
		const now = Date.now()
		const elapsed = this.lastParseTime == 0 ? this.parseInterval : now - this.lastParseTime
		if (elapsed >= this.parseInterval) {
			this.consumePending()
			return
		}
		if (this.parseTimer != 0) return
		this.parseTimer = setTimeout(() => {
			this.parseTimer = 0
			this.consumePending()
		}, this.parseInterval - elapsed)
	}

	private consumePending() {
		if (this.parseLock || this.pendingTask == null || this.userAbort) return
		if (this.parseTimer != 0) {
			clearTimeout(this.parseTimer)
			this.parseTimer = 0
		}
		const task = this.pendingTask
		this.pendingTask = null
		this.parseLock = true
		this.lastParseTime = Date.now()
		const currentSeq = ++this.seq
		this.md2jsonTask(task.text, task.isDone, (list: MarkdownToken[]) => {
			if (currentSeq != this.seq || this.userAbort) {
				this.parseLock = false
				return
			}
			this.updateCallBack(list, task.isDone)
			this.parseLock = false
			if (this.pendingTask != null) {
				this.scheduleParse(this.pendingTask.text, this.pendingTask.isDone)
			}
		})
	}

	private md2jsonTask(markdownText: string, isDone: boolean, md2JsonCallBack: Md2JsonCallBack) {
		markdownText = preprocessMathText(markdownText)
		// #ifdef APP
		proxyWeb.callMethod({
			action: 'parseMarkdown',
			markdownText
		}, (param: UTSJSONObject) => {
			const errorMsg = param['errorMsg'] as string | null
			if (errorMsg != null && errorMsg.length > 0) {
				md2JsonCallBack([])
				return
			}
			const jsonString = param['jsonString'] as string | null
			let newJsonList: MarkdownToken[] = []
			if (jsonString != null && jsonString.length > 0) {
				newJsonList = JSON.parseArray<MarkdownToken>(jsonString) as MarkdownToken[]
			}
			this.handleMd2jsonResult(newJsonList, isDone, md2JsonCallBack)
		})
		return
		// #endif
		// #ifndef APP
		const parseMdRes = md2json(markdownText)
		if (parseMdRes.errorMsg.length > 0) {
			md2JsonCallBack([])
			return
		}
		this.handleMd2jsonResult(parseMdRes.data, isDone, md2JsonCallBack)
		// #endif
	}

	private handleMd2jsonResult(newJsonList: MarkdownToken[], isDone: boolean, md2JsonCallBack: Md2JsonCallBack) {
		console.log('uni-ai-x-render simple-parse tokens=' + newJsonList.length + ' done=' + isDone)
		if (newJsonList.length == 0) {
			md2JsonCallBack([])
			return
		}
		const beforeDone = this.createBeforeDone(newJsonList.length, () => md2JsonCallBack(newJsonList))
		for (let i = 0; i < newJsonList.length; i++) {
			const item = newJsonList[i]
			item.uniqueId = 's' + i
			item.isClose = 1
			this.enrichToken(item, isDone, (nextToken: MarkdownToken | null) => {
				if (nextToken != null) newJsonList[i] = nextToken
				beforeDone()
			})
		}
	}

	private enrichToken(item: MarkdownToken, isDone: boolean, callBack: (token: MarkdownToken | null) => void) {
		if (item.type == 'table') {
			this.setApproxTableContentWidth(item.tokens ?? [])
			callBack(null)
			return
		}
		if (item.type != 'code_block') {
			callBack(null)
			return
		}
		item.text = item.text ?? ''
		const lang = item.lang ?? 'text'
		if (lang == 'math') {
			this.parseMath(item, callBack)
			return
		}
		if (lang == 'mermaid') {
			this.parseMermaid(item, () => callBack(null))
			return
		}
		// 流式阶段也尽量做代码高亮，避免闭合后的代码块要等整条消息结束才变成正确样式。
		this.parseCodehighlight(item, () => callBack(null))
	}

	private tokenCacheKey(codeToken: MarkdownToken): string {
		return (codeToken.lang ?? 'text') + '\n' + (codeToken.text ?? '')
	}

	private parseCodehighlight(codeToken: MarkdownToken, callBack: CallBack) {
		const key = this.tokenCacheKey(codeToken)
		const cached = this.cacheMap.get(key)
		if (cached != null && cached.codeTokens != null) {
			codeToken.codeTokens = cached.codeTokens
			callBack()
			return
		}
		const codeTextArr = codeToken.text?.split('\n') ?? []
		const codeTokens = [] as MarkdownToken[][]
		let lineIndex = 0
		const parseNext = () => {
			if (lineIndex >= codeTextArr.length) {
				codeToken.codeTokens = codeTokens
				this.cacheMap.set(key, codeToken)
				callBack()
				return
			}
			const lineCodeText = codeTextArr[lineIndex]
			parseLineCode((parseCodeRes: ParseLineCodeRes) => {
				codeTokens.push(parseCodeRes.error == null ? parseCodeRes.tokens : [{ text: lineCodeText, className: '' }] as MarkdownToken[])
				lineIndex++
				parseNext()
			}, lineCodeText, codeToken.lang ?? 'text')
		}
		parseNext()
	}

	private parseMermaid(mermaidToken: MarkdownToken, callBack: CallBack) {
		//#ifdef MP-WEIXIN
		callBack()
		//#endif
		// #ifndef MP-WEIXIN
		proxyWeb.callMethod({
			action: 'renderMermaid',
			mermaidText: mermaidToken.text
		}, (param: UTSJSONObject) => {
			const imageDataURL: string = param['imageDataURL'] as string
			if (imageDataURL.length > 0) mermaidToken.href = imageDataURL
			callBack()
		})
		// #endif
	}

	private parseMath(mathToken: MarkdownToken, callBack: (token: MarkdownToken | null) => void) {
		// #ifdef MP-WEIXIN
		callBack(null)
		// #endif
		// #ifndef MP-WEIXIN
		mathToken.text = mathToken.text?.trim()
		proxyWeb.callMethod({
			action: 'katexRender',
			pureMathText: mathToken.text!
		}, (param: UTSJSONObject) => {
			const latexEl: MarkdownToken = {
				type: 'math',
				text: mathToken.text!,
				html: param['resultHtml'] as string | null,
				href: param['imageDataURL'] as string | null,
				width: param['width'] as number | null,
				height: param['height'] as number | null,
				isClose: 1,
				uniqueId: mathToken.uniqueId!
			}
			callBack(latexEl)
		})
		// #endif
	}

	private setApproxTableContentWidth(tableData: MarkdownToken[]) {
		for (let rowIndex = 0; rowIndex < tableData.length; rowIndex++) {
			const row = tableData[rowIndex]
			for (let cellIndex = 0; cellIndex < (row.tokens?.length ?? 0); cellIndex++) {
				const cell = row.tokens![cellIndex]
				cell.width = 0
				for (let itemIndex = 0; itemIndex < (cell.tokens?.length ?? 0); itemIndex++) {
					const cellItem = cell.tokens![itemIndex]
					const text = cellItem.text ?? utils.getTokensText(cellItem.tokens)
					const fontSize = rowIndex == 0 ? 16 : 14
					cellItem.width = text.length == 0 ? 0 : text.length * fontSize * 0.6
					cell.width = (cell.width ?? 0) + cellItem.width
				}
			}
		}
	}

	private createBeforeDone(totalCount: number, callBack: CallBack) {
		if (totalCount <= 0) {
			callBack()
			return () => {}
		}
		let parseCount = 0
		return () => {
			parseCount++
			if (parseCount == totalCount) callBack()
		}
	}
}
