import { MarkdownToken, ParseMdRes } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import { md2json, initCmark } from '@/uni_modules/uni-cmark'
// #ifdef APP-ANDROID
import { asyncMd2json } from '@/uni_modules/uni-cmark'
// #endif
import { parseLineCode, ParseLineCodeRes } from '@/uni_modules/uni-ai-x/sdk/parseCode.uts'
import { setApproxTableContentWidth } from '@/uni_modules/uni-ai-x/sdk/markdown-utils.uts'
import proxyWeb from '@/uni_modules/uni-ai-x/sdk/proxy-web.uts'
import { MarkdownPreprocessor } from '@/uni_modules/uni-ai-worker/utssdk/markdown-preprocessor.uts'

type ParseDone = (markdownTokenList: MarkdownToken[], isParseDone: boolean) => void
type Md2JsonCallBack = (markdownTokenList: MarkdownToken[], isParseDone: boolean | null) => void
type UniCmarkCallback = (result: ParseMdRes) => void
type CallBack = () => void
let parseMarkdownInstanceIndex = 0
const TOKEN_PUBLISH_DELAY = 48
function markdownErrorLog(message: string) {
	console.error(message)
}

export default class ParseMarkdown {
	updateCallBack: ParseDone
	parsing: boolean = false
	pendingText: string | null = null
	pendingDone: boolean = false
	parseTimer: number = 0
	userAbort: boolean = false
	msgReceiveDone: boolean = false
	parseInterval: number
	lastParseTime: number = 0
	private codeLineCacheMap: Map<string, MarkdownToken[]> = new Map()
	private mathCacheMap: Map<string, MarkdownToken> = new Map()
	private mathRenderingMap: Map<string, boolean> = new Map()
	private pendingMathRenderMap: Map<string, MarkdownToken> = new Map()
	private pendingMathRenderKeys: string[] = []
	private mathPublishTimer: number = 0
	private tokenPublishTimer: number = 0
	private pendingPublishList: MarkdownToken[] | null = null
	private pendingPublishDone: boolean = false
	private lastPublishedList: MarkdownToken[] = [] as MarkdownToken[]
	private lastPublishedDone: boolean = false
	private lastParsedText: string = ''
	private lastParsedDone: boolean = false
	private segmentTokenList: MarkdownToken[] = []
	private markdownPreprocessor: MarkdownPreprocessor = new MarkdownPreprocessor()
	private workerPendingTokens: MarkdownToken[] | null = null
	private workerPendingDone: boolean = false
	private workerEnriching: boolean = false
	private latestMsgBody: string = ''
	private traceId: string = ''
	private cmarkReady: boolean = false
	private cmarkInitializing: boolean = false

	constructor(updateCallBack: ParseDone, parseInterval: number = 180, traceId: string = '') {
		this.updateCallBack = updateCallBack
		this.parseInterval = parseInterval
		parseMarkdownInstanceIndex++
		this.traceId = traceId.length > 0 ? traceId : ('pm-' + parseMarkdownInstanceIndex.toString())
		// #ifndef APP
		this.ensureCmarkReady()
		// #endif
		// #ifdef APP-HARMONY
		this.ensureCmarkReady()
		// #endif
	}

	runTask(msgBody: string) {
		this.scheduleParse(msgBody, this.msgReceiveDone)
	}

	flush(msgBody: string) {
		this.scheduleParse(msgBody, true, true)
	}

	applyParsedTokens(markdownTokenList: MarkdownToken[], isDone: boolean) {
		if (this.userAbort) return
		this.msgReceiveDone = this.msgReceiveDone || isDone
		this.workerPendingTokens = markdownTokenList
		this.workerPendingDone = this.workerPendingDone || isDone
		this.enrichPendingWorkerTokens()
	}

	private enrichPendingWorkerTokens() {
		if (this.workerEnriching || this.workerPendingTokens == null || this.userAbort) return
		const nextTokenList = this.workerPendingTokens!
		const isDone = this.workerPendingDone
		this.workerPendingTokens = null
		this.workerPendingDone = false
		this.workerEnriching = true
		this.enrichParsedTokenList(nextTokenList, isDone, (list: MarkdownToken[]) => {
			this.workerEnriching = false
			if (this.userAbort) return
			this.queueTokenPublish(list, isDone)
			this.enrichPendingWorkerTokens()
		})
	}

	private scheduleParse(msgBody: string, isDone: boolean, immediate: boolean = false) {
		if (this.userAbort) return
		if (msgBody.length < this.latestMsgBody.length) return
		this.latestMsgBody = msgBody
		this.pendingText = msgBody
		this.pendingDone = this.pendingDone || isDone
		if (immediate) {
			if (this.parseTimer != 0) {
				clearTimeout(this.parseTimer)
				this.parseTimer = 0
			}
			this.parsePending()
			return
		}
		if (this.parsing) return
		const now = Date.now()
		const elapsed = this.lastParseTime == 0 ? this.parseInterval : now - this.lastParseTime
		if (elapsed >= this.parseInterval) {
			this.parsePending()
			return
		}
		if (this.parseTimer != 0) return
		this.parseTimer = setTimeout(() => {
			this.parseTimer = 0
			this.parsePending()
		}, this.parseInterval - elapsed)
	}

	private parsePending() {
		if (this.parsing || this.pendingText == null || this.userAbort) return
		// #ifndef APP
		if (!this.cmarkReady) {
			this.ensureCmarkReady()
			if (this.parseTimer == 0) {
				this.parseTimer = setTimeout(() => {
					this.parseTimer = 0
					this.parsePending()
				}, 50)
			}
			return
		}
		// #endif
		// #ifdef APP-HARMONY
		if (!this.cmarkReady) {
			this.ensureCmarkReady()
			if (this.parseTimer == 0) {
				this.parseTimer = setTimeout(() => {
					this.parseTimer = 0
					this.parsePending()
				}, 50)
			}
			return
		}
		// #endif
		if (this.parseTimer != 0) {
			clearTimeout(this.parseTimer)
			this.parseTimer = 0
		}
		const text = this.pendingText
		const isDone = this.pendingDone
		this.pendingText = null
		this.pendingDone = false
		if (text == this.lastParsedText && (this.lastParsedDone || !isDone)) return
		this.parsing = true
		this.lastParseTime = Date.now()
		this.md2jsonTask(text, isDone, (list: MarkdownToken[], parseDone: boolean | null) => {
			this.parsing = false
			if (this.userAbort) {
				return
			}
			const callbackDone = parseDone ?? isDone
			this.lastParsedText = text
			this.lastParsedDone = callbackDone
			this.queueTokenPublish(list, callbackDone)
			if (this.pendingText != null) {
				this.scheduleParse(this.pendingText, this.pendingDone || this.msgReceiveDone)
			} else if (this.msgReceiveDone && !callbackDone) {
				this.scheduleParse(this.latestMsgBody, true)
			}
		})
	}

	private ensureCmarkReady() {
		if (this.cmarkReady || this.cmarkInitializing) return
		this.cmarkInitializing = true
		initCmark().then(() => {
			this.cmarkReady = true
			this.cmarkInitializing = false
			if (this.pendingText != null && this.parseTimer == 0 && !this.parsing && !this.userAbort) {
				this.parseTimer = setTimeout(() => {
					this.parseTimer = 0
					this.parsePending()
				}, 0)
			}
		}).catch((err) => {
			this.cmarkInitializing = false
			markdownErrorLog('[uni-ai-x][Markdown解析][' + this.traceId + '] uni-CMark初始化失败：' + JSON.stringify(err))
		})
	}

	private md2jsonTask(markdownText: string, isDone: boolean, md2JsonCallBack: Md2JsonCallBack) {
		const processedMarkdownText = this.markdownPreprocessor.process(markdownText, isDone)
		if (processedMarkdownText == null) {
			md2JsonCallBack(this.publishTokenList(), false)
			return
		}
		this.md2jsonCurrent(processedMarkdownText, isDone, md2JsonCallBack)
		return
	}

	private md2jsonCurrent(markdownText: string, isDone: boolean, md2JsonCallBack: Md2JsonCallBack) {
		this.parseWithUniCmark(markdownText, (parseMdRes: ParseMdRes) => {
			if (this.userAbort) return
			if (parseMdRes.errorMsg.length > 0) {
				markdownErrorLog('[uni-ai-x][Markdown解析] uni-CMark原生解析失败：' + parseMdRes.errorMsg)
				md2JsonCallBack(this.publishTokenList(), isDone)
				return
			}
			this.enrichParsedTokenList(parseMdRes.data, isDone, (list: MarkdownToken[]) => {
				md2JsonCallBack(list, isDone)
			})
		})
	}

	private enrichParsedTokenList(nextTokenList: MarkdownToken[], isDone: boolean, callback: (list: MarkdownToken[]) => void) {
		for (let i = 0; i < nextTokenList.length; i++) {
			const nextToken = nextTokenList[i]
			nextToken.uniqueId = 'u' + i.toString()
			nextToken.isClose = (isDone || i < nextTokenList.length - 1) ? 1 : 0
			const previousToken = i < this.segmentTokenList.length ? this.segmentTokenList[i] : null
			if (previousToken != null && this.canReusePublishedToken(previousToken, nextToken)) {
				nextTokenList[i] = previousToken
			}
		}
		const beforeDone = this.createBeforeDone(nextTokenList.length, () => {
			this.segmentTokenList = nextTokenList
			callback(this.publishTokenList())
		})
		for (let i = 0; i < nextTokenList.length; i++) {
			const token = nextTokenList[i]
			const previousToken = i < this.segmentTokenList.length ? this.segmentTokenList[i] : null
			if (previousToken != null && token === previousToken) {
				beforeDone()
				continue
			}
			this.enrichToken(token, (nextToken: MarkdownToken | null) => {
				if (nextToken != null) nextTokenList[i] = nextToken
				beforeDone()
			})
		}
	}

	private canReusePublishedToken(previousToken: MarkdownToken, nextToken: MarkdownToken): boolean {
		if (previousToken.isClose != 1 || nextToken.isClose != 1) return false
		if ((previousToken.type ?? '') != (nextToken.type ?? '')) return false
		const previousRaw = previousToken.raw ?? ''
		const nextRaw = nextToken.raw ?? ''
		if (previousRaw.length > 0 || nextRaw.length > 0) return previousRaw == nextRaw
		return (previousToken.text ?? '') == (nextToken.text ?? '') &&
			(previousToken.lang ?? '') == (nextToken.lang ?? '') &&
			(previousToken.depth ?? 0) == (nextToken.depth ?? 0)
	}

	private parseWithUniCmark(markdownText: string, callback: UniCmarkCallback) {
		// #ifdef APP-ANDROID
		asyncMd2json(markdownText, (result: ParseMdRes) => {
			callback(result)
		})
		return
		// #endif
		// #ifdef APP-IOS
		const jsonString = md2json(markdownText) as string
		const jsonArray = JSON.parseArray<MarkdownToken>(jsonString) as MarkdownToken[]
		callback({
			data: jsonArray,
			errorMsg: ''
		} as ParseMdRes)
		return
		// #endif
		// #ifdef APP-HARMONY
		callback(md2json(markdownText) as ParseMdRes)
		return
		// #endif
		// #ifndef APP
		callback(md2json(markdownText) as ParseMdRes)
		// #endif
	}

	private publishTokenList(): MarkdownToken[] {
		return this.segmentTokenList.slice()
	}

	private tokenListsMatch(left: MarkdownToken[], right: MarkdownToken[]): boolean {
		if (left.length != right.length) return false
		for (let i = 0; i < left.length; i++) {
			if (left[i] !== right[i]) return false
		}
		return true
	}

	private queueTokenPublish(list: MarkdownToken[], isDone: boolean) {
		this.pendingPublishList = list
		this.pendingPublishDone = this.pendingPublishDone || isDone
		if (this.tokenPublishTimer != 0) return
		this.tokenPublishTimer = setTimeout(() => {
			this.tokenPublishTimer = 0
			this.flushTokenPublish()
		}, TOKEN_PUBLISH_DELAY)
	}

	private flushTokenPublish() {
		if (this.userAbort || this.pendingPublishList == null) return
		const list = this.pendingPublishList!
		const isDone = this.pendingPublishDone
		this.pendingPublishList = null
		this.pendingPublishDone = false
		if (this.tokenListsMatch(list, this.lastPublishedList) && (!isDone || this.lastPublishedDone)) return
		this.lastPublishedList = list
		this.lastPublishedDone = isDone
		this.updateCallBack(list, isDone)
	}

	private enrichToken(item: MarkdownToken, callBack: (token: MarkdownToken | null) => void) {
		if (item.type == 'table') {
			setApproxTableContentWidth(item.tokens ?? [])
			callBack(null)
			return
		}
		if (item.type != 'code_block') {
			callBack(null)
			return
		}
		item.text = item.text ?? ''
		const lang = item.lang ?? 'text'
		if (lang == 'math') {
			this.parseMath(item, callBack)
			return
		}
		if (item.isClose == 1 && lang == 'mermaid') {
			this.parseMermaid(item, () => callBack(null))
			return
		}
		this.parseCodehighlight(item, () => callBack(null))
	}

	private codeLineCacheKey(language: string, lineText: string): string {
		return language + '\n' + lineText
	}

	private parseCodehighlight(codeToken: MarkdownToken, callBack: CallBack) {
		const language = codeToken.lang ?? 'text'
		const codeTextArr = codeToken.text?.split('\n') ?? []
		const codeTokens = [] as MarkdownToken[][]
		let lineIndex = 0
		const parseNext = () => {
			if (lineIndex >= codeTextArr.length) {
				codeToken.codeTokens = codeTokens
				callBack()
				return
			}
			const lineCodeText = codeTextArr[lineIndex]
			const cacheKey = this.codeLineCacheKey(language, lineCodeText)
			const cachedTokens = this.codeLineCacheMap.get(cacheKey)
			if (cachedTokens != null) {
				codeTokens.push(cachedTokens)
				lineIndex++
				parseNext()
				return
			}
			parseLineCode((parseCodeRes: ParseLineCodeRes) => {
				const lineTokens = parseCodeRes.error == null ? (parseCodeRes.tokens ?? [] as MarkdownToken[]) : [{ text: lineCodeText, className: '' }] as MarkdownToken[]
				this.codeLineCacheMap.set(cacheKey, lineTokens)
				codeTokens.push(lineTokens)
				lineIndex++
				parseNext()
			}, lineCodeText, language)
		}
		parseNext()
	}

	private parseMermaid(mermaidToken: MarkdownToken, callBack: CallBack) {
		//#ifdef MP-WEIXIN
		callBack()
		//#endif
		// #ifndef MP-WEIXIN
		proxyWeb.callMethod({
			action: 'renderMermaid',
			mermaidText: mermaidToken.text
		}, (param: UTSJSONObject) => {
			const imageDataURL: string = param['imageDataURL'] as string
			if (imageDataURL.length > 0) {
				mermaidToken.href = imageDataURL
				mermaidToken.renderTheme = (param['theme'] as string | null) ?? ''
			}
			callBack()
		})
		// #endif
	}

	private parseMath(mathToken: MarkdownToken, callBack: (token: MarkdownToken | null) => void) {
		// #ifdef MP-WEIXIN
		callBack(null)
		// #endif
		// #ifndef MP-WEIXIN
		mathToken.text = mathToken.text?.trim()
		const cacheKey = mathToken.text ?? ''
		const cachedToken = this.mathCacheMap.get(cacheKey)
		if (cachedToken != null) {
			this.applyRenderedMathAttrs(mathToken, cachedToken)
			callBack(null)
			return
		}
		this.parseCodehighlight(mathToken, () => {
			callBack(null)
			this.ensureMathRenderStarted(cacheKey, mathToken.text ?? '')
		})
		// #endif
	}

	private applyRenderedMathAttrs(target: MarkdownToken, rendered: MarkdownToken) {
		target.href = rendered.href
		target.html = rendered.html
		target.width = rendered.width
		target.height = rendered.height
		target.renderTheme = rendered.renderTheme
	}

	private ensureMathRenderStarted(cacheKey: string, mathText: string) {
		if (cacheKey.length == 0) return
		if (this.mathRenderingMap.get(cacheKey) == true) return
		this.mathRenderingMap.set(cacheKey, true)
		setTimeout(() => {
			proxyWeb.callMethod({
				action: 'mathSvgRender',
				pureMathText: mathText
			}, (param: UTSJSONObject) => {
				this.mathRenderingMap.delete(cacheKey)
				if (this.userAbort) return
				const renderedToken: MarkdownToken = {
					type: 'code_block',
					lang: 'math',
					text: mathText,
					html: null,
					href: param['imageDataURL'] as string | null,
					width: param['width'] as number | null,
					height: param['height'] as number | null,
					renderTheme: (param['theme'] as string | null) ?? '',
					isClose: 1
				}
				if ((renderedToken.href ?? '').length == 0) return
				this.mathCacheMap.set(cacheKey, renderedToken)
				this.enqueueRenderedMath(cacheKey, renderedToken)
			})
		}, 16)
	}

	private enqueueRenderedMath(cacheKey: string, renderedToken: MarkdownToken) {
		this.pendingMathRenderMap.set(cacheKey, renderedToken)
		if (this.pendingMathRenderKeys.indexOf(cacheKey) == -1) this.pendingMathRenderKeys.push(cacheKey)
		if (this.mathPublishTimer != 0) return
		this.mathPublishTimer = setTimeout(() => {
			this.mathPublishTimer = 0
			this.publishNextRenderedMath()
		}, 0)
	}

	private publishNextRenderedMath() {
		if (this.userAbort) {
			this.pendingMathRenderKeys = []
			this.pendingMathRenderMap.clear()
			return
		}
		if (this.pendingMathRenderKeys.length == 0) return
		const cacheKey = this.pendingMathRenderKeys[0]
		this.pendingMathRenderKeys.splice(0, 1)
		const renderedToken = this.pendingMathRenderMap.get(cacheKey)
		this.pendingMathRenderMap.delete(cacheKey)
		if (renderedToken != null && this.replaceRenderedMathToken(cacheKey, renderedToken)) {
			this.queueTokenPublish(this.publishTokenList(), this.msgReceiveDone)
		}
		if (this.pendingMathRenderKeys.length == 0) return
		this.mathPublishTimer = setTimeout(() => {
			this.mathPublishTimer = 0
			this.publishNextRenderedMath()
		}, 80)
	}

	private replaceRenderedMathToken(cacheKey: string, renderedToken: MarkdownToken): boolean {
		let replaced = false
		for (let i = 0; i < this.segmentTokenList.length; i++) {
			const item = this.segmentTokenList[i]
			if (!this.containsMathTokenNeedingRender(item, cacheKey, renderedToken)) continue
			const clonedList = JSON.parseArray<MarkdownToken>(JSON.stringify([item])) as MarkdownToken[]
			if (clonedList.length == 0) continue
			const clonedItem = clonedList[0]
			if (this.replaceRenderedMathInList([clonedItem] as MarkdownToken[], cacheKey, renderedToken)) {
				this.segmentTokenList[i] = clonedItem
				replaced = true
			}
		}
		return replaced
	}

	private containsMathTokenNeedingRender(item: MarkdownToken, cacheKey: string, renderedToken: MarkdownToken): boolean {
		if (item.type == 'code_block' && (item.lang ?? '') == 'math' && (item.text ?? '').trim() == cacheKey && item.href != renderedToken.href) return true
		const tokens = item.tokens ?? [] as MarkdownToken[]
		for (let i = 0; i < tokens.length; i++) {
			if (this.containsMathTokenNeedingRender(tokens[i], cacheKey, renderedToken)) return true
		}
		const items = item.items ?? [] as MarkdownToken[]
		for (let i = 0; i < items.length; i++) {
			if (this.containsMathTokenNeedingRender(items[i], cacheKey, renderedToken)) return true
		}
		return false
	}

	private replaceRenderedMathInList(tokenList: MarkdownToken[] | null, cacheKey: string, renderedToken: MarkdownToken): boolean {
		if (tokenList == null) return false
		let replaced = false
		for (let i = 0; i < tokenList.length; i++) {
			const item = tokenList[i]
			if (item == null) continue
			if (item.type == 'code_block' && (item.lang ?? '') == 'math' && (item.text ?? '').trim() == cacheKey) {
				this.applyRenderedMathAttrs(item, renderedToken)
				replaced = true
			}
			if (this.replaceRenderedMathInList(item.tokens ?? null, cacheKey, renderedToken)) replaced = true
			if (this.replaceRenderedMathInList(item.items ?? null, cacheKey, renderedToken)) replaced = true
		}
		return replaced
	}

	private createBeforeDone(totalCount: number, callBack: CallBack) {
		if (totalCount <= 0) {
			callBack()
			return () => {}
		}
		let parseCount = 0
		return () => {
			parseCount++
			if (parseCount == totalCount) callBack()
		}
	}

	dispose() {
		this.userAbort = true
		if (this.parseTimer != 0) clearTimeout(this.parseTimer)
		if (this.mathPublishTimer != 0) clearTimeout(this.mathPublishTimer)
		if (this.tokenPublishTimer != 0) clearTimeout(this.tokenPublishTimer)
		this.parseTimer = 0
		this.mathPublishTimer = 0
		this.tokenPublishTimer = 0
		this.pendingText = null
		this.pendingPublishList = null
		this.workerPendingTokens = null
		this.workerPendingDone = false
		this.pendingPublishDone = false
		this.pendingMathRenderKeys = []
		this.pendingMathRenderMap.clear()
	}
}
