import { MarkdownToken, ParseMdRes } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import { md2json, initCmark } from '@/uni_modules/uni-cmark'
// #ifdef APP-ANDROID
import { asyncMd2json } from '@/uni_modules/uni-cmark'
// #endif
import { parseLineCode, ParseLineCodeRes } from '@/uni_modules/uni-ai-x/sdk/parseCode.uts'
import { setApproxTableContentWidth } from '@/uni_modules/uni-ai-x/sdk/markdown-utils.uts'
import proxyWeb from '@/uni_modules/uni-ai-x/sdk/proxy-web.uts'

type ParseDone = (markdownTokenList: MarkdownToken[], isParseDone: boolean) => void
type Md2JsonCallBack = (markdownTokenList: MarkdownToken[], isParseDone: boolean | null) => void
type UniCmarkCallback = (result: ParseMdRes) => void
type CallBack = () => void
let parseMarkdownInstanceIndex = 0
const mathMarkMap = new Map<string, string>([
	['$', '$'],
	['$$', '$$'],
	['\\[', '\\]'],
	['\\(', '\\)'],
	['\\begin{', '\\end{']
])

function markdownErrorLog(message: string) {
	console.error(message)
}

export default class ParseMarkdown {
	updateCallBack: ParseDone
	parsing: boolean = false
	pendingText: string | null = null
	pendingDone: boolean = false
	parseTimer: number = 0
	userAbort: boolean = false
	msgReceiveDone: boolean = false
	parseInterval: number
	lastParseTime: number = 0
	private codeLineCacheMap: Map<string, MarkdownToken[]> = new Map()
	private segmentTokenList: MarkdownToken[] = []
	private segmentStartLineIndex: number = 0
	private segmentEndLineIndex: number = 1
	private segmentNeedContinue: boolean = false
	private oldMsgBodyLength: number = 0
	private lastMathEndIndex: number = 0
	private myMarkdownText: string = ''
	private latestMsgBody: string = ''
	private traceId: string = ''
	private cmarkReady: boolean = false
	private cmarkInitializing: boolean = false

	constructor(updateCallBack: ParseDone, parseInterval: number = 180, traceId: string = '') {
		this.updateCallBack = updateCallBack
		this.parseInterval = parseInterval
		parseMarkdownInstanceIndex++
		this.traceId = traceId.length > 0 ? traceId : ('pm-' + parseMarkdownInstanceIndex.toString())
		// #ifndef APP
		this.ensureCmarkReady()
		// #endif
		// #ifdef APP-HARMONY
		this.ensureCmarkReady()
		// #endif
	}

	runTask(msgBody: string) {
		this.scheduleParse(msgBody, this.msgReceiveDone)
	}

	flush(msgBody: string) {
		this.scheduleParse(msgBody, true, true)
	}

	private scheduleParse(msgBody: string, isDone: boolean, immediate: boolean = false) {
		if (this.userAbort) return
		if (msgBody.length < this.latestMsgBody.length) return
		this.latestMsgBody = msgBody
		this.pendingText = msgBody
		this.pendingDone = this.pendingDone || isDone
		if (immediate) {
			if (this.parseTimer != 0) {
				clearTimeout(this.parseTimer)
				this.parseTimer = 0
			}
			this.parsePending()
			return
		}
		if (this.parsing) return
		const now = Date.now()
		const elapsed = this.lastParseTime == 0 ? this.parseInterval : now - this.lastParseTime
		if (elapsed >= this.parseInterval) {
			this.parsePending()
			return
		}
		if (this.parseTimer != 0) return
		this.parseTimer = setTimeout(() => {
			this.parseTimer = 0
			this.parsePending()
		}, this.parseInterval - elapsed)
	}

	private parsePending() {
		if (this.parsing || this.pendingText == null || this.userAbort) return
		// #ifndef APP
		if (!this.cmarkReady) {
			this.ensureCmarkReady()
			if (this.parseTimer == 0) {
				this.parseTimer = setTimeout(() => {
					this.parseTimer = 0
					this.parsePending()
				}, 50)
			}
			return
		}
		// #endif
		// #ifdef APP-HARMONY
		if (!this.cmarkReady) {
			this.ensureCmarkReady()
			if (this.parseTimer == 0) {
				this.parseTimer = setTimeout(() => {
					this.parseTimer = 0
					this.parsePending()
				}, 50)
			}
			return
		}
		// #endif
		if (this.parseTimer != 0) {
			clearTimeout(this.parseTimer)
			this.parseTimer = 0
		}
		const text = this.pendingText
		const isDone = this.pendingDone
		this.pendingText = null
		this.pendingDone = false
		this.parsing = true
		this.lastParseTime = Date.now()
		this.md2jsonTask(text, isDone, (list: MarkdownToken[], parseDone: boolean | null) => {
			this.parsing = false
			if (this.userAbort) {
				return
			}
			const callbackDone = parseDone ?? isDone
			this.updateCallBack(list, callbackDone)
			if (this.pendingText != null) {
				this.scheduleParse(this.pendingText, this.pendingDone || this.msgReceiveDone)
			} else if (this.segmentNeedContinue) {
				this.scheduleParse(this.latestMsgBody, isDone || this.msgReceiveDone)
			} else if (this.msgReceiveDone && !callbackDone) {
				this.scheduleParse(this.latestMsgBody, true)
			}
		})
	}

	private ensureCmarkReady() {
		if (this.cmarkReady || this.cmarkInitializing) return
		this.cmarkInitializing = true
		initCmark().then(() => {
			this.cmarkReady = true
			this.cmarkInitializing = false
			if (this.pendingText != null && this.parseTimer == 0 && !this.parsing && !this.userAbort) {
				this.parseTimer = setTimeout(() => {
					this.parseTimer = 0
					this.parsePending()
				}, 0)
			}
		}).catch((err) => {
			this.cmarkInitializing = false
			markdownErrorLog('[uni-ai-x][Markdown解析][' + this.traceId + '] uni-CMark初始化失败：' + JSON.stringify(err))
		})
	}

	private md2jsonTask(markdownText: string, isDone: boolean, md2JsonCallBack: Md2JsonCallBack) {
		const processedMarkdownText = this.prepareMarkdownText(markdownText)
		if (processedMarkdownText == null) {
			md2JsonCallBack(this.cloneTokenList(this.segmentTokenList), false)
			return
		}
		this.md2jsonSegmented(processedMarkdownText, isDone, md2JsonCallBack)
		return
	}

	private prepareMarkdownText(msgBody: string): string | null {
		if (msgBody.length < this.oldMsgBodyLength) {
			return null
		}
		this.myMarkdownText = this.myMarkdownText + msgBody.slice(this.oldMsgBodyLength)
		this.oldMsgBodyLength = msgBody.length
		let withFindMathText = this.myMarkdownText.slice(this.lastMathEndIndex)
		const codeTagIndex = withFindMathText.split('```').length - 1
		if (codeTagIndex % 2 != 0) {
			return this.myMarkdownText
		}
		const lastCodeTagIndex = withFindMathText.lastIndexOf('```') + 3
		withFindMathText = withFindMathText.slice(lastCodeTagIndex)
		const mathStartPattern = /\$\$|\$|\\\[|\\\(|\\begin\{[a-zA-Z*]+\}/
		const mathStartIndex = withFindMathText.search(mathStartPattern)
		if (mathStartIndex == -1) {
			return this.myMarkdownText
		}
		const startToken: string = withFindMathText.match(mathStartPattern)![0]!
		const endToken: string = mathMarkMap.get(startToken) ?? ''
		if (endToken.length == 0) throw new Error('mathMarkMap中没有找到对应的结尾')
		const endIndex = withFindMathText.slice(mathStartIndex + startToken.length).indexOf(endToken)
		if (endIndex == -1) {
			return null
		}
		const mathEndIndex = endIndex + mathStartIndex + startToken.length
		const mathText = withFindMathText.slice(startToken.length + mathStartIndex, mathEndIndex)
		const mathCodeText = '\n```math\n' + mathText + '\n```\n'
		this.myMarkdownText = this.myMarkdownText.slice(0, this.lastMathEndIndex + lastCodeTagIndex) +
			withFindMathText.slice(0, mathStartIndex) + mathCodeText +
			withFindMathText.slice(mathEndIndex + endToken.length)
		this.lastMathEndIndex += lastCodeTagIndex + mathStartIndex + mathCodeText.length - 1
		return this.myMarkdownText
	}

	private md2jsonSegmented(markdownText: string, isDone: boolean, md2JsonCallBack: Md2JsonCallBack) {
		const lines = markdownText.split('\n')
		if (this.segmentEndLineIndex > lines.length) {
			this.segmentEndLineIndex = lines.length
		}
		if (this.segmentEndLineIndex < this.segmentStartLineIndex + 1) {
			this.segmentEndLineIndex = this.segmentStartLineIndex + 1
		}
		const segmentText = lines.slice(this.segmentStartLineIndex, this.segmentEndLineIndex).join('\n')
		const isSegmentDone = isDone && this.segmentEndLineIndex >= lines.length
		this.parseWithUniCmark(segmentText, (parseMdRes: ParseMdRes) => {
			if (this.userAbort) return
			if (parseMdRes.errorMsg.length > 0) {
				markdownErrorLog('[uni-ai-x][Markdown解析] uni-CMark原生分段解析失败：' + parseMdRes.errorMsg)
				this.segmentNeedContinue = false
				md2JsonCallBack(this.segmentTokenList, isSegmentDone)
				return
			}
			this.handleSegmentResult(parseMdRes.data, segmentText, lines.length, isSegmentDone, md2JsonCallBack)
		})
	}

	/**
	 * 调用 uni-cmark 解析 Markdown。
	 * APP-ANDROID：通过原生子线程异步执行 md2json，释放主（UI）线程；
	 * 其他平台：直接同步调用后触发回调。
	 */
	private parseWithUniCmark(markdownText: string, callback: UniCmarkCallback) {
		// #ifdef APP-ANDROID
		asyncMd2json(markdownText, (result: ParseMdRes) => {
			callback(result)
		})
		return
		// #endif
		// #ifdef APP-IOS
		const jsonString = md2json(markdownText) as string
		const jsonArray = JSON.parseArray<MarkdownToken>(jsonString) as MarkdownToken[]
		callback({
			data: jsonArray,
			errorMsg: ''
		} as ParseMdRes)
		return
		// #endif
		// #ifdef APP-HARMONY
		callback(md2json(markdownText) as ParseMdRes)
		return
		// #endif
		// #ifndef APP
		callback(md2json(markdownText) as ParseMdRes)
		// #endif
	}

	private handleSegmentResult(newJsonList: MarkdownToken[], segmentText: string, lineCount: number, isSegmentDone: boolean, md2JsonCallBack: Md2JsonCallBack) {
		if (newJsonList.length == 0) {
			if (this.segmentEndLineIndex < lineCount) {
				this.segmentEndLineIndex++
				this.segmentNeedContinue = true
			} else {
				this.segmentNeedContinue = false
			}
			md2JsonCallBack(this.cloneTokenList(this.segmentTokenList), isSegmentDone)
			return
		}
		const tableHasBoundary = newJsonList[0].type == 'table' && this.hasLeadingTableBoundary(segmentText)
		const foundNextBlock = newJsonList.length > 1 && (tableHasBoundary || !(newJsonList[0].type == 'table' && newJsonList[1].isClose != 1))
		this.prepareSegmentTokenList(newJsonList, isSegmentDone, foundNextBlock)
		if (foundNextBlock) {
			this.segmentEndLineIndex--
			if (this.segmentEndLineIndex < this.segmentStartLineIndex + 1) {
				this.segmentEndLineIndex = this.segmentStartLineIndex + 1
			}
			this.segmentStartLineIndex = this.segmentEndLineIndex
			newJsonList[0].isClose = 1
		} else if (this.segmentEndLineIndex < lineCount) {
			this.segmentEndLineIndex++
		}
		if (this.segmentEndLineIndex > lineCount) {
			this.segmentEndLineIndex = lineCount
		}
		const beforeDone = this.createBeforeDone(newJsonList.length, () => {
			this.mergeSegmentTokenList(newJsonList)
			this.segmentNeedContinue = !isSegmentDone && this.segmentEndLineIndex < lineCount && !this.userAbort
			md2JsonCallBack(this.cloneTokenList(this.segmentTokenList), isSegmentDone)
		})
		for (let i = 0; i < newJsonList.length; i++) {
			this.enrichToken(newJsonList[i], (nextToken: MarkdownToken | null) => {
				if (nextToken != null) newJsonList[i] = nextToken
				beforeDone()
			})
		}
	}

	private prepareSegmentTokenList(tokenList: MarkdownToken[], isSegmentDone: boolean, foundNextBlock: boolean) {
		const closedCount = this.segmentTokenList.filter((item: MarkdownToken): boolean => item.isClose == 1).length
		for (let i = 0; i < tokenList.length; i++) {
			const item = tokenList[i]
			item.uniqueId = 'u' + (closedCount + i).toString()
			item.isClose = (isSegmentDone || i != tokenList.length - 1) ? 1 : 0
			if (item.type == 'table' && !isSegmentDone && !foundNextBlock) {
				item.isClose = 0
			}
		}
	}

	private hasLeadingTableBoundary(markdownText: string): boolean {
		const lines = markdownText.split('\n')
		let tableLineCount = 0
		for (let i = 0; i < lines.length; i++) {
			const line = lines[i].trim()
			const isTableLine = line.startsWith('|') && line.endsWith('|')
			if (isTableLine) {
				tableLineCount++
				continue
			}
			if (tableLineCount >= 2 && line.length == 0) return true
			if (tableLineCount >= 2 && !isTableLine) return true
			if (tableLineCount > 0 && !isTableLine) return false
		}
		return false
	}

	private mergeSegmentTokenList(newJsonList: MarkdownToken[]) {
		const lastUnCloseTokenIndex = this.segmentTokenList.findIndex((item: MarkdownToken): boolean => item.isClose == 0)
		if (lastUnCloseTokenIndex != -1) {
			this.segmentTokenList.splice(lastUnCloseTokenIndex, this.segmentTokenList.length - lastUnCloseTokenIndex, ...newJsonList)
		} else {
			this.segmentTokenList.push(...newJsonList)
		}
	}

	private cloneTokenList(tokenList: MarkdownToken[]): MarkdownToken[] {
		return JSON.parseArray<MarkdownToken>(JSON.stringify(tokenList)) as MarkdownToken[]
	}

	private enrichToken(item: MarkdownToken, callBack: (token: MarkdownToken | null) => void) {
		if (item.type == 'table') {
			setApproxTableContentWidth(item.tokens ?? [])
			callBack(null)
			return
		}
		if (item.type != 'code_block') {
			callBack(null)
			return
		}
		item.text = item.text ?? ''
		const lang = item.lang ?? 'text'
		if (item.isClose == 1 && lang == 'math') {
			this.parseMath(item, callBack)
			return
		}
		if (item.isClose == 1 && lang == 'mermaid') {
			this.parseMermaid(item, () => callBack(null))
			return
		}
		this.parseCodehighlight(item, () => callBack(null))
	}

	private codeLineCacheKey(language: string, lineText: string): string {
		return language + '\n' + lineText
	}

	private parseCodehighlight(codeToken: MarkdownToken, callBack: CallBack) {
		const language = codeToken.lang ?? 'text'
		const codeTextArr = codeToken.text?.split('\n') ?? []
		const codeTokens = [] as MarkdownToken[][]
		let lineIndex = 0
		const parseNext = () => {
			if (lineIndex >= codeTextArr.length) {
				codeToken.codeTokens = codeTokens
				callBack()
				return
			}
			const lineCodeText = codeTextArr[lineIndex]
			const cacheKey = this.codeLineCacheKey(language, lineCodeText)
			const cachedTokens = this.codeLineCacheMap.get(cacheKey)
			if (cachedTokens != null) {
				codeTokens.push(cachedTokens)
				lineIndex++
				parseNext()
				return
			}
			parseLineCode((parseCodeRes: ParseLineCodeRes) => {
				const lineTokens = parseCodeRes.error == null ? (parseCodeRes.tokens ?? [] as MarkdownToken[]) : [{ text: lineCodeText, className: '' }] as MarkdownToken[]
				this.codeLineCacheMap.set(cacheKey, lineTokens)
				codeTokens.push(lineTokens)
				lineIndex++
				parseNext()
			}, lineCodeText, language)
		}
		parseNext()
	}

	private parseMermaid(mermaidToken: MarkdownToken, callBack: CallBack) {
		//#ifdef MP-WEIXIN
		callBack()
		//#endif
		// #ifndef MP-WEIXIN
		proxyWeb.callMethod({
			action: 'renderMermaid',
			mermaidText: mermaidToken.text
		}, (param: UTSJSONObject) => {
			const imageDataURL: string = param['imageDataURL'] as string
			if (imageDataURL.length > 0) mermaidToken.href = imageDataURL
			callBack()
		})
		// #endif
	}

	private parseMath(mathToken: MarkdownToken, callBack: (token: MarkdownToken | null) => void) {
		// #ifdef MP-WEIXIN
		callBack(null)
		// #endif
		// #ifndef MP-WEIXIN
		mathToken.text = mathToken.text?.trim()
		proxyWeb.callMethod({
			action: 'katexRender',
			pureMathText: mathToken.text!
		}, (param: UTSJSONObject) => {
			const latexEl: MarkdownToken = {
				type: 'math',
				text: mathToken.text!,
				html: param['resultHtml'] as string | null,
				href: param['imageDataURL'] as string | null,
				width: param['width'] as number | null,
				height: param['height'] as number | null,
				isClose: 1,
				uniqueId: mathToken.uniqueId!
			}
			callBack(latexEl)
		})
		// #endif
	}

	private createBeforeDone(totalCount: number, callBack: CallBack) {
		if (totalCount <= 0) {
			callBack()
			return () => {}
		}
		let parseCount = 0
		return () => {
			parseCount++
			if (parseCount == totalCount) callBack()
		}
	}

	/** 释放资源。在不再使用此实例时调用。 */
	dispose() {
		this.userAbort = true
	}
}
