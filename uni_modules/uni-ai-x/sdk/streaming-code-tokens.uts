import type { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'

export function streamingCodeTokens(codeText: string, tokens: MarkdownToken[][]): MarkdownToken[][] {
	if (tokens.length == 0) return [] as MarkdownToken[][]
	const source = codeText.replace(/\r\n/g, '\n')
	const highlightedText = tokens.map((line: MarkdownToken[]) => {
		return line.map((token: MarkdownToken) => token.text ?? '').join('')
	}).join('\n').replace(/\r\n/g, '\n')
	if (source == highlightedText) return tokens
	if (highlightedText.length == 0 || !source.startsWith(highlightedText)) {
		return [] as MarkdownToken[][]
	}
	// Keep cached colors while the appended suffix waits for asynchronous highlighting.
	const result = tokens.slice()
	const lastLine = result[result.length - 1].slice()
	const suffixLines = source.slice(highlightedText.length).split('\n')
	if (suffixLines[0].length > 0) lastLine.push({ text: suffixLines[0] } as MarkdownToken)
	result[result.length - 1] = lastLine
	for (let index = 1; index < suffixLines.length; index++) {
		result.push([{ text: suffixLines[index] } as MarkdownToken] as MarkdownToken[])
	}
	return result
}
