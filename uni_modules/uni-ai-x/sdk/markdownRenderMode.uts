export type MarkdownRenderMode = 'legacy' | 'simple' | 'compare'

export type MarkdownRenderModeState = {
	mode: MarkdownRenderMode
	parseInterval: number
	heavyRenderOnStreaming: boolean
}

const markdownRenderMode = reactive({
	mode: 'legacy',
	parseInterval: 120,
	heavyRenderOnStreaming: false
} as MarkdownRenderModeState)

export default markdownRenderMode
