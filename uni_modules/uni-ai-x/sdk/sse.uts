import { Chunk } from '@/uni_modules/uni-ai-x/types.uts'
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'

type SseDataCallback = (chunkObj : Chunk) => void
type SseErrorCallback = (err : UTSJSONObject) => void
type SseDoneCallback = () => void

function utf8SequenceLength(byte : number) : number {
	if (byte <= 0x7f) return 1
	if (byte >= 0xc2 && byte <= 0xdf) return 2
	if (byte >= 0xe0 && byte <= 0xef) return 3
	if (byte >= 0xf0 && byte <= 0xf4) return 4
	return 1
}

function completeUtf8PrefixLength(bytes : Uint8Array) : number {
	if (bytes.length == 0) return 0

	let leadIndex = bytes.length - 1
	while (leadIndex >= 0) {
		const byte = bytes[leadIndex]
		if (byte < 0x80 || byte > 0xbf) break
		leadIndex--
	}
	if (leadIndex < 0) return bytes.length as number

	const expectedLength = utf8SequenceLength(bytes[leadIndex])
	const availableLength = bytes.length - leadIndex
	return expectedLength > availableLength ? leadIndex as number : bytes.length as number
}

/**
 * 主线程流式响应解析器。网络分包可能落在 UTF-8 码点或 SSE 行/事件边界中间，
 * 因此需要缓存未完成的字节与文本，避免事件（尤其是结尾的 [DONE]）被丢弃。
 */
export class SseStreamParser {
	private decoder : TextDecoder = new TextDecoder()
	private pendingBytes : Uint8Array = new Uint8Array(0)
	private textBuffer : string = ''
	private dataLines : string[] = []
	private closed : boolean = false
	private dataCallback : SseDataCallback
	private errorCallback : SseErrorCallback
	private doneCallback : SseDoneCallback
	private receivedByteCount : number = 0

	constructor(dataCallback : SseDataCallback, errorCallback : SseErrorCallback, doneCallback : SseDoneCallback) {
		this.dataCallback = dataCallback
		this.errorCallback = errorCallback
		this.doneCallback = doneCallback
	}

	push(chunkData : ArrayBuffer) : void {
		if (this.closed) return
		utils.runOnDispatcher("io", () => {
			if (this.closed) return
			try {
				this.appendBytes(chunkData)
			} catch (error) {
				console.error('[uni-ai-x] SseStreamParser.push error', error)
			}
		})
	}

	/** 兜底入口：当平台未触发分片回调、结束时才拿到完整 SSE 文本时直接解析。 */
	pushText(text : string) : void {
		if (this.closed || text.length == 0) return
		utils.runOnDispatcher("io", () => {
			if (this.closed) return
			try {
				this.receivedByteCount += text.length
				this.textBuffer += text
				this.drainLines(false)
			} catch (error) {
				console.error('[uni-ai-x] SseStreamParser.pushText error', error)
			}
		})
	}

	receivedBytes() : number {
		return this.receivedByteCount
	}

	finish() : void {
		if (this.closed) return
		utils.runOnDispatcher("io", () => {
			if (this.closed) return
			try {
				if (this.pendingBytes.length > 0) {
					this.textBuffer += this.decoder.decode(this.pendingBytes)
					this.pendingBytes = new Uint8Array(0)
				}
				this.drainLines(true)
				if (this.textBuffer.length > 0) {
					this.processLine(this.textBuffer)
					this.textBuffer = ''
				}
				this.dispatchEvent()
			} catch (error) {
				console.error('[uni-ai-x] SseStreamParser.finish error', error)
			}
			this.closed = true
		})
	}

	private appendBytes(chunkData : ArrayBuffer) : void {
		const incoming = new Uint8Array(chunkData)
		const combined = new Uint8Array(this.pendingBytes.length + incoming.length)
		for (let index = 0; index < this.pendingBytes.length; index++) {
			combined[index] = this.pendingBytes[index]
		}
		for (let index = 0; index < incoming.length; index++) {
			combined[(this.pendingBytes.length as number) + index] = incoming[index]
		}

		const completeLength = completeUtf8PrefixLength(combined)
		if (completeLength > 0) {
			this.textBuffer += this.decoder.decode(combined.slice(0, completeLength))
		}
		this.pendingBytes = combined.slice(completeLength)
		this.receivedByteCount += completeLength
		this.drainLines(false)
	}

	private drainLines(flushTrailingCarriageReturn : boolean) : void {
		while (!this.closed) {
			const lfIndex = this.textBuffer.indexOf('\n')
			const crIndex = this.textBuffer.indexOf('\r')
			if (lfIndex < 0 && crIndex < 0) return

			let separatorIndex = lfIndex
			if (separatorIndex < 0 || (crIndex >= 0 && crIndex < separatorIndex)) {
				separatorIndex = crIndex
			}
			const separator = this.textBuffer.charAt(separatorIndex)
			if (separator == '\r' && separatorIndex == this.textBuffer.length - 1 && !flushTrailingCarriageReturn) {
				return
			}

			let separatorLength = 1
			if (separator == '\r' && this.textBuffer.charAt(separatorIndex + 1) == '\n') {
				separatorLength = 2
			}
			const line = this.textBuffer.substring(0, separatorIndex)
			this.textBuffer = this.textBuffer.slice(separatorIndex + separatorLength)
			this.processLine(line)
		}
	}

	private processLine(line : string) : void {
		if (line.length == 0) {
			this.dispatchEvent()
			return
		}
		if (line.startsWith(':')) return

		const colonIndex = line.indexOf(':')
		const field = colonIndex < 0 ? line : line.substring(0, colonIndex)
		let value = colonIndex < 0 ? '' : line.substring(colonIndex + 1)
		if (value.startsWith(' ')) value = value.substring(1)

		if (field == 'data') {
			this.dataLines.push(value)
			return
		}
		if (field == '{"error"') {
			this.handleRawError(value)
		}
	}

	private handleRawError(value : string) : void {
		let info : UTSJSONObject = {}
		try {
			info = JSON.parse<UTSJSONObject>('{"error":' + value.trimStart()) as UTSJSONObject
		} catch (e) {
			console.error('JSON.parse error', e, 'value:', value)
		}
		const error = info.getJSON('error')
		if (error != null) this.errorCallback(error)
		this.dispatchDone()
	}

	private dispatchEvent() : void {
		if (this.closed || this.dataLines.length == 0) return
		const rawData = this.dataLines.join('\n')
		this.dataLines = []
		if (rawData == '[DONE]') {
			this.dispatchDone()
			return
		}
		let chunk : Chunk | null = null
		try {
			chunk = JSON.parse<Chunk>(rawData.trimStart()) as Chunk
		} catch (e) {
			console.error('JSON.parse error', e, 'value:', rawData)
		}
		this.dataCallback(chunk ?? {} as Chunk)
	}

	private dispatchDone() : void {
		if (this.closed) return
		this.closed = true
		this.doneCallback()
	}
}
