import { reactive, watch, nextTick } from 'vue';
import { defaultLLM, currentUser } from '../config';
import { Llm,ChatItem,Chat, MsgItem, RequestAiCoMessage, Userinfo, BaseMsgItem, Setting, ImgItem } from '@/uni_modules/uni-ai-x/types.uts';
export { MsgItem, ChatItem, BaseMsgItem, Userinfo }
import RequestAiRunner, { RequestAiRunnerCallbacks } from '@/uni_modules/uni-ai-x/sdk/requestAiRunner.uts';
import { AiRequestRunnerHandle, getAiRequestRunnerFactory } from '@/uni_modules/uni-ai-x/sdk/chat-extension.uts';
import { StorageManager, AiChat, ChatMessageBatch } from './storage-manager.uts'
import { buildAiMessages } from '@/uni_modules/uni-ai-x/sdk/message-builder.uts'
export { registerCustomProvider, isCustomProvider, providerSupportsTitleUpdate } from '@/uni_modules/uni-ai-x/sdk/provider-registry.uts'
let requestAiRunner: AiRequestRunnerHandle | null = null
type BeforeRequestAiFn = () => void
type StressCopyProgress = (completed: number) => void
class UniAi {
	// 存储管理器
	private storageManager: StorageManager = new StorageManager()
	private stressDataSequence: number = 0
	private loadedChatIds: string[] = [] as string[]
	imgList: ImgItem[] = reactive<ImgItem[]>([]);
	// 当前用户
	currentUser: Userinfo = currentUser
	setting: Setting = reactive<Setting>({
		// UI 主题
		theme: 'light',
		// 语言
		language: 'zh-CN',
		// 大模型
		llm: {
			// 当前提供商
			provider: defaultLLM.provider,
			// 当前模型
			model: defaultLLM.model,
			// 是否开启联网搜索
			webSearch: false
		}
	})
	// 大模型
	get llm(): Llm {
		return this.setting.llm
	}
	set llm(value: Llm) {
		this.setting.llm = value
	}

	chat: Chat = reactive<Chat>({
		datas: reactive<ChatItem[]>([]) as ChatItem[],
		activeId: ''
	})
	/*
	chat太大，分为3个部分，方便与 storage 完美映射，实现数据同步
	1. uni-ai-chat 会话列表
	2. uni-ai-chat-msg-ids 会话对应的消息 id 列表，key 为：uni-ai-chat-msg-ids_chatId_${chatId}
	3. uni-ai-chat-msg-list 消息列表，key 为：消息 id，value 为：消息内容，key 为：uni-ai-chat-msg-list_msgId_${msgId}
	 */
	
	// 当前对话
	get currentChat(): ChatItem | null {
		return this.chat.datas.find((item) => item.id == this.chat.activeId) as ChatItem | null
	}
	
	getLocalMsgId(): string {
		// 生成一个 local_ 开头的随机字符串
		return (this.currentUser._id ?? 'tmp') + "_" + (Date.now()).toString(16) + "_" + Math.floor(Math.random() * 10000).toString(16)
	}

	private getStressDataId(prefix: string): string {
		this.stressDataSequence += 1
		return prefix + '_' + Date.now().toString(36) + '_' + this.stressDataSequence.toString(36)
	}

	private cloneMessagesForStress(sourceMessages: MsgItem[], chatId: string, prefix: string): MsgItem[] {
		const idMap = {} as UTSJSONObject
		const clonedMessages = [] as MsgItem[]
		const createTime = Date.now()
		for (let index = 0; index < sourceMessages.length; index++) {
			const source = sourceMessages[index]
			// 消息 ID 同时是 Storage key；副本可被重新回答/删除，不能与源会话共享。
			const messageId = this.getStressDataId(prefix + '_msg')
			idMap[source._id] = messageId
			const cloned = { ...source } as MsgItem
			cloned._id = messageId
			cloned.chat_id = chatId
			cloned.create_time = createTime + index
			cloned.rendered = true
			clonedMessages.push(cloned)
		}
		for (let index = 0; index < clonedMessages.length; index++) {
			const sourceAboutId = sourceMessages[index].about_msg_id ?? ''
			if (sourceAboutId.length == 0) continue
			const mappedAboutId = idMap[sourceAboutId] as string | null
			if (mappedAboutId != null) clonedMessages[index].about_msg_id = mappedAboutId
		}
		return clonedMessages
	}

	expandCurrentChatForStress(targetRounds: number): string {
		const chat = this.currentChat
		if (chat == null) return '当前没有可复制的会话'
		if (chat.state == 'processing') return '请等待当前流式输出完成'
		if (chat.msgList.length != 2) return '当前会话必须只包含一轮消息'
		if (targetRounds <= 1) return '目标轮数必须大于 1'

		const sourceMessages = chat.msgList.slice(0)
		const appendedMessages = [] as MsgItem[]
		for (let round = 1; round < targetRounds; round++) {
			const cloned = this.cloneMessagesForStress(sourceMessages, chat.id, 'stress_round_' + round.toString())
			for (let index = 0; index < cloned.length; index++) appendedMessages.push(cloned[index])
		}
		if (!this.storageManager.appendChatMessages(chat.id, appendedMessages)) return '写入 Storage 失败'
		chat.msgList.push(...appendedMessages)
		chat.update_time = Date.now()
		this.saveChatList2Storage()
		return ''
	}

	copyLastMessageForStress(count: number): string {
		const chat = this.currentChat
		const message = this.lastAiMsg
		if (chat == null || message == null) return '当前没有可复制的消息'
		if (chat.state == 'processing') return '请等待当前流式输出完成'
		if (count <= 0) return '复制数量必须大于 0'
		const copiedMessages = [] as MsgItem[]
		for (let index = 0; index < count; index++) {
			const copied = this.cloneMessagesForStress([message] as MsgItem[], chat.id, 'stress_message_' + index.toString())
			copiedMessages.push(copied[0])
		}
		if (!this.storageManager.appendChatMessages(chat.id, copiedMessages)) return '写入 Storage 失败'
		chat.msgList.push(...copiedMessages)
		chat.update_time = Date.now()
		this.saveChatList2Storage()
		return ''
	}

	async createCurrentChatStressCopies(runId: string, targetCount: number, onProgress?: StressCopyProgress): Promise<string> {
		const sourceChat = this.currentChat
		if (sourceChat == null) return '当前没有可复制的会话'
		if (sourceChat.state == 'processing') return '请等待当前流式输出完成'
		if (sourceChat.msgList.length == 0) return '当前会话没有消息'
		if (targetCount <= 0) return '复制数量必须大于 0'

		const sourceMessages = sourceChat.msgList.slice(0)
		const sourceTitle = sourceChat.title
		const baseUpdateTime = Date.now()
		// 以消息数限制批次规模；长会话不会一次排队过多 native Storage 请求。
		const maxMessagesPerBatch = 100
		const batchSize = Math.max(1, Math.min(25, Math.floor(maxMessagesPerBatch / sourceMessages.length)))
		const allCopiedChats = [] as ChatItem[]
		let completed = 0
		while (completed < targetCount) {
			const batchEnd = Math.min(completed + batchSize, targetCount)
			const copiedChats = [] as ChatItem[]
			const messageBatches = [] as ChatMessageBatch[]
			for (let copyIndex = completed; copyIndex < batchEnd; copyIndex++) {
				// 会话 ID 是消息索引和 activeId 的隔离边界，必须为每个副本重新生成。
				const chatId = this.getStressDataId('stress_' + runId + '_chat')
				const copiedMessages = this.cloneMessagesForStress(sourceMessages, chatId, 'stress_' + runId + '_' + copyIndex.toString())
				copiedChats.push({
					id: chatId,
					title: '[压测 ' + (copyIndex + 1).toString() + '] ' + sourceTitle,
					state: 'none',
					inputContent: '',
					// 副本已写入 Storage，保持空列表，选中时再按需加载消息。
					msgList: reactive<MsgItem[]>([]),
					update_time: baseUpdateTime + copyIndex
				} as ChatItem)
				messageBatches.push({ chatId: chatId, messages: copiedMessages })
			}
			if (!await this.storageManager.saveChatMessagesBatchAsync(messageBatches)) {
				// 让已完成的批次仍然可见，避免 Storage 中出现无法访问的副本元数据。
				allCopiedChats.reverse()
				if (allCopiedChats.length > 0) this.chat.datas.unshift(...allCopiedChats)
				return '写入 Storage 失败'
			}
			allCopiedChats.push(...copiedChats)
			completed = batchEnd
			if (onProgress != null) onProgress(completed)
		}

		// 只触发一次响应式列表更新；逆序插入可保持压测副本的显示顺序。
		allCopiedChats.reverse()
		this.chat.datas.unshift(...allCopiedChats)
		return ''
	}
	
	addChat(checkEmpty: boolean = true) {
		// 检查是否已经存在空会话，如果存在则直接选中，否则创建新会话
		const lastItem = this.chat.datas.length == 0 ? null : this.chat.datas[0] as ChatItem | null;
		let activeId = lastItem?.id ?? ''
		if (!checkEmpty || lastItem?.msgList.length != 0) {
			const newChat: ChatItem = {
				id: this.getLocalMsgId(),
				title: "新对话",
				state: 'none',
				update_time: Date.now(),
				msgList: reactive<MsgItem[]>([]),
				inputContent: ''
			};
			this.chat.datas.unshift(newChat);
			this.loadedChatIds.push(newChat.id)
			activeId = newChat.id
			this.saveChatList2Storage()
		}
		// 选中新创建的会话
		nextTick(() => {
			this.chat.activeId = activeId
		})
	}
	
	deleteChat(chatId: string): void {
		// 如果只有一个，删之前需要先创建一个并设置为选中，否则会照成无选中会话导致崩溃
		if (uniAi.chat.datas.length == 1) {
			uniAi.addChat(false)
			this.chat.activeId = uniAi.chat.datas[0].id
		} else if (uniAi.chat.activeId == chatId) {
			// 如果删除的是当前激活的对话，则激活其他对话
			const otherChat = uniAi.chat.datas.find((item) => item.id != chatId)!
			uniAi.chat.activeId = otherChat.id
		}
			nextTick(() => {
			const index = uniAi.chat.datas.findIndex((item) => item.id == chatId)
			uniAi.chat.datas.splice(index, 1)
			const loadedIndex = this.loadedChatIds.indexOf(chatId)
			if (loadedIndex >= 0) this.loadedChatIds.splice(loadedIndex, 1)
			this.storageManager.deleteChat(chatId)
		})
	}

	selectChat(chatId: string) {
		this.loadChatMessages(chatId)
		this.chat.activeId = chatId
	}

	private loadChatMessages(chatId: string) {
		if (this.loadedChatIds.indexOf(chatId) >= 0) return
		const chat = this.chat.datas.find((item) => item.id == chatId)
		if (chat == null) return
		const messages = this.storageManager.getChatMessages(chatId)
		chat.msgList.push(...messages)
		this.loadedChatIds.push(chatId)
	}
		
	get lastAiMsg(): MsgItem | null {
		// 获取Ai的最后一条消息(因为 msg 是倒叙的，所以取第一条)
		if (this.currentChat != null) {
			const length = this.currentChat!.msgList.length
			return length > 0 ? this.currentChat!.msgList[length - 1] : null;
		} else {
			return null;
		}
	}
	
	constructor() {
		this.loadDataFromNewStorage()
		this.loadSetting()
		this.watchSetting()
	}
	private loadSetting() {
		uni.getStorage({
			key: 'uni-ai-setting',
			success: (res) => {
				if (res.data != null) {
					const setting = JSON.parse<Setting>(JSON.stringify(res.data)) as Setting
					this.setting.theme = setting.theme
					this.setting.language = setting.language
					this.setting.llm = setting.llm
				}
			},
			fail: (err) => {
				// console.error('uni-ai-setting 获取失败', err)
			}
		})
	}
	private watchSetting() {
		watch((): Setting => this.setting, () => {
			this.saveSetting()
		}, { deep: true, immediate: true })
	}
	private saveSetting() {
		uni.setStorage({
			key: 'uni-ai-setting',
			data: this.setting,
			fail: (err) => {
				console.error('uni-ai-setting 存储失败', err)
			}
		})
	}
	/**
	 * 收到 msg 被更新的通知后，自动保存消息（防抖）
	 */
	sM2STimer: number = 0
	updateMsg2Storage(msg: MsgItem) {
		if (this.sM2STimer != 0) {
			clearTimeout(this.sM2STimer)
			this.sM2STimer = 0
		}
		this.sM2STimer = setTimeout(() => {
			this.storageManager.updateMessage(msg)
		}, 1000)
	}
	saveChatList2Storage() {
		const chatList: ChatItem[] = this.chat.datas
		if (chatList.length > 0) {
			const aiChats: AiChat[] = chatList.map((chat: ChatItem) => {
				const aiChat: AiChat = {
					id: chat.id,
					title: chat.title,
					update_time: chat.update_time
				}
				return aiChat
			})
			this.storageManager.saveChatList(aiChats)
		}
	}
	// 更新会话标题 和 会话更新时间 时，自动保存会话列表到 storage
	updateChatUpdateTime(chatId: string) {
		const chat = this.chat.datas.find(chat => chat.id == chatId)
		if (chat != null) {
			chat.update_time = Date.now()
		} else {
			throw new Error('updateChatUpdateTime 对话不存在' + chatId)
		}
		this.saveChatList2Storage()
	}
	updateChatTitle(chatId: string, title: string) {
		const chat = this.chat.datas.find(chat => chat.id == chatId)
		if (chat != null) {
			chat.title = title
		} else {
			console.error('updateChatTitle 对话不存在', chatId)
			throw new Error('updateChatTitle 对话不存在')
		}
		this.saveChatList2Storage()
	}
	
	/**
	 * 从新的存储结构中加载数据
	 */
	private loadDataFromNewStorage(): void {
		try {
			// 获取会话列表
			const aiChats = this.storageManager.getChatList()
			
			if (aiChats.length == 0) {
				// 如果没有会话，创建一个新会话
				this.addChat()
				return
			}
			
			// 启动只加载会话元数据；消息在选中会话时再读取。
			for (let i = 0; i < aiChats.length; i++) {
				const aiChat = aiChats[i]
				const chatItem: ChatItem = {
					id: aiChat.id,
					title: aiChat.title,
					state: 'none',
					update_time: aiChat.update_time,
					msgList: reactive<MsgItem[]>([]),
					inputContent: ''
				}
				
				this.chat.datas.push(chatItem)
			}
			
			// 默认选中第一个会话
			if (this.chat.datas.length > 0) {
				this.chat.activeId = this.chat.datas[0].id
				this.loadChatMessages(this.chat.activeId)
			}
			
		} catch (error) {
			console.error('从新存储结构加载数据失败:', error)
			// 如果失败，创建一个新会话
			this.addChat()
		}
	}
	
	addMsg(msg: BaseMsgItem): MsgItem {
		// 添加一条消息
		const msgList = this.currentChat!.msgList
		const newMsg: MsgItem = {
			...msg,
			chat_id: this.currentChat!.id,
			_id: this.getLocalMsgId(),
			create_time: Date.now(),
			state: 0,
				markdownHtml: '',
			rendered: false
		} as MsgItem
		msgList.push(newMsg)
		this.storageManager.addMessage(newMsg)
		if (msg.from_uid != 'uni-ai') {
			// 把用户提的问题 内容的前 20 个字符作为标题，去掉换行符
			const title = msg.body.substring(0, 20).replace(/\n/g, '')
			this.currentChat!.title = title
		}
		// 更新会话的更新时间
		this.updateChatUpdateTime(this.currentChat!.id)
		// 返回响应式的 msg
		return msgList[msgList.length - 1]
	}
	
	deleteMsg(msgId: string) {
		// 查出消息索引
		const msgList = this.currentChat!.msgList
		const index = msgList.findIndex((item) => item._id == msgId)
		if (index != -1) {
			msgList.splice(index, 1)
		} else {
			console.error('需要删除的消息未找到', msgId, this.currentChat!.msgList)
			throw new Error('需要删除的消息未找到')
		}
	}
	
	abortRequest() {
		requestAiRunner?.abortRequest()
	}
	
	async sendMsg(inputContent: string = ''): Promise<void> {
		// 发送消息
		if (inputContent == '') {
			inputContent = this.currentChat!.inputContent
		}
		// 去除前后空格
		inputContent = inputContent.trim()
		if (inputContent.length == 0) {
			throw new Error('发给 AI 的消息不能为空');
		}
		// 生成用户提问的消息
		let baseUserMsg: BaseMsgItem = {
			body: inputContent,
			from_uid: this.currentUser._id ?? 'tmp_user_'
		}
		// 如果有图片
		if (this.imgList.length > 0) {
			baseUserMsg.img_url_list = this.imgList.map((item:ImgItem):string => item.path)
			this.imgList.length = 0
		}
		const userMsg: MsgItem = this.addMsg(baseUserMsg)

		// 生成一条空的 ai 回复的内容
		let baseAiMsgItem: BaseMsgItem = {
			body: '', // 初始是空的，后面慢慢追加
			from_uid: "uni-ai",
			about_msg_id: userMsg._id
		}
		const aiMsgItem: MsgItem = this.addMsg(baseAiMsgItem)
		return this.answerQuestion(aiMsgItem)
	}
	resetMsg(msg: MsgItem) {
		msg.body = ''
		msg.rendered = false
		msg.error_msg = null
		msg.thinkContent = null
		msg.markdownHtml = ''
		this.updateMsg2Storage(msg)
	}
	
	// 回答问题
	answerQuestion(aiMsgItem: MsgItem) {
		requestAiRunner?.abortRequest()
		this.updateChatUpdateTime(this.currentChat!.id)
		this.currentChat!.state = 'processing';	
		const messages = this.getMsgToAi(this.currentChat!)
		const runnerCallbacks: RequestAiRunnerCallbacks = {
			onMarkdownHtml: (html: string) => {
				if (this.currentChat!.state == 'stop') return
				aiMsgItem.markdownHtml = html
				this.updateMsg2Storage(aiMsgItem)
			},
			onThinkContent: (thinkContent: string) => {
				aiMsgItem.thinkContent = thinkContent
				this.updateMsg2Storage(aiMsgItem)
			},
			onMsgBody: (msgBody: string) => {
				aiMsgItem.body = msgBody
				this.updateMsg2Storage(aiMsgItem)
			},
			onState: (state: string) => {
				this.currentChat!.state = state
				if (state == 'stop') {
					aiMsgItem.rendered = true
				}
				this.updateMsg2Storage(aiMsgItem)
			},
			onErrorMsg: (errorMsg: string) => {
				aiMsgItem.error_msg = errorMsg
				this.updateMsg2Storage(aiMsgItem)
			},
			onRendered: (rendered: boolean) => {
				aiMsgItem.rendered = rendered
				this.updateMsg2Storage(aiMsgItem)
			},
			onChatTitle: (title: string) => {
				this.updateChatTitle(aiMsgItem.chat_id, title)
			}
		}
		const runnerFactory = getAiRequestRunnerFactory()
		if (runnerFactory != null) {
			requestAiRunner = runnerFactory!(runnerCallbacks)
			return
		}
		const remoteRunner = new RequestAiRunner(runnerCallbacks)
		requestAiRunner = remoteRunner
		remoteRunner.start({
			messages,
			llm: this.llm as Llm,
			chat_id: this.currentChat!.id
		})
	}
	
	// 拿到消息列表，用于发给 AI 
	getMsgToAi(chatItem: ChatItem): RequestAiCoMessage[] {
		return buildAiMessages(chatItem)
	}
	
	// 监听请求 AI 前的回调
	beforeRequestAiFns: BeforeRequestAiFn[] = []
	onBeforeRequestAi(fn: BeforeRequestAiFn) {
		this.beforeRequestAiFns.push(fn)
	}
	offBeforeRequestAi(fn: BeforeRequestAiFn) {
		const index = this.beforeRequestAiFns.indexOf(fn)
		if (index != -1) this.beforeRequestAiFns.splice(index, 1)
	}
	emitBeforeRequestAi() {
		this.beforeRequestAiFns.forEach((fn) => {
			fn()
		})
	}
}

const uniAi = new UniAi()
export { uniAi }
export default uniAi

// 抛出主题
export const uiTheme = computed<string>(() => uniAi.setting.theme)

// #ifdef WEB
// 方便在控制台观察
window.uniAi = uniAi
// #endif
