import RequestAiRunner, { RequestAiRunnerCallbacks } from '@/uni_modules/uni-ai-x/sdk/requestAiRunner.uts';
import { AiRequestRunnerHandle, getAiRequestRunnerFactory } from '@/uni_modules/uni-ai-x/sdk/chat-extension.uts';
import { StorageManager, AiChat, ChatMessageBatch } from './storage-manager.uts'
import { buildAiMessages } from '@/uni_modules/uni-ai-x/sdk/message-builder.uts'
// #ifdef APP-HARMONY || APP-ANDROID
import type { AiWorkerOp } from '@/uni_modules/uni-ai-worker-runtime/utssdk/interface.uts'
import {
	libmarkStreamApply,
	libmarkStreamMarkComplete,
	libmarkStreamReset,
	libmarkStreamRelease
} from '@/uni_modules/uni-ai-x/sdk/libmark-stream-store.uts'
// #endif
export { registerCustomProvider, isCustomProvider, providerSupportsTitleUpdate } from '@/uni_modules/uni-ai-x/sdk/provider-registry.uts'
let requestAiRunner: AiRequestRunnerHandle | null = null
// 消息持久化节流间隔（毫秒）：流式期间按固定节奏落盘，避免杀进程丢失最新内容
const MSG_SAVE_THROTTLE_INTERVAL = 2000
type BeforeRequestAiFn = () => void
type OpenSettingFn = () => void
type StressCopyProgress = (completed: number) => void

export const uiTheme = ref<string>('light')
export const messageToolBarVisible = ref<boolean>(true)
let themeInitialized = false

function updateUiTheme(theme: string) {
	uiTheme.value = theme == 'dark' ? 'dark' : 'light'
}

function updateUiThemeFromAppTheme(appTheme: string) {
	if (appTheme == 'auto') {
		refreshUiTheme()
		return
	}
	updateUiTheme(appTheme)
}

function refreshUiTheme() {
	uni.getSystemInfo({
		success: (res: GetSystemInfoResult) => {
			// #ifdef APP
			updateUiTheme(res.appTheme == 'auto' ? res.osTheme! : res.appTheme!)
			// #endif
			// #ifdef WEB || MP
			updateUiTheme(res.hostTheme!)
			// #endif
		}
	})
}

function initUiTheme() {
	if (themeInitialized) return
	themeInitialized = true
	refreshUiTheme()
	// #ifdef APP
	uni.onAppThemeChange((res: AppThemeChangeResult) => {
		updateUiThemeFromAppTheme(res.appTheme)
	})
	// #endif
	// #ifdef WEB || MP
	uni.onHostThemeChange((res: OnHostThemeChangeCallbackResult) => {
		updateUiTheme(res.hostTheme)
	})
	// #endif
}

function applyAppTheme(theme: Theme) {
	// #ifdef APP
	uni.setAppTheme({
		theme,
		success: () => {
			if (theme == 'auto') {
				refreshUiTheme()
			} else {
				updateUiTheme(theme)
			}
		},
		fail: (err: IAppThemeFail) => {
			console.error('设置应用主题失败', err.errMsg)
		}
	})
	// #endif
}

export function getLlmDisplayName(llm: Llm): string {
	const providerConfig = llmModelMap.get(llm.provider)
	if (providerConfig == null) return llm.model
	const matched = providerConfig.models.find(m => m.modelId == llm.model)
	return matched?.name ?? llm.model
}

class UniAi {
	// 存储管理器
	private storageManager: StorageManager = new StorageManager()
	private answerGeneration: number = 0
	private stressDataSequence: number = 0
	private stressMessageRunSequence: number = 0
	private loadedChatIds: string[] = [] as string[]
	imgList: ImgItem[] = reactive<ImgItem[]>([]);
	// 正在编辑的用户消息：发送时将替换该消息及其之后的全部消息
	editingState: EditState = reactive<EditState>({
		msgId: '',
		imgList: [] as string[]
	})
	get editingMsgId(): string {
		return this.editingState.msgId
	}
	// 当前用户
	currentUser: Userinfo = currentUser
	setting: Setting = reactive<Setting>({
		// UI 主题
		theme: 'auto',
		// 语言
		language: 'zh-CN',
		// 大模型
		llm: {
			// 当前提供商
			provider: defaultLLM.provider,
			// 当前模型
			model: defaultLLM.model,
			// 是否开启联网搜索
			webSearch: false,
			// 是否开启深度思考（仅对支持思考的模型生效）
			thinking: true
		}
	})
	// 大模型
	get llm(): Llm {
		return this.setting.llm
	}
	set llm(value: Llm) {
		this.setting.llm = value
	}
	// 设置被系统调整（如旧模型不可用）时的用户通知，等待 UI 就绪后展示
	private settingNotices: string[] = []
	private pushSettingNotice(message: string) {
		this.settingNotices.push(message)
	}
	consumeSettingNotices(): string[] {
		const notices = this.settingNotices.slice(0)
		this.settingNotices.length = 0
		return notices
	}

	chat: Chat = reactive<Chat>({
		datas: reactive<ChatItem[]>([]) as ChatItem[],
		activeId: ''
	})
	/*
	chat太大，分为3个部分，方便与 storage 完美映射，实现数据同步
	1. uni-ai-chat 会话列表
	2. uni-ai-chat-msg-ids 会话对应的消息 id 列表，key 为：uni-ai-chat-msg-ids_chatId_${chatId}
	3. uni-ai-chat-msg-list 消息列表，key 为：消息 id，value 为：消息内容，key 为：uni-ai-chat-msg-list_msgId_${msgId}
	 */
	
	// 当前对话
	get currentChat(): ChatItem | null {
		return this.chat.datas.find((item) => item.id == this.chat.activeId) as ChatItem | null
	}
	
	getLocalMsgId(): string {
		// 生成一个 local_ 开头的随机字符串
		return (this.currentUser._id ?? 'tmp') + "_" + (Date.now()).toString(16) + "_" + Math.floor(Math.random() * 10000).toString(16)
	}

	private getStressDataId(prefix: string): string {
		this.stressDataSequence += 1
		return prefix + '_' + Date.now().toString(36) + '_' + this.stressDataSequence.toString(36)
	}

	// Deterministic varied HTML keeps stress runs reproducible while exercising rich-text blocks.
	private buildStressSvg(index: number, run: number): string {
		const entropy = run * 100 + index
		const colors = ['#2979FF', '#34A853', '#EA4335', '#F9AB00', '#7B61FF', '#00ACC1']
		let svg = '<svg xmlns="http://www.w3.org/2000/svg" width="300" height="120" viewBox="0 0 300 120">'
		svg += '<rect x="0" y="0" width="300" height="120" fill="#EAF2FF"/>'
		for (let shape = 0; shape < 2 + entropy % 4; shape++) {
			svg += '<circle cx="' + (35 + shape * 48).toString() + '" cy="' + (35 + entropy % 35).toString()
				+ '" r="' + (10 + shape * 2).toString() + '" fill="' + colors[(entropy + shape) % colors.length] + '"/>'
		}
		svg += '<rect x="' + (30 + entropy % 80).toString() + '" y="78" width="' + (70 + entropy % 90).toString()
			+ '" height="18" fill="' + colors[(entropy + 3) % colors.length] + '"/></svg>'
		const buffer = new ArrayBuffer(svg.length)
		const bytes = new Uint8Array(buffer)
		for (let offset = 0; offset < svg.length; offset++) bytes[offset] = svg.charCodeAt(offset)
		return 'data:image/svg+xml;base64,' + uni.arrayBufferToBase64(buffer)
	}

	private buildStressHtml(index: number, run: number, selectedTypes: string[]): string {
		const has = (type: string): boolean => selectedTypes.indexOf(type) >= 0
		const entropy = run * 100 + index
		const letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H']
		const letter = letters[entropy % letters.length]
		const next = letters[(entropy + 2) % letters.length]
		const paragraphLines = 1 + (entropy % 4)
		const quoteLines = 1 + (entropy % 4)
		const tableRows = 3 + (entropy % 4)
		const tableColumns = 2 + (entropy % 3)
		const listCount = 2 + (entropy % 5)
		const codeLines = 4 + (entropy % 5) * 4
		const blocks = [] as string[]
		const heading = (index % 4) + 1
		if (has('标题')) blocks.push('<h' + heading.toString() + '>' + letter + entropy.toString() + '-title-' + next + '</h' + heading.toString() + '>')
		{
			let paragraph = '<p>'
			for (let line = 0; line < paragraphLines; line++) {
				if (line > 0) paragraph += '<br>'
				paragraph += letter + entropy.toString() + '-paragraph-' + line.toString() + ' ' + next + '-text-' + (line + 1).toString() + ' XYZ'
			}
			paragraph += '</p>'
			if (has('长文')) blocks.push(paragraph)
		}
		{
			let quote = '<blockquote>'
			for (let line = 0; line < quoteLines; line++) {
				if (line > 0) quote += '<br>'
				quote += next + entropy.toString() + '-quote-' + line.toString() + ' ' + letter + '@@@'
			}
			quote += '</blockquote>'
			if (has('引用')) blocks.push(quote)
		}
		{
			let list = '<ul>'
			for (let item = 0; item < listCount; item++) list += '<li>' + letter + entropy.toString() + '-item-' + item.toString() + '</li>'
			list += '</ul>'
			if (has('列表')) blocks.push(list)
		}
		{
			let table = '<table><thead><tr>'
			for (let column = 0; column < tableColumns; column++) table += '<th>' + letter + entropy.toString() + '-h' + column.toString() + '</th>'
			table += '</tr></thead><tbody>'
			for (let row = 0; row < tableRows; row++) {
				table += '<tr>'
				for (let column = 0; column < tableColumns; column++) table += '<td>' + next + entropy.toString() + '-r' + row.toString() + '-c' + column.toString() + '</td>'
				table += '</tr>'
			}
			table += '</tbody></table>'
			if (has('表格')) blocks.push(table)
		}
		{
			let code = '<pre><code>'
			for (let line = 0; line < codeLines; line++) code += 'const ' + letter.toLowerCase() + line.toString() + ' = &quot;' + next + entropy.toString() + '-' + line.toString() + '&quot;;<br>'
			code += '</code></pre>'
			if (has('代码')) blocks.push(code)
		}
		if (has('链接')) blocks.push('<p><a href="https://example.com/' + next.toLowerCase() + entropy.toString() + '">' + letter + entropy.toString() + '-link</a></p><hr>')
		// Rotate from a deterministic start; every selected block appears exactly once.
		const rotated = [] as string[]
		const start = blocks.length > 0 ? entropy % blocks.length : 0
		for (let offset = 0; offset < blocks.length; offset++) rotated.push(blocks[(start + offset) % blocks.length])
		return rotated.join('')
	}

	private cloneMessagesForStress(sourceMessages: MsgItem[], chatId: string, prefix: string): MsgItem[] {
		const idMap = {} as UTSJSONObject
		const clonedMessages = [] as MsgItem[]
		const createTime = Date.now()
		for (let index = 0; index < sourceMessages.length; index++) {
			const source = sourceMessages[index]
			// 消息 ID 同时是 Storage key；副本可被重新回答/删除，不能与源会话共享。
			const messageId = this.getStressDataId(prefix + '_msg')
			idMap[source._id] = messageId
			const cloned = { ...source } as MsgItem
			cloned._id = messageId
			cloned.chat_id = chatId
			cloned.create_time = createTime + index
			cloned.rendered = true
			clonedMessages.push(cloned)
		}
		for (let index = 0; index < clonedMessages.length; index++) {
			const sourceAboutId = sourceMessages[index].about_msg_id ?? ''
			if (sourceAboutId.length == 0) continue
			const mappedAboutId = idMap[sourceAboutId] as string | null
			if (mappedAboutId != null) clonedMessages[index].about_msg_id = mappedAboutId
		}
		return clonedMessages
	}

	expandCurrentChatForStress(targetRounds: number): string {
		const chat = this.currentChat
		if (chat == null) return '当前没有可复制的会话'
		if (chat.state == 'processing') return '请等待当前流式输出完成'
		if (chat.msgList.length != 2) return '当前会话必须只包含一轮消息'
		if (targetRounds <= 1) return '目标轮数必须大于 1'

		const sourceMessages = chat.msgList.slice(0)
		const appendedMessages = [] as MsgItem[]
		for (let round = 1; round < targetRounds; round++) {
			const cloned = this.cloneMessagesForStress(sourceMessages, chat.id, 'stress_round_' + round.toString())
			for (let index = 0; index < cloned.length; index++) appendedMessages.push(cloned[index])
		}
		if (!this.storageManager.appendChatMessages(chat.id, appendedMessages)) return '写入 Storage 失败'
		chat.msgList.push(...appendedMessages)
		chat.update_time = Date.now()
		this.saveChatList2Storage()
		return ''
	}

	copyLastMessageForStress(count: number, selectedTypes: string[] = ['标题', '长文', '引用', '列表', '表格', '代码', 'SVG']): string {
		const chat = this.currentChat
		const message = this.lastAiMsg ?? {
			_id: 'stress-template', body: '', from_uid: 'uni-ai', state: 0,
			create_time: Date.now(), chat_id: chat?.id ?? '', rendered: true
		} as MsgItem
		if (chat == null) return '当前没有可生成消息的会话'
		if (chat.state == 'processing') return '请等待当前流式输出完成'
		if (count <= 0) return '复制数量必须大于 0'
		const copiedMessages = [] as MsgItem[]
		this.stressMessageRunSequence += 1
		const run = this.stressMessageRunSequence
		for (let index = 0; index < count; index++) {
			const copied = this.cloneMessagesForStress([message] as MsgItem[], chat.id, 'stress_message_' + index.toString())
			copied[0].body = selectedTypes.length == 1 && selectedTypes[0] == 'SVG'
				? '' : 'Stress message ' + (index + 1).toString()
			copied[0].markdownHtml = this.buildStressHtml(index + 1, run, selectedTypes)
			if (selectedTypes.indexOf('SVG') >= 0) {
				copied[0].stressSvgSource = this.buildStressSvg(index + 1, run)
				copied[0].stressSvgWidth = 300
				copied[0].stressSvgHeight = 120
			} else {
				copied[0].stressSvgSource = ''
				copied[0].stressSvgWidth = 0
				copied[0].stressSvgHeight = 0
			}
			copied[0].rendered = true
			copiedMessages.push(copied[0])
		}
		if (!this.storageManager.appendChatMessages(chat.id, copiedMessages)) return '写入 Storage 失败'
		chat.msgList.push(...copiedMessages)
		chat.update_time = Date.now()
		this.saveChatList2Storage()
		return ''
	}

	async createCurrentChatStressCopies(runId: string, targetCount: number, onProgress?: StressCopyProgress): Promise<string> {
		const sourceChat = this.currentChat
		if (sourceChat == null) return '当前没有可复制的会话'
		if (sourceChat.state == 'processing') return '请等待当前流式输出完成'
		if (sourceChat.msgList.length == 0) return '当前会话没有消息'
		if (targetCount <= 0) return '复制数量必须大于 0'

		const sourceMessages = sourceChat.msgList.slice(0)
		const sourceTitle = sourceChat.title
		const baseUpdateTime = Date.now()
		// 以消息数限制批次规模；长会话不会一次排队过多 native Storage 请求。
		const maxMessagesPerBatch = 100
		const batchSize = Math.max(1, Math.min(25, Math.floor(maxMessagesPerBatch / sourceMessages.length)))
		const allCopiedChats = [] as ChatItem[]
		let completed = 0
		while (completed < targetCount) {
			const batchEnd = Math.min(completed + batchSize, targetCount)
			const copiedChats = [] as ChatItem[]
			const messageBatches = [] as ChatMessageBatch[]
			for (let copyIndex = completed; copyIndex < batchEnd; copyIndex++) {
				// 会话 ID 是消息索引和 activeId 的隔离边界，必须为每个副本重新生成。
				const chatId = this.getStressDataId('stress_' + runId + '_chat')
				const copiedMessages = this.cloneMessagesForStress(sourceMessages, chatId, 'stress_' + runId + '_' + copyIndex.toString())
				copiedChats.push({
					id: chatId,
					title: '[压测 ' + (copyIndex + 1).toString() + '] ' + sourceTitle,
					state: 'none',
					inputContent: '',
					// 副本已写入 Storage，保持空列表，选中时再按需加载消息。
					msgList: reactive<MsgItem[]>([]),
					update_time: baseUpdateTime + copyIndex
				} as ChatItem)
				messageBatches.push({ chatId: chatId, messages: copiedMessages })
			}
			if (!await this.storageManager.saveChatMessagesBatchAsync(messageBatches)) {
				// 让已完成的批次仍然可见，避免 Storage 中出现无法访问的副本元数据。
				allCopiedChats.reverse()
				if (allCopiedChats.length > 0) this.chat.datas.unshift(...allCopiedChats)
				return '写入 Storage 失败'
			}
			allCopiedChats.push(...copiedChats)
			completed = batchEnd
			if (onProgress != null) onProgress(completed)
		}

		// 只触发一次响应式列表更新；逆序插入可保持压测副本的显示顺序。
		allCopiedChats.reverse()
		this.chat.datas.unshift(...allCopiedChats)
		return ''
	}
	
	addChat(checkEmpty: boolean = true) {
		this.cancelEditMsg()
		// 检查是否已经存在空会话，如果存在则直接选中，否则创建新会话
		const lastItem = this.chat.datas.length == 0 ? null : this.chat.datas[0] as ChatItem | null;
		let activeId = lastItem?.id ?? ''
		if (!checkEmpty || lastItem?.msgList.length != 0) {
			const newChat: ChatItem = {
				id: this.getLocalMsgId(),
				title: "新对话",
				state: 'none',
				update_time: Date.now(),
				msgList: reactive<MsgItem[]>([]),
				inputContent: ''
			};
			this.chat.datas.unshift(newChat);
			this.loadedChatIds.push(newChat.id)
			activeId = newChat.id
			this.saveChatList2Storage()
		}
		// 选中新创建的会话
		nextTick(() => {
			this.chat.activeId = activeId
		})
	}
	
	deleteChat(chatId: string): void {
		this.cancelEditMsg()
		this.clearPendingMsgSave()
		const deletingChat = this.chat.datas.find((item) => item.id == chatId)
		if (this.chat.activeId == chatId && deletingChat?.state == 'processing') this.abortRequest()
		// #ifdef APP-HARMONY || APP-ANDROID
		if (deletingChat != null) {
			for (let i = 0; i < deletingChat.msgList.length; i++) libmarkStreamRelease(deletingChat.msgList[i]._id)
		}
		// #endif
		// 如果只有一个，删之前需要先创建一个并设置为选中，否则会照成无选中会话导致崩溃
		if (uniAi.chat.datas.length == 1) {
			uniAi.addChat(false)
			this.chat.activeId = uniAi.chat.datas[0].id
		} else if (uniAi.chat.activeId == chatId) {
			// 如果删除的是当前激活的对话，则激活其他对话
			const otherChat = uniAi.chat.datas.find((item) => item.id != chatId)!
			uniAi.chat.activeId = otherChat.id
		}
			nextTick(() => {
			const index = uniAi.chat.datas.findIndex((item) => item.id == chatId)
			uniAi.chat.datas.splice(index, 1)
			const loadedIndex = this.loadedChatIds.indexOf(chatId)
			if (loadedIndex >= 0) this.loadedChatIds.splice(loadedIndex, 1)
			this.storageManager.deleteChat(chatId)
		})
	}

	deleteAllChats(): void {
		this.clearPendingMsgSave()
		if (this.currentChat?.state == 'processing') this.abortRequest()
		const chatIds = this.chat.datas.map((item: ChatItem): string => item.id)
		// #ifdef APP-HARMONY || APP-ANDROID
		for (let chatIndex = 0; chatIndex < this.chat.datas.length; chatIndex++) {
			const msgList = this.chat.datas[chatIndex].msgList
			for (let msgIndex = 0; msgIndex < msgList.length; msgIndex++) libmarkStreamRelease(msgList[msgIndex]._id)
		}
		// #endif
		for (let index = 0; index < chatIds.length; index++) this.storageManager.deleteChat(chatIds[index])
		this.chat.datas.splice(0, this.chat.datas.length)
		this.loadedChatIds.splice(0, this.loadedChatIds.length)
		this.chat.activeId = ''
		this.addChat(false)
	}

	selectChat(chatId: string) {
		this.cancelEditMsg()
		if (this.chat.activeId != chatId) {
			if (this.currentChat?.state == 'processing') {
				this.abortRequest()
			} else {
				this.answerGeneration += 1
			}
		}
		this.loadChatMessages(chatId)
		this.chat.activeId = chatId
	}

	private loadChatMessages(chatId: string) {
		if (this.loadedChatIds.indexOf(chatId) >= 0) return
		const chat = this.chat.datas.find((item) => item.id == chatId)
		if (chat == null) return
		const messages = this.storageManager.getChatMessages(chatId)
		chat.msgList.push(...messages)
		this.loadedChatIds.push(chatId)
	}
		
	get lastAiMsg(): MsgItem | null {
		// 获取Ai的最后一条消息(因为 msg 是倒叙的，所以取第一条)
		if (this.currentChat != null) {
			const length = this.currentChat!.msgList.length
			return length > 0 ? this.currentChat!.msgList[length - 1] : null;
		} else {
			return null;
		}
	}
	
	constructor() {
		initUiTheme()
		this.loadDataFromNewStorage()
		this.loadSetting()
		this.watchSetting()
	}
	private buildDefaultLlm(): Llm {
		return {
			provider: defaultLLM.provider,
			model: defaultLLM.model,
			webSearch: false,
			thinking: true
		} as Llm
	}
	// 同步读取设置，避免与 watchSetting 的立即保存在时序上互相覆盖
	private loadSetting() {
		let raw: UTSJSONObject | null = null
		try {
			const stored = uni.getStorageSync('uni-ai-setting')
			if (stored != null) {
				const text = typeof stored == 'string' ? stored as string : JSON.stringify(stored)
				if (text.length > 0) raw = JSON.parse<UTSJSONObject>(text) as UTSJSONObject
			}
		} catch (error) {
			console.error('uni-ai-setting 读取失败', error)
			this.pushSettingNotice('本地设置数据读取失败，已恢复默认设置')
			return
		}
		if (raw == null) return
		const themeValue = raw['theme'] as string | null
		if (themeValue == 'dark') {
			this.setting.theme = 'dark'
		} else if (themeValue == 'light') {
			this.setting.theme = 'light'
		} else {
			this.setting.theme = 'auto'
		}
		const languageValue = raw['language'] as string | null
		if (languageValue == 'en-US') {
			this.setting.language = 'en-US'
		} else {
			this.setting.language = 'zh-CN'
		}
		const llmJson = raw.getJSON('llm')
		if (llmJson == null) return
		const providerValue = llmJson['provider'] as string | null
		const modelValue = llmJson['model'] as string | null
		const provider = providerValue ?? ''
		const model = modelValue ?? ''
		const providerConfig = llmModelMap.get(provider)
		const matchedModel = providerConfig?.models.find(m => m.modelId == model)
		if (providerConfig != null && matchedModel != null) {
			const webSearchValue = llmJson['webSearch'] as boolean | null
			const thinkingValue = llmJson['thinking'] as boolean | null
			this.setting.llm = {
				provider: provider,
				model: model,
				webSearch: webSearchValue ?? false,
				thinking: thinkingValue ?? true
			} as Llm
			return
		}
		this.setting.llm = this.buildDefaultLlm()
		// 空模型表示首次初始化或旧版本未保存过模型，不需要打扰用户。
		if (model.length > 0) {
			this.pushSettingNotice('原选择的模型「' + model + '」已不可用，已切换到「' + getLlmDisplayName(this.setting.llm) + '」')
		}
	}
	private watchSetting() {
		watch((): Theme => this.setting.theme, (theme: Theme) => {
			applyAppTheme(theme)
		}, { immediate: true })
		watch((): Setting => this.setting, () => {
			this.saveSetting()
		}, { deep: true, immediate: true })
	}
	private saveSetting() {
		try {
			const plainSetting = JSON.parse<Setting>(JSON.stringify(this.setting)) as Setting
			uni.setStorageSync('uni-ai-setting', plainSetting)
		} catch (error) {
			console.error('uni-ai-setting 存储失败', error)
		}
	}
	/**
	 * 收到 msg 被更新的通知后，按固定节奏节流保存消息：
	 * 窗口内不重置定时器，保证流式期间也能周期性落盘
	 */
	sM2STimer: number = 0
	private pendingMsgSave: MsgItem | null = null
	// 正在流式生成的 AI 消息：中断时需要落一次最终状态
	private streamingAiMsg: MsgItem | null = null
	private clearPendingMsgSave() {
		if (this.sM2STimer != 0) {
			clearTimeout(this.sM2STimer)
			this.sM2STimer = 0
		}
		this.pendingMsgSave = null
	}
	updateMsg2Storage(msg: MsgItem) {
		this.pendingMsgSave = msg
		if (this.sM2STimer != 0) return
		this.sM2STimer = setTimeout(() => {
			this.sM2STimer = 0
			const pending = this.pendingMsgSave
			this.pendingMsgSave = null
			if (pending != null) this.storageManager.updateMessage(pending!)
		}, MSG_SAVE_THROTTLE_INTERVAL)
	}
	// 立即落盘：完成/停止/中断等最终状态不等待节流窗口
	flushMsg2Storage(msg: MsgItem | null = null) {
		const pending = msg != null ? msg! : this.pendingMsgSave
		this.clearPendingMsgSave()
		if (pending != null) this.storageManager.updateMessage(pending!)
	}
	saveChatList2Storage() {
		const chatList: ChatItem[] = this.chat.datas
		if (chatList.length > 0) {
			const aiChats: AiChat[] = chatList.map((chat: ChatItem) => {
				const aiChat: AiChat = {
					id: chat.id,
					title: chat.title,
					update_time: chat.update_time
				}
				return aiChat
			})
			this.storageManager.saveChatList(aiChats)
		}
	}
	// 更新会话标题 和 会话更新时间 时，自动保存会话列表到 storage
	updateChatUpdateTime(chatId: string) {
		const chat = this.chat.datas.find(chat => chat.id == chatId)
		if (chat != null) {
			chat.update_time = Date.now()
		} else {
			throw new Error('updateChatUpdateTime 对话不存在' + chatId)
		}
		this.saveChatList2Storage()
	}
	updateChatTitle(chatId: string, title: string) {
		const chat = this.chat.datas.find(chat => chat.id == chatId)
		if (chat != null) {
			// 标题只允许单行显示：去掉换行符并 trim
			chat.title = title.replace(/\r\n|\n|\r/g, ' ').trim()
		} else {
			console.error('updateChatTitle 对话不存在', chatId)
			throw new Error('updateChatTitle 对话不存在')
		}
		this.saveChatList2Storage()
	}
	
	/**
	 * 从新的存储结构中加载数据
	 */
	private loadDataFromNewStorage(): void {
		try {
			// 获取会话列表
			const aiChats = this.storageManager.getChatList()
			
			if (aiChats.length == 0) {
				// 如果没有会话，创建一个新会话
				this.addChat()
				return
			}
			
			// 启动只加载会话元数据；消息在选中会话时再读取。
			for (let i = 0; i < aiChats.length; i++) {
				const aiChat = aiChats[i]
				const chatItem: ChatItem = {
					id: aiChat.id,
					title: aiChat.title,
					state: 'none',
					update_time: aiChat.update_time,
					msgList: reactive<MsgItem[]>([]),
					inputContent: ''
				}
				
				this.chat.datas.push(chatItem)
			}
			
			// 默认选中第一个会话
			if (this.chat.datas.length > 0) {
				this.chat.activeId = this.chat.datas[0].id
				this.loadChatMessages(this.chat.activeId)
			}
			
		} catch (error) {
			console.error('从新存储结构加载数据失败:', error)
			// 如果失败，创建一个新会话
			this.addChat()
		}
	}
	
	addMsg(msg: BaseMsgItem): MsgItem {
		// 添加一条消息
		const msgList = this.currentChat!.msgList
		const newMsg: MsgItem = {
			...msg,
			chat_id: this.currentChat!.id,
			_id: this.getLocalMsgId(),
			create_time: Date.now(),
			state: 0,
				markdownHtml: '',
				markdownAst: '',
			rendered: false
		} as MsgItem
		msgList.push(newMsg)
		this.storageManager.addMessage(newMsg)
		if (msg.from_uid != 'uni-ai') {
			// 仅首次提问时用问题前缀作为临时标题，避免后续消息覆盖已生成的总结标题
			if (this.currentChat!.title == '新对话') {
				const title = msg.body.substring(0, 20).replace(/\n/g, '')
				this.currentChat!.title = title
			}
		}
		// 更新会话的更新时间
		this.updateChatUpdateTime(this.currentChat!.id)
		// 返回响应式的 msg
		return msgList[msgList.length - 1]
	}
	
	deleteMsg(msgId: string) {
		// 查出消息索引
		const msgList = this.currentChat!.msgList
		const index = msgList.findIndex((item) => item._id == msgId)
		if (index != -1) {
			// #ifdef APP-HARMONY || APP-ANDROID
			libmarkStreamRelease(msgId)
			// #endif
			msgList.splice(index, 1)
			this.storageManager.removeMessages(this.currentChat!.id, [msgId] as string[])
		} else {
			console.error('需要删除的消息未找到', msgId, this.currentChat!.msgList)
			throw new Error('需要删除的消息未找到')
		}
	}

	/**
	 * 进入消息编辑态：把原消息内容回填输入框，发送时将替换该消息及其之后的全部消息
	 */
	startEditMsg(msg: MsgItem): void {
		if (this.currentChat == null) return
		this.editingState.msgId = msg._id
		this.editingState.imgList = (msg.img_url_list ?? [] as string[]).slice(0)
		this.currentChat!.inputContent = msg.body
	}

	/**
	 * 取消编辑态，原消息保持不变
	 */
	cancelEditMsg(): void {
		this.editingState.msgId = ''
		this.editingState.imgList = [] as string[]
	}

	/**
	 * 删除指定消息及其之后的所有消息（内存与 Storage 同步）
	 */
	deleteMsgFrom(msgId: string): void {
		const chat = this.currentChat
		if (chat == null) return
		const msgList = chat.msgList
		const index = msgList.findIndex((item) => item._id == msgId)
		if (index == -1) return
		const removedIds = [] as string[]
		for (let i = index; i < msgList.length; i++) {
			removedIds.push(msgList[i]._id)
		}
		// 先清掉防抖中的待写消息，避免删除后又被写回 Storage
		this.clearPendingMsgSave()
		// #ifdef APP-HARMONY || APP-ANDROID
		for (let i = index; i < msgList.length; i++) libmarkStreamRelease(msgList[i]._id)
		// #endif
		msgList.splice(index, msgList.length - index)
		this.storageManager.removeMessages(chat.id, removedIds)
		this.updateChatUpdateTime(chat.id)
	}
	
	abortRequest() {
		// 中断前把流式中的消息状态落盘，避免停止后重启显示源码/状态缺失
		const streamingMsg = this.streamingAiMsg
		this.streamingAiMsg = null
		if (streamingMsg != null && streamingMsg.rendered != true) {
			streamingMsg.rendered = true
			this.flushMsg2Storage(streamingMsg)
		}
		this.answerGeneration += 1
		requestAiRunner?.abortRequest()
	}
	
	async sendMsg(inputContent: string = ''): Promise<void> {
		// 发送消息
		if (inputContent == '') {
			inputContent = this.currentChat!.inputContent
		}
		// 去除前后空格
		inputContent = inputContent.trim()
		if (inputContent.length == 0) {
			throw new Error('发给 AI 的消息不能为空');
		}
		// 编辑重发：先删除被编辑消息及其之后的所有消息，再发送新消息
		const editingMsgId = this.editingMsgId
		const editingImgList = this.editingState.imgList.slice(0)
		if (editingMsgId != '') {
			this.cancelEditMsg()
			if (this.currentChat!.state == 'processing') {
				this.currentChat!.state = 'stop'
			}
			this.abortRequest()
			this.deleteMsgFrom(editingMsgId)
		}
		// 生成用户提问的消息
		let baseUserMsg: BaseMsgItem = {
			body: inputContent,
			from_uid: this.currentUser._id ?? 'tmp_user_'
		}
		// 如果有图片
		if (this.imgList.length > 0) {
			baseUserMsg.img_url_list = this.imgList.map((item:ImgItem):string => item.path)
			this.imgList.length = 0
		} else if (editingImgList.length > 0) {
			// 编辑带图消息且未重新选图时，沿用原图
			baseUserMsg.img_url_list = editingImgList
		}
		const userMsg: MsgItem = this.addMsg(baseUserMsg)

		// 生成一条空的 ai 回复的内容
		let baseAiMsgItem: BaseMsgItem = {
			body: '', // 初始是空的，后面慢慢追加
			from_uid: "uni-ai",
			about_msg_id: userMsg._id
		}
		const aiMsgItem: MsgItem = this.addMsg(baseAiMsgItem)
		return this.answerQuestion(aiMsgItem)
	}
	resetMsg(msg: MsgItem) {
		this.answerGeneration += 1
		// #ifdef APP-HARMONY || APP-ANDROID
		libmarkStreamReset(msg._id)
		// #endif
		msg.body = ''
		msg.rendered = false
		msg.error_msg = null
		msg.thinkContent = null
		msg.markdownHtml = ''
		msg.markdownAst = ''
		this.flushMsg2Storage(msg)
	}
	
	// 回答问题
	answerQuestion(aiMsgItem: MsgItem) {
		this.abortRequest()
		this.streamingAiMsg = aiMsgItem
		const answerGeneration = this.answerGeneration
		this.emitBeforeRequestAi()
		this.updateChatUpdateTime(this.currentChat!.id)
		this.currentChat!.state = 'processing';	
		const messages = this.getMsgToAi(this.currentChat!)
		const isActiveAiMsg = (): boolean => {
			const chat = this.currentChat
			return this.answerGeneration == answerGeneration && chat != null && chat.id == aiMsgItem.chat_id && chat.msgList.find((item) => item._id == aiMsgItem._id) != null
		}
		const runnerCallbacks: RequestAiRunnerCallbacks = {
			// #ifdef APP-HARMONY || APP-ANDROID
			onMarkdownAstDelta: (ops: AiWorkerOp[]) => {
				if (!isActiveAiMsg() || this.currentChat!.state == 'stop') return
				if (libmarkStreamApply(aiMsgItem._id, ops)) {
					aiMsgItem.libmarkRevision = (aiMsgItem.libmarkRevision ?? 0) + 1
					this.updateMsg2Storage(aiMsgItem)
				}
			},
			// #endif
			onMarkdownHtml: (html: string) => {
				if (!isActiveAiMsg() || this.currentChat!.state == 'stop') return
				aiMsgItem.markdownHtml = html
				this.updateMsg2Storage(aiMsgItem)
			},
			onMarkdownAst: (ast: string) => {
				// 调试日志：排查 ast 是否透传到消息时启用
				// console.log('[uni-ai-x][runner] ast=' + ast.length.toString())
				if (!isActiveAiMsg() || this.currentChat!.state == 'stop') return
				// #ifdef APP-HARMONY || APP-ANDROID
				if (ast.length == 0 && (aiMsgItem.markdownAst ?? '').indexOf('libmark.ast/1') >= 0) return
				// #endif
				aiMsgItem.markdownAst = ast
				this.updateMsg2Storage(aiMsgItem)
			},
			onThinkContent: (thinkContent: string) => {
				if (!isActiveAiMsg()) return
				aiMsgItem.thinkContent = thinkContent
				this.updateMsg2Storage(aiMsgItem)
			},
			onMsgBody: (msgBody: string) => {
				if (!isActiveAiMsg()) return
				aiMsgItem.body = msgBody
				this.updateMsg2Storage(aiMsgItem)
			},
			onState: (state: string) => {
				if (!isActiveAiMsg()) return
				this.currentChat!.state = state
				// #ifdef APP-HARMONY || APP-ANDROID
				if (state == 'completed') {
					// 渲染数据不落 storage：只刷新完成态，重启后由 body 重建
					libmarkStreamMarkComplete(aiMsgItem._id)
					aiMsgItem.libmarkRevision = (aiMsgItem.libmarkRevision ?? 0) + 1
				}
				// #endif
				if (state == 'stop') {
					aiMsgItem.rendered = true
				}
				if (state == 'completed' || state == 'stop') {
					this.streamingAiMsg = null
				}
				this.flushMsg2Storage(aiMsgItem)
			},
			onErrorMsg: (errorMsg: string) => {
				if (!isActiveAiMsg()) return
				aiMsgItem.error_msg = errorMsg
				this.updateMsg2Storage(aiMsgItem)
			},
			onRendered: (rendered: boolean) => {
				if (!isActiveAiMsg()) return
				aiMsgItem.rendered = rendered
				this.flushMsg2Storage(aiMsgItem)
			},
			onChatTitle: (title: string) => {
				if (!isActiveAiMsg()) return
				this.updateChatTitle(aiMsgItem.chat_id, title)
			}
		}
		const runnerFactory = getAiRequestRunnerFactory()
		if (runnerFactory != null) {
			requestAiRunner = runnerFactory!(runnerCallbacks)
			return
		}
		const remoteRunner = new RequestAiRunner(runnerCallbacks)
		requestAiRunner = remoteRunner
		// 仅会话首条提问在回答成功后总结标题，避免每轮对话都与回答请求一起占用同一模型的 RPM
		let userMsgCount = 0
		this.currentChat!.msgList.forEach((item: MsgItem) => {
			if (item.from_uid != 'uni-ai') userMsgCount += 1
		})
		remoteRunner.start({
			messages,
			llm: this.llm as Llm,
			chat_id: this.currentChat!.id,
			updateTitleAfterDone: userMsgCount == 1
		})
	}
	
	// 拿到消息列表，用于发给 AI 
	getMsgToAi(chatItem: ChatItem): RequestAiCoMessage[] {
		return buildAiMessages(chatItem)
	}
	
	// 监听请求 AI 前的回调
	beforeRequestAiFns: BeforeRequestAiFn[] = []
	onBeforeRequestAi(fn: BeforeRequestAiFn) {
		this.beforeRequestAiFns.push(fn)
	}
	offBeforeRequestAi(fn: BeforeRequestAiFn) {
		const index = this.beforeRequestAiFns.indexOf(fn)
		if (index != -1) this.beforeRequestAiFns.splice(index, 1)
	}
	emitBeforeRequestAi() {
		this.beforeRequestAiFns.forEach((fn) => {
			fn()
		})
	}
	
	// 监听"打开设置"的回调（如：模型不支持图片理解时，用户点击"去设置"）
	openSettingFns: OpenSettingFn[] = []
	onOpenSetting(fn: OpenSettingFn) {
		this.openSettingFns.push(fn)
	}
	offOpenSetting(fn: OpenSettingFn) {
		const index = this.openSettingFns.indexOf(fn)
		if (index != -1) this.openSettingFns.splice(index, 1)
	}
	emitOpenSetting() {
		this.openSettingFns.forEach((fn) => {
			fn()
		})
	}
}

const uniAi = new UniAi()
export { uniAi }
export default uniAi

// #ifdef WEB
// 方便在控制台观察
window.uniAi = uniAi
// #endif
