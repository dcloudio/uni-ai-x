import {
	MarkdownAstNode,
	MarkdownRenderBlock
} from '@/uni_modules/uni-ai-worker/utssdk/markdown-ast.uts'
import {
	MarkdownHtmlBlock,
	prepareMarkdownTable
} from '@/uni_modules/uni-ai-worker/utssdk/markdown-html.uts'
import type { LibmarkRenderBlock, LibmarkTextSpan } from '@/uni_modules/uni-ai-worker/utssdk/libmark-ast.uts'

export type MarkdownTextSpan = {
	text: string
	className: string
	href: string
	isImage: boolean
	imageSrc: string
	svgSource: string
	svgWidth: number
	svgHeight: number
	svgBaseline: number
}

export type MarkdownTextRenderBlock = {
	kind: string
	key: string
	html: string
	text: string
	language: string
	isComplete: boolean
	columnWidths: number[]
	rowTextWidths: number[][]
	spans: MarkdownTextSpan[]
	level: number
	indent: number
	marker: string
	quoteDepth: number
	svgSource: string
	svgWidth: number
	svgHeight: number
}

function emptyAstNodes(): MarkdownAstNode[] {
	return [] as MarkdownAstNode[]
}

function emptySpans(): MarkdownTextSpan[] {
	return [] as MarkdownTextSpan[]
}

function emptyNumbers(): number[] {
	return [] as number[]
}

function emptyNumberRows(): number[][] {
	return [] as number[][]
}

function nodeChildren(node: MarkdownAstNode | null): MarkdownAstNode[] {
	if (node == null || node.children == null) return emptyAstNodes()
	return node.children!
}

function escapeHtmlText(text: string): string {
	let result = text.replace(/&/g, '&amp;')
	result = result.replace(/</g, '&lt;')
	result = result.replace(/>/g, '&gt;')
	result = result.replace(/"/g, '&quot;')
	return result
}

function decodeHtmlEntities(text: string): string {
	return text
		.replace(/&nbsp;/gi, ' ')
		.replace(/&amp;/gi, '&')
		.replace(/&lt;/gi, '<')
		.replace(/&gt;/gi, '>')
		.replace(/&quot;/gi, '"')
		.replace(/&#39;/gi, "'")
}

function htmlToPlainText(html: string): string {
	let result = html
	result = result.replace(/<br\s*\/?\s*>/gi, '\n')
	result = result.replace(/<li[^>]*>/gi, '• ')
	result = result.replace(/<\/(p|div|h[1-6]|li|blockquote|tr)>/gi, '\n')
	result = result.replace(/<[^>]+>/g, '')
	result = decodeHtmlEntities(result)
	return result.replace(/\n{3,}/g, '\n\n').trim()
}

function htmlHeadingLevel(html: string): number {
	const value = html.trim().toLowerCase()
	for (let level = 1; level <= 6; level++) {
		if (value.startsWith('<h' + level.toString())) return level
	}
	return 0
}

function inlineNodeText(node: MarkdownAstNode | null, depth: number = 0): string {
	if (node == null || depth > 64) return ''
	if (node.literal != null) return node.literal!
	let result = ''
	const children = nodeChildren(node)
	for (let index = 0; index < children.length; index++) {
		result += inlineNodeText(children[index], depth + 1)
	}
	return result
}

function inlineChildrenHtml(node: MarkdownAstNode | null, depth: number = 0): string {
	if (node == null || depth > 64) return ''
	let result = ''
	const children = nodeChildren(node)
	for (let index = 0; index < children.length; index++) {
		result += inlineNodeHtml(children[index], depth + 1)
	}
	return result
}

function inlineNodeHtml(node: MarkdownAstNode | null, depth: number = 0): string {
	if (node == null || depth > 64) return ''
	const type = node.type
	if (type == 'text') return escapeHtmlText(node.literal ?? '')
	if (type == 'softbreak' || type == 'linebreak') return '<br>'
	if (type == 'code') return '<code>' + escapeHtmlText(node.literal ?? '') + '</code>'
	if (type == 'emph') return '<em>' + inlineChildrenHtml(node, depth + 1) + '</em>'
	if (type == 'strong') return '<strong>' + inlineChildrenHtml(node, depth + 1) + '</strong>'
	if (type == 'strikethrough') return '<del>' + inlineChildrenHtml(node, depth + 1) + '</del>'
	if (type == 'link') {
		return '<a href="' + escapeHtmlText(node.url ?? '') + '">' +
			inlineChildrenHtml(node, depth + 1) + '</a>'
	}
	if (type == 'image') {
		return '<img src="' + escapeHtmlText(node.url ?? '') + '" alt="' +
			escapeHtmlText(inlineNodeText(node, depth + 1)) + '" />'
	}
	if (type == 'html_inline' || type == 'html_block') {
		return escapeHtmlText(node.literal ?? '')
	}
	return inlineChildrenHtml(node, depth + 1)
}

function tableRawHtml(node: MarkdownAstNode): string {
	const alignments = node.alignments ?? ([] as string[])
	const rows = nodeChildren(node)
	let headerHtml = ''
	let bodyHtml = ''
	for (let rowIndex = 0; rowIndex < rows.length; rowIndex++) {
		const row = rows[rowIndex]
		const cells = nodeChildren(row)
		const tag = row.header == true ? 'th' : 'td'
		let rowHtml = '<tr>'
		for (let cellIndex = 0; cellIndex < cells.length; cellIndex++) {
			const align = cellIndex < alignments.length ? alignments[cellIndex] : 'left'
			rowHtml += '<' + tag + ' style="text-align:' + (align.length > 0 ? align : 'left') + '">' +
				inlineChildrenHtml(cells[cellIndex]) + '</' + tag + '>'
		}
		rowHtml += '</tr>'
		if (row.header == true) headerHtml += rowHtml
		else bodyHtml += rowHtml
	}
	let html = '<table>'
	if (headerHtml.length > 0) html += '<thead>' + headerHtml + '</thead>'
	if (bodyHtml.length > 0) html += '<tbody>' + bodyHtml + '</tbody>'
	return html + '</table>'
}

function spanClassName(styles: string[]): string {
	let className = 'uni-ai-md-text-span'
	for (let index = 0; index < styles.length; index++) {
		className += ' uni-ai-md-text-span-' + styles[index]
	}
	return className
}

function makeSpan(text: string, styles: string[] = [] as string[], href: string = '',
	isImage: boolean = false, imageSrc: string = '', svgSource: string = '',
	svgWidth: number = 0, svgHeight: number = 0, svgBaseline: number = 0): MarkdownTextSpan {
	return {
		text: text,
		className: spanClassName(styles),
		href: href,
		isImage: isImage,
		imageSrc: imageSrc,
		svgSource: svgSource,
		svgWidth: svgWidth,
		svgHeight: svgHeight,
		svgBaseline: svgBaseline
	}
}

function appendInlineNode(node: MarkdownAstNode, spans: MarkdownTextSpan[],
	styles: string[] = [] as string[], depth: number = 0) {
	if (depth > 64) return
	const type = node.type
	if (type == 'text' || type == 'escape') {
		const text = node.literal ?? ''
		if (text.length > 0) spans.push(makeSpan(text, styles))
		return
	}
	if (type == 'softbreak' || type == 'linebreak' || type == 'br') {
		spans.push(makeSpan('\n', styles))
		return
	}
	if (type == 'code') {
		spans.push(makeSpan(node.literal ?? '', styles.concat(['code'])))
		return
	}
	if (type == 'emph') {
		const nextStyles = styles.concat(['em'])
		const children = nodeChildren(node)
		for (let index = 0; index < children.length; index++) {
			appendInlineNode(children[index], spans, nextStyles, depth + 1)
		}
		return
	}
	if (type == 'strong') {
		const nextStyles = styles.concat(['strong'])
		const children = nodeChildren(node)
		for (let index = 0; index < children.length; index++) {
			appendInlineNode(children[index], spans, nextStyles, depth + 1)
		}
		return
	}
	if (type == 'strikethrough') {
		const nextStyles = styles.concat(['del'])
		const children = nodeChildren(node)
		for (let index = 0; index < children.length; index++) {
			appendInlineNode(children[index], spans, nextStyles, depth + 1)
		}
		return
	}
	if (type == 'link' || type == 'autolink') {
		const nextStyles = styles.concat(['link'])
		const href = node.url ?? ''
		const spanStart = spans.length
		const children = nodeChildren(node)
		if (children.length == 0) {
			const text = node.literal ?? href
			if (text.length > 0) spans.push(makeSpan(text, nextStyles, href))
		} else {
			for (let index = 0; index < children.length; index++) {
				appendInlineNode(children[index], spans, nextStyles, depth + 1)
			}
			for (let index = spanStart; index < spans.length; index++) {
				if (spans[index].href.length == 0) spans[index].href = href
			}
		}
		return
	}
	if (type == 'image') {
		const alt = inlineNodeText(node, depth + 1)
		const src = node.url ?? ''
		if (src.length > 0) spans.push(makeSpan(alt, styles, '', true, src))
		else if (alt.length > 0) spans.push(makeSpan(alt, styles))
		return
	}
	if (type == 'html_inline') {
		const text = htmlToPlainText(node.literal ?? '')
		if (text.length > 0) spans.push(makeSpan(text, styles))
		return
	}
	const children = nodeChildren(node)
	if (children.length == 0) {
		const text = node.literal ?? ''
		if (text.length > 0) spans.push(makeSpan(text, styles))
		return
	}
	for (let index = 0; index < children.length; index++) {
		appendInlineNode(children[index], spans, styles, depth + 1)
	}
}

function inlineSpans(nodes: MarkdownAstNode[]): MarkdownTextSpan[] {
	const spans = emptySpans()
	for (let index = 0; index < nodes.length; index++) {
		appendInlineNode(nodes[index], spans)
	}
	return spans
}

function createTextBlock(kind: string, key: string, spans: MarkdownTextSpan[],
	level: number = 0, indent: number = 0, marker: string = '',
	quoteDepth: number = 0): MarkdownTextRenderBlock {
	return {
		kind: kind,
		key: key,
		html: '',
		text: '',
		language: '',
		isComplete: true,
		columnWidths: emptyNumbers(),
		rowTextWidths: emptyNumberRows(),
		spans: spans,
		level: level,
		indent: indent,
		marker: marker,
		quoteDepth: quoteDepth,
		svgSource: '',
		svgWidth: 0,
		svgHeight: 0
	}
}

function createSpecialBlock(kind: string, key: string, html: string = '',
	text: string = '', language: string = '', isComplete: boolean = true,
	columnWidths: number[] = [] as number[], rowTextWidths: number[][] = [] as number[][]): MarkdownTextRenderBlock {
	return {
		kind: kind,
		key: key,
		html: html,
		text: text,
		language: language,
		isComplete: isComplete,
		columnWidths: columnWidths,
		rowTextWidths: rowTextWidths,
		spans: emptySpans(),
		level: 0,
		indent: 0,
		marker: '',
		quoteDepth: 0,
		svgSource: '',
		svgWidth: 0,
		svgHeight: 0
	}
}

function textAstNode(text: string): MarkdownAstNode {
	return {
		type: 'text',
		literal: text
	}
}

function htmlBlockFromRenderBlock(block: MarkdownRenderBlock): MarkdownHtmlBlock {
	return {
		kind: block.kind,
		key: block.key,
		html: block.html,
		text: block.text,
		language: block.language,
		isComplete: block.isComplete,
		columnWidths: block.columnWidths,
		rowTextWidths: block.rowTextWidths
	}
}

function appendInlineBlock(result: MarkdownTextRenderBlock[], kind: string, key: string,
	nodes: MarkdownAstNode[], level: number, indent: number, marker: string, quoteDepth: number) {
	const spans = inlineSpans(nodes)
	if (spans.length == 0) return
	result.push(createTextBlock(kind, key, spans, level, indent, marker, quoteDepth))
}

function isTaskItem(item: MarkdownAstNode, list: MarkdownAstNode): boolean {
	return list.type == 'tasklist' || item.tasklist == true || item.checked != null
}

function listMarker(list: MarkdownAstNode, item: MarkdownAstNode, index: number): string {
	if (isTaskItem(item, list)) return item.checked == true ? '☑ ' : '☐ '
	if (list.listType == 'ordered') {
		const start = list.start ?? 1
		return (start + index).toString() + '. '
	}
	return '• '
}

function isBlockNode(type: string): boolean {
	return type == 'heading' || type == 'paragraph' || type == 'block_quote'
		|| type == 'list' || type == 'tasklist' || type == 'thematic_break'
		|| type == 'code_block' || type == 'table' || type == 'html_block'
}

function appendCodeBlock(result: MarkdownTextRenderBlock[], node: MarkdownAstNode,
	key: string, isDone: boolean) {
	const info = (node.info ?? '').split(' ')[0]
	let kind = 'code'
	let language = info.length > 0 ? info : 'text'
	let isComplete = isDone
	if (info == 'math' || info == 'math-pending') {
		kind = 'math'
		language = 'math'
		isComplete = info == 'math'
	} else if (info == 'mermaid' || info == 'mermaid-pending') {
		kind = 'mermaid'
		language = 'mermaid'
		isComplete = info == 'mermaid' || isDone
	}
	const text = (node.literal ?? '').replace(/\n$/, '')
	if (kind == 'math') {
		result.push(createTextBlock('math', key, [makeSpan(text, ['math'])] as MarkdownTextSpan[]))
		result[result.length - 1].text = text
		result[result.length - 1].isComplete = isComplete
		return
	}
	result.push(createSpecialBlock(kind, key, '', text, language, isComplete))
}

function appendTableBlock(result: MarkdownTextRenderBlock[], node: MarkdownAstNode, key: string) {
	const prepared = prepareMarkdownTable(tableRawHtml(node), result.length)
	result.push(createSpecialBlock('table', key, prepared.html, '', '', true,
		prepared.columnWidths, prepared.rowTextWidths))
}

function appendListNode(result: MarkdownTextRenderBlock[], node: MarkdownAstNode,
	indent: number, quoteDepth: number, prefix: string, isDone: boolean) {
	const items = nodeChildren(node)
	for (let index = 0; index < items.length; index++) {
		const item = items[index]
		const marker = listMarker(node, item, index)
		const children = nodeChildren(item)
		let hasTextBlock = false
		let inlineFallback = [] as MarkdownAstNode[]
		for (let childIndex = 0; childIndex < children.length; childIndex++) {
			const child = children[childIndex]
			if (child.type == 'paragraph') {
				appendInlineBlock(result, 'list', prefix + '-item-' + index.toString(),
					nodeChildren(child), 0, indent, marker, quoteDepth)
				hasTextBlock = true
				continue
			}
			if (child.type == 'list' || child.type == 'tasklist') {
				appendListNode(result, child, indent + 1, quoteDepth,
					prefix + '-item-' + index.toString() + '-nested-' + childIndex.toString(), isDone)
				continue
			}
			if (isBlockNode(child.type)) {
				appendAstNode(result, child, indent, quoteDepth,
					prefix + '-item-' + index.toString() + '-child-' + childIndex.toString(), isDone)
				continue
			}
			inlineFallback.push(child)
		}
		if (!hasTextBlock && inlineFallback.length > 0) {
			appendInlineBlock(result, 'list', prefix + '-item-' + index.toString(),
				inlineFallback, 0, indent, marker, quoteDepth)
		}
	}
}

function appendAstNode(result: MarkdownTextRenderBlock[], node: MarkdownAstNode,
	indent: number, quoteDepth: number, key: string, isDone: boolean) {
	if (node.type == 'heading') {
		const level = Math.max(1, Math.min(node.level ?? 1, 6))
		appendInlineBlock(result, 'heading', key, nodeChildren(node), level, indent, '', quoteDepth)
		return
	}
	if (node.type == 'paragraph' || node.type == 'text') {
		const nodes = node.type == 'paragraph' ? nodeChildren(node) : [node] as MarkdownAstNode[]
		appendInlineBlock(result, 'paragraph', key, nodes, 0, indent, '', quoteDepth)
		return
	}
	if (node.type == 'block_quote') {
		const children = nodeChildren(node)
		if (children.length == 0) {
			const text = inlineNodeText(node)
			if (text.length > 0) appendInlineBlock(result, 'paragraph', key,
				[textAstNode(text)], 0, indent, '', quoteDepth + 1)
			return
		}
		for (let index = 0; index < children.length; index++) {
			appendAstNode(result, children[index], indent, quoteDepth + 1,
				key + '-quote-' + index.toString(), isDone)
		}
		return
	}
	if (node.type == 'list' || node.type == 'tasklist') {
		appendListNode(result, node, indent, quoteDepth, key, isDone)
		return
	}
	if (node.type == 'thematic_break') {
		result.push(createTextBlock('hr', key, emptySpans(), 0, indent, '', quoteDepth))
		return
	}
	if (node.type == 'code_block') {
		appendCodeBlock(result, node, key, isDone)
		return
	}
	if (node.type == 'table') {
		appendTableBlock(result, node, key)
		return
	}
	if (node.type == 'html_block') {
		const text = htmlToPlainText(node.literal ?? '')
		if (text.length > 0) {
			const level = htmlHeadingLevel(node.literal ?? '')
			result.push(createTextBlock(level > 0 ? 'heading' : 'paragraph',
				key, [makeSpan(text)] as MarkdownTextSpan[], level, indent, '', quoteDepth))
		}
		return
	}
	const children = nodeChildren(node)
	if (children.length > 0) {
		let hasBlockChild = false
		for (let index = 0; index < children.length; index++) {
			if (isBlockNode(children[index].type)) {
				hasBlockChild = true
				break
			}
		}
		if (hasBlockChild) {
			for (let index = 0; index < children.length; index++) {
				appendAstNode(result, children[index], indent, quoteDepth,
					key + '-' + index.toString(), isDone)
			}
		} else {
			appendInlineBlock(result, 'paragraph', key, [node],
				0, indent, '', quoteDepth)
		}
		return
	}
	const text = node.literal ?? ''
	if (text.length > 0) {
		appendInlineBlock(result, 'paragraph', key,
			[textAstNode(text)], 0, indent, '', quoteDepth)
	}
}

function copySpecialBlock(block: MarkdownRenderBlock): MarkdownTextRenderBlock {
	return createSpecialBlock(block.kind, block.key, block.html, block.text, block.language,
		block.isComplete, block.columnWidths, block.rowTextWidths)
}

function legacyHtmlBlockToText(block: MarkdownHtmlBlock): MarkdownTextRenderBlock {
	const source = block.kind == 'text' ? block.text : block.html
	const text = htmlToPlainText(source)
	const level = htmlHeadingLevel(source)
	const quoteDepth = block.kind == 'quote' ? 1 : 0
	const kind = level > 0 ? 'heading' : block.kind == 'math' ? 'math' : 'paragraph'
	const renderBlock = createTextBlock(kind, block.key, [makeSpan(text,
		kind == 'math' ? ['math'] as string[] : [] as string[])] as MarkdownTextSpan[],
		level, 0, '', quoteDepth)
	renderBlock.text = block.text
	renderBlock.language = block.language
	renderBlock.isComplete = block.isComplete
	return renderBlock
}

function libmarkSpanToTextSpan(span: LibmarkTextSpan): MarkdownTextSpan {
	return makeSpan(span.text, span.styles, span.href, span.isImage, span.imageSrc,
		span.svgSource, span.svgWidth, span.svgHeight, span.svgBaseline)
}

function libmarkBlockComplete(block: LibmarkRenderBlock, isDone: boolean): boolean {
	return isDone ? true : block.isComplete
}

function libmarkTextBlock(block: LibmarkRenderBlock, isDone: boolean): MarkdownTextRenderBlock {
	const spans = [] as MarkdownTextSpan[]
	if (block.kind != 'math') {
		for (let spanIndex = 0; spanIndex < block.spans.length; spanIndex++) {
			spans.push(libmarkSpanToTextSpan(block.spans[spanIndex]))
		}
	}
	const result = createTextBlock(block.kind, block.key, spans, block.level, block.indent,
		block.marker, block.quoteDepth)
	result.text = block.text
	result.language = block.language
	result.isComplete = libmarkBlockComplete(block, isDone)
	result.svgSource = block.svgSource
	result.svgWidth = block.svgWidth
	result.svgHeight = block.svgHeight
	return result
}

function libmarkSpecialBlock(block: LibmarkRenderBlock, isDone: boolean): MarkdownTextRenderBlock {
	const result = createSpecialBlock(block.kind, block.key, block.html, block.text, block.language,
		libmarkBlockComplete(block, isDone), block.columnWidths, block.rowTextWidths)
	result.indent = block.indent
	result.marker = block.marker
	result.quoteDepth = block.quoteDepth
	result.level = block.level
	result.svgSource = block.svgSource
	result.svgWidth = block.svgWidth
	result.svgHeight = block.svgHeight
	return result
}

export function libmarkRenderBlocksToTextBlocks(blocks: LibmarkRenderBlock[],
	isDone: boolean = false): MarkdownTextRenderBlock[] {
	const result = [] as MarkdownTextRenderBlock[]
	for (let index = 0; index < blocks.length; index++) {
		const block = blocks[index]
		if (block.kind == 'table' || block.kind == 'code' || block.kind == 'mermaid') {
			result.push(libmarkSpecialBlock(block, isDone))
		} else {
			result.push(libmarkTextBlock(block, isDone))
		}
	}
	return result
}

export function markdownRenderBlocksToTextBlocks(blocks: MarkdownRenderBlock[],
	isDone: boolean = false): MarkdownTextRenderBlock[] {
	const result = [] as MarkdownTextRenderBlock[]
	for (let index = 0; index < blocks.length; index++) {
		const block = blocks[index]
		if (block.kind == 'table' || block.kind == 'code' || block.kind == 'mermaid') {
			result.push(copySpecialBlock(block))
			continue
		}
		if (block.kind == 'math') {
			const mathBlock = createTextBlock('math', block.key,
				[makeSpan(block.text, ['math'])] as MarkdownTextSpan[])
			mathBlock.text = block.text
			mathBlock.isComplete = block.isComplete
			result.push(mathBlock)
			continue
		}
		if (block.nodes.length > 0) {
			for (let nodeIndex = 0; nodeIndex < block.nodes.length; nodeIndex++) {
				appendAstNode(result, block.nodes[nodeIndex], 0, 0,
					block.key + '-node-' + nodeIndex.toString(), isDone)
			}
			continue
		}
		if (block.html.length > 0 || block.text.length > 0) {
			result.push(legacyHtmlBlockToText(htmlBlockFromRenderBlock(block)))
		}
	}
	return result
}

export function markdownHtmlBlocksToTextBlocks(blocks: MarkdownHtmlBlock[]): MarkdownTextRenderBlock[] {
	const result = [] as MarkdownTextRenderBlock[]
	for (let index = 0; index < blocks.length; index++) {
		const block = blocks[index]
		if (block.kind == 'table' || block.kind == 'code' || block.kind == 'mermaid') {
			result.push(createSpecialBlock(block.kind, block.key, block.html, block.text,
				block.language, block.isComplete, block.columnWidths, block.rowTextWidths))
			continue
		}
		result.push(legacyHtmlBlockToText(block))
	}
	return result
}

export function plainMarkdownTextBlock(text: string, key: string = 'plain'): MarkdownTextRenderBlock {
	return createTextBlock('paragraph', key, [makeSpan(text)] as MarkdownTextSpan[])
}

export function markdownHtmlTextBlock(html: string, key: string,
	quoteDepth: number = 0): MarkdownTextRenderBlock {
	const text = htmlToPlainText(html)
	return createTextBlock('paragraph', key, [makeSpan(text)] as MarkdownTextSpan[],
		0, 0, '', quoteDepth)
}
