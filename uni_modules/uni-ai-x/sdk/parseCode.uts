const grammarList = ['javascript', 'python', 'typescript', 'javascriptReact', 'html', 'css', 'cpp', 'dart', 'go', 'java', 'lua', 'php', 'r', 'sql', 'json', 'jsonc', 'jsonl', 'c', 'cuda-cpp', 'xml', 'xsl']
// Import all grammar files - start
// #ifndef APP-ANDROID || APP-HARMONY
import javascriptGrammar from '@/uni_modules/uni-highlight/static/grammar/javascript.tmLanguage.json'
import pythonGrammar from '@/uni_modules/uni-highlight/static/grammar/python.tmLanguage.json'
import javascriptReactGrammar from '@/uni_modules/uni-highlight/static/grammar/Javascript-react.tmLanguage.json'
import typescriptGrammar from '@/uni_modules/uni-highlight/static/grammar/typescript.tmLanguage.json'
import htmlGrammar from '@/uni_modules/uni-highlight/static/grammar/html.tmLanguage.json'
import cssGrammar from '@/uni_modules/uni-highlight/static/grammar/css.tmLanguage.json'
import cppGrammar from '@/uni_modules/uni-highlight/static/grammar/cpp.tmLanguage.json'
import dartGrammar from '@/uni_modules/uni-highlight/static/grammar/dart.tmLanguage.json'
import goGrammar from '@/uni_modules/uni-highlight/static/grammar/go.tmLanguage.json'
import javaGrammar from '@/uni_modules/uni-highlight/static/grammar/java.tmLanguage.json'
import luaGrammar from '@/uni_modules/uni-highlight/static/grammar/lua.tmLanguage.json'
import phpGrammar from '@/uni_modules/uni-highlight/static/grammar/php.tmLanguage.json'
import rGrammar from '@/uni_modules/uni-highlight/static/grammar/r.tmLanguage.json'
import sqlGrammar from '@/uni_modules/uni-highlight/static/grammar/sql.tmLanguage.json'
import jsonGrammar from '@/uni_modules/uni-highlight/static/grammar/json.tmLanguage.json'
import jsoncGrammar from '@/uni_modules/uni-highlight/static/grammar/jsonc.tmLanguage.json'
import jsonlGrammar from '@/uni_modules/uni-highlight/static/grammar/jsonl.tmLanguage.json'
import cGrammar from '@/uni_modules/uni-highlight/static/grammar/c.tmLanguage.json'
import cudaCppGrammar from '@/uni_modules/uni-highlight/static/grammar/cuda-cpp.tmLanguage.json'
import xmlGrammar from '@/uni_modules/uni-highlight/static/grammar/xml.tmLanguage.json'
import xslGrammar from '@/uni_modules/uni-highlight/static/grammar/xsl.tmLanguage.json'
// #endif
// Import all grammar files - end
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'

import { CreateHighLighter, HighLighterOptions, ILineTokens } from "@/uni_modules/uni-highlight"
import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
export { MarkdownToken }
export type ParseCodeTextRes = {
	lines: MarkdownToken[][],
	language: string,
	error: string | null
}
export type ParseCodeTextCallBack = (parseCodeTextRes: ParseCodeTextRes) => void
type TmlFile = {
	scopeName : string,
	path : string
}
let uniCodeHighlighter = null as CreateHighLighter | null

function scopeClassName(scopes: string[] | null): string {
	if (scopes == null) return ''
	const recognized = ['comment', 'string', 'constant', 'keyword', 'storage', 'function', 'variable', 'entity', 'support', 'meta', 'punctuation']
	for (let scopeIndex = scopes.length - 1; scopeIndex >= 0; scopeIndex--) {
		const parts = scopes[scopeIndex].split('.')
		for (let partIndex = parts.length - 1; partIndex >= 0; partIndex--) {
			if (recognized.includes(parts[partIndex])) return parts[partIndex]
		}
	}
	return ''
}

function getTmlFile(filePaths: TmlFile[]) {
	let fileManager = uni.getFileSystemManager()
	let res = {}
	try {
		filePaths.forEach(item => {
			let content = fileManager.readFileSync(item.path, 'utf-8') as string
			res[item.scopeName] = JSON.parse(content)
		})
	} catch (err) {
		console.error('读取tml文件失败，请检查文件是否存在', err, filePaths)
		uni.showToast({
			title: '读取tml文件失败，请检查文件是否存在',
			icon: 'none'
		})
	}
	return res
}

function initUniCodeHighlighter(callBack: () => void){
	if (uniCodeHighlighter == null) {
		// #ifndef APP-ANDROID || APP-HARMONY
		// 根据 grammarList 生成tmls
		const tmls = {
			javascript: javascriptGrammar,
			python: pythonGrammar,
			typescript: typescriptGrammar,
			javascriptReact: javascriptReactGrammar,
			html: htmlGrammar,
			css: cssGrammar,
			cpp: cppGrammar,
			dart: dartGrammar,
			go: goGrammar,
			java: javaGrammar,
			lua: luaGrammar,
			php: phpGrammar,
			r: rGrammar,
			sql: sqlGrammar,
			json: jsonGrammar,
			jsonc: jsoncGrammar,
			jsonl: jsonlGrammar,
			c: cGrammar,
			"cuda-cpp": cudaCppGrammar,
			xml: xmlGrammar,
			xsl: xslGrammar
		}
		// #endif
		// #ifdef APP-ANDROID || APP-HARMONY
		const tmlsList = [] as TmlFile[]
		grammarList.forEach(item => {
			tmlsList.push({
				scopeName: item,
				path: `/uni_modules/uni-highlight/static/grammar/${item == 'javascriptReact' ? 'Javascript-react' : item}.tmLanguage.json`
			})
		})
		const tmls = getTmlFile(tmlsList)
		// #endif
		uniCodeHighlighter = new CreateHighLighter({ languages: tmls } as HighLighterOptions)
		callBack()
	} else {
		callBack()
	}
}

export function parseCodeText(parseCodeTextCallBack: ParseCodeTextCallBack, codeSource: string, language: string) {
	if (language == 'js') language = "javascript"
	try {
		// 判断这个language是否在支持的列表中
		if (!grammarList.includes(language)) {
			// console.error('不支持解析的语言类型',language,'仅支持',grammarList.join(','))
			const res: ParseCodeTextRes = {
				lines: [],
				language: language,
				error: '不支持解析的语言类型'
			}
			parseCodeTextCallBack(res)
			return
		}
		initUniCodeHighlighter(() => {
			uniCodeHighlighter!.tokenizeFullText(language, codeSource).then((lineTokens: ILineTokens[]) => {
				utils.runOnDispatcher("io", () => {
					const sourceLines = codeSource.split('\n')
					const parsedLines = [] as MarkdownToken[][]
					for (let lineIndex = 0; lineIndex < sourceLines.length; lineIndex++) {
						const sourceLine = sourceLines[lineIndex]
						const parsedLine = lineTokens[lineIndex]
						const tokens = [] as MarkdownToken[]
						parsedLine?.tokens.forEach((tk) => {
							const start = Math.max(0, Math.min(tk.startIndex, sourceLine.length))
							const end = Math.max(start, Math.min(tk.endIndex, sourceLine.length))
							if (start == end) return
							tokens.push({
								text: sourceLine.substring(start, end),
								className: scopeClassName(tk.scopes ?? null)
							})
						})
						parsedLines.push(tokens)
					}
					const res: ParseCodeTextRes = {
						lines: parsedLines,
						language: language,
						error: null
					}
					utils.runOnDispatcher('main', () => {
						parseCodeTextCallBack(res)
					})
				});
			}).catch((error: any) => {
				const res = { lines: [], language: language, error: error.message } as ParseCodeTextRes
				utils.runOnDispatcher('main', () => {
					parseCodeTextCallBack(res)
				})
			})
		})
	} catch (error) {
		const res: ParseCodeTextRes = {
			lines: [],
			language: language,
			// #ifdef WEB
			error: (error as any).message
			// #endif
			// #ifndef WEB
			error: error.message
			// #endif
		}
		parseCodeTextCallBack(res)
	}
}
