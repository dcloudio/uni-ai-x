const grammarList = ['javascript', 'python', 'typescript', 'javascriptReact', 'html', 'css', 'cpp', 'dart', 'go', 'java', 'lua', 'php', 'r', 'sql', 'json', 'jsonc', 'jsonl', 'c', 'cuda-cpp', 'xml', 'xsl']
// Import all grammar files - start
// #ifndef APP-ANDROID || APP-HARMONY
import javascriptGrammar from '@/uni_modules/uni-highlight/static/grammar/javascript.tmLanguage.json'
import pythonGrammar from '@/uni_modules/uni-highlight/static/grammar/python.tmLanguage.json'
import javascriptReactGrammar from '@/uni_modules/uni-highlight/static/grammar/Javascript-react.tmLanguage.json'
import typescriptGrammar from '@/uni_modules/uni-highlight/static/grammar/typescript.tmLanguage.json'
import htmlGrammar from '@/uni_modules/uni-highlight/static/grammar/html.tmLanguage.json'
import cssGrammar from '@/uni_modules/uni-highlight/static/grammar/css.tmLanguage.json'
import cppGrammar from '@/uni_modules/uni-highlight/static/grammar/cpp.tmLanguage.json'
import dartGrammar from '@/uni_modules/uni-highlight/static/grammar/dart.tmLanguage.json'
import goGrammar from '@/uni_modules/uni-highlight/static/grammar/go.tmLanguage.json'
import javaGrammar from '@/uni_modules/uni-highlight/static/grammar/java.tmLanguage.json'
import luaGrammar from '@/uni_modules/uni-highlight/static/grammar/lua.tmLanguage.json'
import phpGrammar from '@/uni_modules/uni-highlight/static/grammar/php.tmLanguage.json'
import rGrammar from '@/uni_modules/uni-highlight/static/grammar/r.tmLanguage.json'
import sqlGrammar from '@/uni_modules/uni-highlight/static/grammar/sql.tmLanguage.json'
import jsonGrammar from '@/uni_modules/uni-highlight/static/grammar/json.tmLanguage.json'
import jsoncGrammar from '@/uni_modules/uni-highlight/static/grammar/jsonc.tmLanguage.json'
import jsonlGrammar from '@/uni_modules/uni-highlight/static/grammar/jsonl.tmLanguage.json'
import cGrammar from '@/uni_modules/uni-highlight/static/grammar/c.tmLanguage.json'
import cudaCppGrammar from '@/uni_modules/uni-highlight/static/grammar/cuda-cpp.tmLanguage.json'
import xmlGrammar from '@/uni_modules/uni-highlight/static/grammar/xml.tmLanguage.json'
import xslGrammar from '@/uni_modules/uni-highlight/static/grammar/xsl.tmLanguage.json'
// #endif
// Import all grammar files - end
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'

// #ifdef APP
import { CreateHighLighter } from "@/uni_modules/uni-highlight"
// #endif
// #ifndef APP
import { createHighLighter } from "@/uni_modules/uni-highlight"
// #endif
import { CreateHighLighterRes, ILineTokens } from '@/uni_modules/uni-highlight/utssdk/interface.uts'
import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import { measureCodePerformance } from '@/uni_modules/uni-ai-x/sdk/code-performance.uts'
export { MarkdownToken }
export type ParseCodeTextRes = {
	lines: MarkdownToken[][],
	language: string,
	error: string | null
}
export type ParseCodeTextCallBack = (parseCodeTextRes: ParseCodeTextRes) => void
type TmlFile = {
	scopeName : string,
	path : string
}
// #ifdef APP
let uniCodeHighlighter = null as CreateHighLighter | null
// #endif
// #ifndef APP
let uniCodeHighlighter = null as CreateHighLighterRes | null
let highlighterInitialization = null as Promise<CreateHighLighterRes> | null
// #endif
const completedCodeCache = new Map<string, MarkdownToken[][]>()
const pendingCodeCache = new Map<string, ParseCodeTextCallBack[]>()
const codeCacheOrder = [] as string[]
const maxCodeCacheEntries = 256

type CodeHighlightSession = {
	messageId: string
	id: string
	source: string[]
	lines: MarkdownToken[][]
	tail: Promise<void>
	released: boolean
}
const highlightSessions = new Map<string, CodeHighlightSession>()
let highlightSessionSequence = 0

function disposeHighlightSession(session: CodeHighlightSession) {
	session.released = true
	session.tail.then(() => { uniCodeHighlighter?.releaseSession(session.id) })
}

export function releaseCodeHighlightSessions(messageId: string) {
	highlightSessions.forEach((session: CodeHighlightSession, key: string) => {
		if (session.messageId != messageId) return
		highlightSessions.delete(key)
		disposeHighlightSession(session)
	})
}

function tokensForLine(source: string, parsed: ILineTokens | null): MarkdownToken[] {
	const tokens = [] as MarkdownToken[]
	parsed?.tokens.forEach((token) => {
		const start = Math.max(0, Math.min(token.startIndex, source.length))
		const end = Math.max(start, Math.min(token.endIndex, source.length))
		if (start < end) tokens.push({ text: source.substring(start, end), className: scopeClassName(token.scopes ?? null) })
	})
	return tokens
}

function parseIncrementalCode(callback: ParseCodeTextCallBack, messageId: string, blockKey: string, source: string, language: string) {
	if (!grammarList.includes(language)) {
		callback({ lines: [], language, error: '不支持解析的语言类型' })
		return
	}
	const key = messageId + '\u001f' + blockKey + '\u001f' + language
	let session = highlightSessions.get(key)
	if (session == null) {
		highlightSessionSequence += 1
		session = { messageId, id: 'code-' + highlightSessionSequence.toString(), source: [], lines: [], tail: Promise.resolve(), released: false }
		// Bound native syntax stacks independently of the completed-result cache.
		if (highlightSessions.size >= 64) {
			let oldest = ''
			highlightSessions.forEach((_value: CodeHighlightSession, entryKey: string) => { if (oldest.length == 0) oldest = entryKey })
			const expired = highlightSessions.get(oldest)
			if (expired != null) disposeHighlightSession(expired)
			highlightSessions.delete(oldest)
		}
	}
	highlightSessions.delete(key)
	highlightSessions.set(key, session)
	const active = session
	active.tail = active.tail.then(async () => {
		if (active.released) {
			callback({ lines: [], language, error: '代码高亮会话已释放' })
			return
		}
		try {
			await new Promise<void>((resolve, reject) => initUniCodeHighlighter(resolve, (message: string) => reject(new Error(message))))
			const sourceLines = source.split('\n')
			let appendOnly = sourceLines.length >= active.source.length
			for (let i = 0; appendOnly && i < active.source.length; i++) {
				if (active.source[i] != sourceLines[i]) appendOnly = false
			}
			const start = appendOnly ? active.source.length : 0
			const added = sourceLines.slice(start)
			const parsed = added.length > 0 ? await uniCodeHighlighter!.tokenizeLines(active.id, language, added, start == 0) : [] as ILineTokens[]
			if (parsed.length != added.length) throw new Error('代码高亮返回行数不一致')
			const lines = appendOnly ? active.lines.slice() : [] as MarkdownToken[][]
			for (let i = 0; i < added.length; i++) lines.push(tokensForLine(added[i], parsed[i]))
			active.source = sourceLines
			active.lines = lines
			callback({ lines, language, error: null })
		} catch (error) {
			active.source = []
			active.lines = []
			callback({ lines: [], language, error: '代码增量高亮失败' })
		}
	})
}

function cloneCodeTokens(lines: MarkdownToken[][]): MarkdownToken[][] {
	return lines.map((line: MarkdownToken[]): MarkdownToken[] => line.map((token: MarkdownToken): MarkdownToken => {
		return { type: token.type, text: token.text, className: token.className }
	}))
}

export function makeCodeHighlightCacheKey(messageId: string, blockKey: string, language: string, codeText: string): string {
	return messageId + '\u001f' + blockKey + '\u001f' + language + '\u001f' + codeText
}

function putCodeCache(key: string, lines: MarkdownToken[][]) {
	if (!completedCodeCache.has(key)) codeCacheOrder.push(key)
	completedCodeCache.set(key, cloneCodeTokens(lines))
	while (codeCacheOrder.length > maxCodeCacheEntries) {
		const oldest = codeCacheOrder.shift()
		if (oldest != null) completedCodeCache.delete(oldest)
	}
}

export function clearCodeHighlightCache() {
	completedCodeCache.clear()
	codeCacheOrder.length = 0
	// pending 请求不主动取消，只让回调在完成后正常收敛，避免留下悬挂 Promise。
}

export function requestCachedCodeText(callback: ParseCodeTextCallBack, messageId: string, blockKey: string, codeText: string, language: string): boolean {
	const normalizedLanguage = language == 'js' ? 'javascript' : language
	const key = makeCodeHighlightCacheKey(messageId, blockKey, normalizedLanguage, codeText)
	const cached = completedCodeCache.get(key)
	if (cached != null) {
		callback({ lines: cloneCodeTokens(cached), language: normalizedLanguage, error: null })
		return true
	}
	const pending = pendingCodeCache.get(key)
	if (pending != null) {
		pending.push(callback)
		return true
	}
	pendingCodeCache.set(key, [callback] as ParseCodeTextCallBack[])
	parseIncrementalCode((result: ParseCodeTextRes) => {
		if (result.error == null) putCodeCache(key, result.lines)
		const callbacks = pendingCodeCache.get(key) ?? [] as ParseCodeTextCallBack[]
		pendingCodeCache.delete(key)
		callbacks.forEach((item: ParseCodeTextCallBack) => item({
			lines: cloneCodeTokens(result.lines), language: result.language, error: result.error
		}))
	}, messageId, blockKey, codeText, normalizedLanguage)
	return false
}

function scopeClassName(scopes: string[] | null): string {
	if (scopes == null) return ''
	const recognized = ['comment', 'string', 'constant', 'keyword', 'storage', 'function', 'variable', 'entity', 'support', 'meta', 'punctuation']
	for (let scopeIndex = scopes.length - 1; scopeIndex >= 0; scopeIndex--) {
		const parts = scopes[scopeIndex].split('.')
		for (let partIndex = parts.length - 1; partIndex >= 0; partIndex--) {
			if (recognized.includes(parts[partIndex])) return parts[partIndex]
		}
	}
	return ''
}

function getTmlFile(filePaths: TmlFile[]) {
	let fileManager = uni.getFileSystemManager()
	let res = {}
	try {
		filePaths.forEach(item => {
			let content = fileManager.readFileSync(item.path, 'utf-8') as string
			res[item.scopeName] = JSON.parse(content)
		})
	} catch (err) {
		console.error('读取tml文件失败，请检查文件是否存在', err, filePaths)
		uni.showToast({
			title: '读取tml文件失败，请检查文件是否存在',
			icon: 'none'
		})
	}
	return res
}

function initUniCodeHighlighter(callBack: () => void, onError: (message: string) => void){
	if (uniCodeHighlighter == null) {
		// #ifndef APP-ANDROID || APP-HARMONY
		// 根据 grammarList 生成tmls
		const tmls = {
			javascript: javascriptGrammar,
			python: pythonGrammar,
			typescript: typescriptGrammar,
			javascriptReact: javascriptReactGrammar,
			html: htmlGrammar,
			css: cssGrammar,
			cpp: cppGrammar,
			dart: dartGrammar,
			go: goGrammar,
			java: javaGrammar,
			lua: luaGrammar,
			php: phpGrammar,
			r: rGrammar,
			sql: sqlGrammar,
			json: jsonGrammar,
			jsonc: jsoncGrammar,
			jsonl: jsonlGrammar,
			c: cGrammar,
			"cuda-cpp": cudaCppGrammar,
			xml: xmlGrammar,
			xsl: xslGrammar
		}
		// #endif
		// #ifdef APP-ANDROID || APP-HARMONY
		const tmlsList = [] as TmlFile[]
		grammarList.forEach(item => {
			tmlsList.push({
				scopeName: item,
				path: `/uni_modules/uni-highlight/static/grammar/${item == 'javascriptReact' ? 'Javascript-react' : item}.tmLanguage.json`
			})
		})
		const tmls = getTmlFile(tmlsList)
		// #endif
		// #ifdef APP
		uniCodeHighlighter = new CreateHighLighter({ languages: tmls })
		callBack()
		// #endif
		// #ifndef APP
		if (highlighterInitialization == null) highlighterInitialization = createHighLighter({ languages: tmls })
		highlighterInitialization!.then((highlighter) => {
			uniCodeHighlighter = highlighter
			callBack()
		}).catch((error: any) => {
			highlighterInitialization = null
			onError(error.message ?? '代码高亮初始化失败')
		})
		// #endif
	} else {
		callBack()
	}
}

export function parseCodeText(parseCodeTextCallBack: ParseCodeTextCallBack, codeSource: string, language: string) {
	const startedAt = Date.now()
	if (language == 'js') language = "javascript"
	try {
		// 判断这个language是否在支持的列表中
		if (!grammarList.includes(language)) {
			// console.error('不支持解析的语言类型',language,'仅支持',grammarList.join(','))
			const res: ParseCodeTextRes = {
				lines: [],
				language: language,
				error: '不支持解析的语言类型'
			}
			measureCodePerformance('parseCodeText', startedAt, language)
			parseCodeTextCallBack(res)
			return
		}
		initUniCodeHighlighter(() => {
			uniCodeHighlighter!.tokenizeFullText(language, codeSource).then((lineTokens: ILineTokens[]) => {
				utils.runOnDispatcher("io", () => {
					const sourceLines = codeSource.split('\n')
					const parsedLines = [] as MarkdownToken[][]
					for (let lineIndex = 0; lineIndex < sourceLines.length; lineIndex++) {
						const sourceLine = sourceLines[lineIndex]
						const parsedLine = lineTokens[lineIndex]
						const tokens = [] as MarkdownToken[]
						parsedLine?.tokens.forEach((tk) => {
							const start = Math.max(0, Math.min(tk.startIndex, sourceLine.length))
							const end = Math.max(start, Math.min(tk.endIndex, sourceLine.length))
							if (start == end) return
							tokens.push({
								text: sourceLine.substring(start, end),
								className: scopeClassName(tk.scopes ?? null)
							})
						})
						parsedLines.push(tokens)
					}
					const res: ParseCodeTextRes = {
						lines: parsedLines,
						language: language,
						error: null
					}
					utils.runOnDispatcher('main', () => {
						parseCodeTextCallBack(res)
						measureCodePerformance('parseCodeText', startedAt, language)
					})
				});
			}).catch((error: any) => {
				const res: ParseCodeTextRes = { lines: [], language: language, error: error.message }
				utils.runOnDispatcher('main', () => {
					parseCodeTextCallBack(res)
					measureCodePerformance('parseCodeText', startedAt, language)
				})
			})
		}, (message: string) => {
			parseCodeTextCallBack({ lines: [], language: language, error: message })
			measureCodePerformance('parseCodeText', startedAt, language)
		})
	} catch (error) {
		const res: ParseCodeTextRes = {
			lines: [],
			language: language,
			// #ifdef WEB
			error: (error as any).message
			// #endif
			// #ifndef WEB
			error: error.message
			// #endif
		}
		parseCodeTextCallBack(res)
		measureCodePerformance('parseCodeText', startedAt, language)
	}
}
