// All mini programs use the small tokenizer by default; App and Web keep TextMate.
// Select WeChat basic: node scripts/select-mp-weixin-mode.mjs basic
// Select WeChat full TextMate: node scripts/select-mp-weixin-mode.mjs full
// The selector switches this export, the uni-highlight MP API, WASM, grammars
// and chat subpackage config. Select basic again after publishing full mode.
// #ifdef MP
// The selector enables this export together with the full MP API and WASM.
export * from './parseCode-basic.uts'
// export * from './parseCode-textmate.uts'
// #endif
// #ifndef MP
export * from './parseCode-textmate.uts'
// #endif
