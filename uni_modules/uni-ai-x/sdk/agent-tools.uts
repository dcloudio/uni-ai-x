import { llmModelMap, mcpServers } from '@/uni_modules/uni-ai-x/config.uts'
import { Chunk, ChunkToolCall, CustomProviderAdapter, CustomProviderCallbacks, CalendarToolConfirmation, RequestAiCoMessage } from '@/uni_modules/uni-ai-x/types.uts'
import { registerCustomProvider } from './provider-registry.uts'
import { SseStreamParser } from './sse.uts'
import { McpClient, McpRequestError } from './mcp-client.uts'

type ToolEntry = {
	name: string,
	description: string,
	parameters: UTSJSONObject
}

const toolRegistry: ToolEntry[] = []

type McpToolBinding = {
	client: McpClient,
	remoteName: string
}

const mcpClients = mcpServers.map((server): McpClient => new McpClient(server))

// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
toolRegistry.push({
	name: 'create_calendar_reminder',
	description: '仅当用户明确要求创建日程或提醒，且标题和开始时间明确时调用。在手机系统日历创建一次性日程。start_at 使用设备本地时间 YYYY-MM-DD HH:mm；时间不明确时先询问用户。',
	parameters: {
		type: 'object',
		properties: {
			title: { type: 'string', description: '日程标题' },
			start_at: { type: 'string', description: '设备本地开始时间，格式 YYYY-MM-DD HH:mm' },
			duration_minutes: { type: 'number', description: '持续分钟数，未指定时为 30' },
			alarm_minutes_before: { type: 'number', description: '提前提醒分钟数，未指定时为 5；0 表示开始时提醒' }
		},
		required: ['title', 'start_at']
	} as UTSJSONObject
})
// #endif

function pad2(value: number): string {
	return value < 10 ? '0' + value.toString() : value.toString()
}

function localDateTime(date: Date): string {
	return `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())} ${pad2(date.getHours())}:${pad2(date.getMinutes())}`
}

// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
function parseLocalDateTime(value: string): number {
	const parts = value.split(' ')
	if (parts.length != 2) return 0
	const day = parts[0].split('-')
	const time = parts[1].split(':')
	if (day.length != 3 || time.length != 2 || day[0].length != 4 || day[1].length != 2 || day[2].length != 2 || time[0].length != 2 || time[1].length != 2) return 0
	const year = parseInt(day[0])
	const month = parseInt(day[1])
	const dateNumber = parseInt(day[2])
	const hour = parseInt(time[0])
	const minute = parseInt(time[1])
	if (year < 2020 || year > 2100 || month < 1 || month > 12 || dateNumber < 1 || dateNumber > 31 || hour < 0 || hour > 23 || minute < 0 || minute > 59) return 0
	const date = new Date()
	date.setDate(1)
	date.setFullYear(year)
	date.setMonth(month - 1)
	date.setDate(dateNumber)
	date.setHours(hour)
	date.setMinutes(minute)
	date.setSeconds(0)
	date.setMilliseconds(0)
	return localDateTime(date) == value ? date.getTime() : 0
}

// #ifdef APP-ANDROID
function requestCalendarPermissions(): Promise<string> {
	const permissions = ['android.permission.READ_CALENDAR', 'android.permission.WRITE_CALENDAR']
	return new Promise<string>((resolve) => {
		let settled = false
		let timeout = 0
		const finish = (status: string) => {
			if (settled) return
			settled = true
			clearTimeout(timeout)
			resolve(status)
		}
		timeout = setTimeout(() => { finish('timeout') }, 90000)
		try {
			uni.requestSystemPermission({
				permissions: permissions,
				success: (result) => {
					const granted = permissions.every((permission: string): boolean => result.grantedList.includes(permission))
					finish(granted ? 'granted' : 'denied')
				},
				fail: (error) => {
					console.error('[uni-ai-x][calendar] permission fail', error.errCode, error.errMsg)
					finish('failed')
				}
			})
		} catch (error) {
			console.error('[uni-ai-x][calendar] permission exception', error)
			finish('unavailable')
		}
	})
}
// #endif

async function createCalendarReminder(args: UTSJSONObject): Promise<string> {
	const title = args['title']
	const startAt = args['start_at']
	const durationValue = args['duration_minutes']
	const alarmValue = args['alarm_minutes_before']
	if (typeof title != 'string' || title.trim().length == 0 || title.length > 100 || typeof startAt != 'string') {
		return Promise.resolve(JSON.stringify({ error: '需要 1 到 100 字的标题和明确的开始时间' }))
	}
	const startTime = parseLocalDateTime(startAt)
	if (startTime <= Date.now()) return Promise.resolve(JSON.stringify({ error: '开始时间无效或已过去，请确认设备本地时间' }))
	const duration = durationValue == null ? 30 : durationValue as number
	const alarmMinutes = alarmValue == null ? 5 : alarmValue as number
	if (typeof duration != 'number' || duration < 1 || duration > 1440 || Math.floor(duration) != duration || typeof alarmMinutes != 'number' || alarmMinutes < 0 || alarmMinutes > 10080 || Math.floor(alarmMinutes) != alarmMinutes) {
		return Promise.resolve(JSON.stringify({ error: '持续时间需为 1 到 1440 分钟，提前提醒时间需为 0 到 10080 分钟' }))
	}
	// #ifdef APP-ANDROID
	// Without permission Android opens the system editor, where some devices ignore alarmOffset.
	const permission = await requestCalendarPermissions()
	if (permission != 'granted') {
		const message = permission == 'denied' ? '请授予日历读写权限，以按指定时间创建提醒' : '当前应用无法申请日历权限，请更新应用后重试'
		return JSON.stringify({ error: message })
	}
	// #endif
	if (startTime <= Date.now()) return JSON.stringify({ error: '开始时间已过去，请重新指定提醒时间' })
	const endTime = startTime + duration * 60 * 1000
	return new Promise<string>((resolve) => {
		try {
			uni.addPhoneCalendar({
				title: title.trim(), startTime: startTime, endTime: endTime,
				alarm: true, alarmOffset: alarmMinutes * 60,
				success: (calendarResponse) => {
					const message = calendarResponse?.errMsg
					if (message == null || message.length == 0) {
						resolve(JSON.stringify({ status: 'opened' }))
						return
					}
					resolve(JSON.stringify({ success: true, title: title.trim(), start_at: startAt, duration_minutes: duration, alarm_minutes_before: alarmMinutes }))
				},
				fail: (error) => {
					if (error.errCode == 609) {
						resolve(JSON.stringify({ status: 'opened' }))
						return
					}
					resolve(JSON.stringify({ error: '系统日历创建失败', code: error.errCode, detail: error.errMsg }))
				}
			})
		} catch (error) {
			resolve(JSON.stringify({ error: '系统日历调用失败', detail: `${error}` }))
		}
	})
}
// #endif

export async function runCalendarConfirmation(details: CalendarToolConfirmation): Promise<string> {
	// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
	return await createCalendarReminder({
		title: details.title,
		start_at: details.startAt,
		duration_minutes: details.durationMinutes,
		alarm_minutes_before: details.alarmMinutesBefore
	} as UTSJSONObject)
	// #endif
	// #ifndef APP-ANDROID || APP-IOS || APP-HARMONY
	return JSON.stringify({ error: '当前平台不支持系统日历' })
	// #endif
}

function toolDefinitions(): UTSJSONObject[] {
	return toolRegistry.map((tool): UTSJSONObject => ({
		type: 'function',
		function: {
			name: tool.name,
			description: tool.description,
			parameters: tool.parameters
		}
	} as UTSJSONObject))
}

function requestModel(url: string, token: string, data: UTSJSONObject, callbacks: CustomProviderCallbacks): Promise<UTSJSONObject> {
	return new Promise<UTSJSONObject>((resolve, reject) => {
		const startedAt = Date.now()
		console.log('[uni-ai-x][model] request', JSON.stringify({ url: url, model: data['model'], messageCount: (data['messages'] as UTSJSONObject[]).length, toolChoice: data['tool_choice'] }))
		let settled = false
		let chunkReceived = false
		let content = ''
		const calls = new Map<number, UTSJSONObject>()
		const parser = new SseStreamParser((chunk: Chunk) => {
			if (settled) return
			const delta = chunk.choices?.[0]?.delta
			if (delta == null) return
			const text = delta.content ?? ''
			if (text.length > 0) content += text
			if (text.length > 0 || (delta.reasoning_content ?? '').length > 0) callbacks.onChunk?.(chunk)
			const fragments = delta.tool_calls ?? [] as ChunkToolCall[]
			fragments.forEach((fragment: ChunkToolCall) => {
				const index = fragment.index
				const call = calls.get(index) ?? { id: '', type: 'function', function: { name: '', arguments: '' } } as UTSJSONObject
				if (fragment.id != null) call['id'] = fragment.id
				if (fragment.type != null) call['type'] = fragment.type
				const fn = call['function'] as UTSJSONObject
				if (fragment.function?.name != null) fn['name'] = (fn['name'] as string) + fragment.function!.name!
				if (fragment.function?.arguments != null) fn['arguments'] = (fn['arguments'] as string) + fragment.function!.arguments!
				calls.set(index, call)
			})
		}, (error: UTSJSONObject) => {
			if (settled) return
			settled = true
			reject(new Error((error['message'] as string | null) ?? '模型流式响应失败'))
		}, () => {
			if (settled) return
			settled = true
			const toolCalls: UTSJSONObject[] = []
			Array.from(calls.keys()).sort((a, b) => a - b).forEach((index: number) => {
				const call = calls.get(index)!
				if ((call['id'] as string).length == 0) {
					call['id'] = `call_${Date.now()}_${index}_${Math.floor(Math.random() * 1000000)}`
					console.warn('[uni-ai-x][tools] model omitted tool call id', JSON.stringify({ index: index, name: (call['function'] as UTSJSONObject)['name'], generatedId: call['id'] }))
				}
				toolCalls.push(call)
			})
			resolve({ choices: [{ message: { role: 'assistant', content: content, tool_calls: toolCalls } }] } as UTSJSONObject)
		})
		const task = uni.request({
			url: url,
			method: 'POST',
			dataType: 'text',
			// @ts-ignore enableChunked is available on Web and App request tasks.
			enableChunked: true,
			timeout: 90000,
			data: data,
			header: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
			success: (response: RequestSuccess<any>) => {
				const responseText = typeof response.data == 'string' ? response.data as string : ''
				const errorBody = response.statusCode >= 400 ? (responseText.length > 0 ? responseText : JSON.stringify(response.data)) : ''
				console.log('[uni-ai-x][model] response', JSON.stringify({ url: url, model: data['model'], status: response.statusCode, durationMs: Date.now() - startedAt, responseBody: errorBody }))
				if (response.statusCode < 200 || response.statusCode >= 300) {
					if (!settled) {
						settled = true
						reject(new Error('模型请求失败（HTTP ' + response.statusCode.toString() + '）'))
					}
					return
				}
					if (!chunkReceived && responseText.length > 0) parser.pushText(responseText)
				parser.finish()
			},
			fail: (error: RequestFail) => {
				console.error('[uni-ai-x][model] network failure', JSON.stringify({ url: url, model: data['model'], durationMs: Date.now() - startedAt, error: error.errMsg }))
				if (settled) return
				settled = true
				reject(new Error(error.errMsg))
			}
		})
		// @ts-ignore
		task.onChunkReceived((chunk: RequestTaskOnChunkReceivedListenerResult) => {
			chunkReceived = true
			parser.push(chunk.data)
		})
	})
}

function weatherExhaustedError(reason: string): string {
	return `天气查询工具连续三次调用失败。${reason}。请点击重试。`
}
async function executeMcpTool(binding: McpToolBinding, argumentText: string, callbacks: CustomProviderCallbacks): Promise<string> {
	const isWeather = binding.client.config.id == 'weather'
	const source = isWeather ? '天气查询工具' : 'MCP 工具'
	const step = isWeather
		? (binding.remoteName == 'openmeteo_search_locations' || binding.remoteName == 'geocode_location' ? '查找城市坐标' : '获取实时天气')
		: binding.remoteName
	let args: UTSJSONObject
	try {
		args = JSON.parse<UTSJSONObject>(argumentText.trim().length == 0 ? '{}' : argumentText) as UTSJSONObject
	} catch (_error) {
		callbacks.onToolStatus?.(`${source} · ${step} · 参数无效，等待模型修正`)
		return JSON.stringify({ isError: true, error: 'MCP 工具参数不是有效 JSON，请修正后重试调用' })
	}
	if (args == null || typeof args != 'object') {
		callbacks.onToolStatus?.(`${source} · ${step} · 参数无效，等待模型修正`)
		return JSON.stringify({ isError: true, error: 'MCP 工具参数必须是对象，请修正后重试调用' })
	}
	let lastError = ''
	for (let attempt = 1; attempt <= 3; attempt++) {
		try {
			if (attempt == 1) callbacks.onToolStatus?.(`${source} · ${step} · ${isWeather ? '正在查询' : '正在调用'}`)
			console.log('[uni-ai-x][mcp] tool call', JSON.stringify({ server: binding.client.config.id, url: binding.client.config.url, tool: binding.remoteName, attempt: attempt, arguments: args }))
			const result = await binding.client.callTool(binding.remoteName, args)
			console.log('[uni-ai-x][mcp] tool result', JSON.stringify({ server: binding.client.config.id, tool: binding.remoteName, result: result }))
			if (binding.client.config.id == 'weather') {
				const structured = result['structuredContent'] as UTSJSONObject | null
				const toolError = structured?.['error'] as UTSJSONObject | null
				const rateLimited = (toolError?.['data'] as UTSJSONObject | null)?.['reason'] == 'rate_limited'
				if (result['isError'] == true && (toolError?.['retryable'] == true || rateLimited)) {
					throw new McpRequestError((toolError?.['message'] as string | null) ?? '远程天气服务暂时不可用', true, rateLimited ? 5000 : 0)
				}
				const content = result['content'] as UTSJSONObject[] | null
				const hasText = content?.some((item: UTSJSONObject): boolean => (item['type'] as string | null) == 'text' && ((item['text'] as string | null) ?? '').trim().length > 0) == true
				const current = structured?.['current'] as UTSJSONObject | null
				const hourly = structured?.['hourly'] as UTSJSONObject | null
				const daily = structured?.['daily'] as UTSJSONObject | null
				const emptyForecast = binding.remoteName == 'openmeteo_get_forecast' && structured != null
					&& (current == null || Object.keys(current).length == 0)
					&& (hourly == null || Object.keys(hourly).length == 0)
					&& (daily == null || Object.keys(daily).length == 0)
				if (result['isError'] != true && (emptyForecast || ((structured == null || Object.keys(structured).length == 0) && !hasText))) {
					throw new McpRequestError('远程天气工具返回空结果', true)
				}
			}
			callbacks.onToolStatus?.(`${source} · ${step} · ${result['isError'] == true ? '工具返回错误，等待模型处理' : (isWeather && step == '获取实时天气' ? '天气数据已获取，正在生成回答' : '查询完成，正在准备下一步')}`)
			return JSON.stringify(result)
		} catch (error) {
			lastError = `${error}`
			console.error('[uni-ai-x][mcp] tool request failed', JSON.stringify({ server: binding.client.config.id, url: binding.client.config.url, tool: binding.remoteName, attempt: attempt, arguments: args, error: lastError }))
			if (!(error instanceof McpRequestError) || !error.retryable) throw error
			if (attempt < 3) {
				callbacks.onToolStatus?.(`${source} · ${step} · ${attempt == 1 ? '首次调用失败，正在第 1 次重试' : '再次调用失败，正在第 2 次重试'}`)
				const delayMs = Math.max(error.delayMs, attempt * 400)
				await new Promise<void>((resolve) => { setTimeout(resolve, delayMs) })
			}
		}
	}
	if (binding.client.config.id == 'weather') throw new Error(weatherExhaustedError(lastError))
	throw new Error(`MCP 工具连续三次调用失败：${binding.client.config.id}/${binding.remoteName}。${lastError}`)
}

async function listMcpTools(client: McpClient, callbacks: CustomProviderCallbacks): Promise<UTSJSONObject[]> {
	let lastError = ''
	const needsConnection = !client.hasCachedTools()
	for (let attempt = 1; attempt <= 3; attempt++) {
		try {
			if (attempt == 1 && needsConnection) callbacks.onToolStatus?.(client.config.id == 'weather' ? '天气查询工具 · 连接天气服务 · 正在连接' : 'MCP 服务 · 连接服务 · 正在连接')
			const tools = await client.listTools()
			if (needsConnection) callbacks.onToolStatus?.(client.config.id == 'weather' ? '天气查询工具 · 确定查询步骤 · 服务已连接，正在等待模型选择工具' : 'MCP 服务 · 确定下一步 · 工具已就绪，正在等待模型选择')
			return tools
		} catch (error) {
			lastError = `${error}`
			console.error('[uni-ai-x][mcp] discovery failed', JSON.stringify({ server: client.config.id, url: client.config.url, attempt: attempt, error: lastError }))
			if (!(error instanceof McpRequestError) || !error.retryable) throw error
			if (attempt < 3) {
				callbacks.onToolStatus?.(client.config.id == 'weather'
					? `天气查询工具 · 连接天气服务 · ${attempt == 1 ? '首次连接失败，正在第 1 次重试' : '再次连接失败，正在第 2 次重试'}`
					: `MCP 服务 · 连接服务 · ${attempt == 1 ? '首次连接失败，正在第 1 次重试' : '再次连接失败，正在第 2 次重试'}`)
				const delayMs = Math.max(error.delayMs, attempt * 400)
				await new Promise<void>((resolve) => { setTimeout(resolve, delayMs) })
			}
		}
	}
	throw new Error(`MCP 服务连续三次连接失败：${client.config.id}。${lastError}。请点击重试。`)
}

// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
function calendarConfirmation(argumentText: string): CalendarToolConfirmation | null {
	try {
		const args = JSON.parse<UTSJSONObject>(argumentText) as UTSJSONObject
		const title = args['title']
		const startAt = args['start_at']
		if (typeof title != 'string' || title.trim().length == 0 || title.length > 100 || typeof startAt != 'string' || parseLocalDateTime(startAt) <= Date.now()) return null
		const duration = args['duration_minutes'] == null ? 30 : args['duration_minutes'] as number
		const alarm = args['alarm_minutes_before'] == null ? 5 : args['alarm_minutes_before'] as number
		if (typeof duration != 'number' || duration < 1 || duration > 1440 || Math.floor(duration) != duration || typeof alarm != 'number' || alarm < 0 || alarm > 10080 || Math.floor(alarm) != alarm) return null
		return { title: title.trim(), startAt: startAt, durationMinutes: duration, alarmMinutesBefore: alarm, state: 'pending' } as CalendarToolConfirmation
	} catch (_error) {
		return null
	}
}
// #endif

class QiniuToolAdapter extends CustomProviderAdapter {
	override supportsTitleUpdate: boolean = false

	override async request(messages: RequestAiCoMessage[], model: string, _chatId: string, callbacks: CustomProviderCallbacks, thinking?: boolean): Promise<boolean> {
		const provider = llmModelMap.get('qiniu')
		if (provider == null || provider.baseURL == null || provider.getToken == null) {
			callbacks.onError?.({ errMsg: '七牛模型未配置' })
			return false
		}
		try {
			const token = await provider.getToken!()
			const history = JSON.parse<UTSJSONObject[]>(JSON.stringify(messages)) as UTSJSONObject[]
			const now = new Date()
			const modelConfig = provider.models.find((entry) => entry.modelId == model)
			const tools = modelConfig?.toolCall == true ? toolDefinitions() : [] as UTSJSONObject[]
			const mcpBindings = new Map<string, McpToolBinding>()
			let mcpStatusActive = false
			if (modelConfig?.toolCall == true) {
				for (let serverIndex = 0; serverIndex < mcpClients.length; serverIndex++) {
					const client = mcpClients[serverIndex]
					if (!client.hasCachedTools()) mcpStatusActive = true
					const remoteTools = await listMcpTools(client, callbacks)
					let enabledCount = 0
					remoteTools.forEach((remoteTool: UTSJSONObject) => {
						const remoteName = remoteTool['name'] as string
						if (client.config.tools != null && !client.config.tools!.includes(remoteName)) return
						const name = client.config.id + '__' + remoteName
						const schema = remoteTool['inputSchema'] as UTSJSONObject | null
						if (schema == null || mcpBindings.has(name)) throw new Error('MCP 工具定义无效：' + name)
						tools.push({ type: 'function', function: { name: name, description: remoteTool['description'] ?? '', parameters: schema } } as UTSJSONObject)
						mcpBindings.set(name, { client: client, remoteName: remoteName })
						enabledCount += 1
					})
					if (enabledCount == 0) throw new Error('MCP 服务没有提供已配置的工具：' + client.config.id)
				}
			}
			const systemContent = tools.length > 0
				? `当前设备本地时间：${localDateTime(now)}。相对时间按此时间计算。请识别用户消息中的全部需求，并根据工具说明自行决定是否调用。用户没有要求天气时不要主动提及天气；城市不明确时先询问。工具返回参数或地名错误时，若用户已提供明确城市，请修正参数后重新调用；否则请向用户询问，不要猜测城市。天气回答必须依据工具返回的有效数据；工具报错或没有数据时，不得声称已查到天气。日程标题或开始时间不明确时先询问，不要调用日历工具。需要的工具尽量在同一轮全部调用。create_calendar_reminder 只是本地操作意图，工具返回 pending 表示尚未打开系统日历。收到 pending 后，继续调用尚未执行的远程工具；最终只回答已完成的其他需求，不要说日历已打开、已创建或解释待确认状态。日历确认卡片由应用展示，用户选择后应用会另行显示简短结果。`
				: `当前设备本地时间：${localDateTime(now)}。相对时间按此时间计算。`
			history.unshift({ role: 'system', content: systemContent } as UTSJSONObject)
			let calendarCalled = false
			let remoteCalled = false
			let pendingCalendar: CalendarToolConfirmation | null = null
			for (let round = 0; round < 5; round++) {
				const body: UTSJSONObject = {
					model: model, messages: history, stream: true
				} as UTSJSONObject
				if (tools.length > 0) {
					body['tools'] = calendarCalled ? tools.filter((tool) => ((tool['function'] as UTSJSONObject)['name'] as string) != 'create_calendar_reminder') : tools
					body['tool_choice'] = 'auto'
				}
				if (modelConfig?.thinking == true) body['thinking'] = { type: thinking == false ? 'disabled' : 'enabled' }
				const response = await requestModel(provider.baseURL!, token, body, callbacks)
				const choices = response['choices'] as UTSJSONObject[] | null
				const message = choices?.[0]?.['message'] as UTSJSONObject | null
				if (message == null) throw new Error('模型没有返回消息')
				const calls = message['tool_calls'] as UTSJSONObject[] | null
				if (calls == null || calls.length == 0) {
					const content = (message['content'] as string | null) ?? ''
					if (content.trim().length == 0 && pendingCalendar == null) throw new Error('模型没有生成回答。请点击重试。')
					if (pendingCalendar != null) callbacks.onToolConfirm?.(pendingCalendar!)
					if (mcpStatusActive) callbacks.onToolStatus?.('')
					callbacks.onDone?.({})
					return true
				}
				history.push(message)
				for (let index = 0; index < calls.length; index++) {
					const call = calls[index]
					const fn = call['function'] as UTSJSONObject | null
					const name = (fn?.['name'] as string | null) ?? ''
					const args = (fn?.['arguments'] as string | null) ?? '{}'
					// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
					if (name == 'create_calendar_reminder') {
						let calendarResult = JSON.stringify({ error: '日历工具本轮已调用，请勿重复执行' })
						if (!calendarCalled) {
							calendarCalled = true
							const details = calendarConfirmation(args)
							if (details == null) {
								calendarResult = JSON.stringify({ error: '日程参数无效或时间已过去，请重新确认' })
							} else {
								pendingCalendar = details
								calendarResult = JSON.stringify({ status: 'pending' })
							}
						}
						history.push({ role: 'tool', tool_call_id: call['id'], content: calendarResult } as UTSJSONObject)
						continue
					}
					// #endif
					if (mcpBindings.has(name)) {
						const binding = mcpBindings.get(name)!
						mcpStatusActive = true
						const result = await executeMcpTool(binding, args, callbacks)
						history.push({ role: 'tool', tool_call_id: call['id'], content: result } as UTSJSONObject)
						remoteCalled = true
					} else {
					history.push({ role: 'tool', tool_call_id: call['id'], content: JSON.stringify({ error: '未知工具: ' + name }) } as UTSJSONObject)
				}
				}
				if (pendingCalendar != null && !remoteCalled) {
				if (mcpStatusActive) callbacks.onToolStatus?.('')
					callbacks.onToolConfirm?.(pendingCalendar!)
					callbacks.onDone?.({})
					return true
				}
			}
			throw new Error('工具调用轮数超过上限')
		} catch (error) {
			callbacks.onError?.({ errMsg: `${error}` })
			callbacks.onToolStatus?.('')
			return false
		}
	}
}

export function installAgentTools() {
	registerCustomProvider('qiniu', new QiniuToolAdapter())
}
