import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'
import { estimateTextWidth } from '@/uni_modules/uni-ai-x/sdk/text-width.uts'

export function setApproxTableContentWidth(tableData: MarkdownToken[]) {
	for (let rowIndex = 0; rowIndex < tableData.length; rowIndex++) {
		const row = tableData[rowIndex]
		for (let cellIndex = 0; cellIndex < (row.tokens?.length ?? 0); cellIndex++) {
			const cell = row.tokens![cellIndex]
			cell.width = 0
			for (let itemIndex = 0; itemIndex < (cell.tokens?.length ?? 0); itemIndex++) {
				const cellItem = cell.tokens![itemIndex]
				const text = cellItem.text ?? utils.getTokensText(cellItem.tokens)
				const fontSize = rowIndex == 0 ? 14 : 13
				const extraWidth = cellItem.type == 'code' ? 10 : 0
				cellItem.width = estimateTextWidth(text, fontSize) + extraWidth
				cell.width = (cell.width ?? 0) + cellItem.width
			}
		}
	}
}
