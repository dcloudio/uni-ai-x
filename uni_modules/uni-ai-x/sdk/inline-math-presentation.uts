import type { MarkdownTextRenderBlock } from './markdown-text.uts'
import { prepareHarmonySvgImageSource } from './harmony-svg-workaround.uts'

// Harmony 的 rich-text 接收本地 SVG 文件路径：把 libmark 输出的公式 SVG data URL
// 落盘并把 src 替换为文件路径。Android 由 libmark 直接交付内联 <svg>，不走这里。
export function prepareNativeInlineMathBlocks(messageId: string, blocks: MarkdownTextRenderBlock[], theme: string, changed: () => void) {
	// #ifdef APP-HARMONY
	for (let index = 0; index < blocks.length; index++) {
		const block = blocks[index]
		if (block.kind != 'html' && block.kind != 'table') continue
		const tags = block.html.match(/<img\b[^>]*>/g) ?? [] as string[]
		for (const tag of tags) {
			if (!/class="[^"]*\bmath\b[^"]*"/.test(tag)) continue
			const match = tag.match(/src="(data:image\/svg\+xml;base64,[A-Za-z0-9+/=\r\n]+)"/)
			if (match == null) continue
			const source = match[1] ?? ''
			if (source.length == 0) continue
			prepareHarmonySvgImageSource(source, true, (localSource: string, _cacheable: boolean) => {
				if (localSource.length == 0 || localSource == source) return
				const replacement = tag.replace(source, localSource)
				block.html = block.html.split(tag).join(replacement)
				if (block.kind == 'table') block.table = undefined
				changed()
			})
		}
	}
	// #endif
}
