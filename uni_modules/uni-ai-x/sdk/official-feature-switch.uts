import { reactive } from 'vue'
import { tr } from './locale.uts'

// 保留关闭旧确认层的接口；官方直连的切换操作已禁用。
export const officialFeatureSwitch = reactive({ visible: false, content: '' })

export function resolveOfficialFeatureSwitch(_confirm: boolean) {
	officialFeatureSwitch.visible = false
	// 不再切换到 deepseek 官方直连服务商。
}

export function requestOfficialFeatureSwitch() {
	// 不引导用户在前端配置长期 Key。网关模型继续按各自能力使用。
	uni.showToast({
		title: tr('此功能尚未接入云端中转，暂不可用', 'This feature needs a server proxy and is currently unavailable'),
		icon: 'none'
	})
}
