import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import {
	buildMarkdownRenderDescriptions,
	MarkdownRenderDescription,
	MarkdownRenderKind
} from '@/uni_modules/uni-ai-worker/utssdk/render-descriptions.uts'

export type MarkdownRenderBlock = {
	kind: MarkdownRenderKind
	key: string
	tokens: MarkdownToken[]
	nodes: UTSJSONObject[]
}

function blockTokensMatch(left: MarkdownToken[], right: MarkdownToken[]): boolean {
	if (left.length != right.length) return false
	for (let index = 0; index < left.length; index++) {
		if (left[index] !== right[index]) return false
	}
	return true
}

export function materializeMarkdownRenderBlocks(tokens: MarkdownToken[] | null,
	descriptions: MarkdownRenderDescription[] | null, keyPrefix: string = '',
	previousBlocks: MarkdownRenderBlock[] | null = null): MarkdownRenderBlock[] {
	const blocks = [] as MarkdownRenderBlock[]
	if (tokens == null || descriptions == null) return blocks
	for (let index = 0; index < descriptions.length; index++) {
		const description = descriptions[index]
		if (description.tokenStart < 0 || description.tokenCount <= 0 || description.tokenStart >= tokens.length) continue
		const blockTokens = tokens.slice(description.tokenStart,
			Math.min(tokens.length, description.tokenStart + description.tokenCount))
		if (blockTokens.length == 0) continue
		const block = {
			kind: description.kind,
			key: keyPrefix + description.key,
			tokens: blockTokens,
			nodes: description.nodes
		} as MarkdownRenderBlock
		const previous = previousBlocks != null && index < previousBlocks.length ? previousBlocks[index] : null
		if (previous != null && previous.kind == block.kind && previous.key == block.key &&
			blockTokensMatch(block.tokens, previous.tokens)) {
			blocks.push(previous)
		} else {
			blocks.push(block)
		}
	}
	return blocks
}

export function buildMarkdownRenderBlocks(tokens: MarkdownToken[] | null, keyPrefix: string = '',
	previousBlocks: MarkdownRenderBlock[] | null = null): MarkdownRenderBlock[] {
	if (tokens == null) return [] as MarkdownRenderBlock[]
	const descriptions = buildMarkdownRenderDescriptions(tokens)
	return materializeMarkdownRenderBlocks(tokens, descriptions, keyPrefix, previousBlocks)
}
