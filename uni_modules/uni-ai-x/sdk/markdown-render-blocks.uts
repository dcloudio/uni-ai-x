import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'

export type MarkdownRenderKind = 'rich' | 'table' | 'code' | 'mermaid' | 'math'

export type MarkdownRenderBlock = {
	kind: MarkdownRenderKind
	key: string
	tokens: MarkdownToken[]
}

export function markdownRenderKind(token: MarkdownToken): MarkdownRenderKind {
	const type = token.type ?? 'text'
	if (type == 'code_block') {
		const language = (token.lang ?? '').toLowerCase()
		if (language == 'mermaid') return 'mermaid'
		if (language == 'math' || language == 'math-pending') return 'math'
		return 'code'
	}
	if (type == 'math') return 'math'
	if (type == 'table') return 'table'
	return 'rich'
}

function tokenKey(token: MarkdownToken, index: number, keyPrefix: string): string {
	const id = token.uniqueId ?? ((token.type ?? 'node') + '-' + index.toString())
	return keyPrefix + id
}

export function buildMarkdownRenderBlocks(tokens: MarkdownToken[] | null, keyPrefix: string = ''): MarkdownRenderBlock[] {
	const blocks = [] as MarkdownRenderBlock[]
	if (tokens == null) return blocks
	for (let i = 0; i < tokens.length; i++) {
		const token = tokens[i]
		if (token == null) continue
		const kind = markdownRenderKind(token)
		const lastBlock = blocks.length > 0 ? blocks[blocks.length - 1] : null
		if (kind == 'rich' && lastBlock != null && lastBlock.kind == 'rich') {
			lastBlock.tokens.push(token)
			continue
		}
		blocks.push({
			kind,
			key: tokenKey(token, i, keyPrefix),
			tokens: [token] as MarkdownToken[]
		} as MarkdownRenderBlock)
	}
	return blocks
}
