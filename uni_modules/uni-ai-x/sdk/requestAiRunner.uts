import { llmModelMap } from '@/uni_modules/uni-ai-x/config.uts';
import { Chunk, Provider, RequestAiCoMessage, Llm, CustomProviderCallbacks } from '@/uni_modules/uni-ai-x/types.uts';
import { getCustomProvider } from '@/uni_modules/uni-ai-x/sdk/provider-registry.uts'
import { parseChunkData } from '@/uni_modules/uni-ai-x/sdk/sse.uts'
import {
	activeDemoMarkdownScenarioId,
	beginDemoMarkdownRun,
	finishDemoMarkdownRun,
	isDemoMarkdownEnabled,
	reportDemoMarkdownSnapshot
} from '@/uni_modules/uni-ai-x/sdk/demo-chat.uts'
// #ifdef APP-ANDROID
import {
	appendAiWorkerMarkdown,
	cancelAiWorkerRequest,
	completeAiWorkerMarkdown,
	destroyAiWorkerRuntime,
	readAiWorkerSnapshot,
	startAiWorkerDemo,
	startAiWorkerMarkdown,
	startAiWorkerRequest
} from '@/uni_modules/uni-ai-worker-runtime'
// #endif

export type RequestAiRunnerCallbacks = {
	onMarkdownHtml: (html: string) => void,
	onThinkContent: (thinkContent: string) => void,
	onMsgBody: (msgBody: string) => void,
	onState: (state: string) => void,
	onErrorMsg: (errorMsg: string) => void,
	onRendered: (rendered: boolean) => void,
	onChatTitle: (title: string) => void
}
export type RequestAiStartOptions = {
	messages: RequestAiCoMessage[],
	llm: Llm,
	chat_id: string
}
type RequestAiOnChunkFn = (chunkObj : Chunk) => void
type RequestAiOnErrorFn = (err : UTSJSONObject) => void
type RequestAiOnDoneFn = (data : UTSJSONObject) => void
type RequestAiOnSuccessFn = (chunkObj : Chunk) => void
type RequestAiOnTaskCreateFn = (requestTask : RequestTask) => void
type RequestPromiseFn = (data : UTSJSONObject) => void
type RequestAiServerOptions = {
	llm : Llm,
	messages : RequestAiCoMessage[],
	stream ?: boolean,
	chat_id ?: string,
	onChunk ?: RequestAiOnChunkFn,
	onError ?: RequestAiOnErrorFn,
	onDone ?: RequestAiOnDoneFn,
	onSuccess ?: RequestAiOnSuccessFn,
	onTaskCreate ?: RequestAiOnTaskCreateFn
}

const MARKDOWN_RENDER_INTERVAL = 300
const DEMO_STREAM_BATCH_SIZE = 10
const DEMO_STREAM_INTERVAL = 100
const DEMO_BLOCK_INTERVAL = MARKDOWN_RENDER_INTERVAL

class RequestAiRunner {
	requestTask : RequestTask | null = null
	msgBody : string = ''
	thinkContent : string = ''
	private callbacks : RequestAiRunnerCallbacks | null = null
	currentChatState : string = ''
	userAbort : boolean = false
	hasThinkContent : boolean = false
	private bodyEmitTimer: number = 0
	private lastBodyEmitTime: number = 0
	private workerPollTimer: number = 0
	private workerRequestVersion: number = 0
	private workerSnapshotVersion: number = 0
	private workerActive: boolean = false
	constructor(callbacks: RequestAiRunnerCallbacks) {
		this.callbacks = callbacks
	}
	private emitMsgBody(force: boolean = false) {
		if (force) {
			if (this.bodyEmitTimer != 0) clearTimeout(this.bodyEmitTimer)
			this.bodyEmitTimer = 0
			this.lastBodyEmitTime = Date.now()
			this.callbacks?.onMsgBody(this.msgBody)
			return
		}
		const elapsed = this.lastBodyEmitTime == 0 ? MARKDOWN_RENDER_INTERVAL : Date.now() - this.lastBodyEmitTime
		if (elapsed >= MARKDOWN_RENDER_INTERVAL) {
			this.lastBodyEmitTime = Date.now()
			this.callbacks?.onMsgBody(this.msgBody)
			return
		}
		if (this.bodyEmitTimer != 0) return
		this.bodyEmitTimer = setTimeout(() => {
			this.bodyEmitTimer = 0
			this.lastBodyEmitTime = Date.now()
			this.callbacks?.onMsgBody(this.msgBody)
		}, MARKDOWN_RENDER_INTERVAL - elapsed)
	}
	onChunkFn(chunkObj : Chunk) {
		let reasoningContent: null | string = null
		let content = chunkObj.choices?.[0]?.delta?.content
		if (this.msgBody == '' && content == "<think>") {
			this.hasThinkContent = true
			content = ''
		}
		if (this.hasThinkContent) {
			if (content != '</think>') {
				reasoningContent = content
			} else {
				this.hasThinkContent = false
			}
			content = ''
		}

		reasoningContent = reasoningContent ?? chunkObj.choices?.[0]?.delta?.reasoning_content
		// #ifdef APP-ANDROID
		if (this.workerActive) {
			appendAiWorkerMarkdown(this.workerRequestVersion, content ?? '', reasoningContent ?? '')
			return
		}
		// #endif
		if (content != null && content.length > 0) {
			this.msgBody += content
			this.emitMsgBody()
		} else if (reasoningContent != null) {
			this.thinkContent += reasoningContent
			this.callbacks?.onThinkContent(this.thinkContent.trim())
		}

	};
	resetRequestState() {
		this.stopWorkerRuntime(true)
		finishDemoMarkdownRun()
		this.workerRequestVersion += 1
		if (this.bodyEmitTimer != 0) clearTimeout(this.bodyEmitTimer)
		this.bodyEmitTimer = 0
		this.lastBodyEmitTime = 0
		this.msgBody = ''
		this.thinkContent = ''
		this.currentChatState = ''
		this.userAbort = false
		this.hasThinkContent = false
	}
	handleRequestError(errRes: UTSJSONObject) {
		if (this.workerActive) this.stopWorkerRuntime(true)
		console.error('requestAiServer error', errRes)
		const errCode = errRes.getString('errCode', '')
		let errMsg = errRes.getString('errMsg', '未知错误')
		if (errCode == 'data_inspection_failed') {
			errMsg = '数据检查失败，疑似包含敏感信息'
		}
		if (this.userAbort == false) {
			this.callbacks?.onErrorMsg(errMsg)
		}
		this.currentChatState = 'stop'
		this.callbacks?.onState('stop')
	}
	finishRequest() {
		if (this.currentChatState == 'stop') {
			return
		}
		// #ifdef APP-ANDROID
		if (this.workerActive) {
			completeAiWorkerMarkdown(this.workerRequestVersion)
			return
		}
		// #endif
		if (!this.msgBody.endsWith('\n')) {
			this.msgBody += '\n'
		}
		this.emitMsgBody(true)
		this.handleRequestError({
			errCode: 'markdown_html_unsupported',
			errMsg: '当前平台未启用 Markdown HTML Worker'
		} as UTSJSONObject)
	}
	start(options: RequestAiStartOptions) {
		this.requestAi(options.messages, options.llm, options.chat_id)
	}
	requestAi(messages : RequestAiCoMessage[], llm : Llm, chat_id : string) {
		this.resetRequestState()

		if (isDemoMarkdownEnabled()) {
			if (beginDemoMarkdownRun()) {
				// #ifdef APP-ANDROID
				this.streamDemoMarkdownInWorker()
				// #endif
				// #ifndef APP-ANDROID
				this.handleRequestError({
					errCode: 'markdown_html_unsupported',
					errMsg: '当前平台未启用 Markdown HTML Worker'
				} as UTSJSONObject)
				// #endif
			} else {
				this.handleRequestError({
					errCode: 'demo_scenario_missing',
					errMsg: '请先选择 Markdown 测试类型'
				} as UTSJSONObject)
			}
			return
		}

		// #ifndef APP-ANDROID
		this.handleRequestError({
			errCode: 'markdown_html_unsupported',
			errMsg: '当前平台未启用 Markdown HTML Worker'
		} as UTSJSONObject)
		return
		// #endif

		this.updateChatTitle(messages, llm)
		this.requestRemoteAi(messages, llm, chat_id)
	}
	requestRemoteAi(messages : RequestAiCoMessage[], llm : Llm, chat_id : string) {
		// #ifdef APP-ANDROID
		if (getCustomProvider(llm.provider) == null) {
			this.requestRemoteAiInWorker(messages, llm, chat_id)
			return
		}
		this.startMarkdownHtmlWorker()
		// #endif
		this.requestAiServer({
			llm,
			messages,
			stream: true,
			chat_id: chat_id,
			onTaskCreate: (requestTask : RequestTask) => {
				this.requestTask = requestTask
			},
			onChunk: (chunkObj : Chunk) => {
				this.onChunkFn(chunkObj)
			},
			onError: (errRes) => {
				this.handleRequestError(errRes as UTSJSONObject)
			},
			onDone: () => {
				this.finishRequest()
			}
		}).finally(() => {
			this.requestTask = null
		})
	}
	// #ifdef APP-ANDROID
	private async requestRemoteAiInWorker(messages: RequestAiCoMessage[], llm: Llm, chat_id: string) {
		const requestVersion = this.workerRequestVersion + 1
		this.workerRequestVersion = requestVersion
		const requestOptions: RequestAiServerOptions = {
			llm: llm,
			messages: messages,
			stream: true,
			chat_id: chat_id,
			onError: (errRes: UTSJSONObject) => {
				if (requestVersion == this.workerRequestVersion) this.handleRequestError(errRes)
			}
		}
		try {
			const config = this.getProviderConfig(llm.provider, requestOptions)
			const tmpToken = await this.requestProviderToken(config, requestOptions)
			if (this.userAbort || requestVersion != this.workerRequestVersion) return
			const body = {
				messages: messages,
				stream: true,
				model: llm.model
			} as UTSJSONObject
			this.workerSnapshotVersion = 0
			this.workerActive = true
			startAiWorkerRequest({
				requestVersion: requestVersion,
				provider: llm.provider,
				model: llm.model,
				url: config.baseURL!,
				authorization: 'Bearer ' + tmpToken,
				bodyJson: JSON.stringify(body),
				renderInterval: MARKDOWN_RENDER_INTERVAL,
				timeout: 90000
			})
			this.workerPollTimer = setInterval(() => {
				this.pollWorkerSnapshot(requestVersion)
			}, 50)
		} catch (_error) {
			// getProviderConfig/requestProviderToken 已通过 requestOptions.onError 上报。
		}
	}

	private pollWorkerSnapshot(requestVersion: number) {
		if (!this.workerActive || requestVersion != this.workerRequestVersion || this.userAbort) return
		const snapshotJson = readAiWorkerSnapshot()
		if (snapshotJson.length == 0) return
		let snapshot: UTSJSONObject
		try {
			snapshot = JSON.parse<UTSJSONObject>(snapshotJson) as UTSJSONObject
		} catch (_error) {
			this.handleWorkerSnapshotError('worker_snapshot_invalid', 'Worker 返回数据解析失败')
			return
		}
		if (snapshot.getNumber('requestVersion', 0) != requestVersion) return
		const phase = snapshot.getString('phase', '')
		const snapshotVersion = snapshot.getNumber('snapshotVersion', 0)
		if (phase != 'error' && snapshotVersion <= this.workerSnapshotVersion) return
		if (snapshotVersion > this.workerSnapshotVersion) this.workerSnapshotVersion = snapshotVersion
		if (phase == 'error') {
			console.log('[uni-ai-x][AI Worker] error', JSON.stringify({
				requestVersion: requestVersion,
				snapshotVersion: snapshotVersion,
				eventCount: snapshot.getNumber('eventCount', 0),
				networkChunkCount: snapshot.getNumber('networkChunkCount', 0),
				receivedBytes: snapshot.getNumber('receivedBytes', 0),
				elapsed: snapshot.getNumber('elapsed', 0),
				errCode: snapshot.getString('errCode', 'worker_error')
			} as UTSJSONObject))
			this.handleWorkerSnapshotError(
				snapshot.getString('errCode', 'worker_error'),
				snapshot.getString('errMsg', 'Worker 请求失败')
			)
			return
		}
		if (phase != 'snapshot' && phase != 'complete') return

		this.msgBody = snapshot.getString('msgBody', this.msgBody)
		this.thinkContent = snapshot.getString('thinkContent', this.thinkContent)
		reportDemoMarkdownSnapshot(
			this.msgBody.length,
			snapshot.getNumber('demoBlockCount', 0),
			snapshot.getNumber('elapsed', 0)
		)
		this.emitMsgBody(true)
		this.callbacks?.onThinkContent(this.thinkContent)
		const renderMode = snapshot.getString('renderMode', '')
		if (renderMode != 'html') {
			this.handleWorkerSnapshotError('worker_html_required', 'Worker 必须返回 Markdown HTML')
			return
		}
		const isDone = phase == 'complete' || snapshot.getBoolean('isDone', false)
		if (isDone) {
			console.log('[uni-ai-x][AI Worker] complete', JSON.stringify({
				requestVersion: requestVersion,
				snapshotVersion: snapshotVersion,
				eventCount: snapshot.getNumber('eventCount', 0),
				networkChunkCount: snapshot.getNumber('networkChunkCount', 0),
				receivedBytes: snapshot.getNumber('receivedBytes', 0),
				renderMode: renderMode,
				htmlLength: snapshot.getNumber('htmlLength', 0),
				terminalSource: snapshot.getString('terminalSource', ''),
				elapsed: snapshot.getNumber('elapsed', 0)
			} as UTSJSONObject))
			this.stopWorkerRuntime(false)
		}
		this.callbacks?.onMarkdownHtml(snapshot.getString('html', ''))
		if (isDone) {
			this.currentChatState = 'completed'
			this.callbacks?.onState('completed')
			this.callbacks?.onRendered(true)
		}
	}

	private handleWorkerSnapshotError(errCode: string, errMsg: string) {
		this.stopWorkerRuntime(false)
		finishDemoMarkdownRun()
		this.handleRequestError({
			errCode: errCode,
			errMsg: errMsg
		} as UTSJSONObject)
	}
	// #endif

	private stopWorkerRuntime(cancelRequest: boolean) {
		if (this.workerPollTimer != 0) clearInterval(this.workerPollTimer)
		this.workerPollTimer = 0
		// #ifdef APP-ANDROID
		if (cancelRequest && this.workerActive) cancelAiWorkerRequest(this.workerRequestVersion)
		destroyAiWorkerRuntime()
		// #endif
		this.workerActive = false
	}

	// #ifdef APP-ANDROID
	private startMarkdownHtmlWorker() {
		const requestVersion = this.workerRequestVersion + 1
		this.workerRequestVersion = requestVersion
		this.workerSnapshotVersion = 0
		this.workerActive = true
		startAiWorkerMarkdown({
			requestVersion: requestVersion,
			renderInterval: MARKDOWN_RENDER_INTERVAL
		})
		this.workerPollTimer = setInterval(() => {
			this.pollWorkerSnapshot(requestVersion)
		}, 50)
	}

	private streamDemoMarkdownInWorker() {
		const requestVersion = this.workerRequestVersion + 1
		this.workerRequestVersion = requestVersion
		this.workerSnapshotVersion = 0
		this.workerActive = true
		startAiWorkerDemo({
			requestVersion: requestVersion,
			scenarioId: activeDemoMarkdownScenarioId(),
			renderInterval: MARKDOWN_RENDER_INTERVAL,
			streamInterval: DEMO_STREAM_INTERVAL,
			batchSize: DEMO_STREAM_BATCH_SIZE,
			blockInterval: DEMO_BLOCK_INTERVAL
		})
		this.workerPollTimer = setInterval(() => {
			this.pollWorkerSnapshot(requestVersion)
		}, 50)
	}
	// #endif

	async requestViaCustomProvider(options : RequestAiServerOptions) : Promise<UTSJSONObject> {
		const adapter = getCustomProvider(options.llm.provider)
		if (adapter == null) {
			const errInfo: UTSJSONObject = {
				errCode: -200,
				errMsg: '自定义提供商适配器未注册: ' + options.llm.provider
			}
			options.onError?.(errInfo)
			throw errInfo
		}

		const callbacks: CustomProviderCallbacks = {
			onChunk: options.onChunk,
			onError: options.onError,
			onDone: options.onDone
		}
		const currentChatId = options.chat_id ?? ''
		let success = false
		try {
			success = await adapter.request(options.messages, options.llm.model, currentChatId, callbacks)
		} catch (e) {
			console.error('自定义提供商请求异常', e)
			const errInfo: UTSJSONObject = {
				errCode: -204,
				errMsg: '自定义提供商请求异常'
			}
			options.onError?.(errInfo)
			throw errInfo
		}
		if (!success) {
			const errInfo: UTSJSONObject = {
				errCode: -201,
				errMsg: '自定义提供商发送消息失败'
			}
			options.onError?.(errInfo)
			throw errInfo
		}
		return {} as UTSJSONObject
	}
	async requestAiServer(options : RequestAiServerOptions) : Promise<UTSJSONObject> {
		let resolveFn = (_ : UTSJSONObject) : void => { }, rejectFn = resolveFn;

		if (getCustomProvider(options.llm.provider) != null) {
			return this.requestViaCustomProvider(options)
		}

		const config = this.getProviderConfig(options.llm.provider, options)
		const tmpToken = await this.requestProviderToken(config, options)
		const requestTask: RequestTask = uni.request({
			url: config.baseURL!,
			method: 'POST',
			dataType: 'text',
			data: {
				messages: options.messages,
				stream: options.stream ?? true,
				model: options.llm.model
			},
			// @ts-ignore
			enableChunked: options.stream ?? true,
			header: {
				'Authorization': `Bearer ${tmpToken}`,
				'Content-Type': 'application/json'
			},
			success: (res : RequestSuccess<any>) => {
				this.handleRequestSuccess(res, options, resolveFn, rejectFn)
			},
			fail: (err : RequestFail) => {
				console.error('request fail', err)
				const errInfo: UTSJSONObject = {
					errCode: err.errCode,
					errMsg: err.errMsg
				}
				rejectFn(errInfo)
				options.onError?.(errInfo)
			}
		})
		options.onTaskCreate?.(requestTask)
		if (options.stream == true) {
			this.bindStreamChunks(requestTask, options, rejectFn)
		}
		return new Promise<UTSJSONObject>((resolve, reject) => {
			resolveFn = (data : UTSJSONObject) => { resolve(data as UTSJSONObject) }
			rejectFn = (data : UTSJSONObject) => { reject(data as UTSJSONObject) }
		})
	}
	getProviderConfig(provider: string, options: RequestAiServerOptions): Provider {
		const config = llmModelMap.get(provider)
		if (config == null) {
			const errInfo: UTSJSONObject = {
				errCode: -101,
				errMsg: '模型提供商未配置: ' + provider
			}
			options.onError?.(errInfo)
			throw errInfo
		}
		return config
	}
	async requestProviderToken(config: Provider, options: RequestAiServerOptions): Promise<string> {
		try {
			return await config.getToken?.()!
		} catch (e) {
			const errInfo: UTSJSONObject = {
				errCode: -100,
				errMsg: '获取临时token失败'
			}
			options.onError?.(errInfo)
			throw errInfo
		}
	}
	handleRequestSuccess(res: RequestSuccess<any>, options: RequestAiServerOptions, resolveFn: RequestPromiseFn, rejectFn: RequestPromiseFn) {
		if (options.stream == false) {
			const strData = typeof res.data == 'string' ? res.data : JSON.stringify(res.data)
			const chunkObj : Chunk = (JSON.parse<Chunk>(strData) ?? {}) as Chunk
			options.onSuccess?.(chunkObj)
			resolveFn({} as UTSJSONObject)
			return
		}
		if (res.data instanceof UTSJSONObject) {
			const error = res.data.getJSON('error')
			if (error != null) {
				const errInfo: UTSJSONObject = {
					errCode: error.getString('code', 'unknown'),
					errMsg: error.getString('message', '未知错误')
				}
				options.onError?.(errInfo)
				rejectFn(errInfo)
				return
			}
		}
		resolveFn({} as UTSJSONObject)
	}
	bindStreamChunks(requestTask: RequestTask, options: RequestAiServerOptions, rejectFn: RequestPromiseFn) {
		const textDecoder = new TextDecoder()
		// @ts-ignore
		requestTask.onChunkReceived((chunk : RequestTaskOnChunkReceivedListenerResult) => {
			parseChunkData(chunk.data as ArrayBuffer, textDecoder, (chunkObj : Chunk) => {
				options.onChunk?.(chunkObj)
			},
				(err : UTSJSONObject) => {
					err.errCode = err.code ?? ''
					err.errMsg = err.message ?? '未知错误'
					options.onError?.(err)
					rejectFn(err)
				},
				() => {
					options.onDone?.({} as UTSJSONObject)
				})
		})
	}
	updateChatTitle(messages: RequestAiCoMessage[], llm: Llm) {
		const customAdapter = getCustomProvider(llm.provider)
		if (customAdapter != null && customAdapter.supportsTitleUpdate != true) return;
		messages = messages.slice(0)
		messages.push({
			role: 'user',
			content: '请总结一下这段对话的内容，不包含本对话，用于更新会话的标题。注意：可以直接使用的不要有多余的文字，只保留总结的内容。字数控制在 10 个字以内。'
		})
		this.requestAiServer({
			llm,
			messages,
			stream: false,
			onError: (err: UTSJSONObject) => {
				console.error('updateChatTitle error', err)
			},
			onSuccess: (chunkObj: Chunk) => {
				const newTitle = chunkObj.choices?.[0]?.message?.content
				this.callbacks?.onChatTitle(newTitle ?? '更新失败')
			}
		})
	}
	abortRequest() {
		if (this.bodyEmitTimer != 0) clearTimeout(this.bodyEmitTimer)
		this.bodyEmitTimer = 0
		this.userAbort = true
		finishDemoMarkdownRun()
		this.stopWorkerRuntime(true)
		this.workerRequestVersion += 1
		this.requestTask?.abort()
		this.callbacks?.onState('stop')
		this.callbacks = null
	}
}
export default RequestAiRunner;
