export type TextWidthMode = 'normal' | 'mono'

// 流式 Markdown 解析需要同步返回宽度；canvas measureText 可作为后续增强，但不放进主链路。
function isFullWidthChar(code: number): boolean {
	return (code >= 0x1100 && code <= 0x115f)
		|| (code >= 0x2e80 && code <= 0xa4cf)
		|| (code >= 0xac00 && code <= 0xd7a3)
		|| (code >= 0xf900 && code <= 0xfaff)
		|| (code >= 0xff01 && code <= 0xff60)
		|| (code >= 0xffe0 && code <= 0xffe6)
}

function getCharWidthRatio(code: number, mode: TextWidthMode): number {
	if (code == 9) return mode == 'mono' ? 2.4 : 1.2
	if (isFullWidthChar(code)) return 1
	if (mode == 'mono') return 0.62
	if ((code >= 65 && code <= 90) || code == 64 || code == 37) return 0.68
	if (code >= 48 && code <= 57) return 0.56
	if (code == 32) return 0.32
	return 0.52
}

export function estimateTextWidth(text: string, fontSize: number, mode: TextWidthMode = 'normal'): number {
	if (text.length == 0) return 0
	let width = 0
	for (let i = 0; i < text.length; i++) {
		width += fontSize * getCharWidthRatio(text.charCodeAt(i), mode)
	}
	return Math.ceil(width)
}

export function estimateMaxLineTextWidth(lines: string[], fontSize: number, mode: TextWidthMode = 'normal'): number {
	let width = 0
	for (let i = 0; i < lines.length; i++) {
		width = Math.max(width, estimateTextWidth(lines[i], fontSize, mode))
	}
	return Math.max(1, width)
}
