import type { AiWorkerOp } from '@/uni_modules/uni-ai-worker-runtime/utssdk/interface.uts'
import { requestAiWorkerMarkdownRebuild } from '@/uni_modules/uni-ai-worker-runtime'
import { LibmarkStreamAdapter } from '@/uni_modules/uni-ai-worker/utssdk/libmark-ast.uts'
import { libmarkRenderBlocksToTextBlocks } from '@/uni_modules/uni-ai-x/sdk/markdown-text.uts'
import type { MarkdownTextRenderBlock, MarkdownTextSpan } from '@/uni_modules/uni-ai-x/sdk/markdown-text.uts'

// 内存中保留的渲染条目上限：超出后按最近访问顺序淘汰最久未访问的条目
const STREAM_ENTRY_LIMIT = 200

type LibmarkStreamEntry = {
	adapter: LibmarkStreamAdapter
	textBlocks: MarkdownTextRenderBlock[]
}

const streamEntries = new Map<string, LibmarkStreamEntry>()
// 最近访问顺序（末尾最新），用于 LRU 淘汰
const streamEntryOrder = [] as string[]

function touchEntry(msgId: string): void {
	const index = streamEntryOrder.indexOf(msgId)
	if (index >= 0) streamEntryOrder.splice(index, 1)
	streamEntryOrder.push(msgId)
}

function evictEntriesIfNeeded(): void {
	while (streamEntryOrder.length > STREAM_ENTRY_LIMIT) {
		const oldest = streamEntryOrder.shift()
		if (oldest == null) break
		streamEntries.delete(oldest!)
	}
}

function emptyBlocks(): MarkdownTextRenderBlock[] {
	return [] as MarkdownTextRenderBlock[]
}

function entryFor(msgId: string): LibmarkStreamEntry {
	const existing = streamEntries.get(msgId)
	if (existing != null) {
		touchEntry(msgId)
		return existing!
	}
	const entry = {
		adapter: new LibmarkStreamAdapter(),
		textBlocks: emptyBlocks()
	} as LibmarkStreamEntry
	streamEntries.set(msgId, entry)
	touchEntry(msgId)
	evictEntriesIfNeeded()
	return entry
}

function refreshEntry(entry: LibmarkStreamEntry, isDone: boolean = false): void {
	entry.textBlocks = libmarkRenderBlocksToTextBlocks(entry.adapter.getBlocks(), isDone)
}

function cloneSpan(span: MarkdownTextSpan): MarkdownTextSpan {
	return {
		text: span.text,
		className: span.className,
		href: span.href,
		isImage: span.isImage,
		imageSrc: span.imageSrc,
		svgSource: span.svgSource,
		svgWidth: span.svgWidth,
		svgHeight: span.svgHeight,
		svgBaseline: span.svgBaseline
	}
}

function cloneBlock(block: MarkdownTextRenderBlock): MarkdownTextRenderBlock {
	const spans = [] as MarkdownTextSpan[]
	for (let index = 0; index < block.spans.length; index++) spans.push(cloneSpan(block.spans[index]))
	const columnWidths = [] as number[]
	for (let index = 0; index < block.columnWidths.length; index++) columnWidths.push(block.columnWidths[index])
	const rowTextWidths = [] as number[][]
	for (let rowIndex = 0; rowIndex < block.rowTextWidths.length; rowIndex++) {
		const row = [] as number[]
		for (let columnIndex = 0; columnIndex < block.rowTextWidths[rowIndex].length; columnIndex++) {
			row.push(block.rowTextWidths[rowIndex][columnIndex])
		}
		rowTextWidths.push(row)
	}
	return {
		kind: block.kind,
		key: block.key,
		html: block.html,
		text: block.text,
		language: block.language,
		isComplete: block.isComplete,
		columnWidths: columnWidths,
		rowTextWidths: rowTextWidths,
		spans: spans,
		level: block.level,
		indent: block.indent,
		marker: block.marker,
		quoteDepth: block.quoteDepth,
		svgSource: block.svgSource,
		svgWidth: block.svgWidth,
		svgHeight: block.svgHeight
	}
}

function cloneBlocks(blocks: MarkdownTextRenderBlock[]): MarkdownTextRenderBlock[] {
	const result = [] as MarkdownTextRenderBlock[]
	for (let index = 0; index < blocks.length; index++) result.push(cloneBlock(blocks[index]))
	return result
}

export function libmarkStreamApply(msgId: string, ops: AiWorkerOp[]): boolean {
	if (ops.length == 0) return false
	const entry = entryFor(msgId)
	const applied = entry.adapter.applyOps(ops)
	refreshEntry(entry)
	return applied
}

export function libmarkStreamGetBlocks(msgId: string): MarkdownTextRenderBlock[] {
	const entry = streamEntries.get(msgId)
	if (entry == null) return emptyBlocks()
	touchEntry(msgId)
	return cloneBlocks(entry!.textBlocks)
}

export function libmarkStreamComplete(msgId: string): string {
	const entry = entryFor(msgId)
	refreshEntry(entry, true)
	if (!entry.adapter.hasContent()) return ''
	return entry.adapter.getCompleteAstJson()
}

// 仅刷新完成态（不序列化 AST），用于流式结束后的 UI 收尾
export function libmarkStreamMarkComplete(msgId: string): void {
	const entry = streamEntries.get(msgId)
	if (entry == null) return
	refreshEntry(entry!, true)
}

// #ifdef APP-HARMONY || APP-ANDROID
// 正在等待 Worker 重建结果的消息（去重）
const rebuildingMsgIds = [] as string[]
// 本次会话重建失败的消息（避免反复请求）
const rebuildFailedMsgIds = [] as string[]
// #endif

/**
 * 请求 Worker 用 libmark 从消息原文（body）重建渲染 ops（重启/中断后的恢复路径）。
 * 页面运行环境无法调用 libmark 原生插件，统一由 Worker 解析，
 * 解析结果通过 setAiWorkerRebuildListener 的监听器回调，再调用 libmarkStreamApplyRebuild 应用。
 */
export function libmarkStreamRequestRebuild(msgId: string, text: string): boolean {
	// #ifdef APP-HARMONY || APP-ANDROID
	if (text.length == 0) return false
	if (rebuildFailedMsgIds.indexOf(msgId) >= 0) return false
	if (rebuildingMsgIds.indexOf(msgId) >= 0) return false
	const existing = streamEntries.get(msgId)
	if (existing != null && existing!.textBlocks.length > 0) return false
	rebuildingMsgIds.push(msgId)
	requestAiWorkerMarkdownRebuild(msgId, text)
	return true
	// #endif
	// #ifndef APP-HARMONY
	// #ifndef APP-ANDROID
	return false
	// #endif
	// #endif
}

/**
 * 应用 Worker 回传的重建 ops；ops 为空或应用后无 blocks 均视为重建失败，本次会话不再重试。
 */
export function libmarkStreamApplyRebuild(msgId: string, ops: AiWorkerOp[]): boolean {
	// #ifdef APP-HARMONY || APP-ANDROID
	const index = rebuildingMsgIds.indexOf(msgId)
	if (index >= 0) rebuildingMsgIds.splice(index, 1)
	const markFailed = (): boolean => {
		if (rebuildFailedMsgIds.indexOf(msgId) < 0) rebuildFailedMsgIds.push(msgId)
		return false
	}
	if (ops.length == 0) return markFailed()
	const applied = libmarkStreamApply(msgId, ops)
	if (libmarkStreamGetBlocks(msgId).length == 0) return markFailed()
	return applied
	// #endif
	// #ifndef APP-HARMONY
	// #ifndef APP-ANDROID
	return false
	// #endif
	// #endif
}

export function libmarkStreamReset(msgId: string): void {
	const entry = entryFor(msgId)
	entry.adapter.reset()
	entry.textBlocks = emptyBlocks()
}

export function libmarkStreamLoadFromAst(msgId: string, astJson: string): boolean {
	const entry = entryFor(msgId)
	entry.adapter.loadDocument(astJson)
	refreshEntry(entry, true)
	return entry.textBlocks.length > 0
}

export function libmarkStreamRelease(msgId: string): void {
	streamEntries.delete(msgId)
	const index = streamEntryOrder.indexOf(msgId)
	if (index >= 0) streamEntryOrder.splice(index, 1)
}
