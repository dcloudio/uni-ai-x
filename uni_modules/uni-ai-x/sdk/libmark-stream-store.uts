import type { AiWorkerOp } from '@/uni_modules/uni-ai-worker-runtime/utssdk/interface.uts'
import { requestAiWorkerMarkdownRebuild } from '@/uni_modules/uni-ai-worker-runtime'
import { LibmarkHtmlStreamAdapter } from '@/uni_modules/uni-ai-worker/utssdk/libmark-html.uts'
import { libmarkHtmlBlocksToTextBlocks } from '@/uni_modules/uni-ai-x/sdk/markdown-text.uts'
import type { MarkdownTextRenderBlock } from '@/uni_modules/uni-ai-x/sdk/markdown-text.uts'
import { ref } from 'vue'
import { prepareCodeBlocks } from './code-presentation.uts'
import { releaseCodeHighlightSessions } from './parseCode.uts'
import { prepareNativeMermaidBlocks } from '@/uni_modules/uni-ai-x/sdk/mermaid-presentation.uts'
import { prepareNativeInlineMathBlocks } from './inline-math-presentation.uts'
// #ifdef APP-ANDROID
import { prepareAndroidPresentation, releaseAndroidPresentation, completeAndroidInlineMath } from '@/uni_modules/uni-ai-worker-runtime'
import proxyWeb from './proxy-web.uts'
// #endif

export const libmarkPresentationRevision = ref<number>(0)
let presentationTheme = 'light'

// 内存中保留的渲染条目上限：超出后按最近访问顺序淘汰最久未访问的条目
const STREAM_ENTRY_LIMIT = 200

type LibmarkStreamEntry = {
	messageId: string
	workerId: string
	preparationVersion: number
	presentationRevision: number
	adapter: LibmarkHtmlStreamAdapter
	textBlocks: MarkdownTextRenderBlock[]
	body: string
	citationIds: number[]
}

const streamEntries = new Map<string, LibmarkStreamEntry>()
let workerSequence = 0
// 最近访问顺序（末尾最新），用于 LRU 淘汰
const streamEntryOrder = [] as string[]

function touchEntry(msgId: string): void {
	const index = streamEntryOrder.indexOf(msgId)
	if (index >= 0) streamEntryOrder.splice(index, 1)
	streamEntryOrder.push(msgId)
}

function evictEntriesIfNeeded(): void {
	while (streamEntryOrder.length > STREAM_ENTRY_LIMIT) {
		const oldest = streamEntryOrder.shift()
		if (oldest == null) break
		libmarkStreamRelease(oldest!)
	}
}

function emptyBlocks(): MarkdownTextRenderBlock[] {
	return [] as MarkdownTextRenderBlock[]
}

function entryFor(msgId: string): LibmarkStreamEntry {
	const existing = streamEntries.get(msgId)
	if (existing != null) {
		touchEntry(msgId)
		return existing!
	}
	const entry: LibmarkStreamEntry = {
		messageId: msgId,
		workerId: msgId + ':' + (++workerSequence).toString(),
		preparationVersion: 0,
		presentationRevision: 0,
		adapter: new LibmarkHtmlStreamAdapter(),
		textBlocks: emptyBlocks(),
		body: '',
		citationIds: []
	}
	streamEntries.set(msgId, entry)
	touchEntry(msgId)
	evictEntriesIfNeeded()
	return entry
}

function notifyEntry(entry: LibmarkStreamEntry) {
	entry.presentationRevision = libmarkPresentationRevision.value + 1
	libmarkPresentationRevision.value = entry.presentationRevision
}

export function libmarkStreamGetRevision(msgId: string): number {
	return streamEntries.get(msgId)?.presentationRevision ?? 0
}

function refreshEntry(entry: LibmarkStreamEntry, isDone: boolean = false): void {
	const version = ++entry.preparationVersion
	const blocks = libmarkHtmlBlocksToTextBlocks(entry.adapter.getBlocks(), isDone)
	const isCurrent = (): boolean => streamEntries.get(entry.messageId) == entry && entry.preparationVersion == version
	prepareCodeBlocks(entry.messageId, blocks, (prepared: MarkdownTextRenderBlock[]) => {
		if (!isCurrent()) return
		entry.textBlocks = prepared
		prepareNativeInlineMathBlocks(entry.messageId, prepared, presentationTheme, () => {
			if (!isCurrent()) return
			entry.textBlocks = prepared.slice()
			notifyEntry(entry)
		})
		notifyEntry(entry)
		prepareNativeMermaidBlocks(prepared, presentationTheme, () => {
			if (!isCurrent()) return
			entry.textBlocks = prepared.slice()
			notifyEntry(entry)
		})
	}, entry.textBlocks)
}

// #ifdef APP-ANDROID
export function libmarkStreamSetContext(msgId: string, body: string, citationIds: number[]) {
	const entry = entryFor(msgId)
	if (entry.body == body && entry.citationIds.join(',') == citationIds.join(',')) return
	entry.body = body
	entry.citationIds = citationIds
	if (entry.preparationVersion > 0) prepareAndroidEntry(entry, [])
}

function prepareAndroidEntry(entry: LibmarkStreamEntry, ops: AiWorkerOp[], done: boolean = false) {
	entry.preparationVersion += 1
	const wireOps = ops.map((op: AiWorkerOp): UTSJSONObject => ({
		op: op.op, kind: op.kind, content: op.content, index: op.index, unchanged: op.unchanged
	} as UTSJSONObject))
	prepareAndroidPresentation(entry.workerId, wireOps, done, presentationTheme, (message: UTSJSONObject) => {
		if (streamEntries.get(entry.messageId) != entry) return
		if (message['action'] == 'inline-math') {
			const theme = message['theme'] as string
			const source = message['source'] as string
			proxyWeb.callMethod({ action: 'rasterizeInlineMath', source: source, theme: theme }, (result: UTSJSONObject) => {
				if (streamEntries.get(entry.messageId) != entry || presentationTheme != theme) return
				completeAndroidInlineMath(entry.workerId, source, theme, result)
			})
			return
		}
		if (message['action'] == 'error') {
			notifyEntry(entry)
			return
		}
		const blocks = entry.textBlocks.slice(0, message['length'] as number)
		const deltas = message['changes'] as UTSJSONObject[]
		const changed: MarkdownTextRenderBlock[] = []
		for (let i = 0; i < deltas.length; i++) {
			const index = deltas[i]['index'] as number
			const wireBlock = deltas[i]['block'] as UTSJSONObject
			const block = wireBlock as MarkdownTextRenderBlock
			const prefix = wireBlock['codeHtmlPrefix'] as number
			const previousHtml = blocks[index]?.codeHtml ?? ''
			if (prefix < 0 || prefix > previousHtml.length) {
				console.error('[uni-ai-x][presentation-worker] Invalid HTML patch prefix')
				return
			}
			block.codeHtml = previousHtml.slice(0, prefix) + (block.codeHtml ?? '')
			blocks[index] = block
			changed.push(block)
		}
		entry.preparationVersion += 1
		// Worker deltas reuse stable blocks. Only changed blocks need image preparation.
		entry.textBlocks = blocks
		const published = changed.slice()
		const publish = () => {
			if (streamEntries.get(entry.messageId) != entry || !published.some((block: MarkdownTextRenderBlock): boolean => entry.textBlocks.includes(block))) return
			const updated = entry.textBlocks.slice()
			for (let i = 0; i < deltas.length; i++) {
				const index = deltas[i]['index'] as number
				if (updated[index] == published[i]) {
					published[i] = cloneBlock(changed[i])
					updated[index] = published[i]
				}
			}
			entry.textBlocks = updated
			notifyEntry(entry)
		}
		prepareNativeMermaidBlocks(changed, presentationTheme, publish)
		notifyEntry(entry)
	}, entry.body, entry.citationIds)
}
// #endif

export function libmarkStreamSetTheme(theme: string) {
	if (presentationTheme == theme) return
	presentationTheme = theme
	streamEntries.forEach((entry: LibmarkStreamEntry) => {
		// #ifdef APP-ANDROID
		prepareAndroidEntry(entry, [])
		// #endif
		// #ifndef APP-ANDROID
		refreshEntry(entry)
		// #endif
	})
}

function cloneBlock(block: MarkdownTextRenderBlock): MarkdownTextRenderBlock {
	const columnWidths = [] as number[]
	for (let index = 0; index < block.columnWidths.length; index++) columnWidths.push(block.columnWidths[index])
	const rowTextWidths = [] as number[][]
	for (let rowIndex = 0; rowIndex < block.rowTextWidths.length; rowIndex++) {
		const row = [] as number[]
		for (let columnIndex = 0; columnIndex < block.rowTextWidths[rowIndex].length; columnIndex++) {
			row.push(block.rowTextWidths[rowIndex][columnIndex])
		}
		rowTextWidths.push(row)
	}
	return {
		kind: block.kind,
		key: block.key,
		html: block.html,
		text: block.text,
		language: block.language,
		isComplete: block.isComplete,
		columnWidths: columnWidths,
		rowTextWidths: rowTextWidths,
		codeTokens: block.codeTokens,
		codeLines: block.codeLines,
		codeHtml: block.codeHtml,
		codeContentHeight: block.codeContentHeight,
		codeCompleteLines: block.codeCompleteLines,
		codeHighlightedText: block.codeHighlightedText,
		codeHeight: block.codeHeight,
		table: block.table,
		mermaidImageSource: block.mermaidImageSource,
		level: block.level,
		indent: block.indent,
		marker: block.marker,
		quoteDepth: block.quoteDepth,
		svgSource: block.svgSource,
		svgWidth: block.svgWidth,
		svgHeight: block.svgHeight
	}
}

function cloneBlocks(blocks: MarkdownTextRenderBlock[]): MarkdownTextRenderBlock[] {
	const result = [] as MarkdownTextRenderBlock[]
	for (let index = 0; index < blocks.length; index++) result.push(cloneBlock(blocks[index]))
	return result
}

export function libmarkStreamApply(msgId: string, ops: AiWorkerOp[]): boolean {
	if (ops.length == 0) return false
	const entry = entryFor(msgId)
	// #ifdef APP-ANDROID
	prepareAndroidEntry(entry, ops)
	return true
	// #endif
	// #ifndef APP-ANDROID
	const applied = entry.adapter.applyOps(ops)
	refreshEntry(entry)
	return applied
	// #endif
}

export function libmarkStreamGetBlocks(msgId: string): MarkdownTextRenderBlock[] {
	const entry = streamEntries.get(msgId)
	if (entry == null) return emptyBlocks()
	touchEntry(msgId)
	// #ifdef APP-ANDROID
	return entry!.textBlocks
	// #endif
	// #ifndef APP-ANDROID
	return cloneBlocks(entry!.textBlocks)
	// #endif
}

// 仅刷新完成态（不序列化 AST），用于流式结束后的 UI 收尾
export function libmarkStreamMarkComplete(msgId: string): void {
	const entry = streamEntries.get(msgId)
	if (entry == null) return
	// #ifdef APP-ANDROID
	prepareAndroidEntry(entry!, [], true)
	return
	// #endif
	// #ifndef APP-ANDROID
	entry!.adapter.markComplete()
	refreshEntry(entry!, true)
	// #endif
}

// #ifdef APP-HARMONY || APP-ANDROID
// 正在等待 Worker 重建结果的消息（去重）
const rebuildingMsgIds = [] as string[]
// 本次会话重建失败的消息（避免反复请求）
const rebuildFailedMsgIds = [] as string[]
// #endif

/**
 * 请求 Worker 用 libmark 从消息原文（body）重建渲染 ops（重启/中断后的恢复路径）。
 * 页面运行环境无法调用 libmark 原生插件，统一由 Worker 解析，
 * 解析结果通过 setAiWorkerRebuildListener 的监听器回调，再调用 libmarkStreamApplyRebuild 应用。
 */
export function libmarkStreamRequestRebuild(msgId: string, text: string): boolean {
	// #ifdef APP-HARMONY || APP-ANDROID
	if (text.length == 0) return false
	if (rebuildFailedMsgIds.indexOf(msgId) >= 0) return false
	if (rebuildingMsgIds.indexOf(msgId) >= 0) return false
	const existing = streamEntries.get(msgId)
	if (existing != null && (existing!.textBlocks.length > 0 || existing!.preparationVersion > 0)) return false
	rebuildingMsgIds.push(msgId)
	requestAiWorkerMarkdownRebuild(msgId, text)
	return true
	// #endif
	// #ifndef APP-HARMONY
	// #ifndef APP-ANDROID
	return false
	// #endif
	// #endif
}

/**
 * 应用 Worker 回传的重建 ops；ops 为空或应用后无 blocks 均视为重建失败，本次会话不再重试。
 */
export function libmarkStreamApplyRebuild(msgId: string, ops: AiWorkerOp[]): boolean {
	// #ifdef APP-HARMONY || APP-ANDROID
	const index = rebuildingMsgIds.indexOf(msgId)
	if (index < 0) return false
	rebuildingMsgIds.splice(index, 1)
	const markFailed = (): boolean => {
		if (rebuildFailedMsgIds.indexOf(msgId) < 0) rebuildFailedMsgIds.push(msgId)
		return false
	}
	if (ops.length == 0) return markFailed()
	const applied = libmarkStreamApply(msgId, ops)
	// #ifndef APP-ANDROID
	if (streamEntries.get(msgId)!.adapter.getBlocks().length == 0) return markFailed()
	// #endif
	return applied
	// #endif
	// #ifndef APP-HARMONY
	// #ifndef APP-ANDROID
	return false
	// #endif
	// #endif
}

export function libmarkStreamReset(msgId: string): void {
	libmarkStreamRelease(msgId)
	const entry = entryFor(msgId)
	entry.adapter.reset()
	entry.textBlocks = emptyBlocks()
}

export function libmarkStreamRelease(msgId: string): void {
	// #ifdef APP-ANDROID
	const entry = streamEntries.get(msgId)
	if (entry != null) releaseAndroidPresentation(entry.workerId)
	// #endif
	releaseCodeHighlightSessions(msgId)
	streamEntries.delete(msgId)
	const index = streamEntryOrder.indexOf(msgId)
	if (index >= 0) streamEntryOrder.splice(index, 1)
	// #ifdef APP-ANDROID || APP-HARMONY
	const pendingIndex = rebuildingMsgIds.indexOf(msgId)
	if (pendingIndex >= 0) rebuildingMsgIds.splice(pendingIndex, 1)
	const failedIndex = rebuildFailedMsgIds.indexOf(msgId)
	if (failedIndex >= 0) rebuildFailedMsgIds.splice(failedIndex, 1)
	// #endif
}

export function releaseAllLibmarkStreams(): void {
	const ids: string[] = []
	streamEntries.forEach((entry: LibmarkStreamEntry) => { ids.push(entry.messageId) })
	for (let i = 0; i < ids.length; i++) libmarkStreamRelease(ids[i])
}
