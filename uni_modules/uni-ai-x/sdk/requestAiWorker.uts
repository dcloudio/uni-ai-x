import testMarkdownText from './testMarkdownText.uts';
import { llmModelMap } from '@/uni_modules/uni-ai-x/config.uts';
import { Chunk, Provider, RequestAiCoMessage, MarkdownElItem, Llm, CustomProviderCallbacks } from '@/uni_modules/uni-ai-x/types.uts';
import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import ParseMarkdownSimple from '@/uni_modules/uni-ai-x/sdk/parseMarkdownSimple.uts';
import treeToListSdk from '@/uni_modules/uni-ai-x/sdk/treeToList';
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'
import { getCustomProvider } from '@/uni_modules/uni-ai-x/sdk/provider-registry.uts'

export type OnMessageOptions = {
	type: string,
	data?: string | boolean | number,
	action?: 'set' | 'update' | 'remove' | 'add',
	index?: number,
	size?: number,
	markdownElList?: MarkdownElItem[]
}

type BeforeUpdateMdElList = (markdownTokenList : MarkdownToken[], isParseDone: boolean) => void;
type BailianOptionsOnChunkFn = (chunkObj : Chunk) => void
type BailianOptionsOnErrorFn = (err : UTSJSONObject) => void
type BailianOptionsOnDoneFn = (data : UTSJSONObject) => void
type BailianOptionsOnSuccessFn = (chunkObj : Chunk) => void
type BailianOptionsOnTaskCreateFn = (requestTask : RequestTask) => void
type BailianOptions = {
	llm : Llm,
	messages : RequestAiCoMessage[],
	stream ?: boolean,
	chat_id ?: string,
	onChunk ?: BailianOptionsOnChunkFn,
	onError ?: BailianOptionsOnErrorFn,
	onDone ?: BailianOptionsOnDoneFn,
	onSuccess ?: BailianOptionsOnSuccessFn,
	onTaskCreate ?: BailianOptionsOnTaskCreateFn
}

const SIMPLE_PARSE_INTERVAL = 120

// 消息类型
export type RequestAiOptions = {
	type: 'requestAi',
	messages: RequestAiCoMessage[],
	llm: Llm,
	chat_id: string
}

type OnMessageFn = (message : any) => void;
class RequestAiWorker {
	requestTask : RequestTask | null = null
	msgBody : string = ''
	thinkContent : string = ''
	parseMarkdownSimple : ParseMarkdownSimple | null = null
	onMessageFnList : OnMessageFn[] = [];
	canRender : boolean = true
	currentChatState : string = ''
	pendingMarkdownElList : MarkdownElItem[] | null = null
	pendingParseDone : boolean = false
	beforeUpdateMdElList : BeforeUpdateMdElList = (markdownTokenList : MarkdownToken[], isParseDone: boolean) => {}
	userAbort : boolean = false
	hasThinkContent : boolean = false
	constructor() {
		this.onMessageFnList = []
		this.beforeUpdateMdElList = (newMarkdownTokenList : MarkdownToken[], isParseDone: boolean) => {
			const markdownElList = newMarkdownTokenList.map((item : MarkdownToken) => this.token2el(item))
			this.pendingMarkdownElList = markdownElList
			this.pendingParseDone = this.pendingParseDone || isParseDone
			if (!this.canRender) return
			this.flushPendingRender()
		}
		this.resetParser()
	}
	entry() { }
	flushPendingRender() {
		const markdownElList = this.pendingMarkdownElList
		if (markdownElList == null) return
		const isParseDone = this.pendingParseDone
		this.pendingMarkdownElList = null
		this.pendingParseDone = false
		this.emitOnMessage({
			type: "setMarkdownElList",
			action: 'set',
			markdownElList
		})
		if (isParseDone) {
			this.currentChatState = 'completed'
			this.emitOnMessage({
				type: "setCurrentChatState",
				data: 'completed'
			})
			this.emitOnMessage({type: "setRendered", data: true} as OnMessageOptions)
		}
	}
	resetParser() {
		this.parseMarkdownSimple = new ParseMarkdownSimple(this.beforeUpdateMdElList, SIMPLE_PARSE_INTERVAL)
	}
	token2el(token : MarkdownToken) : MarkdownElItem {
		return {
			uniqueId: token.uniqueId!,
			type: token.type!,
			datasList: treeToListSdk.markTreeToList(token)
		}
	}
	onChunkFn(chunkObj : Chunk) {
		let reasoningContent: null | string = null
		let content = chunkObj.choices?.[0]?.delta?.content
		if (this.msgBody == '' && content == "<think>") {
			this.hasThinkContent = true
			content = ''
		}
		if (this.hasThinkContent) {
			if (content != '</think>') {
				reasoningContent = content
			} else {
				this.hasThinkContent = false
			}
			content = ''
		}

		reasoningContent = reasoningContent ?? chunkObj.choices?.[0]?.delta?.reasoning_content
		if (content != null && content.length > 0) {
			this.msgBody += content
			this.emitOnMessage({
				type: "setMsgBody",
				data: this.msgBody
			})
		} else if (reasoningContent != null) {
			this.thinkContent += reasoningContent
			this.emitOnMessage({
				type: "setThinkContent",
				data: this.thinkContent.trim()
			})
		}

		if (content != null) {
			this.runMarkdownParse(false)
		}
	};
	runMarkdownParse(isDone: boolean = false) {
		console.log('uni-ai-x-render run mode=simple done=' + isDone)
		this.parseMarkdownSimple!.msgReceiveDone = isDone
		if (isDone) {
			this.parseMarkdownSimple?.flush(this.msgBody)
		} else {
			this.parseMarkdownSimple?.runTask(this.msgBody)
		}
	}
	requestAi(messages : RequestAiCoMessage[], llm : Llm, chat_id : string) {
		console.log('uni-ai-x-render request mode=simple')
		this.msgBody = ''
		this.thinkContent = ''
		this.currentChatState = ''
		this.pendingMarkdownElList = null
		this.pendingParseDone = false
		this.userAbort = false
		this.hasThinkContent = false
		this.resetParser()

		if (testMarkdownText.length > 0) {
			let i = 0
			let timer: number = 0
			timer = setInterval(() => {
				if (this.userAbort || i >= testMarkdownText.length) {
					clearInterval(timer)
					this.runMarkdownParse(true)
				} else {
					const batchSize = 10
					const endIndex = Math.min(i + batchSize, testMarkdownText.length)
					const newText = testMarkdownText.slice(i, endIndex)
					this.msgBody += newText
					this.emitOnMessage({
						type: "setMsgBody",
						data: this.msgBody
					})
					i = endIndex
					this.runMarkdownParse(false)
				}
			}, 100)
			return
		}

		this.updateChatTitle(messages, llm)
		this.requestAlServer({
			llm,
			messages,
			stream: true,
			chat_id: chat_id,
			onTaskCreate: (requestTask : RequestTask) => {
				this.requestTask = requestTask
			},
			onChunk: (chunkObj : Chunk) => {
				this.onChunkFn(chunkObj)
			},
			onError: (errRes) => {
				console.error('requestAlServer error', errRes)
				errRes = errRes as UTSJSONObject
				const errCode = errRes.getString('errCode', '')
				let errMsg = errRes.getString('errMsg', '未知错误')
				if (errCode == 'data_inspection_failed') {
					errMsg = '数据检查失败，疑似包含敏感信息'
				}
				if (this.userAbort == false) {
					this.emitOnMessage({
						type: "setErrorMsg",
						data: errMsg
					})
				}
				this.currentChatState = 'stop'
				this.emitOnMessage({
					type: "setCurrentChatState",
					data: 'stop'
				})
			},
			onDone: () => {
				if (this.currentChatState == 'stop') {
					console.log('requestAlServer onDone 当前对话已停止，忽略消息')
					return
				}
				if (!this.msgBody.endsWith('\n')) {
					this.msgBody += '\n'
				}
				this.runMarkdownParse(true)
			}
		}).finally(() => {
			this.requestTask = null
		})
	}
	async requestViaCustomProvider(options : BailianOptions, resolveFn : (data : UTSJSONObject) => void, rejectFn : (data : UTSJSONObject) => void) : Promise<UTSJSONObject> {
		const adapter = getCustomProvider(options.llm.provider)
		if (adapter == null) {
			const errInfo: UTSJSONObject = {
				errCode: -200,
				errMsg: '自定义提供商适配器未注册: ' + options.llm.provider
			}
			options.onError?.(errInfo)
			return new Promise<UTSJSONObject>((resolve, reject) => {
				reject(errInfo)
			})
		}

		try {
			const callbacks: CustomProviderCallbacks = {
				onChunk: options.onChunk,
				onError: options.onError,
				onDone: options.onDone
			}
			const currentChatId = options.chat_id ?? ''
			const success = await adapter.request(options.messages, options.llm.model, currentChatId, callbacks)

			if (!success) {
				const errInfo: UTSJSONObject = {
					errCode: -201,
					errMsg: '自定义提供商发送消息失败'
				}
				options.onError?.(errInfo)
				return new Promise<UTSJSONObject>((resolve, reject) => {
					reject(errInfo)
				})
			}

			return new Promise<UTSJSONObject>((resolve, reject) => {
				resolveFn = resolve
				rejectFn = reject
			})
		} catch (e) {
			console.error('自定义提供商请求异常', e)
			const errInfo: UTSJSONObject = {
				errCode: -204,
				errMsg: '自定义提供商请求异常'
			}
			options.onError?.(errInfo)
			return new Promise<UTSJSONObject>((resolve, reject) => {
				reject(errInfo)
			})
		}
	}
	async requestAlServer(options : BailianOptions) : Promise<UTSJSONObject> {
		let resolveFn = (_ : UTSJSONObject) : void => { }, rejectFn = resolveFn;
		const config : Provider = llmModelMap.get(options.llm.provider)!

		if (getCustomProvider(options.llm.provider) != null) {
			return this.requestViaCustomProvider(options, resolveFn, rejectFn)
		}

		let tmpToken : string;
		try {
			tmpToken = await config.getToken?.()!
		} catch (e) {
			options.onError?.({
				errCode: -100,
				errMsg: '获取临时token失败'
			} as UTSJSONObject)
			return new Promise<UTSJSONObject>((resolve, reject) => {
				reject({
					errCode: -100,
					errMsg: '获取临时token失败'
				} as UTSJSONObject)
			})
		}
		const requestTask: RequestTask = uni.request({
			url: config.baseURL!,
			method: 'POST',
			dataType: 'text',
			data: {
				messages: options.messages,
				stream: options.stream ?? true,
				model: options.llm.model
			},
			// @ts-ignore
			enableChunked: options.stream ?? true,
			header: {
				'Authorization': `Bearer ${tmpToken}`,
				'Content-Type': 'application/json'
			},
			success: (res : RequestSuccess<any>) => {
				if (options.stream == false) {
					const strData = typeof res.data == 'string' ? res.data : JSON.stringify(res.data)
					const chunkObj : Chunk = (JSON.parse<Chunk>(strData) ?? {}) as Chunk
					options.onSuccess?.(chunkObj)
				} else {
					if (res.data instanceof UTSJSONObject) {
						const error = res.data.getJSON('error')
						if (error != null) {
							const errInfo: UTSJSONObject = {
								errCode: error.getString('code', 'unknown'),
								errMsg: error.getString('message', '未知错误')
							}
							options.onError?.(errInfo)
							rejectFn(errInfo)
							return
						}
					}
					resolveFn({} as UTSJSONObject)
				}
			},
			fail: (err : RequestFail) => {
				console.error('request fail', err)
				const errInfo: UTSJSONObject = {
					errCode: err.errCode,
					errMsg: err.errMsg
				}
				rejectFn(errInfo)
				options.onError?.(errInfo)
			}
		})
		options.onTaskCreate?.(requestTask)
		if (options.stream == true) {
			// @ts-ignore
			requestTask.onChunkReceived((chunk : RequestTaskOnChunkReceivedListenerResult) => {
				parseChunkData(chunk.data as ArrayBuffer, (chunkObj : Chunk) => {
					options.onChunk?.(chunkObj)
				},
					(err : UTSJSONObject) => {
						err.errCode = err.code ?? ''
						err.errMsg = err.message ?? '未知错误'
						options.onError?.(err)
						rejectFn(err)
					},
					() => {
						options.onDone?.({} as UTSJSONObject)
					})
			})
		}
		return new Promise<UTSJSONObject>((resolve, reject) => {
			resolveFn = (data : UTSJSONObject) => { resolve(data as UTSJSONObject) }
			rejectFn = (data : UTSJSONObject) => { reject(data as UTSJSONObject) }
		})
	}
	updateChatTitle(messages: RequestAiCoMessage[], llm: Llm) {
		const customAdapter = getCustomProvider(llm.provider)
		if (customAdapter != null && customAdapter.supportsTitleUpdate != true) return;
		messages = messages.slice(0)
		messages.push({
			role: 'user',
			content: '请总结一下这段对话的内容，不包含本对话，用于更新会话的标题。注意：可以直接使用的不要有多余的文字，只保留总结的内容。字数控制在 10 个字以内。'
		})
		this.requestAlServer({
			llm,
			messages,
			stream: false,
			onError: (err: UTSJSONObject) => {
				console.error('updateChatTitle error', err)
			},
			onSuccess: (chunkObj: Chunk) => {
				const newTitle = chunkObj.choices?.[0]?.message?.content
				this.emitOnMessage({
					type: "setChatTitle",
					data: newTitle ?? '更新失败'
				})
			}
		})
	}
	postMessage(message : RequestAiOptions | UTSJSONObject) {
		if (message instanceof RequestAiOptions) {
			const messageCopy : RequestAiOptions | UTSJSONObject = JSON.parse<RequestAiOptions>(JSON.stringify(message))!
			if (messageCopy instanceof RequestAiOptions) {
				utils.uniGetDispatcher("io", () => {
					this.requestAi(messageCopy.messages as RequestAiCoMessage[], messageCopy.llm, messageCopy.chat_id);
				});
			}
		} else if (message instanceof UTSJSONObject) {
			const type = message.getString('type')
			if (type == 'abortRequest') {
				this.parseMarkdownSimple!.userAbort = true
				this.userAbort = true
				this.requestTask?.abort()
				this.emitOnMessage({
					type: "setCurrentChatState",
					data: 'stop'
				})
				this.onMessageFnList.length = 0
			} else if (type == 'setCanRender') {
				this.canRender = message.getBoolean('value', true)
				if (this.canRender) {
					this.flushPendingRender()
				}
			} else {
				console.error('postMessage未知任务类型的消息', message)
			}
		} else {
			console.error('postMessage未知类型的消息', message)
		}
	}
	emitOnMessage(message : OnMessageOptions) {
		const messageCopy = JSON.parse<OnMessageOptions>(JSON.stringify(message)) as OnMessageOptions
		this.onMessageFnList.forEach(fn => {
			utils.uniGetDispatcher("main", () => {
				fn(messageCopy);
			});
		});
	}
	onMessage(onMessageFn : OnMessageFn) {
		this.onMessageFnList.push(onMessageFn);
	}
}
export default RequestAiWorker;

function parseChunkData(chunkData : ArrayBuffer, callback : (chunkObj : Chunk) => void, errorCallback : (err : UTSJSONObject) => void, doneCallback : () => void) {
	utils.uniGetDispatcher("io", () => {
		const chunkText : string = new TextDecoder().decode(chunkData)
		const normalizedChunkText = chunkText.replace(/\r\n/g, '\n').replace(/\r/g, '\n')
		const lines : string[] = normalizedChunkText.split('\n\n')
		lines.forEach((line : string) => {
			if (line.length == 0) return
			line.split('\n').forEach((lineItem : string) => {
				if (lineItem.length == 0) return
				const keyValue : string[] = lineItem.split(':')
				const key : string = keyValue[0].trim()
				const value : string = keyValue.slice(1).join(':')
				const normalizedValue = value.trim()
				if (key == 'data') {
					if (normalizedValue == "[DONE]") {
						doneCallback()
						return
					}
					let chunk : Chunk | null = null
					try {
						chunk = JSON.parse<Chunk>(value.trimStart()) as Chunk
					} catch (e) {
						console.error('JSON.parse error', e, 'value:', value)
					}
					callback(chunk ?? {} as Chunk);
				} else if (key == '{"error"') {
					let info : UTSJSONObject = {}
					try {
						info = JSON.parse<UTSJSONObject>('{"error":' + value.trimStart()) as UTSJSONObject
					} catch (e) {
						console.error('JSON.parse error', e, 'value:', value)
					}
					errorCallback(info.error! as UTSJSONObject)
					doneCallback()
				} else {
					callback({} as Chunk);
				}
			})
		})
	})
}
