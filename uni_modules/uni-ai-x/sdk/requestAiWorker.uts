import testMarkdownText from './testMarkdownText.uts';
import { llmModelMap } from '@/uni_modules/uni-ai-x/config.uts';
import { Chunk, Provider, RequestAiCoMessage, MarkdownElItem, Llm, CustomProviderCallbacks } from '@/uni_modules/uni-ai-x/types.uts';
import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import ParseMarkdownSimple from '@/uni_modules/uni-ai-x/sdk/parseMarkdownSimple.uts';
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'
import { getCustomProvider } from '@/uni_modules/uni-ai-x/sdk/provider-registry.uts'
import { parseChunkData } from '@/uni_modules/uni-ai-x/sdk/sse.uts'

export type OnMessageOptions = {
	type: string,
	data?: string | boolean | number,
	markdownElList?: MarkdownElItem[]
}

type BeforeUpdateMdElList = (markdownTokenList : MarkdownToken[], isParseDone: boolean) => void;
type RequestAiOnChunkFn = (chunkObj : Chunk) => void
type RequestAiOnErrorFn = (err : UTSJSONObject) => void
type RequestAiOnDoneFn = (data : UTSJSONObject) => void
type RequestAiOnSuccessFn = (chunkObj : Chunk) => void
type RequestAiOnTaskCreateFn = (requestTask : RequestTask) => void
type RequestAiServerOptions = {
	llm : Llm,
	messages : RequestAiCoMessage[],
	stream ?: boolean,
	chat_id ?: string,
	onChunk ?: RequestAiOnChunkFn,
	onError ?: RequestAiOnErrorFn,
	onDone ?: RequestAiOnDoneFn,
	onSuccess ?: RequestAiOnSuccessFn,
	onTaskCreate ?: RequestAiOnTaskCreateFn
}

const SIMPLE_PARSE_INTERVAL = 120
const DEMO_STREAM_BATCH_SIZE = 10
const DEMO_STREAM_INTERVAL = 100

// 消息类型
export type RequestAiOptions = {
	type: 'requestAi',
	messages: RequestAiCoMessage[],
	llm: Llm,
	chat_id: string
}

type OnMessageFn = (message : OnMessageOptions) => void;
class RequestAiWorker {
	requestTask : RequestTask | null = null
	msgBody : string = ''
	thinkContent : string = ''
	parseMarkdownSimple : ParseMarkdownSimple | null = null
	onMessageFnList : OnMessageFn[] = [];
	currentChatState : string = ''
	beforeUpdateMdElList : BeforeUpdateMdElList = (markdownTokenList : MarkdownToken[], isParseDone: boolean) => {}
	userAbort : boolean = false
	hasThinkContent : boolean = false
	constructor() {
		this.onMessageFnList = []
		this.beforeUpdateMdElList = (newMarkdownTokenList : MarkdownToken[], isParseDone: boolean) => {
			this.emitOnMessage({
				type: "setMarkdownElList",
				markdownElList: newMarkdownTokenList
			})
			if (isParseDone) {
				this.currentChatState = 'completed'
				this.emitOnMessage({
					type: "setCurrentChatState",
					data: 'completed'
				})
				this.emitOnMessage({type: "setRendered", data: true} as OnMessageOptions)
			}
		}
		this.resetParser()
	}
	entry() { }
	resetParser() {
		this.parseMarkdownSimple = new ParseMarkdownSimple(this.beforeUpdateMdElList, SIMPLE_PARSE_INTERVAL)
	}
	onChunkFn(chunkObj : Chunk) {
		let reasoningContent: null | string = null
		let content = chunkObj.choices?.[0]?.delta?.content
		if (this.msgBody == '' && content == "<think>") {
			this.hasThinkContent = true
			content = ''
		}
		if (this.hasThinkContent) {
			if (content != '</think>') {
				reasoningContent = content
			} else {
				this.hasThinkContent = false
			}
			content = ''
		}

		reasoningContent = reasoningContent ?? chunkObj.choices?.[0]?.delta?.reasoning_content
		if (content != null && content.length > 0) {
			this.msgBody += content
			this.emitOnMessage({
				type: "setMsgBody",
				data: this.msgBody
			})
		} else if (reasoningContent != null) {
			this.thinkContent += reasoningContent
			this.emitOnMessage({
				type: "setThinkContent",
				data: this.thinkContent.trim()
			})
		}

		if (content != null) {
			this.runMarkdownParse(false)
		}
	};
	runMarkdownParse(isDone: boolean = false) {
		this.parseMarkdownSimple!.msgReceiveDone = isDone
		if (isDone) {
			this.parseMarkdownSimple?.flush(this.msgBody)
		} else {
			this.parseMarkdownSimple?.runTask(this.msgBody)
		}
	}
	resetRequestState() {
		this.msgBody = ''
		this.thinkContent = ''
		this.currentChatState = ''
		this.userAbort = false
		this.hasThinkContent = false
		this.resetParser()
	}
	handleRequestError(errRes: UTSJSONObject) {
		console.error('requestAiServer error', errRes)
		const errCode = errRes.getString('errCode', '')
		let errMsg = errRes.getString('errMsg', '未知错误')
		if (errCode == 'data_inspection_failed') {
			errMsg = '数据检查失败，疑似包含敏感信息'
		}
		if (this.userAbort == false) {
			this.emitOnMessage({
				type: "setErrorMsg",
				data: errMsg
			})
		}
		this.currentChatState = 'stop'
		this.emitOnMessage({
			type: "setCurrentChatState",
			data: 'stop'
		})
	}
	finishRequest() {
		if (this.currentChatState == 'stop') {
			return
		}
		if (!this.msgBody.endsWith('\n')) {
			this.msgBody += '\n'
		}
		this.runMarkdownParse(true)
	}
	requestAi(messages : RequestAiCoMessage[], llm : Llm, chat_id : string) {
		this.resetRequestState()

		if (testMarkdownText.length > 0) {
			this.streamDemoMarkdown()
			return
		}

		this.updateChatTitle(messages, llm)
		this.requestAiServer({
			llm,
			messages,
			stream: true,
			chat_id: chat_id,
			onTaskCreate: (requestTask : RequestTask) => {
				this.requestTask = requestTask
			},
			onChunk: (chunkObj : Chunk) => {
				this.onChunkFn(chunkObj)
			},
			onError: (errRes) => {
				this.handleRequestError(errRes as UTSJSONObject)
			},
			onDone: () => {
				this.finishRequest()
			}
		}).finally(() => {
			this.requestTask = null
		})
	}
	streamDemoMarkdown() {
		let index = 0
		let timer: number = 0
		timer = setInterval(() => {
			if (this.userAbort || index >= testMarkdownText.length) {
				clearInterval(timer)
				this.runMarkdownParse(true)
				return
			}
			const endIndex = Math.min(index + DEMO_STREAM_BATCH_SIZE, testMarkdownText.length)
			this.msgBody += testMarkdownText.slice(index, endIndex)
			this.emitOnMessage({
				type: "setMsgBody",
				data: this.msgBody
			})
			index = endIndex
			this.runMarkdownParse(false)
		}, DEMO_STREAM_INTERVAL)
	}
	async requestViaCustomProvider(options : RequestAiServerOptions) : Promise<UTSJSONObject> {
		const adapter = getCustomProvider(options.llm.provider)
		if (adapter == null) {
			const errInfo: UTSJSONObject = {
				errCode: -200,
				errMsg: '自定义提供商适配器未注册: ' + options.llm.provider
			}
			options.onError?.(errInfo)
			throw errInfo
		}

		const callbacks: CustomProviderCallbacks = {
			onChunk: options.onChunk,
			onError: options.onError,
			onDone: options.onDone
		}
		const currentChatId = options.chat_id ?? ''
		let success = false
		try {
			success = await adapter.request(options.messages, options.llm.model, currentChatId, callbacks)
		} catch (e) {
			console.error('自定义提供商请求异常', e)
			const errInfo: UTSJSONObject = {
				errCode: -204,
				errMsg: '自定义提供商请求异常'
			}
			options.onError?.(errInfo)
			throw errInfo
		}
		if (!success) {
			const errInfo: UTSJSONObject = {
				errCode: -201,
				errMsg: '自定义提供商发送消息失败'
			}
			options.onError?.(errInfo)
			throw errInfo
		}
		return {} as UTSJSONObject
	}
	async requestAiServer(options : RequestAiServerOptions) : Promise<UTSJSONObject> {
		let resolveFn = (_ : UTSJSONObject) : void => { }, rejectFn = resolveFn;
		const config : Provider = llmModelMap.get(options.llm.provider)!

		if (getCustomProvider(options.llm.provider) != null) {
			return this.requestViaCustomProvider(options)
		}

		let tmpToken : string;
		try {
			tmpToken = await config.getToken?.()!
		} catch (e) {
			const errInfo: UTSJSONObject = {
				errCode: -100,
				errMsg: '获取临时token失败'
			}
			options.onError?.(errInfo)
			throw errInfo
		}
		const requestTask: RequestTask = uni.request({
			url: config.baseURL!,
			method: 'POST',
			dataType: 'text',
			data: {
				messages: options.messages,
				stream: options.stream ?? true,
				model: options.llm.model
			},
			// @ts-ignore
			enableChunked: options.stream ?? true,
			header: {
				'Authorization': `Bearer ${tmpToken}`,
				'Content-Type': 'application/json'
			},
			success: (res : RequestSuccess<any>) => {
				if (options.stream == false) {
					const strData = typeof res.data == 'string' ? res.data : JSON.stringify(res.data)
					const chunkObj : Chunk = (JSON.parse<Chunk>(strData) ?? {}) as Chunk
					options.onSuccess?.(chunkObj)
				} else {
					if (res.data instanceof UTSJSONObject) {
						const error = res.data.getJSON('error')
						if (error != null) {
							const errInfo: UTSJSONObject = {
								errCode: error.getString('code', 'unknown'),
								errMsg: error.getString('message', '未知错误')
							}
							options.onError?.(errInfo)
							rejectFn(errInfo)
							return
						}
					}
					resolveFn({} as UTSJSONObject)
				}
			},
			fail: (err : RequestFail) => {
				console.error('request fail', err)
				const errInfo: UTSJSONObject = {
					errCode: err.errCode,
					errMsg: err.errMsg
				}
				rejectFn(errInfo)
				options.onError?.(errInfo)
			}
		})
		options.onTaskCreate?.(requestTask)
		if (options.stream == true) {
			// @ts-ignore
			requestTask.onChunkReceived((chunk : RequestTaskOnChunkReceivedListenerResult) => {
				parseChunkData(chunk.data as ArrayBuffer, (chunkObj : Chunk) => {
					options.onChunk?.(chunkObj)
				},
					(err : UTSJSONObject) => {
						err.errCode = err.code ?? ''
						err.errMsg = err.message ?? '未知错误'
						options.onError?.(err)
						rejectFn(err)
					},
					() => {
						options.onDone?.({} as UTSJSONObject)
					})
			})
		}
		return new Promise<UTSJSONObject>((resolve, reject) => {
			resolveFn = (data : UTSJSONObject) => { resolve(data as UTSJSONObject) }
			rejectFn = (data : UTSJSONObject) => { reject(data as UTSJSONObject) }
		})
	}
	updateChatTitle(messages: RequestAiCoMessage[], llm: Llm) {
		const customAdapter = getCustomProvider(llm.provider)
		if (customAdapter != null && customAdapter.supportsTitleUpdate != true) return;
		messages = messages.slice(0)
		messages.push({
			role: 'user',
			content: '请总结一下这段对话的内容，不包含本对话，用于更新会话的标题。注意：可以直接使用的不要有多余的文字，只保留总结的内容。字数控制在 10 个字以内。'
		})
		this.requestAiServer({
			llm,
			messages,
			stream: false,
			onError: (err: UTSJSONObject) => {
				console.error('updateChatTitle error', err)
			},
			onSuccess: (chunkObj: Chunk) => {
				const newTitle = chunkObj.choices?.[0]?.message?.content
				this.emitOnMessage({
					type: "setChatTitle",
					data: newTitle ?? '更新失败'
				})
			}
		})
	}
	postMessage(message : RequestAiOptions) {
		utils.uniGetDispatcher("io", () => {
			this.requestAi(message.messages, message.llm, message.chat_id);
		});
	}
	abortRequest() {
		this.parseMarkdownSimple!.userAbort = true
		this.userAbort = true
		this.requestTask?.abort()
		this.emitOnMessage({
			type: "setCurrentChatState",
			data: 'stop'
		})
		this.onMessageFnList.length = 0
	}
	emitOnMessage(message : OnMessageOptions) {
		this.onMessageFnList.forEach(fn => {
			utils.uniGetDispatcher("main", () => {
				fn(message);
			});
		});
	}
	onMessage(onMessageFn : OnMessageFn) {
		this.onMessageFnList.push(onMessageFn);
	}
}
export default RequestAiWorker;
