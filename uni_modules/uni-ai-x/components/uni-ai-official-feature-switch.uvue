<template>
	<view v-if="officialFeatureSwitch.visible" class="restriction-overlay uni-theme-root" @click.stop="block">
		<view class="restriction-dialog" @click.stop="block">
			<text class="restriction-title">{{tr('功能使用限制', 'Feature restriction')}}</text>
			<text class="restriction-content">{{officialFeatureSwitch.content}}</text>
			<view class="restriction-actions">
				<view class="restriction-button restriction-cancel" @click="resolveOfficialFeatureSwitch(false)"><text class="restriction-cancel-text">{{tr('暂不切换', 'Not now')}}</text></view>
				<view class="restriction-button" @click="resolveOfficialFeatureSwitch(true)"><text class="restriction-confirm-text">{{tr('立即切换', 'Switch now')}}</text></view>
			</view>
		</view>
	</view>
</template>
<script setup lang="uts">
