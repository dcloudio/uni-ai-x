<template>
	<image v-if="isImage" class="uni-ai-md-inline-image" :src="imageSrc" mode="widthFix" @click="previewImage" />
	<text v-else class="uni-ai-md-inline" :class="inlineClass" @click="toLink">{{inlineText}}</text>
</template>

<script lang="uts" setup>
	import { MarkdownAstNode } from '@/uni_modules/uni-ai-worker/utssdk/markdown-ast.uts'

	type UniAiMdInlineProps = {
		node: MarkdownAstNode
	}

	defineOptions({
		name: 'uni-ai-md-inline'
	})
	const props = defineProps<UniAiMdInlineProps>()

	const isImage = computed<boolean>(() => props.node.type == 'image')
	const imageSrc = computed<string>(() => props.node.url ?? '')

	const inlineClass = computed<string>(() => {
		const type = props.node.type
		if (type == 'emph') return 'uni-ai-md-inline-em'
		if (type == 'strikethrough') return 'uni-ai-md-inline-del'
		return 'uni-ai-md-inline-' + type
	})

	const inlineText = computed<string>(() => tokenText(props.node))

	function tokenText(node: MarkdownAstNode): string {
		const type = node.type
		if (type == 'softbreak' || type == 'linebreak' || type == 'br') return '\n'
		if (node.literal != null) return node.literal!
		let text = ''
		const children = node.children
		if (children != null) {
			for (let index = 0; index < children.length; index++) text += tokenText(children[index])
		}
		return text
	}

	function toLink() {
		const url = props.node.url
		if (url == null || url.length == 0) return
		uni.navigateTo({
			url: '/uni_modules/uni-ai-x/pages/common/webview/webview?url=' + url,
			fail: (e) => {
				console.error(e)
			}
		})
	}

	function previewImage() {
		const src = props.node.url
		if (src == null || src.length == 0) return
		uni.previewImage({ urls: [src] as string[] })
	}
</script>

<style lang="scss">
	@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

	.uni-ai-md-inline {
		font-size: 18px;
		line-height: 28px;
		color: var(--text-primary);
		white-space: pre-wrap;
	}

	.uni-ai-md-inline-strong {
		font-weight: 700;
	}

	.uni-ai-md-inline-em {
		font-style: italic;
	}

	.uni-ai-md-inline-del {
		text-decoration-line: line-through;
	}

	.uni-ai-md-inline-code {
		font-size: 16px;
		padding: 1px 4px;
		border-radius: 4px;
		background-color: var(--bg-tertiary);
	}

	.uni-ai-md-inline-link {
		color: #2979ff;
		text-decoration-line: underline;
	}

	.uni-ai-md-inline-image {
		width: 240px;
		border-radius: 6px;
	}
</style>
