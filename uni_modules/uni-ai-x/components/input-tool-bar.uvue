<template>
	<view class="input-tool-bar" :class="[`ui-theme-${uiTheme}`]">
		<view class="input-tool-bar-main">
		<view class="input-tool-bar-btn" :class="currentLLMModel.thinking == true ? 'input-tool-bar-btn-active' : ''" @click="setThinking">
            <uni-ai-icon code="e639" :color="isOpenClaw ? '#aaa' : (currentLLMModel.thinking != null ? '#3c76e4': !hasDeepseekR1Model ? '#aaa' : '#666')"></uni-ai-icon>
            <text class="input-tool-bar-text" :class="[(currentLLMModel.thinking ?? false) ? 'input-tool-bar-text-active' : '', isOpenClaw ? 'input-tool-bar-text-disable' : (!hasDeepseekR1Model ? 'input-tool-bar-text-disable' : '')]">深度思考 (R1)</text>
			</view>
			<view class="input-tool-bar-btn input-tool-bar-search" :class="[!canWebSearch ? 'input-tool-bar-btn-disable' : '', webSearch ? 'input-tool-bar-btn-active' : '']" @click="setWebSearch">
            <uni-ai-icon code="e797" :color="webSearch ? '#3c76e4': !canWebSearch ? '#aaa' : '#666'"></uni-ai-icon>
            <text class="input-tool-bar-text" :class="[!canWebSearch ? 'input-tool-bar-text-disable' : '', webSearch ? 'input-tool-bar-text-active' : '']">联网搜索</text>
			</view>
			<uni-icons v-if="canParseImg" @click="uploadImage" class="input-tool-bar-upload-image-btn" type="plusempty" size="25" color="var(--text-secondary)"></uni-icons>
		<view v-if="aiState == 'processing'" class="input-tool-bar-stop input-tool-bar-stop-active"
			@click="stop">
            <uni-ai-icon code="e691" color="#FFF" size="14"></uni-ai-icon>
        </view>
		<view v-else class="input-tool-bar-send" @click="send" :class="inputContent.length > 0 && allUploaded ? 'input-tool-bar-send-active' : ''"
					<!-- #ifdef WEB -->
					:title="allUploaded ? '发送' : '请等待图片上传完成'"
					<!-- #endif -->
				>
            <uni-ai-icon code="e627" color="#FFF" size="20"></uni-ai-icon>
        </view>
		</view>
		<view class="input-tool-bar-stress">
			<button class="input-tool-bar-stress-button" :class="!canCopyMessages ? 'input-tool-bar-stress-button-disabled' : ''" :disabled="!canCopyMessages" @click="copyMessages">复制100条消息</button>
			<button class="input-tool-bar-stress-button" :class="!canCopyChats ? 'input-tool-bar-stress-button-disabled' : ''" :disabled="!canCopyChats" @click="copyChats">复制500个会话</button>
		</view>
		<view v-if="copyingChats" class="input-tool-bar-copy-mask">
			<text class="input-tool-bar-copy-mask-text">正在复制会话 {{copiedChats}} / 500</text>
		</view>
    </view>
</template>
<script lang="uts" setup>
import uniAi, { uiTheme, isCustomProvider } from '@/uni_modules/uni-ai-x/sdk';
import {llmModelMap, defaultLLM, type LLMModel} from '../config';
import { uploadDraftImages } from '@/uni_modules/uni-ai-x/sdk/image-upload.uts';
import { getModelCapabilitySummary } from '@/uni_modules/uni-ai-x/sdk/model-capabilities.uts';

const modelCapabilitySummary = getModelCapabilitySummary()
const canWebSearchLLmList = modelCapabilitySummary.webSearchModelNames
const hasDeepseekR1Model = modelCapabilitySummary.hasDeepseekR1Model
const hasDoubaoSeed16Model = modelCapabilitySummary.hasDoubaoSeed16Model

const isOpenClaw = computed<boolean>(() => {
    return isCustomProvider(uniAi.llm.provider);
});


const aiState = computed<string>(() => {
    return uniAi.currentChat?.state ?? 'none'
});

const inputContent = computed<string>({
    get: (): string => {
        return uniAi.currentChat?.inputContent ?? ''
    },
    set: (value: string) => {
        if (uniAi.currentChat != null) {
            uniAi.currentChat!.inputContent = value
        }
    }
})

const canParseImg = computed<boolean>(() => {
    return true
});

const copyingChats = ref<boolean>(false)
const copiedChats = ref<number>(0)
let targetCopiedChats = 0
let completedChatCount = 0
let copyProgressTimer: number | null = null
let stressCopyRunId = ''
const canCopyMessages = computed<boolean>(() => {
    return !copyingChats.value && aiState.value != 'processing' && uniAi.lastAiMsg != null
})
const canCopyChats = computed<boolean>(() => {
    return !copyingChats.value && aiState.value != 'processing' && (uniAi.currentChat?.msgList.length ?? 0) > 0
})

function copyMessages() {
    if (!canCopyMessages.value) return
    uniAi.copyLastMessageForStress(100)
}

function copyChats() {
    if (!canCopyChats.value) return
    copyingChats.value = true
    copiedChats.value = 0
    completedChatCount = 0
    targetCopiedChats = 500
    stressCopyRunId = Date.now().toString(36)
    startCopyProgressSampling()
    copyNextChat()
}

function startCopyProgressSampling() {
    if (copyProgressTimer != null) clearInterval(copyProgressTimer)
    copyProgressTimer = setInterval(() => {
        copiedChats.value = completedChatCount
    }, 250) as number
}

function stopCopyProgressSampling() {
    if (copyProgressTimer != null) {
        clearInterval(copyProgressTimer)
        copyProgressTimer = null
    }
    copiedChats.value = completedChatCount
}

const copyNextChat = async () => {
    if (completedChatCount >= targetCopiedChats) {
        uniAi.saveChatList2Storage()
        stopCopyProgressSampling()
        copyingChats.value = false
        return
    }
    const error = await uniAi.createCurrentChatStressCopy(stressCopyRunId, completedChatCount)
    if (error.length > 0) {
        uniAi.saveChatList2Storage()
        stopCopyProgressSampling()
        copyingChats.value = false
        return
    }
    completedChatCount += 1
    setTimeout(() => copyNextChat(), 0)
}

const currentLLMModel = computed<LLMModel>(() => {
    const provider = uniAi.llm.provider
    const model = uniAi.llm.model
    const currentProviderInfo = llmModelMap.get(provider)
    if (currentProviderInfo == null) {
        if (!isCustomProvider(provider)) {
            uni.showModal({
                content: 'provider：' + provider + ' 不可用，请到系统设置中切换为其他 provider',
                showCancel: false
            });
            console.error('provider：' + provider + ' 不可用，请到系统设置中切换为其他 provider')
        }
        return { name: model.length > 0 ? model : defaultLLM.model } as LLMModel
    }
    return currentProviderInfo.models.find(m => m.name == model) ?? currentProviderInfo.models[0]!
});

const webSearch = computed<boolean>(() => {
    return uniAi.llm.webSearch as boolean;
});

const canWebSearch = computed<boolean>(() => {
    const canWebSearch = currentLLMModel.value.webSearch ?? false;
    if (!canWebSearch) {
        uniAi.llm.webSearch = false;
    }
    return canWebSearch
});

const stop = async () => {
    uniAi.currentChat!.state = 'stop';
    uniAi.abortRequest()
    await nextTick()
};

const allUploaded = computed<boolean>(() => {
    return uniAi.imgList.every(img => img.uploadPercent == 100);
});

const send = async () => {
    if (inputContent.value.length == 0) {
        return;
    }
    if (!allUploaded.value) {
        uni.showToast({
            title: '请等待图片上传完成',
            duration: 3000,
            icon: 'none'
        });
        return;
    }
    uniAi.sendMsg(inputContent.value)
    inputContent.value = '';
};

const canThinking = computed<boolean>(() => {
    return currentLLMModel.value.thinking ?? false;
});
const setThinking = () => {
    if (isOpenClaw.value) {
        uni.showToast({
            title: uniAi.llm.provider + '不支持深度思考',
            icon: 'none'
        });
        return
    }
    if (!hasDeepseekR1Model) {
        uni.showToast({
            title: '请在 config.json 中配置 deepseek-r1 模型',
            duration: 3000,
            icon: 'none'
        });
    } else {
        uniAi.llm.model = canThinking.value ? "deepseek-v3" : "deepseek-r1"
    }
};

const setWebSearch = () => {
    if (canWebSearch.value) {
        uniAi.llm.webSearch = !webSearch.value;
    } else {
        const title: string = canWebSearchLLmList.length > 0 ? `仅${canWebSearchLLmList.join('、')}模型支持联网搜索` : '当前模型不支持联网搜索';
        uni.showToast({
            title,
            duration: 3000,
            icon: 'none'
        });
    }
};

function uploadImage() {
    uploadDraftImages(currentLLMModel.value, hasDoubaoSeed16Model)
}

onMounted(() => {
    // #ifdef WEB
    document.addEventListener('keydown', async (e) => {
        if (e.key == 'Enter' && !e.ctrlKey && !e.shiftKey && !e.altKey && !e.metaKey && !e.isComposing) {
            e.preventDefault()
            if (aiState.value == 'processing') {
                await stop()
            }
            send()
        }
    })
    // #endif
});

onBeforeUnmount(() => {
    stopCopyProgressSampling()
})
</script>
<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
.ui-theme-light {
    --input-btn-active-bg: #dbeafe;
    --input-btn-bg: #f3f4f6;
}
.ui-theme-dark {
    --input-btn-active-bg: #3d434b;
    --input-btn-bg: #3d434b;
}

.input-tool-bar {
    display: flex;
    flex-direction: column;
    padding: 5px 0;
}

.input-tool-bar-main {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.input-tool-bar-btn {
    flex-direction: row;
    align-items: center;
    padding: 5px 10px;
    border-radius: 30px;
    margin-right: 5px;
    background-color: var(--input-btn-bg);
}

.input-tool-bar-btn-active {
    background-color: var(--input-btn-active-bg);
}

.input-tool-bar-text {
    font-size: 12px;
    color: var(--text-secondary);
    margin-left: 3px;
}

.input-tool-bar-text-active {
    color: var(--accent-primary);
}

.input-tool-bar-text-disable {
    color: var(--text-disabled);
}

.input-tool-bar-search {
    margin-right: auto;
}

.input-tool-bar-stop,
.input-tool-bar-send {
    background-color: var(--accent-secondary);
    width: 30px;
    height: 30px;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
}

.input-tool-bar-stop-active,
.input-tool-bar-send-active {
    background-color: var(--accent-primary);
}

.input-tool-bar-upload-image-btn {
    margin-right: 15px;
}

.input-tool-bar-stress {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.input-tool-bar-stress-button {
    height: 28px;
    margin-left: 4px;
    padding: 0 5px;
    border: 1px solid var(--border-primary);
    border-radius: 4px;
    background-color: var(--input-btn-bg);
    font-size: 11px;
    line-height: 26px;
    color: var(--text-secondary);
}

.input-tool-bar-stress-button-disabled {
    opacity: 0.45;
}

.input-tool-bar-copy-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 500;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.35);
}

.input-tool-bar-copy-mask-text {
    padding: 12px 16px;
    border-radius: 6px;
    background-color: var(--bg-primary);
    font-size: 14px;
    color: var(--text-primary);
}
</style>
