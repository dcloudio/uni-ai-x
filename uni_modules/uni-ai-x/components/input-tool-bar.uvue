<template>
	<view class="input-tool-bar uni-theme-root">
        <view class="composer-modes">
		<view class="input-tool-bar-btn" :class="[thinkingActive ? 'input-tool-bar-btn-active' : '', !canThinking ? 'input-tool-bar-btn-disable' : '']" @click="setThinking"
					<!-- #ifdef WEB -->
					:title="thinkingTitle"
					<!-- #endif -->
				>
            <uni-ai-icon name="think-outline" size="17" :color="!canThinking ? 'var(--text-disabled)' : (thinkingActive ? '#3c76e4' : 'var(--text-primary)')" />
            <text class="input-tool-bar-text" :class="[thinkingActive ? 'input-tool-bar-text-active' : '', !canThinking ? 'input-tool-bar-text-disable' : '']">{{tr('深度思考', 'Think')}}</text>
		</view>
			<view class="input-tool-bar-btn input-tool-bar-search" :class="[webSearch ? 'input-tool-bar-btn-active' : '']" @click="setWebSearch">
            <uni-ai-icon name="globe-outline" size="17" :color="webSearch ? '#3c76e4' : 'var(--text-primary)'" />
            <text class="input-tool-bar-text" :class="[webSearch ? 'input-tool-bar-text-active' : '']">{{tr('联网搜索', 'Search web')}}</text>
			</view>
        </view>
        <view class="composer-actions">
            <view class="composer-toggle" @click="toggleAttachments"><uni-ai-icon :name="composerState.attachments ? 'close-circle-outline' : 'plus-circle-outline'" size="26" color="var(--text-primary)" /></view>
            <view class="composer-toggle" @click="toggleVoice"><uni-ai-icon :name="composerState.voice ? 'keyboard-outline' : 'voice-outline'" size="26" color="var(--text-primary)" /></view>
		<view v-if="aiState == 'processing'" class="input-tool-bar-stop input-tool-bar-stop-active"
			@click="stop">
            <uni-ai-icon name="stop-fill" color="#FFF" size="14" />
        </view>
		<view v-else-if="inputContent.length > 0 || (uniAi.currentChat?.draftFiles?.length ?? 0) > 0 || uniAi.imgList.length > 0" class="input-tool-bar-send" @click="send" :class="inputContent.length > 0 && allUploaded ? 'input-tool-bar-send-active' : ''"
					<!-- #ifdef WEB -->
					:title="allUploaded ? tr('发送', 'Send') : tr('请等待附件就绪，或移除失败附件', 'Wait for attachments or remove failed files')"
					<!-- #endif -->
				>
            <uni-ai-icon name="send-outline" color="#FFF" size="20" />
        </view>
        </view>
    </view>
</template>
<script lang="uts" setup>
import { composerState } from '@/uni_modules/uni-ai-x/sdk/composer-state.uts'
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
import uniAi from '@/uni_modules/uni-ai-x/sdk';
import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'
import {llmModelMap, type LLMModel} from '../config';
import { documentDrafts } from '@/uni_modules/uni-ai-x/sdk/document-drafts.uts'

const isOpenClaw = computed<boolean>(() => {
    return uniAi.llm.provider == 'openClaw';
});


const aiState = computed<string>(() => {
    return uniAi.currentChat?.state ?? 'none'
});

const inputContent = computed<string>({
    get: (): string => {
        return uniAi.currentChat?.inputContent ?? ''
    },
    set: (value: string) => {
        if (uniAi.currentChat != null) {
            uniAi.currentChat!.inputContent = value
        }
    }
})

const currentLLMModel = computed<LLMModel>(() => {
    const provider = uniAi.llm.provider
    const model = uniAi.llm.model
    const currentProviderInfo = llmModelMap.get(provider)
    if (currentProviderInfo == null) {
        return { modelId: model } as LLMModel
    }
    return currentProviderInfo.models.find(m => m.modelId == model) ?? currentProviderInfo.models[0]!
});

let unavailableModelWarned = false
watch((): string => uniAi.llm.provider + '/' + uniAi.llm.model, (): void => {
    const providerConfig = llmModelMap.get(uniAi.llm.provider)
    const matched = providerConfig?.models.find(m => m.modelId == uniAi.llm.model)
    if (providerConfig != null && matched != null) {
        unavailableModelWarned = false
        return
    }
    if (unavailableModelWarned) return
    unavailableModelWarned = true
    uni.showModal({
        title: tr('当前模型不可用', 'Model unavailable'),
        content: tr('当前模型「', 'The model "') + uniAi.llm.model + tr('」不可用，请到系统设置中重新选择模型', '" is unavailable. Choose another model in Settings.'),
        showCancel: false
    })
})

const webSearch = computed<boolean>(() => {
    return uniAi.llm.webSearch as boolean;
});

const stop = async () => {
    uniAi.currentChat!.state = 'stop';
    uniAi.abortRequest()
    await nextTick()
};

const allUploaded = computed<boolean>(() => {
    return uniAi.imgList.every(img => img.uploadPercent == 100) && !documentDrafts.pending.some((item) => item.chatId == uniAi.currentChat?.id);
});

const send = async () => {
    if (inputContent.value.trim().length == 0 && (uniAi.currentChat?.draftFiles?.length ?? 0) == 0 && uniAi.imgList.length == 0) return
    if (!allUploaded.value) {
        uni.showToast({
            title: tr('请等待附件就绪，或移除失败附件', 'Wait for attachments or remove failed files'),
            duration: 3000,
            icon: 'none'
        });
        return;
    }
    const content = inputContent.value.trim().length > 0 ? inputContent.value : tr('请分析附件内容。', 'Analyze the attached files.')
    uniAi.sendMsg(content)
    inputContent.value = '';
};

const canThinking = computed<boolean>(() => {
    return currentLLMModel.value.thinking ?? false;
});

// 深度思考当前是否开启：模型支持思考，且用户未显式关闭（未设置时默认开启）
const thinkingActive = computed<boolean>(() => {
    return canThinking.value && (uniAi.llm.thinking ?? true);
});

// Web 端 hover 提示：不支持时提示不可操作，支持时提示切换动作
const thinkingTitle = computed<string>(() => {
    if (!canThinking.value) {
        return tr('当前模型不支持操作', 'This model does not support this')
    }
    return thinkingActive.value ? tr('关闭深度思考', 'Turn off thinking') : tr('开启深度思考', 'Turn on thinking')
});

const setThinking = () => {
    if (isOpenClaw.value) {
        uni.showToast({
            title: uniAi.llm.provider + tr('不支持深度思考', ' does not support thinking'),
            icon: 'none'
        });
        return
    }
    if (!canThinking.value) {
        uni.showToast({
            title: tr('当前模型不支持深度思考', 'This model does not support thinking'),
            duration: 3000,
            icon: 'none'
        });
        return
    }
    const enabled = !thinkingActive.value
    uniAi.llm.thinking = enabled
};

const setWebSearch = () => {
    uniAi.llm.webSearch = !webSearch.value;
};

function toggleAttachments() {
    if (composerState.voicePhase != 'idle') return
    composerState.attachments = !composerState.attachments
    uni.getElementById('chat-input-textarea')?.blur()
}
function toggleVoice() {
    if (composerState.voicePhase != 'idle') return
    composerState.voice = !composerState.voice
    composerState.attachments = false
    uni.getElementById('chat-input-textarea')?.blur()
}

onMounted(() => {
    // #ifdef WEB
    document.addEventListener('keydown', async (e) => {
        if (e.key == 'Enter' && !e.ctrlKey && !e.shiftKey && !e.altKey && !e.metaKey && !e.isComposing) {
            e.preventDefault()
            if (aiState.value == 'processing') {
                await stop()
            }
            send()
        }
    })
    // #endif
});

</script>
<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.input-tool-bar {
    flex-direction: row;
    align-items: center;
    padding: 0;
    flex-wrap: wrap;
    justify-content: space-between;
}

.input-tool-bar-btn {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--border-secondary);
    flex-shrink: 0;
    border-radius: 30px;
    margin-right: 8px;
    background-color: var(--bg-primary);
}

.input-tool-bar-btn-active {
    background-color: var(--input-btn-active-bg);
}

.input-tool-bar-btn-disable {
    /* #ifdef WEB */
    cursor: not-allowed;
    /* #endif */
}

.input-tool-bar-text {
    font-size: 14px;
    color: var(--text-primary);
    margin-left: 3px;
}

.input-tool-bar-text-active {
    color: var(--accent-primary);
}

.input-tool-bar-text-disable {
    color: var(--text-disabled);
}

.input-tool-bar-search {
    margin-right: 0;
}

.input-tool-bar-stop,
.input-tool-bar-send {
    background-color: var(--input-btn-active-bg);
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    margin-left: 4px;
    margin-right: 4px;
    justify-content: center;
    align-items: center;
    border-radius: 100px;
}

.input-tool-bar-stop-active,
.input-tool-bar-send-active {
    background-color: var(--accent-primary);
}

.composer-toggle {
    width: 34px; height: 34px; align-items: center; justify-content: center; flex-shrink: 0;
}

.composer-modes { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 36px; }
.composer-actions { flex-direction: row; align-items: center; justify-content: flex-end; margin-left: auto; flex-shrink: 0; min-height: 36px; }

</style>
