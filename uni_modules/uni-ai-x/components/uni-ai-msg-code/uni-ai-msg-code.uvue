<template>
	<view class="uni-code-msg-root" :class="[`ui-theme-${uiTheme}`, language == 'mermaid' ? 'uni-code-msg-root-mermaid' : '']">
		<view class="uni-code-msg-code-header">
			<view class="uni-code-msg-mermaid-switch" v-if="language == 'mermaid'">
				<text class="uni-code-msg-mermaid-item" :class="showMermaidImage ? 'uni-code-msg-mermaid-item-active' : ''" @click="setMermaidView(true)">图表</text>
				<text class="uni-code-msg-mermaid-item" :class="!showMermaidImage ? 'uni-code-msg-mermaid-item-active' : ''" @click="setMermaidView(false)">代码</text>
			</view>
			<template v-if="!showMermaidImage">
				<text class="uni-code-msg-language">{{language}}</text>
				<view class="uni-code-msg-copy-btn" @click="copyCode">
					<uni-ai-icon class="uni-code-msg-copy-icon" code="e60c" size="12" color="var(--text-primary)"/>
					<text class="uni-code-msg-copy-text">复制代码</text>
				</view>
			</template>
		</view>
		<view v-if="!showMermaidImage && shouldShowHorizontalHint" class="uni-code-msg-scroll-tip-row">
			<text class="uni-code-msg-scroll-tip">左右滑动查看完整代码</text>
		</view>
		<view v-if="language == 'mermaid' && showMermaidImage" class="uni-code-msg-mermaid-image-box">
			<image class="uni-code-msg-mermaid-image" :src="href" mode="aspectFit" @click="previewMermaidImage" />
		</view>
		<scroll-view v-else class="uni-code-msg-code-scroll-view" direction="horizontal" :style="{height: scrollViewHeight}">
			<text v-if="shouldUseOriginCode" class="uni-code-msg-origin-line" v-for="(lineText, lineIndex) in rawCodeLines" :key="'raw-' + lineIndex" :style="{width: maxLineWidth}">{{lineText}}</text>
			<text v-else class="uni-code-msg-line" v-for="(tokens,index) in safeCodeTokens" :key="index" :style="{width: maxLineWidth}">
				<text v-for="(token, tokenIndex) in tokens" :key="index + '-' + tokenIndex + '-' + (token.className ?? '') + '-' + (token.text ?? '')" :class="'uni-code-msg-line-code uni-code-msg-code-' + (token.className ?? '')">{{token.text}}</text>
			</text>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
import { MarkdownToken as IToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import {uiTheme} from '@/uni_modules/uni-ai-x/sdk';
import { estimateMaxLineTextWidth } from '@/uni_modules/uni-ai-x/sdk/text-width.uts'

type UniAiMsgCodeProps = {
	codeText?: string
	codeTokens?: IToken[][] | null
	language?: string
	href?: string
}

const props = withDefaults(defineProps<UniAiMsgCodeProps>(), {
	codeText: `
	import App from './App.uvue'
	// 注释：这是注释的内容
	import { createSSRApp } from 'vue'
	export function createApp() {
		const app = createSSRApp(App)
		return {
			app
		}
	}
`,
	codeTokens: () => [] as IToken[][],
	language: 'text',
	href: null
})

function hasMermaidImage(href: string | null): boolean {
	return href != null && href.length > 0
}

const maxLineWidth = ref<string>('')
const showMermaidImage = ref<boolean>(false)
const mermaidViewTouched = ref<boolean>(false)
const codeLineHeight = 22
const codeVerticalPadding = 16
const codeFontSize = 14
const estimatedCodeHorizontalPadding = 30
const estimatedCardHorizontalInset = 48
const forceFixedLineWidthOnAndroid = ref<boolean>(false)
const windowWidth = ref<number>(0)

// Android 继续保留显式宽度修复，避免长代码行被错误裁切。
// #ifdef APP-ANDROID
forceFixedLineWidthOnAndroid.value = true
// #endif

function setMermaidView(showImage: boolean) {
	mermaidViewTouched.value = true
	showMermaidImage.value = showImage && hasMermaidImage(props.href)
}

const previewMermaidImage = () => {
	if (props.href == null || props.href.length == 0) return
	uni.previewImage({ urls: [props.href] as string[] })
}

function normalizeCodeText(text: string): string {
	return text.replace(/\r\n/g, '\n')
}

function normalizeCodeTokens(codeTokens: IToken[][] | null): IToken[][] {
	return (codeTokens ?? [] as IToken[][]).map((lineTokens: IToken[] | null): IToken[] => lineTokens ?? [] as IToken[])
}

function buildRenderedCodeText(codeTokens: IToken[][]): string {
	return codeTokens.map((lineTokens: IToken[]) => {
		return lineTokens.map((token: IToken) => token.text ?? '').join('')
	}).join('\n')
}

const safeCodeTokens = computed<IToken[][]>(() => {
	return normalizeCodeTokens(props.codeTokens)
})

const showOriginCode = computed<boolean>(() => {
	if (safeCodeTokens.value.length == 0) return true
	const rawCode = normalizeCodeText(props.codeText)
	const renderedCode = normalizeCodeText(buildRenderedCodeText(safeCodeTokens.value))
	return rawCode != renderedCode
})

const shouldUseOriginCode = computed<boolean>(() => {
	return showOriginCode.value
})

function normalizeRawCodeLines(text: string): string[] {
	const normalizedText = normalizeCodeText(text)
	const lines = normalizedText.split('\n')
	return lines.map((line: string) => line.length > 0 ? line : ' ')
}

function updateWindowWidth() {
	windowWidth.value = uni.getWindowInfo().windowWidth
}

const rawCodeLines = computed<string[]>(() => {
	return normalizeRawCodeLines(props.codeText)
})

function getCodeTextWidth(text: string): number {
	const lines = normalizeCodeText(text).split('\n')
	return estimateMaxLineTextWidth(lines, codeFontSize, 'mono') + estimatedCodeHorizontalPadding
}

const shouldShowHorizontalHint = computed<boolean>(() => {
	if (showMermaidImage.value) return false
	const currentWindowWidth = windowWidth.value > 0 ? windowWidth.value : uni.getWindowInfo().windowWidth
	const visibleCodeWidth = Math.max(160, currentWindowWidth - estimatedCardHorizontalInset)
	const requiredCodeWidth = getCodeTextWidth(props.codeText)
	return requiredCodeWidth > visibleCodeWidth
})

watch((): string => props.language, (language: string) => {
	mermaidViewTouched.value = false
	showMermaidImage.value = language == 'mermaid' && hasMermaidImage(props.href)
	//#ifdef uniVersion < 4.81 && APP-IOS || MP-WEIXIN
	showMermaidImage.value = false
	//#endif
}, {immediate: true})

watch((): string | null => props.href, (href: string | null) => {
	if (props.language == 'mermaid' && hasMermaidImage(href) && !mermaidViewTouched.value) {
		showMermaidImage.value = true
	}
})

onMounted(() => {
	updateWindowWidth()
})

//#ifdef uniVersion < 4.81
watch((): string => props.codeText, (codeText: string) => {
	if (forceFixedLineWidthOnAndroid.value) {
		maxLineWidth.value = `${getCodeTextWidth(codeText)}px`
	} else if (props.codeTokens.length == 0 && codeText.length > 0) {
		maxLineWidth.value = `${getCodeTextWidth(codeText)}px`
	}
}, {immediate: true})
// #endif
// #ifdef uniVersion >= 4.81 || MP-WEIXIN
if (forceFixedLineWidthOnAndroid.value) {
	watch((): string => props.codeText, (codeText: string) => {
		maxLineWidth.value = `${getCodeTextWidth(codeText)}px`
	}, {immediate: true})
} else {
	maxLineWidth.value = 'auto'
}
// #endif

const scrollViewHeight = computed<string>(() => {
	if (props.language == 'mermaid') return 'auto'
	const rawLineCount = rawCodeLines.value.length
	const renderedLineCount = props.codeTokens.length
	const lineCount = shouldUseOriginCode.value ? rawLineCount : (renderedLineCount > 0 ? renderedLineCount : rawLineCount)
	return `${lineCount * codeLineHeight + codeVerticalPadding}px`
})

const copyCode = () => {
	uni.setClipboardData({
		data: props.codeText,
		success: () => {
			uni.showToast({
				title: '代码已复制到剪贴板',
				icon: 'success'
			})
		},
		fail: () => {
			uni.showToast({
				title: '复制失败',
				icon: 'none'
			})
		}
	})
}

</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
@font-face {
	// #ifdef WEB
	font-display: swap;
	// #endif
	font-family: CodeFontFamily;
	// #ifndef MP-WEIXIN
	src: url('/uni_modules/uni-ai-x/static/font/FiraCode-Regular.ttf') format('truetype');
	// #endif
}
// 浅色主题类
.ui-theme-light {
  /* 代码高亮颜色 - 浅色主题 */
  --code-keyword: #1a237e;
  --code-string: #b71c1c;
  --code-comment: #757575;
  --code-meta: #ad1457;
  --code-storage: #1976d2;
  --code-entity: #00897b;
  --code-support: #00897b;
  --code-constant: #388e3c;
  --code-variable: #1565c0;
  --code-punctuation: #333;
  --code-function: #fbc02d;
}

// 深色主题类
.ui-theme-dark {
  /* 代码高亮颜色 - 深色主题 */
  --code-keyword: #4fc1ff;
  --code-string: #ff8a80;
  --code-comment: #81c784;
  --code-meta: #e1bee7;
  --code-storage: #4fc1ff;
  --code-entity: #80deea;
  --code-support: #80deea;
  --code-constant: #81d4fa;
  --code-variable: #b3e5fc;
  --code-punctuation: #f5f5f5;
  --code-function: #fff59d;
}
.uni-code-msg-root {
	width: 100%;
	margin-bottom: 5px;
	background-color: var(--bg-secondary);
	border-radius: 6px;
	border: 1px solid var(--border-color);
}

.uni-code-msg-code-header {
	width: 100%;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 4px 10px;
	background-color: var(--bg-tertiary);
}

.uni-code-msg-scroll-tip-row {
	padding: 4px 12px 0;
	flex-direction: row;
	justify-content: flex-end;
	background-color: var(--bg-secondary);
}

.uni-code-msg-scroll-tip {
	font-size: 10px;
	line-height: 14px;
	color: var(--text-secondary);
}

.uni-code-msg-mermaid-switch {
	flex-direction: row;
	border-radius: 6px;
	padding: 2px 0;
	background-color: var(--border-color);
}

.uni-code-msg-mermaid-item {
	padding: 4px 10px;
	margin: 0 1px;
	border-radius: 6px;
	font-size: 12px;
	color: var(--text-secondary);
}

.uni-code-msg-mermaid-item-active {
	background-color: var(--bg-primary);
	color: var(--text-primary);
}

.uni-code-msg-language {
	font-size: 12px;
	color: var(--text-primary);
}

.uni-code-msg-copy-btn {
	flex-direction: row;
	align-items: center;
	padding: 2px 4px;
	border-radius: 4px;
}

.uni-code-msg-copy-text {
	font-size: 10px;
	color: var(--text-primary);
	margin-left: 2px;
}

.uni-code-msg-code-scroll-view {
	padding: 8px 0;
	height: auto;
	width: 100%;
	transition: height 0.2s linear;
}

.uni-code-msg-line,
.uni-code-msg-origin-code,
.uni-code-msg-origin-line {
	padding: 0 15px;
}

.uni-code-msg-line {
	height: 22px;
	white-space: nowrap;
	align-self: flex-start;
}

.uni-code-msg-line-code {
	white-space: pre;
	font-family: CodeFontFamily;
	font-size: 14px;
	color: var(--text-primary);
}

/* #ifdef APP-ANDROID */
.uni-code-msg-line-code,
.uni-code-msg-origin-code {
	font-family: monospace;
}
/* #endif */

.uni-code-msg-code-keyword { color: var(--code-keyword); }
.uni-code-msg-code-string { color: var(--code-string); }
.uni-code-msg-code-comment { color: var(--code-comment); }
.uni-code-msg-code-meta { color: var(--code-meta); }
.uni-code-msg-code-storage { color: var(--code-storage); }
.uni-code-msg-code-entity { color: var(--code-entity); }
.uni-code-msg-code-support { color: var(--code-support); }
.uni-code-msg-code-constant { color: var(--code-constant); }
.uni-code-msg-code-variable { color: var(--code-variable); }
.uni-code-msg-code-punctuation { color: var(--code-punctuation); }
.uni-code-msg-code-function { color: var(--code-function); }

.uni-code-msg-origin-code {
	color: var(--text-primary);
	height: 100%;
	font-size: 14px;
	align-self: flex-start;
	line-height: 22px;
	white-space: pre;
	font-family: CodeFontFamily;
	overflow: visible;
}

.uni-code-msg-origin-line {
	height: 22px;
	line-height: 22px;
	white-space: pre;
	font-size: 14px;
	color: var(--text-primary);
	align-self: flex-start;
	font-family: CodeFontFamily;
}

.uni-code-msg-mermaid-image-box {
	width: 100%;
	aspect-ratio: 5 / 4;
	background-color: #ffffff;
	overflow: hidden;
}

.uni-code-msg-mermaid-image {
	width: 100%;
	height: 100%;
}

.uni-code-msg-root-mermaid .uni-code-msg-code-scroll-view {
	width: 100%;
	aspect-ratio: 5 / 4;
	overflow: auto;
}

</style>
