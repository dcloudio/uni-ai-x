<template>
	<view class="uni-code-msg-root uni-theme-root">
		<view class="uni-code-msg-code-header">
			<text class="uni-code-msg-language" flatten>{{language}}</text>
			<view class="uni-code-msg-copy-btn" @click.stop="copyCode">
				<uni-ai-icon class="uni-code-msg-copy-icon" code="e60c" size="12" color="#f4f4f4"/>
				<text class="uni-code-msg-copy-text" flatten>复制代码</text>
			</view>
		</view>
		<scroll-view class="uni-code-msg-code-scroll-view" direction="horizontal" :show-scrollbar="false" :style="'height:' + preparedHeight + ';background-color:#111827;'">
			<view class="uni-code-msg-lines">
				<rich-text :disable-split-screen-render="true" class="uni-code-msg-rich-text" :user-select="true"
					:style="{height: preparedContentHeight}"
					style="font-size:14px;line-height:22px;font-family:monospace;background-color:#111827;color:#d1fae5;"
					:nodes="preparedHtml" mode="native"></rich-text>
			</view>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'

const props = withDefaults(defineProps<{
	codeText?: string
	language?: string
	preparedHtml?: string
	preparedContentHeight?: string
	preparedHeight?: string
}>(), {
	codeText: '',
	language: 'text',
	preparedHtml: '',
	preparedContentHeight: '22px',
	preparedHeight: '38px'
})

function copyCode() {
	uni.setClipboardData({
		data: props.codeText,
		showToast: false,
		success: () => { utils.showCopySuccessToast() },
		fail: () => { utils.showCopyFailureToast() }
	})
}
</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.uni-code-msg-root {
	width: 100%;
	margin: 6px 0;
	background-color: #111827;
	border: 1px solid #374151;
	overflow: hidden;
}

.uni-code-msg-code-header {
	position: relative;
	z-index: 2;
	width: 100%;
	height: 38px;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 4px 10px;
	background-color: #0d0d0d;
}

.uni-code-msg-language {
	font-size: 12px;
	color: #b4b4b4;
}

.uni-code-msg-copy-btn {
	height: 30px;
	flex-direction: row;
	align-items: center;
	padding: 0 5px;
	border-radius: 4px;
}

.uni-code-msg-copy-text {
	font-size: 11px;
	color: #f4f4f4;
	margin-left: 3px;
}

.uni-code-msg-code-scroll-view {
	width: 100%;
	height: auto;
	flex-direction: row;
	align-items: flex-start;
	box-sizing: border-box;
	background-color: #111827;
}

.uni-code-msg-lines {
	/* Let the outer scroll viewport clip intrinsic-width code rows. */
	overflow: visible;
	align-self: flex-start;
	flex-shrink: 0;
	padding: 8px 0;
}

.uni-code-msg-rich-text {
	align-self: flex-start;
	flex-shrink: 0;
}

</style>
