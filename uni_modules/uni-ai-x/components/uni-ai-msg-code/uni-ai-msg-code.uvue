<template>
	<view class="uni-code-msg-root uni-theme-root" :style="codeRootStyle">
		<view class="uni-code-msg-code-header" :style="codeHeaderStyle">
			<!-- #ifndef MP-WEIXIN -->
			<view class="uni-code-msg-mermaid-switch" v-if="language == 'mermaid'" flatten>
				<text class="uni-code-msg-mermaid-item" :class="showMermaidImage ? 'uni-code-msg-mermaid-item-active' : ''" @click.stop="setMermaidView(true)">图表</text>
				<text class="uni-code-msg-mermaid-item" :class="!showMermaidImage ? 'uni-code-msg-mermaid-item-active' : ''" @click.stop="setMermaidView(false)">代码</text>
			</view>
			<!-- #endif -->
			<template v-if="language != 'mermaid'">
				<text class="uni-code-msg-language" flatten>{{language}}</text>
				<view class="uni-code-msg-copy-btn" @click.stop="copyCode">
					<uni-ai-icon class="uni-code-msg-copy-icon" code="e60c" size="12" color="#f4f4f4"/>
					<text class="uni-code-msg-copy-text" flatten>复制代码</text>
				</view>
			</template>
			<view v-else-if="!showMermaidImage" class="uni-code-msg-copy-btn" @click.stop="copyCode">
				<uni-ai-icon class="uni-code-msg-copy-icon" code="e60c" size="12" color="#f4f4f4"/>
				<text class="uni-code-msg-copy-text" flatten>复制代码</text>
			</view>
		</view>
		<view v-if="language == 'mermaid'" class="uni-code-msg-mermaid-stage" :style="mermaidStageStyle">
			<image v-if="buffer0MermaidHref.length > 0" class="uni-code-msg-mermaid-image" :src="buffer0MermaidHref"
				:style="buffer0MermaidImageStyle" mode="aspectFit" @load="onMermaidBuffer0Load"
				@error="onMermaidBuffer0Error" @click.stop="previewMermaidImage" />
			<image v-if="buffer1MermaidHref.length > 0" class="uni-code-msg-mermaid-image" :src="buffer1MermaidHref"
				:style="buffer1MermaidImageStyle" mode="aspectFit" @load="onMermaidBuffer1Load"
				@error="onMermaidBuffer1Error" @click.stop="previewMermaidImage" />
			<view v-if="showMermaidImage && !mermaidImageReady" class="uni-code-msg-mermaid-image-box" :style="mermaidImageBoxStyle">
				<uni-rotate-icon v-if="!mermaidGenerationFailed" class="uni-code-msg-mermaid-loading" />
				<text class="uni-code-msg-mermaid-status-text" flatten>{{mermaidGenerationFailed ? '图表生成失败' : '图片正在生成中'}}</text>
			</view>
				<scroll-view v-if="!showMermaidImage" class="uni-code-msg-code-scroll-view uni-code-msg-mermaid-code-scroll" direction="horizontal"
					:show-scrollbar="false" :style="mermaidCodeScrollStyle"
					>
					<text class="uni-code-msg-mermaid-code-text">{{displayCodeText}}</text>
			</scroll-view>
		</view>
		<scroll-view v-else class="uni-code-msg-code-scroll-view" direction="horizontal" :show-scrollbar="false" :style="codeScrollViewStyle"
			>
			<rich-text :disable-split-screen-render="true" class="uni-code-msg-rich-text" :style="codeRichTextStyle" :nodes="codeRichHtml" mode="native"></rich-text>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
import { MarkdownToken as IToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import {uiTheme, MsgItem} from '@/uni_modules/uni-ai-x/sdk';
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'
import { estimateMaxLineTextWidth } from '@/uni_modules/uni-ai-x/sdk/text-width.uts'
import { markdownCodeTokenToRichTextNodes } from '@/uni_modules/uni-ai-x/sdk/markdown-rich-text.uts'
// #ifndef MP-WEIXIN
import { renderMermaidSvgForTheme, ThemedSvgResult } from '@/uni_modules/uni-ai-x/sdk/themed-svg.uts'
// #endif
// #ifdef APP || WEB
import proxyWeb from '@/uni_modules/uni-ai-x/sdk/proxy-web.uts'
// #endif

type UniAiMsgCodeProps = {
	codeText?: string
	blockKey?: string
	codeTokens?: IToken[][]
	language?: string
	href?: string
	renderTheme?: string
	isClose?: number
	// 所属消息对象（reactive 引用）：list-view 复用 item 的子组件 props 更新在长流式过程中
	// 可能丢失（vapor v-for/组件 props diff 缺陷），msg 对象属性为响应式直连不受影响，用于兜底
	msg?: MsgItem | null
}

const props = withDefaults(defineProps<UniAiMsgCodeProps>(), {
	codeText: '',
	blockKey: '',
	codeTokens: () => [] as IToken[][],
	language: 'text',
	href: '',
	renderTheme: '',
	isClose: 0,
	msg: null
})

function hasMermaidImage(href: string | null): boolean {
	return href != null && href.length > 0
}

const mermaidImageModeLatched = ref<boolean>(props.language == 'mermaid' && props.isClose == 1)
const showMermaidImage = ref<boolean>(mermaidImageModeLatched.value)
//#ifdef uniVersion < 4.81 && APP-IOS || MP-WEIXIN
showMermaidImage.value = false
//#endif
const mermaidViewSelectedByUser = ref<boolean>(false)
const mermaidImageLoadFailed = ref<boolean>(false)
const mermaidRenderPending = ref<boolean>(false)
const buffer0MermaidHref = ref<string>('')
const buffer0MermaidLoaded = ref<boolean>(false)
const buffer0MermaidWidth = ref<number>(0)
const buffer0MermaidHeight = ref<number>(0)
const buffer1MermaidHref = ref<string>('')
const buffer1MermaidLoaded = ref<boolean>(false)
const buffer1MermaidWidth = ref<number>(0)
const buffer1MermaidHeight = ref<number>(0)
const activeMermaidBuffer = ref<number>(0)
const pendingMermaidBuffer = ref<number>(-1)
let mermaidRenderRequestKey = ''
let mermaidSourceKey = ''
let mermaidWasClosed = false
let codeHighlightRequestVersion = 0
// 已高亮完成行的缓存：与代码行按索引前缀对齐（流式中已完成的行内容不再变化）
let highlightedCacheLanguage = ''
let cacheLineTexts = [] as string[]
let cacheLineTokens = [] as IToken[][]
const highlightedCodeTokens = ref<IToken[][]>([] as IToken[][])
const codeLineHeight = 22
const codeVerticalPadding = 16
const codeFontSize = 14
const codeHorizontalPadding = 14
const estimatedCardHorizontalInset = 48
// 行尾 1em 余量：覆盖各平台 monospace 回退字体的度量误差，防止估算宽度略小于实际渲染宽度导致折行
const codeTailPadding = 14
// 流式期间 6em 前瞻余量：未完成行仍在增长，提前占住宽度，
// 吸收 chunk 到达时内容与容器更新的时间差，避免"先折行再弹回"的抖动；闭合后去掉，宽度单向收敛
const codeLookaheadPadding = 84
const windowWidth = ref<number>(0)

const themePageBackgroundColor = computed<string>(() => {
	return uiTheme.value == 'dark' ? '#25282c' : '#ffffff'
})

const mermaidHref = computed<string>(() => {
	return activeMermaidBuffer.value == 0 ? buffer0MermaidHref.value : buffer1MermaidHref.value
})

const mermaidImageReady = computed<boolean>(() => {
	const loaded = activeMermaidBuffer.value == 0 ? buffer0MermaidLoaded.value : buffer1MermaidLoaded.value
	return hasMermaidImage(mermaidHref.value) && loaded
})

const buffer0MermaidImageStyle = computed<string>(() => {
	const visible = showMermaidImage.value && activeMermaidBuffer.value == 0 && buffer0MermaidLoaded.value
	return 'position:absolute;left:0;top:0;width:100%;height:' + mermaidContentHeight.value
		+ ';background-color:' + themePageBackgroundColor.value + ';opacity:' + (visible ? '1' : '0')
		+ ';pointer-events:' + (visible ? 'auto' : 'none') + ';'
})

const buffer1MermaidImageStyle = computed<string>(() => {
	const visible = showMermaidImage.value && activeMermaidBuffer.value == 1 && buffer1MermaidLoaded.value
	return 'position:absolute;left:0;top:0;width:100%;height:' + mermaidContentHeight.value
		+ ';background-color:' + themePageBackgroundColor.value + ';opacity:' + (visible ? '1' : '0')
		+ ';pointer-events:' + (visible ? 'auto' : 'none') + ';'
})

function setMermaidView(showImage: boolean) {
	mermaidViewSelectedByUser.value = true
	showMermaidImage.value = showImage && !mermaidImageLoadFailed.value
}

function isWebPc(): boolean {
	let isPc = false
	// #ifdef WEB
	const userAgent = window.navigator.userAgent
	isPc = userAgent.match(/Android|iPhone|iPad|iPod|Mobile/i) == null
	// #endif
	return isPc
}

const previewMermaidImage = () => {
	if (isWebPc()) return
	if (!showMermaidImage.value || !mermaidImageReady.value) return
	uni.previewImage({ urls: [mermaidHref.value] as string[] })
}

function hasQueuedMermaidImage(): boolean {
	return buffer0MermaidHref.value.length > 0 || buffer1MermaidHref.value.length > 0
}

function resetMermaidImages() {
	buffer0MermaidHref.value = ''
	buffer0MermaidLoaded.value = false
	buffer0MermaidWidth.value = 0
	buffer0MermaidHeight.value = 0
	buffer1MermaidHref.value = ''
	buffer1MermaidLoaded.value = false
	buffer1MermaidWidth.value = 0
	buffer1MermaidHeight.value = 0
	activeMermaidBuffer.value = 0
	pendingMermaidBuffer.value = -1
}

function queueMermaidImage(href: string, width: number = 0, height: number = 0) {
	if (href.length == 0) return
	if (mermaidHref.value == href) {
		if (width > 0 && height > 0) {
			if (activeMermaidBuffer.value == 0) {
				buffer0MermaidWidth.value = width
				buffer0MermaidHeight.value = height
			} else {
				buffer1MermaidWidth.value = width
				buffer1MermaidHeight.value = height
			}
		}
		pendingMermaidBuffer.value = -1
		return
	}
	const targetBuffer = activeMermaidBuffer.value == 0 ? 1 : 0
	if (targetBuffer == 0) {
		if (buffer0MermaidHref.value == href && buffer0MermaidLoaded.value) {
			activeMermaidBuffer.value = 0
			pendingMermaidBuffer.value = -1
			return
		}
		if (buffer0MermaidHref.value != href) buffer0MermaidLoaded.value = false
		buffer0MermaidHref.value = href
		buffer0MermaidWidth.value = width
		buffer0MermaidHeight.value = height
	} else {
		if (buffer1MermaidHref.value == href && buffer1MermaidLoaded.value) {
			activeMermaidBuffer.value = 1
			pendingMermaidBuffer.value = -1
			return
		}
		if (buffer1MermaidHref.value != href) buffer1MermaidLoaded.value = false
		buffer1MermaidHref.value = href
		buffer1MermaidWidth.value = width
		buffer1MermaidHeight.value = height
	}
	pendingMermaidBuffer.value = targetBuffer
}

function onMermaidBufferLoad(buffer: number) {
	if (buffer == 0) buffer0MermaidLoaded.value = true
	else buffer1MermaidLoaded.value = true
	if (pendingMermaidBuffer.value != buffer) return
	activeMermaidBuffer.value = buffer
	pendingMermaidBuffer.value = -1
	mermaidImageLoadFailed.value = false
	mermaidImageModeLatched.value = true
	if (!mermaidViewSelectedByUser.value) showMermaidImage.value = true
}

function onMermaidBufferError(buffer: number) {
	if (buffer == 0) {
		buffer0MermaidLoaded.value = false
		if (activeMermaidBuffer.value != 0) {
			buffer0MermaidHref.value = ''
			buffer0MermaidWidth.value = 0
			buffer0MermaidHeight.value = 0
		}
	} else {
		buffer1MermaidLoaded.value = false
		if (activeMermaidBuffer.value != 1) {
			buffer1MermaidHref.value = ''
			buffer1MermaidWidth.value = 0
			buffer1MermaidHeight.value = 0
		}
	}
	if (pendingMermaidBuffer.value == buffer) pendingMermaidBuffer.value = -1
	if (!mermaidImageReady.value) {
		mermaidImageLoadFailed.value = true
		showMermaidImage.value = false
	}
}

function onMermaidBuffer0Load(_event: ImageLoadEvent) { onMermaidBufferLoad(0) }
function onMermaidBuffer1Load(_event: ImageLoadEvent) { onMermaidBufferLoad(1) }
function onMermaidBuffer0Error(_event: ImageErrorEvent) { onMermaidBufferError(0) }
function onMermaidBuffer1Error(_event: ImageErrorEvent) { onMermaidBufferError(1) }

function normalizeCodeText(text: string): string {
	return text.replace(/\r\n/g, '\n')
}

function normalizeCodeTokens(codeTokens: IToken[][]): IToken[][] {
	return (codeTokens ?? [] as IToken[][]).map((lineTokens: IToken[] | null): IToken[] => lineTokens ?? [] as IToken[])
}

function buildRenderedCodeText(codeTokens: IToken[][]): string {
	return codeTokens.map((lineTokens: IToken[]) => {
		return lineTokens.map((token: IToken) => token.text ?? '').join('')
	}).join('\n')
}

type MiniProgramCodeLine = {
	tokens: IToken[]
	blockCommentEnd: string
}

function isMiniProgramWordStart(charCode: number): boolean {
	return (charCode >= 65 && charCode <= 90) || (charCode >= 97 && charCode <= 122)
		|| charCode == 36 || charCode == 95
}

function isMiniProgramWordPart(charCode: number): boolean {
	return isMiniProgramWordStart(charCode) || (charCode >= 48 && charCode <= 57)
}

function miniProgramUsesHashComments(language: string): boolean {
	return language == 'python' || language == 'py' || language == 'shell' || language == 'bash'
		|| language == 'sh' || language == 'yaml' || language == 'yml' || language == 'ruby'
}

function miniProgramKeywordClass(word: string): string {
	const normalizedWord = word.toLowerCase()
	const keywords = '|as|async|await|break|case|catch|class|const|continue|def|default|delete|do|else|elif|end|ensure|except|export|extends|finally|for|from|function|fun|if|implements|import|in|interface|lambda|let|module|namespace|new|of|package|pass|private|protected|public|return|static|switch|then|throw|throws|try|typeof|var|when|while|with|yield|'
	const constants = '|false|inf|infinity|nan|nil|none|null|true|undefined|'
	const supports = '|any|array|boolean|byte|char|date|double|float|int|integer|list|long|map|number|object|promise|set|string|void|'
	if (keywords.indexOf('|' + normalizedWord + '|') >= 0) return 'keyword'
	if (constants.indexOf('|' + normalizedWord + '|') >= 0) return 'constant'
	if (supports.indexOf('|' + normalizedWord + '|') >= 0) return 'support'
	return ''
}

function miniProgramCodeLineTokens(line: string, language: string, blockCommentEnd: string): MiniProgramCodeLine {
	const tokens = [] as IToken[]
	let index = 0
	let plainText = ''
	const normalizedLanguage = language.toLowerCase()
	const hashComments = miniProgramUsesHashComments(normalizedLanguage)
	const htmlLike = normalizedLanguage == 'html' || normalizedLanguage == 'xml' || normalizedLanguage == 'vue'
	const pushToken = (text: string, className: string = '') => {
		if (text.length == 0) return
		const token: IToken = { text }
		if (className.length > 0) token.className = className
		tokens.push(token)
	}
	const flushPlainText = () => {
		pushToken(plainText)
		plainText = ''
	}
	while (index < line.length) {
		if (blockCommentEnd.length > 0) {
			const closeIndex = line.indexOf(blockCommentEnd, index)
			if (closeIndex < 0) {
				pushToken(line.slice(index), 'comment')
				return { tokens, blockCommentEnd }
			}
			pushToken(line.slice(index, closeIndex + blockCommentEnd.length), 'comment')
			index = closeIndex + blockCommentEnd.length
			blockCommentEnd = ''
			continue
		}

		const current = line.charAt(index)
		const next = line.charAt(index + 1)
		if (htmlLike && line.slice(index, index + 4) == '<!--') {
			flushPlainText()
			const closeIndex = line.indexOf('-->', index + 4)
			if (closeIndex < 0) {
				pushToken(line.slice(index), 'comment')
				return { tokens, blockCommentEnd: '-->' }
			}
			pushToken(line.slice(index, closeIndex + 3), 'comment')
			index = closeIndex + 3
			continue
		}
		if (current == '/' && next == '*') {
			flushPlainText()
			const closeIndex = line.indexOf('*/', index + 2)
			if (closeIndex < 0) {
				pushToken(line.slice(index), 'comment')
				return { tokens, blockCommentEnd: '*/' }
			}
			pushToken(line.slice(index, closeIndex + 2), 'comment')
			index = closeIndex + 2
			continue
		}
		if ((current == '/' && next == '/') || (normalizedLanguage == 'sql' && current == '-' && next == '-')
			|| (hashComments && current == '#')) {
			flushPlainText()
			pushToken(line.slice(index), 'comment')
			break
		}
		if (current == '"' || current == "'" || current == '`') {
			flushPlainText()
			const quote = current
			let end = index + 1
			while (end < line.length) {
				if (line.charAt(end) == '\\') {
					end += 2
					continue
				}
				if (line.charAt(end) == quote) {
					end += 1
					break
				}
				end += 1
			}
			pushToken(line.slice(index, end), 'string')
			index = end
			continue
		}
		if (htmlLike && current == '<') {
			const closeIndex = line.indexOf('>', index + 1)
			if (closeIndex >= 0) {
				flushPlainText()
				pushToken(line.slice(index, closeIndex + 1), 'entity')
				index = closeIndex + 1
				continue
			}
		}
		const charCode = line.charCodeAt(index)
		if (isMiniProgramWordStart(charCode)) {
			flushPlainText()
			let end = index + 1
			while (end < line.length && isMiniProgramWordPart(line.charCodeAt(end))) end += 1
			const word = line.slice(index, end)
			let className = miniProgramKeywordClass(word)
			let nextIndex = end
			while (nextIndex < line.length && (line.charAt(nextIndex) == ' ' || line.charAt(nextIndex) == '\t')) nextIndex += 1
			if (className.length == 0 && line.charAt(nextIndex) == '(') className = 'function'
			pushToken(word, className)
			index = end
			continue
		}
		if (charCode >= 48 && charCode <= 57) {
			flushPlainText()
			let end = index + 1
			while (end < line.length) {
				const numberChar = line.charAt(end)
				const numberCharCode = line.charCodeAt(end)
				if ((numberCharCode >= 48 && numberCharCode <= 57) || (numberCharCode >= 65 && numberCharCode <= 70)
					|| (numberCharCode >= 97 && numberCharCode <= 102) || numberChar == '.' || numberChar == 'x' || numberChar == 'X') {
					end += 1
					continue
				}
				break
			}
			pushToken(line.slice(index, end), 'constant')
			index = end
			continue
		}
		plainText += current
		index += 1
	}
	flushPlainText()
	return { tokens, blockCommentEnd }
}

const safeCodeTokens = computed<IToken[][]>(() => {
	const propTokens = normalizeCodeTokens(props.codeTokens)
	return propTokens.length > 0 ? propTokens : highlightedCodeTokens.value
})

function resetHighlightCache() {
	cacheLineTexts = [] as string[]
	cacheLineTokens = [] as IToken[][]
}

function placeholderLineTokens(line: string): IToken[] {
	const token: IToken = { text: line }
	return [token] as IToken[]
}

function truncateHighlightCache(length: number) {
	if (cacheLineTexts.length <= length) return
	const texts = [] as string[]
	const tokens = [] as IToken[][]
	for (let index = 0; index < length; index++) {
		texts.push(cacheLineTexts[index])
		tokens.push(cacheLineTokens[index])
	}
	cacheLineTexts = texts
	cacheLineTokens = tokens
}

// 构建渲染 tokens：已高亮的行取缓存，未高亮与未完成的行用纯色占位 token，
// 保证行数与行文本和源码完全一致（showOriginCode 完整性校验依赖这一点）
function buildRenderedCodeTokens(lines: string[], completedCount: number): IToken[][] {
	let matchPrefix = 0
	while (matchPrefix < completedCount
		&& matchPrefix < cacheLineTexts.length
		&& matchPrefix < lines.length
		&& cacheLineTexts[matchPrefix] == lines[matchPrefix]) {
		matchPrefix += 1
	}
	truncateHighlightCache(matchPrefix)
	const nextTokens = [] as IToken[][]
	for (let index = 0; index < lines.length; index++) {
		if (index < matchPrefix) nextTokens.push(cacheLineTokens[index])
		else nextTokens.push(placeholderLineTokens(lines[index]))
	}
	return nextTokens
}

function highlightCode() {
	codeHighlightRequestVersion += 1
	const requestVersion = codeHighlightRequestVersion
	if (props.language == 'mermaid' || props.language == 'math' || props.language == 'math-pending') {
		highlightedCacheLanguage = ''
		resetHighlightCache()
		highlightedCodeTokens.value = [] as IToken[][]
		return
	}
	if (props.language != highlightedCacheLanguage) {
		highlightedCacheLanguage = props.language
		resetHighlightCache()
	}
	const lines = normalizeCodeText(displayCodeText.value).split('\n')
	if (lines.length == 0) return
	// 流式期间最后一行视为未完成行，不高亮；其余已完成行按行高亮
	const completedCount = props.isClose == 1 ? lines.length : lines.length - 1
	// #ifdef APP || WEB
	highlightedCodeTokens.value = buildRenderedCodeTokens(lines, completedCount)
	const requestLines = [] as string[]
	for (let index = cacheLineTexts.length; index < completedCount; index++) {
		requestLines.push(lines[index])
	}
	if (requestLines.length > 0) {
		proxyWeb.callMethod({
			action: 'highlightCodeLines',
			language: props.language,
			codeLines: requestLines
		} as UTSJSONObject, (param: UTSJSONObject) => {
			if (requestVersion != codeHighlightRequestVersion) return
			const linesTokensJson = (param['linesTokensJson'] as string | null) ?? '[]'
			const errorMsg = (param['errorMsg'] as string | null) ?? ''
			if (errorMsg.length > 0) return
			const lineJsonList = JSON.parseArray<string>(linesTokensJson) ?? ([] as string[])
			for (let index = 0; index < requestLines.length && index < lineJsonList.length; index++) {
				const lineJson = lineJsonList[index] ?? '[]'
				cacheLineTexts.push(requestLines[index])
				cacheLineTokens.push(JSON.parseArray<IToken>(lineJson) as IToken[])
			}
			const currentLines = normalizeCodeText(displayCodeText.value).split('\n')
			const currentCompleted = props.isClose == 1 ? currentLines.length : currentLines.length - 1
			highlightedCodeTokens.value = buildRenderedCodeTokens(currentLines, currentCompleted)
		})
	}
	// #endif
	// #ifdef MP-WEIXIN
	const nextTokens = [] as IToken[][]
	let blockCommentEnd = ''
	for (let index = 0; index < lines.length; index++) {
		if (index < completedCount) {
			const result = miniProgramCodeLineTokens(lines[index], props.language, blockCommentEnd)
			nextTokens.push(result.tokens)
			blockCommentEnd = result.blockCommentEnd
		} else {
			nextTokens.push(placeholderLineTokens(lines[index]))
		}
	}
	if (requestVersion == codeHighlightRequestVersion) {
		highlightedCodeTokens.value = nextTokens
	}
	// #endif
}

const showOriginCode = computed<boolean>(() => {
	if (safeCodeTokens.value.length == 0) return true
	const rawCode = normalizeCodeText(displayCodeText.value)
	const renderedCode = normalizeCodeText(buildRenderedCodeText(safeCodeTokens.value))
	return rawCode != renderedCode
})

const shouldUseOriginCode = computed<boolean>(() => {
	return showOriginCode.value
})

function escapeCodeHtml(text: string): string {
	return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;')
}

function codeNodeHtml(node: UTSJSONObject): string {
	const type = node['type'] as string | null
	if (type == 'text') return escapeCodeHtml((node['text'] as string | null) ?? '')
	const name = node['name'] as string | null
	if (name == 'br') return '<br/>'
	if (name == null) return ''
	const attrs = node['attrs'] as UTSJSONObject | null
	let html = '<' + name
	if (attrs != null) {
		const style = attrs['style'] as string | null
		if (style != null) html += ' style="' + escapeCodeHtml(style) + '"'
	}
	html += '>'
	const children = node['children'] as UTSJSONObject[] | null
	if (children != null) for (let i = 0; i < children.length; i++) html += codeNodeHtml(children[i])
	return html + '</' + name + '>'
}

const codeRichNodes = computed<UTSJSONObject[]>(() => {
	const token: IToken = { type: 'code_block', lang: props.language, text: displayCodeText.value, codeTokens: shouldUseOriginCode.value ? [] as IToken[][] : safeCodeTokens.value }
	return markdownCodeTokenToRichTextNodes(token)
})

const codeRichHtml = computed<string>(() => {
	const nodes = codeRichNodes.value
	let html = ''
	for (let i = 0; i < nodes.length; i++) html += codeNodeHtml(nodes[i])
	return html
})

function updateWindowWidth() {
	windowWidth.value = uni.getWindowInfo().windowWidth
}

const rawCodeLineCount = computed<number>(() => {
	return normalizeCodeText(displayCodeText.value).split('\n').length
})

function getCodeTextWidth(text: string): number {
	const lines = normalizeCodeText(text).split('\n')
	return estimateMaxLineTextWidth(lines, codeFontSize, 'mono')
}

function visibleCodeWidth(): number {
	const currentWindowWidth = windowWidth.value > 0 ? windowWidth.value : uni.getWindowInfo().windowWidth
	return Math.max(160, Math.min(currentWindowWidth, 800) - estimatedCardHorizontalInset)
}

function visibleCodeContentWidth(): number {
	return Math.max(1, visibleCodeWidth() - codeHorizontalPadding * 2)
}

const codeContentWidth = computed<string>(() => {
	// 估算使用保守比率（text-width.uts mono 0.7/全角 1.05），保证估算宽度不小于实际渲染宽度
	const estimatedWidth = getCodeTextWidth(props.codeText) + codeTailPadding
	if (props.isClose != 1) {
		return Math.max(visibleCodeContentWidth(), estimatedWidth + codeLookaheadPadding).toString() + 'px'
	}
	// 代码块闭合：去掉流式前瞻余量，按最终内容重算一次，宽度单向收敛且不折行
	return Math.max(visibleCodeContentWidth(), estimatedWidth).toString() + 'px'
})

const codeLinesStyle = computed<string>(() => {
	return 'width:' + codeContentWidth.value + ';height:' + scrollViewHeight.value
		+ ';font-size:14px;line-height:22px;font-family:monospace;background-color:#111827;'
})

const codeRichTextStyle = computed<string>(() => {
	return codeLinesStyle.value + ';color:#d1fae5;'
})

const mermaidGenerationFailed = computed<boolean>(() => {
	return props.language == 'mermaid'
		&& (mermaidImageLoadFailed.value || (props.isClose == 1 && !mermaidRenderPending.value && !hasQueuedMermaidImage()))
})

function syncMermaidImageTheme(textOverride: string | null = null) {
	if (props.language != 'mermaid') {
		mermaidImageModeLatched.value = false
		showMermaidImage.value = false
		return
	}
	// 兜底路径（textOverride 非空）时以直连数据为准：props 更新链可能已失效
	const effectiveText = textOverride ?? props.codeText
	const nextSourceKey = props.language + '\n' + effectiveText
	if (mermaidSourceKey != nextSourceKey) {
		mermaidSourceKey = nextSourceKey
		mermaidImageLoadFailed.value = false
		mermaidViewSelectedByUser.value = false
		resetMermaidImages()
	}
	const isClosed = props.isClose == 1 || textOverride != null
	if (!isClosed) {
		if (mermaidWasClosed) resetMermaidImages()
		mermaidWasClosed = false
		mermaidImageModeLatched.value = false
		showMermaidImage.value = false
		mermaidRenderRequestKey = ''
		mermaidRenderPending.value = false
		return
	}
	mermaidWasClosed = true
// #ifdef MP-WEIXIN
	// 微信小程序不支持隐藏 WebView，图表保留源码显示。
mermaidImageModeLatched.value = false
showMermaidImage.value = false
mermaidRenderRequestKey = ''
mermaidRenderPending.value = false
return
// #endif
// #ifndef MP-WEIXIN
mermaidImageModeLatched.value = true
if (!mermaidViewSelectedByUser.value && mermaidImageModeLatched.value && !mermaidImageLoadFailed.value) showMermaidImage.value = true
//#ifdef uniVersion < 4.81 && APP-IOS
showMermaidImage.value = false
//#endif
const theme = uiTheme.value
const sourceHref = props.href ?? ''
if (sourceHref.length > 0 && mermaidHref.value.length == 0) queueMermaidImage(sourceHref)
if (sourceHref.length > 0 && (props.renderTheme ?? '') == theme) {
	mermaidRenderRequestKey = ''
	mermaidRenderPending.value = false
	queueMermaidImage(sourceHref)
	return
}
const mermaidText = effectiveText
if (mermaidText.trim().length == 0) return
const requestKey = theme + '\n' + mermaidText
mermaidRenderRequestKey = requestKey
mermaidRenderPending.value = true
renderMermaidSvgForTheme(mermaidText, theme, (result: ThemedSvgResult) => {
	if (mermaidRenderRequestKey != requestKey || uiTheme.value != theme) return
	mermaidRenderRequestKey = ''
	mermaidRenderPending.value = false
	if (result.imageSource.length == 0) {
		mermaidImageLoadFailed.value = true
		showMermaidImage.value = false
		return
	}
	queueMermaidImage(result.imageSource, result.width, result.height)
})
// #endif
}

watch((): string => {
	return uiTheme.value + '\n' + props.renderTheme + '\n' + props.language
		+ '\n' + props.codeText + '\n' + props.isClose.toString()
		+ '\n' + ((props.href ?? '').length > 0 ? '1' : '0')
}, () => {
	syncMermaidImageTheme()
}, { immediate: true })

// 从消息正文中提取当前代码块，不能固定取第一个 Mermaid 块。
function extractMermaidText(body: string, blockKey: string): string {
	let targetBlockIndex = -1
	const keyPrefix = 'code-'
	if (blockKey.indexOf(keyPrefix) == 0) {
		targetBlockIndex = Number.parseInt(blockKey.slice(keyPrefix.length), 10)
	}
	let blockIndex = 0
	let cursor = 0
	let insideFence = false
	let currentIsMermaid = false
	let currentContentStart = 0
	let currentBlockIndex = -1
	while (cursor <= body.length) {
		const lineEnd = body.indexOf('\n', cursor)
		const hasLineEnd = lineEnd >= 0
		const line = hasLineEnd ? body.slice(cursor, lineEnd) : body.slice(cursor)
		const trimmedLine = line.trim()
		if (!insideFence && trimmedLine.indexOf('```') == 0) {
			const info = trimmedLine.length > 3 ? trimmedLine.slice(3).trim().split(' ')[0].toLowerCase() : ''
			currentIsMermaid = info == 'mermaid' || info == 'mermaid-pending'
			currentBlockIndex = blockIndex
			blockIndex += 1
			currentContentStart = hasLineEnd ? lineEnd + 1 : body.length
			insideFence = true
		} else if (insideFence && trimmedLine == '```') {
			if (currentIsMermaid && (targetBlockIndex < 0 || targetBlockIndex == currentBlockIndex)) {
				return body.slice(currentContentStart, cursor)
			}
			insideFence = false
			currentIsMermaid = false
		}
		if (!hasLineEnd) break
		cursor = lineEnd + 1
	}
	if (insideFence && currentIsMermaid && (targetBlockIndex < 0 || targetBlockIndex == currentBlockIndex)) {
		return body.slice(currentContentStart)
	}
	return ''
}

// 直连兜底：list-view 复用 item 的子组件 props 更新在长流式（多帧思考/滚动）后可能丢失，
// msg 为 reactive 对象引用，其 body/rendered 属性为响应式直连，不受 props 断链影响。
// watch msg.body：流式期间直连更新源码显示；围栏闭合或消息完成时以直连数据强制同步图片渲染。
watch((): string => {
	const msgItem = props.msg
	if (msgItem == null) return ''
	return msgItem.body + '\n' + (msgItem.rendered ? '1' : '0')
}, () => {
	if (props.language != 'mermaid') return
	const msgItem = props.msg
	if (msgItem == null) return
	const body = msgItem.body
	if (body.length == 0) return
	const mermaidText = extractMermaidText(body, props.blockKey)
	if (mermaidText.length == 0) return
	const fenceClosed = props.isClose == 1 || msgItem.rendered
	if (mermaidText != displayCodeText.value) {
		displayCodeText.value = mermaidText
	}
	if (fenceClosed) {
		syncMermaidImageTheme(mermaidText)
	}
})

// 渲染用文本：滞后一帧追上 props.codeText。
// 宽度（codeContentWidth）依赖 props.codeText 在本次渲染立即生效，
// 内容文本下一帧才更新，使 rich-text 布局新内容时容器宽度已就位，
// 避免"内容先按旧宽度折行、宽度生效后弹回"的抖动（宽度变化帧与内容变化帧分离）
const displayCodeText = ref<string>(props.codeText)

watch((): string => props.language + '\n' + props.codeText + '\n' + props.isClose.toString(), () => {
	nextTick(() => {
		displayCodeText.value = props.codeText
	})
}, { immediate: true })

watch((): string => props.language + '\n' + displayCodeText.value + '\n' + props.isClose.toString(), () => {
	highlightCode()
}, { immediate: true })

onMounted(() => {
	updateWindowWidth()
})

const scrollViewHeight = computed<string>(() => {
	if (props.language == 'mermaid') return mermaidContentHeight.value
	const rawLineCount = rawCodeLineCount.value
	const renderedLineCount = safeCodeTokens.value.length
	const lineCount = shouldUseOriginCode.value ? rawLineCount : (renderedLineCount > 0 ? renderedLineCount : rawLineCount)
	return `${lineCount * codeLineHeight + codeVerticalPadding}px`
})

const mermaidContentHeight = computed<string>(() => {
	const intrinsicWidth = activeMermaidBuffer.value == 0 ? buffer0MermaidWidth.value : buffer1MermaidWidth.value
	const intrinsicHeight = activeMermaidBuffer.value == 0 ? buffer0MermaidHeight.value : buffer1MermaidHeight.value
	if (intrinsicWidth > 0 && intrinsicHeight > 0) {
		return Math.max(1, Math.round(visibleCodeWidth() * intrinsicHeight / intrinsicWidth)).toString() + 'px'
	}
	return Math.round(visibleCodeWidth() * 4 / 5).toString() + 'px'
})

const codeRootStyle = computed<string>(() => {
	return 'width:100%;margin-top:6px;margin-bottom:6px;background-color:#111827;border-width:1px;border-style:solid;border-color:#374151;overflow:hidden;'
})

const codeHeaderStyle = computed<string>(() => {
	return 'position:relative;z-index:2;width:100%;height:38px;flex-direction:row;justify-content:space-between;align-items:center;padding-top:4px;padding-bottom:4px;padding-left:10px;padding-right:10px;background-color:#0d0d0d;'
})

const codeScrollViewStyle = computed<string>(() => {
	return 'width:100%;height:' + scrollViewHeight.value
		+ ';flex-direction:row;align-items:flex-start;padding-left:14px;padding-right:14px;box-sizing:border-box;background-color:#111827;'
})

const mermaidCodeScrollStyle = computed<string>(() => {
	return codeScrollViewStyle.value + 'position:absolute;left:0;top:0;'
})

const mermaidStageStyle = computed<string>(() => {
	return 'position:relative;width:100%;height:' + mermaidContentHeight.value
		+ ';overflow:hidden;background-color:' + themePageBackgroundColor.value + ';'
})

const mermaidImageBoxStyle = computed<string>(() => {
	return 'position:absolute;left:0;top:0;width:100%;height:' + mermaidContentHeight.value
		+ ';overflow:hidden;background-color:' + themePageBackgroundColor.value + ';justify-content:center;align-items:center;'
})

const copyCode = () => {
	uni.setClipboardData({
		data: props.codeText,
		showToast: false,
		success: () => {
			utils.showCopySuccessToast()
		},
		fail: () => {
			utils.showCopyFailureToast()
		}
	})
}

</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.uni-code-msg-root {
	width: 100%;
	margin: 6px 0;
	background-color: #111827;
	border: 1px solid #374151;
	overflow: hidden;
}

.uni-code-msg-code-header {
	position: relative;
	z-index: 2;
	width: 100%;
	height: 38px;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 4px 10px;
	background-color: #0d0d0d;
}

.uni-code-msg-mermaid-switch {
	height: 30px;
	flex-direction: row;
	padding: 2px;
	border-radius: 5px;
	background-color: #262626;
}

.uni-code-msg-mermaid-item {
	height: 26px;
	line-height: 26px;
	padding: 0 10px;
	border-radius: 4px;
	font-size: 12px;
	color: #a3a3a3;
}

.uni-code-msg-mermaid-item-active {
	background-color: #f5f5f5;
	color: #171717;
}

.uni-code-msg-language {
	font-size: 12px;
	color: #b4b4b4;
}

.uni-code-msg-copy-btn {
	height: 30px;
	flex-direction: row;
	align-items: center;
	padding: 0 5px;
	border-radius: 4px;
}

.uni-code-msg-copy-text {
	font-size: 11px;
	color: #f4f4f4;
	margin-left: 3px;
}

.uni-code-msg-code-scroll-view {
	width: 100%;
	height: auto;
	flex-direction: row;
	align-items: flex-start;
	padding-left: 14px;
	padding-right: 14px;
	box-sizing: border-box;
	background-color: #111827;
}

.uni-code-msg-mermaid-image-box {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	overflow: hidden;
	background-color: var(--bg-primary);
	justify-content: center;
	align-items: center;
}

.uni-code-msg-mermaid-image {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	background-color: var(--bg-primary);
}

.uni-code-msg-mermaid-stage {
	position: relative;
	width: 100%;
	overflow: hidden;
	background-color: var(--bg-primary);
}



.uni-code-msg-mermaid-code-scroll {
	position: absolute;
	left: 0;
	top: 0;
}

.uni-code-msg-mermaid-code-text {
	font-size: 14px;
	line-height: 22px;
	font-family: monospace;
	color: #d1fae5;
	/* #ifdef WEB */
	white-space: pre;
	/* #endif */
	align-self: flex-start;
}

.uni-code-msg-mermaid-loading {
	width: 18px;
	height: 18px;
	margin-bottom: 10px;
}

.uni-code-msg-mermaid-status-text {
	font-size: 13px;
	color: var(--text-secondary);
}
</style>
