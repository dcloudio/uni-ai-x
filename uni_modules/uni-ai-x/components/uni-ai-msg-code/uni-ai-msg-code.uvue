<template>
	<view class="uni-code-msg-root uni-theme-root">
		<view class="uni-code-msg-code-header">
			<text class="uni-code-msg-language" flatten>{{language}}</text>
			<view class="uni-code-msg-copy-btn" @click.stop="copyCode">
				<uni-ai-icon class="uni-code-msg-copy-icon" code="e60c" size="12" color="#f4f4f4"/>
				<text class="uni-code-msg-copy-text" flatten>复制代码</text>
			</view>
		</view>
		<scroll-view class="uni-code-msg-code-scroll-view" direction="horizontal" :show-scrollbar="false" :style="codeScrollViewStyle"
			>
			<rich-text :disable-split-screen-render="true" class="uni-code-msg-rich-text" :user-select="true" :style="codeRichTextStyle" :nodes="codeRichHtml" mode="native"></rich-text>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
import { MarkdownToken as IToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import {MsgItem} from '@/uni_modules/uni-ai-x/sdk';
import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'
import { estimateMaxLineTextWidth } from '@/uni_modules/uni-ai-x/sdk/text-width.uts'
import { markdownCodeTokenToRichTextNodes } from '@/uni_modules/uni-ai-x/sdk/markdown-rich-text.uts'
import { requestCachedCodeText, ParseCodeTextRes } from '@/uni_modules/uni-ai-x/sdk/parseCode.uts'
import { measureCodePerformance } from '@/uni_modules/uni-ai-x/sdk/code-performance.uts'
import { streamingCodeTokens } from '@/uni_modules/uni-ai-x/sdk/streaming-code-tokens.uts'

type UniAiMsgCodeProps = {
	codeText?: string
	blockKey?: string
	codeTokens?: IToken[][]
	language?: string
	isClose?: number
	// 所属消息对象（reactive 引用）：list-view 复用 item 的子组件 props 更新在长流式过程中
	// 可能丢失（vapor v-for/组件 props diff 缺陷），msg 对象属性为响应式直连不受影响，用于兜底
	msg?: MsgItem | null
}

const props = withDefaults(defineProps<UniAiMsgCodeProps>(), {
	codeText: '',
	blockKey: '',
	codeTokens: () => [] as IToken[][],
	language: 'text',
	isClose: 0,
	msg: null
})

let codeHighlightRequestVersion = 0
let codeIdentityVersion = ''
const highlightedCodeTokens = ref<IToken[][]>([] as IToken[][])
const highlightedCodeText = ref<string>('')
let highlightedCodeLanguage = ''
let requestedCodeText = ''
let requestedCodeLanguage = ''
let pendingCodeText = ''
let pendingCodeLanguage = ''
const codeLineHeight = 22
const codeVerticalPadding = 16
const codeFontSize = 14
const codeHorizontalPadding = 14
const estimatedCardHorizontalInset = 48
// 行尾 1em 余量：覆盖各平台 monospace 回退字体的度量误差，防止估算宽度略小于实际渲染宽度导致折行
const codeTailPadding = 14
// 流式期间 6em 前瞻余量：未完成行仍在增长，提前占住宽度，
// 吸收 chunk 到达时内容与容器更新的时间差，避免"先折行再弹回"的抖动；闭合后去掉，宽度单向收敛
const codeLookaheadPadding = 84
const windowWidth = ref<number>(0)

function normalizeCodeText(text: string): string {
	return text.replace(/\r\n/g, '\n')
}

function normalizeCodeTokens(codeTokens: IToken[][]): IToken[][] {
	return (codeTokens ?? [] as IToken[][]).map((lineTokens: IToken[] | null): IToken[] => lineTokens ?? [] as IToken[])
}

function buildRenderedCodeText(codeTokens: IToken[][]): string {
	return codeTokens.map((lineTokens: IToken[]) => {
		return lineTokens.map((token: IToken) => token.text ?? '').join('')
	}).join('\n')
}

function preserveStableCodeLines(codeText: string, nextTokens: IToken[][], language: string): IToken[][] {
	if (highlightedCodeLanguage != language) return nextTokens
	const previousText = normalizeCodeText(highlightedCodeText.value)
	const nextText = normalizeCodeText(codeText)
	if (previousText.length == 0 || !nextText.startsWith(previousText)) return nextTokens
	const previousLines = previousText.split('\n')
	const nextLines = nextText.split('\n')
	const previousTokens = highlightedCodeTokens.value
	const result = [] as IToken[][]
	for (let lineIndex = 0; lineIndex < nextTokens.length; lineIndex++) {
		if (lineIndex < previousLines.length && lineIndex < previousTokens.length
			&& previousLines[lineIndex] == nextLines[lineIndex]) {
			result.push(previousTokens[lineIndex])
		} else {
			result.push(nextTokens[lineIndex])
		}
	}
	return result
}

const safeCodeTokens = computed<IToken[][]>(() => {
	const propTokens = normalizeCodeTokens(props.codeTokens)
	const highlightedTokens = highlightedCodeTokens.value
	if (propTokens.length > 0) return propTokens
	return highlightedCodeLanguage == props.language ? highlightedTokens : [] as IToken[][]
})

function highlightCode() {
	// 闭合代码块的 token 已经随渲染数据传入，避免回收重用时再次异步解析。
	if (normalizeCodeTokens(props.codeTokens).length > 0 && props.isClose == 1) return
	const language = props.language
	if (requestedCodeText.length > 0 && requestedCodeLanguage != language) {
		codeHighlightRequestVersion += 1
		requestedCodeText = ''
		requestedCodeLanguage = ''
		pendingCodeText = ''
		pendingCodeLanguage = ''
	}
	const lines = normalizeCodeText(displayCodeText.value).split('\n')
	if (lines.length == 0) return
	const completedCount = props.isClose == 1 ? lines.length : lines.length - 1
	if (completedCount == 0) {
		pendingCodeText = ''
		pendingCodeLanguage = ''
		return
	}
	const completedText = lines.slice(0, completedCount).join('\n')
	if (highlightedCodeLanguage == language && highlightedCodeText.value == completedText) {
		pendingCodeText = ''
		pendingCodeLanguage = ''
		return
	}
	if (requestedCodeLanguage == language && requestedCodeText == completedText) return
	if (requestedCodeText.length > 0) {
		pendingCodeText = completedText
		pendingCodeLanguage = language
		return
	}
	startCodeHighlightRequest(completedText, language)
}

function startCodeHighlightRequest(codeText: string, language: string) {
	requestedCodeText = codeText
	requestedCodeLanguage = language
	const requestVersion = codeHighlightRequestVersion
	const identity = codeIdentity.value
	requestCachedCodeText((result: ParseCodeTextRes) => {
		if (requestVersion != codeHighlightRequestVersion) return
		if (identity != codeIdentity.value) return
		const currentText = normalizeCodeText(displayCodeText.value)
		if (language == props.language && currentText.startsWith(codeText) && result.error == null) {
			const hasNewerCachedText = highlightedCodeLanguage == language
				&& highlightedCodeText.value.length > codeText.length
				&& currentText.startsWith(highlightedCodeText.value)
			if (!hasNewerCachedText) {
				const stableTokens = preserveStableCodeLines(codeText, result.lines, language)
				highlightedCodeText.value = codeText
				highlightedCodeLanguage = language
				highlightedCodeTokens.value = stableTokens
			}
		}
		requestedCodeText = ''
		requestedCodeLanguage = ''
		const nextCodeText = pendingCodeText
		const nextLanguage = pendingCodeLanguage
		pendingCodeText = ''
		pendingCodeLanguage = ''
		if (nextCodeText.length > 0 && nextLanguage == props.language) {
			const liveText = normalizeCodeText(displayCodeText.value)
			if (liveText.startsWith(nextCodeText)
				&& !(highlightedCodeLanguage == nextLanguage && highlightedCodeText.value == nextCodeText)) {
				startCodeHighlightRequest(nextCodeText, nextLanguage)
			}
		}
	}, props.msg?._id ?? '', stableBlockKey.value, codeText, language)
}

const safeHighlightedText = computed<string>(() => {
	const propTokens = normalizeCodeTokens(props.codeTokens)
	if (propTokens.length > 0) return buildRenderedCodeText(propTokens)
	const highlightedText = highlightedCodeText.value
	return highlightedCodeLanguage == props.language ? highlightedText : ''
})

const renderedCodeTokens = computed<IToken[][]>(() => {
	return streamingCodeTokens(displayCodeText.value, safeHighlightedText.value, safeCodeTokens.value)
})

const shouldUseOriginCode = computed<boolean>(() => {
	return renderedCodeTokens.value.length == 0
})

function escapeCodeHtml(text: string): string {
	return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;')
}

function codeNodeHtml(node: UTSJSONObject): string {
	const type = node['type'] as string | null
	if (type == 'text') return escapeCodeHtml((node['text'] as string | null) ?? '')
	const name = node['name'] as string | null
	if (name == 'br') return '<br/>'
	if (name == null) return ''
	const attrs = node['attrs'] as UTSJSONObject | null
	let html = '<' + name
	if (attrs != null) {
		const style = attrs['style'] as string | null
		if (style != null) html += ' style="' + escapeCodeHtml(style) + '"'
	}
	html += '>'
	const children = node['children'] as UTSJSONObject[] | null
	if (children != null) for (let i = 0; i < children.length; i++) html += codeNodeHtml(children[i])
	return html + '</' + name + '>'
}

const codeRichNodes = computed<UTSJSONObject[]>(() => {
	const startedAt = Date.now()
	const token: IToken = { type: 'code_block', lang: props.language, text: displayCodeText.value, codeTokens: renderedCodeTokens.value }
	const nodes = markdownCodeTokenToRichTextNodes(token)
	measureCodePerformance('codeRichNodes', startedAt, codeIdentity.value)
	return nodes
})

const codeRichHtml = computed<string>(() => {
	const startedAt = Date.now()
	const nodes = codeRichNodes.value
	let html = ''
	for (let i = 0; i < nodes.length; i++) html += codeNodeHtml(nodes[i])
	measureCodePerformance('codeRichHtml', startedAt, codeIdentity.value)
	return html
})

function updateWindowWidth() {
	windowWidth.value = uni.getWindowInfo().windowWidth
}

const rawCodeLineCount = computed<number>(() => {
	return normalizeCodeText(displayCodeText.value).split('\n').length
})

const codeWidthCache = new Map<string, number>()
const codeWidthCacheOrder = [] as string[]
const maxCodeWidthCacheEntries = 128

function getCodeTextWidth(text: string): number {
	const startedAt = Date.now()
	const cached = codeWidthCache.get(text)
	if (cached != null) {
		measureCodePerformance('getCodeTextWidth', startedAt, codeIdentity.value)
		return cached
	}
	const lines = normalizeCodeText(text).split('\n')
	const width = estimateMaxLineTextWidth(lines, codeFontSize, 'mono')
	codeWidthCache.set(text, width)
	codeWidthCacheOrder.push(text)
	if (codeWidthCacheOrder.length > maxCodeWidthCacheEntries) {
		const oldest = codeWidthCacheOrder.shift()
		if (oldest != null) codeWidthCache.delete(oldest)
	}
	measureCodePerformance('getCodeTextWidth', startedAt, codeIdentity.value)
	return width
}

function visibleCodeWidth(): number {
	const currentWindowWidth = windowWidth.value > 0 ? windowWidth.value : uni.getWindowInfo().windowWidth
	return Math.max(160, Math.min(currentWindowWidth, 800) - estimatedCardHorizontalInset)
}

function visibleCodeContentWidth(): number {
	return Math.max(1, visibleCodeWidth() - codeHorizontalPadding * 2)
}

const codeContentWidth = computed<string>(() => {
	// 估算使用保守比率（text-width.uts mono 0.7/全角 1.05），保证估算宽度不小于实际渲染宽度
	const estimatedWidth = getCodeTextWidth(props.codeText) + codeTailPadding
	if (props.isClose != 1) {
		return Math.max(visibleCodeContentWidth(), estimatedWidth + codeLookaheadPadding).toString() + 'px'
	}
	// 代码块闭合：去掉流式前瞻余量，按最终内容重算一次，宽度单向收敛且不折行
	return Math.max(visibleCodeContentWidth(), estimatedWidth).toString() + 'px'
})

const codeLinesStyle = computed<string>(() => {
	return 'height:' + scrollViewHeight.value
		+ ';font-size:14px;line-height:22px;font-family:monospace;background-color:#111827;'
})

const codeRichTextStyle = computed<string>(() => {
	return codeLinesStyle.value + ';color:#d1fae5;'
})

const codeIdentity = computed<string>(() => {
	return (props.msg?._id ?? '') + ':' + stableBlockKey.value
})

const stableBlockKey = computed<string>(() => {
	const value = props.blockKey
	return value.endsWith('-c') ? value.slice(0, value.length - 2) : value
})

function resetCodeIdentityState() {
	codeHighlightRequestVersion += 1
	highlightedCodeText.value = ''
	highlightedCodeLanguage = ''
	highlightedCodeTokens.value = [] as IToken[][]
	requestedCodeText = ''
	requestedCodeLanguage = ''
	pendingCodeText = ''
	pendingCodeLanguage = ''
}

// Android ListView 复用同一个组件实例时，必须把代码块身份作为状态边界。
const displayCodeText = ref<string>(props.codeText)

watch(codeIdentity, (nextIdentity: string) => {
	if (codeIdentityVersion == nextIdentity) return
	const shouldReset = codeIdentityVersion.length > 0
	codeIdentityVersion = nextIdentity
	if (shouldReset) {
		resetCodeIdentityState()
	}
	displayCodeText.value = props.codeText
	// 身份切换后立即尝试同步命中已完成代码的高亮缓存，避免复用首帧显示无色文本。
	highlightCode()
}, { immediate: true })

// ListView 复用时同步接收最新代码文本，避免旧的半截内容在下一帧覆盖新代码。
watch((): string => props.language + '\n' + props.codeText + '\n' + props.isClose.toString(), () => {
	displayCodeText.value = props.codeText
}, { immediate: true })

watch((): string => props.language + '\n' + displayCodeText.value + '\n' + props.isClose.toString(), () => {
	highlightCode()
}, { immediate: true })

onMounted(() => {
	updateWindowWidth()
})

const scrollViewHeight = computed<string>(() => {
	const rawLineCount = rawCodeLineCount.value
	return `${Math.max(1, rawLineCount) * codeLineHeight + codeVerticalPadding}px`
})

const codeScrollViewStyle = computed<string>(() => {
	return 'height:' + scrollViewHeight.value + ';background-color:#111827;'
})

const copyCode = () => {
	uni.setClipboardData({
		data: props.codeText,
		showToast: false,
		success: () => {
			utils.showCopySuccessToast()
		},
		fail: () => {
			utils.showCopyFailureToast()
		}
	})
}

</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.uni-code-msg-root {
	width: 100%;
	margin: 6px 0;
	background-color: #111827;
	border: 1px solid #374151;
	overflow: hidden;
}

.uni-code-msg-code-header {
	position: relative;
	z-index: 2;
	width: 100%;
	height: 38px;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 4px 10px;
	background-color: #0d0d0d;
}

.uni-code-msg-language {
	font-size: 12px;
	color: #b4b4b4;
}

.uni-code-msg-copy-btn {
	height: 30px;
	flex-direction: row;
	align-items: center;
	padding: 0 5px;
	border-radius: 4px;
}

.uni-code-msg-copy-text {
	font-size: 11px;
	color: #f4f4f4;
	margin-left: 3px;
}

.uni-code-msg-code-scroll-view {
	width: 100%;
	height: auto;
	flex-direction: row;
	align-items: flex-start;
	box-sizing: border-box;
	background-color: #111827;
}

.uni-code-msg-rich-text {
	align-self: flex-start;
	flex-shrink: 0;
}

</style>
