<template>
	<view class="uni-code-msg-root" :class="[`ui-theme-${uiTheme}`]">
		<view class="uni-code-msg-code-header">
			<view class="uni-code-msg-mermaid-switch" v-if="language == 'mermaid'">
				<text class="uni-code-msg-mermaid-item" :class="showMermaidImage ? 'uni-code-msg-mermaid-item-active' : ''" @click="setMermaidView(true)">流程图</text>
				<text class="uni-code-msg-mermaid-item" :class="!showMermaidImage ? 'uni-code-msg-mermaid-item-active' : ''" @click="setMermaidView(false)">代码</text>
			</view>
			<template v-if="language != 'mermaid'">
				<text class="uni-code-msg-language">{{language}}</text>
				<view class="uni-code-msg-copy-btn" @click.stop="copyCode">
					<uni-ai-icon class="uni-code-msg-copy-icon" code="e60c" size="12" color="#f4f4f4"/>
					<text class="uni-code-msg-copy-text">复制代码</text>
				</view>
			</template>
			<view v-else-if="!showMermaidImage" class="uni-code-msg-copy-btn" @click.stop="copyCode">
				<uni-ai-icon class="uni-code-msg-copy-icon" code="e60c" size="12" color="#f4f4f4"/>
				<text class="uni-code-msg-copy-text">复制代码</text>
			</view>
		</view>
		<view v-if="language == 'mermaid' && showMermaidImage" class="uni-code-msg-mermaid-image-box" :style="{height: mermaidContentHeight}">
			<image v-if="hasMermaidImage(href)" class="uni-code-msg-mermaid-image" :src="href" mode="aspectFit" @click="previewMermaidImage" />
			<view v-else class="uni-code-msg-mermaid-status">
				<uni-rotate-icon v-if="!mermaidGenerationFailed" class="uni-code-msg-mermaid-loading" />
				<text class="uni-code-msg-mermaid-status-text">{{mermaidGenerationFailed ? '流程图生成失败' : '图片正在生成中'}}</text>
			</view>
		</view>
		<scroll-view v-else class="uni-code-msg-code-scroll-view" direction="horizontal" :style="{height: scrollViewHeight}">
			<rich-text class="uni-code-msg-rich-text" :style="{width: codeContentWidth}" :nodes="codeRichNodes" mode="native" :selectable="true"></rich-text>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
import { MarkdownToken as IToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
import {uiTheme} from '@/uni_modules/uni-ai-x/sdk';
import { estimateMaxLineTextWidth } from '@/uni_modules/uni-ai-x/sdk/text-width.uts'
import { markdownCodeTokenToRichTextNodes } from '@/uni_modules/uni-ai-x/sdk/markdown-rich-text.uts'

type UniAiMsgCodeProps = {
	codeText?: string
	codeTokens?: IToken[][]
	language?: string
	href?: string
	isClose?: number
}

const props = withDefaults(defineProps<UniAiMsgCodeProps>(), {
	codeText: '',
	codeTokens: () => [] as IToken[][],
	language: 'text',
	href: '',
	isClose: 0
})

function hasMermaidImage(href: string | null): boolean {
	return href != null && href.length > 0
}

const showMermaidImage = ref<boolean>(false)
const autoSwitchedMermaidHref = ref<string>('')
const codeLineHeight = 22
const codeVerticalPadding = 16
const codeFontSize = 14
const estimatedCodeHorizontalPadding = 30
const estimatedCardHorizontalInset = 48
const windowWidth = ref<number>(0)

function setMermaidView(showImage: boolean) {
	showMermaidImage.value = showImage
}

const previewMermaidImage = () => {
	if (props.href == null || props.href.length == 0) return
	uni.previewImage({ urls: [props.href] as string[] })
}

function normalizeCodeText(text: string): string {
	return text.replace(/\r\n/g, '\n')
}

function normalizeCodeTokens(codeTokens: IToken[][]): IToken[][] {
	return (codeTokens ?? [] as IToken[][]).map((lineTokens: IToken[] | null): IToken[] => lineTokens ?? [] as IToken[])
}

function buildRenderedCodeText(codeTokens: IToken[][]): string {
	return codeTokens.map((lineTokens: IToken[]) => {
		return lineTokens.map((token: IToken) => token.text ?? '').join('')
	}).join('\n')
}

const safeCodeTokens = computed<IToken[][]>(() => {
	return normalizeCodeTokens(props.codeTokens)
})

const showOriginCode = computed<boolean>(() => {
	if (safeCodeTokens.value.length == 0) return true
	const rawCode = normalizeCodeText(props.codeText)
	const renderedCode = normalizeCodeText(buildRenderedCodeText(safeCodeTokens.value))
	return rawCode != renderedCode
})

const shouldUseOriginCode = computed<boolean>(() => {
	return showOriginCode.value
})

const codeRichNodes = computed<UTSJSONObject[]>(() => {
	const token: IToken = {
		type: 'code_block',
		lang: props.language,
		text: props.codeText,
		codeTokens: shouldUseOriginCode.value ? [] as IToken[][] : safeCodeTokens.value
	}
	return markdownCodeTokenToRichTextNodes(token)
})

function normalizeRawCodeLines(text: string): string[] {
	const normalizedText = normalizeCodeText(text)
	const lines = normalizedText.split('\n')
	return lines.map((line: string) => line.length > 0 ? line : ' ')
}

function updateWindowWidth() {
	windowWidth.value = uni.getWindowInfo().windowWidth
}

const rawCodeLines = computed<string[]>(() => {
	return normalizeRawCodeLines(props.codeText)
})

function getCodeTextWidth(text: string): number {
	const lines = normalizeCodeText(text).split('\n')
	return estimateMaxLineTextWidth(lines, codeFontSize, 'mono') + estimatedCodeHorizontalPadding
}

function visibleCodeWidth(): number {
	const currentWindowWidth = windowWidth.value > 0 ? windowWidth.value : uni.getWindowInfo().windowWidth
	return Math.max(160, Math.min(currentWindowWidth, 800) - estimatedCardHorizontalInset)
}

const codeContentWidth = computed<string>(() => {
	return Math.max(1, getCodeTextWidth(props.codeText)).toString() + 'px'
})

const mermaidGenerationFailed = computed<boolean>(() => {
	return props.language == 'mermaid' && props.isClose == 1 && !hasMermaidImage(props.href)
})

watch((): string => props.language, (language: string) => {
	showMermaidImage.value = language == 'mermaid' && hasMermaidImage(props.href)
	autoSwitchedMermaidHref.value = hasMermaidImage(props.href) ? (props.href ?? '') : ''
	//#ifdef uniVersion < 4.81 && APP-IOS || MP-WEIXIN
	showMermaidImage.value = false
	//#endif
}, {immediate: true})

watch((): string | null => props.href, (href: string | null) => {
	if (props.language == 'mermaid' && hasMermaidImage(href) && autoSwitchedMermaidHref.value != href) {
		autoSwitchedMermaidHref.value = href as string
		showMermaidImage.value = true
	}
})

onMounted(() => {
	updateWindowWidth()
})

const scrollViewHeight = computed<string>(() => {
	if (props.language == 'mermaid') return mermaidContentHeight.value
	const rawLineCount = rawCodeLines.value.length
	const renderedLineCount = safeCodeTokens.value.length
	const lineCount = shouldUseOriginCode.value ? rawLineCount : (renderedLineCount > 0 ? renderedLineCount : rawLineCount)
	return `${lineCount * codeLineHeight + codeVerticalPadding}px`
})

const mermaidContentHeight = computed<string>(() => {
	return Math.round(visibleCodeWidth() * 4 / 5).toString() + 'px'
})

const copyCode = () => {
	uni.setClipboardData({
		data: props.codeText,
		success: () => {
			uni.showToast({
				title: '代码已复制到剪贴板',
				icon: 'success'
			})
		},
		fail: () => {
			uni.showToast({
				title: '复制失败',
				icon: 'none'
			})
		}
	})
}

</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.uni-code-msg-root {
	width: 100%;
	margin: 6px 0;
	background-color: #111827;
	border: 1px solid #374151;
	border-radius: 6px;
	overflow: hidden;
}

.uni-code-msg-code-header {
	width: 100%;
	height: 38px;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 4px 10px;
	background-color: #0d0d0d;
}

.uni-code-msg-mermaid-switch {
	height: 30px;
	flex-direction: row;
	padding: 2px;
	border-radius: 5px;
	background-color: #262626;
}

.uni-code-msg-mermaid-item {
	height: 26px;
	line-height: 26px;
	padding: 0 10px;
	border-radius: 4px;
	font-size: 12px;
	color: #a3a3a3;
}

.uni-code-msg-mermaid-item-active {
	background-color: #f5f5f5;
	color: #171717;
}

.uni-code-msg-language {
	font-size: 12px;
	color: #b4b4b4;
}

.uni-code-msg-copy-btn {
	height: 30px;
	flex-direction: row;
	align-items: center;
	padding: 0 5px;
	border-radius: 4px;
}

.uni-code-msg-copy-text {
	font-size: 11px;
	color: #f4f4f4;
	margin-left: 3px;
}

.uni-code-msg-code-scroll-view {
	width: 100%;
	height: auto;
	background-color: #111827;
}

.uni-code-msg-rich-text {
	align-self: flex-start;
}

.uni-code-msg-mermaid-image-box {
	width: 100%;
	overflow: hidden;
	background-color: #ffffff;
	justify-content: center;
	align-items: center;
}

.uni-code-msg-mermaid-image {
	width: 100%;
	height: 100%;
}

.uni-code-msg-mermaid-status {
	width: 100%;
	height: 100%;
	justify-content: center;
	align-items: center;
}

.uni-code-msg-mermaid-loading {
	width: 18px;
	height: 18px;
	margin-bottom: 10px;
}

.uni-code-msg-mermaid-status-text {
	font-size: 13px;
	color: #666666;
}
</style>
