<template>
	<view class="uni-ai-tool-bar uni-theme-root" :style="toolBarStyle">
		<!-- 复制按钮、重新回答按钮 -->
		<view class="uni-ai-tool-bar-btn" :style="toolBarButtonStyle" @click="copy">
			<uni-ai-icon name="copy-outline" size="20" :color="toolBarIconColor" />
		</view>
		<uni-ai-speech-output v-if="canSpeak && msg.from_uid == 'uni-ai' && msg.body.length > 0" :messageId="msg._id" :text="msg.body" :enabled="props.visible" />
		<view class="uni-ai-tool-bar-btn uni-ai-tool-bar-retry" :style="toolBarButtonStyle + 'margin-left:auto;margin-right:0;'" @click="loop" v-if="msg.from_uid == 'uni-ai' && isLastAiMsg && !isWeatherToolError">
			<uni-ai-icon name="refresh-outline" size="20" :color="toolBarIconColor" />
		</view>

		<!-- <view class="btn"  @click="deleteMsg" v-if="aiState != 'processing'">
			<uni-ai-icon class="delete" name="trash-outline" size="22" color="#999" />
		</view> -->
	</view>
</template>

<script lang="uts" setup>
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import uniAiSpeechOutput from '@/uni_modules/uni-ai-x/components/uni-ai-speech-output.uvue'
	import {uniAi, MsgItem, uiTheme} from '@/uni_modules/uni-ai-x/sdk';
	import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts';
	import { getModelCapabilities } from '@/uni_modules/uni-ai-x/sdk/model-capabilities.uts'
	const canSpeak = computed<boolean>(() => getModelCapabilities(uniAi.llm.provider, uniAi.llm.model).speechOutput)
	
	const props = withDefaults(defineProps<{
		msg: MsgItem
		visible?: boolean
	}>(), { visible: true })
	
	const msg = props.msg as MsgItem;
	
	const aiState = computed<string>(() => {
		return uniAi.currentChat!.state
	})
	
	const isLastAiMsg = computed<boolean>(() => {
		return msg._id == uniAi.lastAiMsg?._id
	})
	const isWeatherToolError = computed<boolean>(() => {
		const error = msg.error_msg ?? ''
		return error.includes('天气查询超时') || error.includes('MCP 请求超时') || error.includes('天气查询工具连续三次调用失败') || error.includes('MCP 服务连续三次连接失败') || error.includes('MCP 工具连续三次调用失败')
	})
	
	const toolBarBackgroundColor = computed<string>(() => {
		return uiTheme.value == 'dark' ? '#25282c' : '#ffffff'
	})

	const toolBarIconColor = computed<string>(() => {
		return uiTheme.value == 'dark' ? '#b0b0b0' : '#8a8a8a'
	})

	const toolBarStyle = computed<string>(() => {
		return 'width:100%;height:42px;flex-direction:row;opacity:' + (props.visible ? '1' : '0') + ';background-color:' + toolBarBackgroundColor.value + ';'
	})

	const toolBarButtonStyle = computed<string>(() => {
		return 'width:32px;height:36px;align-items:center;justify-content:center;flex-shrink:0;margin-top:6px;margin-right:4px;'
	})

	const copyToClipboard = (text: string) => {
		uni.setClipboardData({
			data: text,
			showToast: false,
			success: () => {
				utils.showCopySuccessToast()
			},
			fail: () => {
				utils.showCopyFailureToast()
			}
		})
	}
	
	const copy = () => {
		if (!props.visible) return
		// 请求出错时错误信息存放于 error_msg，优先复制错误信息，便于用户反馈问题
		const errorMsg = msg.error_msg
		if (errorMsg != null && errorMsg.length > 0) {
			copyToClipboard(errorMsg)
			return
		}
		if (typeof msg.body != 'string') {
			utils.showCopyFailureToast()
			return
		}
		const result = msg.toolResultText ?? ''
		copyToClipboard(result.length > 0 ? (msg.body.length > 0 ? msg.body + '\n' : '') + result : msg.body)
	}
	
	const loop = () => {
		if (!props.visible || uniAi.currentChat!.state == 'processing') return
		uniAi.resetMsg(msg)
		uniAi.answerQuestion(msg)
	}
	
	// const deleteMsg = () => {
	// 	uniAi.deleteMsg(msg._id)
	// }
</script>

<style lang="scss">
	.uni-ai-tool-bar {
		width: 100%;
		flex-direction: row;
	}

	.uni-ai-tool-bar-btn {
		width: 30px;
		height: 30px;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		margin-top: 5px;
		margin-right: 15px;
		/* #ifdef WEB */
		cursor: pointer;
		/* #endif */
	}

</style>
