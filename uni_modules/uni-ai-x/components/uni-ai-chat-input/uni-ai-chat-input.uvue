<template>
	<view id="chat-composer-shell" class="composer-shell">
    <view v-show="keyboardHeight == 0 && !isFullscreenLayout && !voiceHolding" class="composer-bottom-mask" :style="{height: (46 + composerSafeBottom) + 'px'}" />
	<view id="chat-input-container" class="chat-input" :class="[isFullscreenLayout ? 'chat-input-fullscreen' : '', voiceHolding ? (composerState.voiceCancel ? 'chat-input-canceling' : 'chat-input-recording') : '', keyboardHeight > 0 ? 'chat-input-keyboard-open' : '']"
		:style="{height: chatInputHeight, width: isFullscreenLayout ? fullscreenInputWidth : 'auto'}">
		<uni-ai-draft-images v-if="uniAi.imgList.length > 0 && !voiceHolding" />
		<uni-ai-draft-documents v-show="!voiceHolding" />
		<view v-if="isEditingMsg && !voiceHolding" class="chat-input-edit-tip">
			<text class="chat-input-edit-tip-text" flatten>{{tr('正在编辑消息，发送后将替换该消息及之后的对话', 'Editing this message will replace it and all later replies.')}}</text>
			<view class="chat-input-edit-tip-cancel" @click="cancelEdit">
				<text class="chat-input-edit-tip-cancel-text">{{tr('取消', 'Cancel')}}</text>
			</view>
		</view>
		<uni-ai-voice-input v-if="composerState.voice" />
		<view v-else class="chat-input-editor">
		<view v-if="chatInputContent.length > 0 || isFullscreen" class="chat-input-fullscreen-btn" @click.stop="toggleFullscreen"
			@touchstart.stop="prepareFullscreenToggle"
			<!-- #ifdef WEB -->
			@mousedown.stop="prepareFullscreenToggle"
			<!-- #endif -->
			<!-- #ifdef WEB -->
			:title="isFullscreen ? tr('退出全屏输入', 'Exit full screen') : tr('全屏输入', 'Full screen')"
			<!-- #endif -->
		>
			<uni-ai-icon :name="isFullscreen ? 'compact-outline' : 'fullscreen-outline'" size="16" color="#9b9b9b" />
		</view>
		<textarea id="chat-input-textarea" class="chat-input-textarea" :class="isFullscreen ? 'chat-input-textarea-expanded' : ''"
			:style="{height: isFullscreen ? expandedTextareaHeight : '46px'}" v-model="chatInputContent" :placeholder="tr('发消息或按住说话', 'Message or hold to talk')"
			:adjust-position="false" :hold-keyboard="isFullscreen || keepKeyboardForToggle" @keyboardheightchange="onKeyboardheightchange" placeholder-class="chat-input-placeholder"
			:focus="inputFocused" @focus="onInputFocus" @blur="onInputBlur" :auto-height="false"
		></textarea>
		</view>
		<view v-show="!voiceHolding" class="chat-input-toolbar" :class="isFullscreenLayout ? 'chat-input-toolbar-fullscreen' : ''"
			:style="{bottom: isFullscreenLayout ? (keyboardHeight > 0 ? (keyboardHeight + 5) + 'px' : 'env(safe-area-inset-bottom)') : 'auto'}">
			<input-tool-bar @scrollToLastMsg="scrollToLastMsg" @click.stop />
		</view>
		<view class="chat-input-keyboard-cover"
			:class="keyboardHeight > 0 ? 'chat-input-keyboard-cover-keyboard' : ''"
			:style="{height: keyboardHeight + 'px'}"></view>
	</view>
    <uni-ai-attachment-panel v-show="composerState.attachments && !voiceHolding && !isFullscreen" />
    <view v-show="keyboardHeight == 0 && !isFullscreenLayout && !voiceHolding" class="composer-footer" :style="{height: (22 + composerSafeBottom) + 'px', paddingBottom: composerSafeBottom + 'px'}">
        <text class="composer-footer-text">{{tr('内容由 AI 生成，请仔细甄别', 'AI generated content. Please verify.')}}</text>
    </view>
    </view>
</template>

<script lang="uts" setup>
	import { composerState } from '@/uni_modules/uni-ai-x/sdk/composer-state.uts'
	import uniAiVoiceInput from '../uni-ai-voice-input.uvue'
	import uniAiAttachmentPanel from '../uni-ai-attachment-panel.uvue'
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import uniAi from '@/uni_modules/uni-ai-x/sdk'
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'
	import inputToolBar from '@/uni_modules/uni-ai-x/components/input-tool-bar.uvue'
	import uniAiDraftImages from '@/uni_modules/uni-ai-x/components/uni-ai-draft-images.uvue'

	import uniAiDraftDocuments from '@/uni_modules/uni-ai-x/components/uni-ai-draft-documents.uvue'

	const emit = defineEmits<{
		'scroll-to-last-msg': []
        'layout-height': [height: number]
	}>()

	const voiceHolding = computed<boolean>(() => composerState.voicePhase == 'starting' || composerState.voicePhase == 'recording')
	const keyboardHeight = ref<number>(0)
    const composerSafeBottom = ref<number>(0)
    // #ifdef APP-ANDROID
    composerSafeBottom.value = uni.getWindowInfo().safeAreaInsets.bottom
    // #endif
	const isFullscreen = ref<boolean>(false)
	const isFullscreenLayout = ref<boolean>(false)
	const inputFocused = ref<boolean>(false)
	const keepKeyboardForToggle = ref<boolean>(false)
	const restoreFocusAfterToggle = ref<boolean>(false)
	const layoutTransitioning = ref<boolean>(false)
	const expandedTextareaHeight = ref<string>('0px')
	const chatInputHeight = ref<string>('auto')
	const fullscreenInputWidth = ref<string>('auto')
	let normalChatInputHeight: string = 'auto'
	let layoutTransitionTimer: number = 0
	const chatInputContent = computed<string>({
		get: (): string => {
			return uniAi.currentChat?.inputContent ?? ''
		},
		set: (value: string) => {
			if (uniAi.currentChat != null) {
				uniAi.currentChat!.inputContent = value
			}
		}
	})

	const isEditingMsg = computed<boolean>(() => {
		return uniAi.editingMsgId != ''
	})

	const cancelEdit = () => {
		uniAi.cancelEditMsg()
		if (uniAi.currentChat != null) {
			uniAi.currentChat!.inputContent = ''
		}
	}

	watch(() => composerState.voice, () => {
        if (isFullscreen.value) toggleFullscreen()
        inputFocused.value = false
    })
    watch(() => uniAi.currentChat?.id, () => { composerState.attachments = false })

	function scrollToLastMsg() {
		emit('scroll-to-last-msg')
	}

	function onKeyboardheightchange(res: UniInputKeyboardHeightChangeEvent) {
		if (layoutTransitioning.value) {
			return
		}
		keyboardHeight.value = res.detail.height
	}

	function onInputFocus() {
		composerState.attachments = false
		inputFocused.value = true
		restoreFocusAfterToggle.value = false
	}

	function onInputBlur() {
		if (!restoreFocusAfterToggle.value) {
			inputFocused.value = false
		}
	}

	function prepareFullscreenToggle() {
		keepKeyboardForToggle.value = true
		restoreFocusAfterToggle.value = inputFocused.value
	}

	function toggleFullscreen() {
		if (layoutTransitionTimer != 0) {
			clearTimeout(layoutTransitionTimer)
			layoutTransitionTimer = 0
			layoutTransitioning.value = false
		}
		isFullscreen.value = !isFullscreen.value
		if (isFullscreen.value) {
			const chatInput = uni.getElementById('chat-input-container')
			const currentHeight = chatInput?.getBoundingClientRect().height ?? 0
			normalChatInputHeight = currentHeight > 0 ? currentHeight + 'px' : 'auto'
			chatInputHeight.value = normalChatInputHeight
			fullscreenInputWidth.value = uni.getWindowInfo().windowWidth + 'px'
			isFullscreenLayout.value = true
			expandedTextareaHeight.value = uni.getWindowInfo().windowHeight + 'px'
			nextTick(() => {
				const windowInfo = uni.getWindowInfo()
				chatInputHeight.value = (windowInfo.windowHeight - windowInfo.statusBarHeight) + 'px'
			})
		} else {
			layoutTransitioning.value = true
			chatInputHeight.value = normalChatInputHeight
			layoutTransitionTimer = setTimeout(() => {
				isFullscreenLayout.value = false
				keepKeyboardForToggle.value = false
				layoutTransitioning.value = false
				chatInputHeight.value = 'auto'
				layoutTransitionTimer = 0
			}, 140)
		}
		if (restoreFocusAfterToggle.value) {
			nextTick(() => {
				const textarea = uni.getElementById('chat-input-textarea')
				textarea?.focus()
				restoreFocusAfterToggle.value = false
			})
		}
	}
    // Observe the complete composer, including drafts, the keyboard and attachment panel.
    // Fullscreen removes its card from normal flow; retain the last ordinary height.
    // #ifdef WEB
    let layoutObserver: ResizeObserver | null = null
    // #endif
    // #ifdef APP-ANDROID
    let layoutObserver: UniResizeObserver | null = null
    // #endif
    // #ifdef WEB || APP-ANDROID
    function reportComposerHeight() {
        if (isFullscreenLayout.value) return
        const height = uni.getElementById('chat-composer-shell')?.getBoundingClientRect().height ?? 0
        if (height > 0) emit('layout-height', height)
    }
    onMounted(() => {
        nextTick(() => {
            const shell = uni.getElementById('chat-composer-shell')
            if (shell == null) return
            // #ifdef WEB
            layoutObserver = new ResizeObserver(() => { reportComposerHeight() })
            // #endif
            // #ifdef APP-ANDROID
            layoutObserver = new UniResizeObserver((_entries: UniResizeObserverEntry[]) => { reportComposerHeight() })
            // #endif
            layoutObserver?.observe(shell)
            reportComposerHeight()
        })
    })
    onUnmounted(() => { layoutObserver?.disconnect(); layoutObserver = null })
    // #endif

</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
.composer-shell { position: relative; z-index: 30; flex-shrink: 0; background-color: transparent; }
.composer-bottom-mask { position: absolute; left: 0; right: 0; bottom: 0; background-color: var(--bg-primary); }
.composer-footer { position: relative; height: 22px; box-sizing: border-box; flex-shrink: 0; align-items: center; justify-content: center; background-color: var(--bg-primary); }
.composer-footer-text { font-size: 10px; line-height: 14px; color: var(--text-tertiary); }

.chat-input {
	position: absolute;
	/* #ifdef MP-WEIXIN */
	position: relative;
	flex-shrink: 0;
	/* #endif */
	left: 0;
	right: 0;
	bottom: 0;
	flex-direction: column;
	background-color: var(--bg-primary);
	padding: 10px 10px 8px;
	margin: 6px 12px 0;
	border-radius: 24px;
	border: 1px solid var(--border-color);
	box-sizing: border-box;
	overflow: hidden;
	z-index: 30;
	transition-property: height;
	transition-duration: 140ms;
	transition-timing-function: ease-out;
}

.chat-input-keyboard-open { margin-bottom: 0; }
.chat-input-canceling { margin: 0; border-radius: 20px 20px 0 0; background-image: linear-gradient(to bottom, #ffffff, #ffcdd7); }
.chat-input-recording { margin: 0; border-radius: 20px 20px 0 0; background-image: linear-gradient(to bottom, #ffffff, #3979ff); }

.chat-input-fullscreen {
	margin: 0;
	border-radius: 0;
	position: fixed;
	right: 0;
	bottom: 0;
	left: auto;
	z-index: 1000;
	overflow: hidden;
}

.chat-input-editor {
	position: relative;
	background-color: transparent;
	margin-bottom: 2px;
	flex-shrink: 0;
}

.chat-input-textarea {
	max-height: 200px;
	width: 100%;
	padding: 2px 28px 2px 6px;
	font-size: 15px;
	line-height: 23px;
	box-sizing: border-box;
	color: var(--text-primary);
}

.chat-input-textarea-expanded {
	max-height: 2000px;
}

.chat-input-fullscreen-btn {
	position: absolute;
	top: 0;
	right: 0;
	width: 36px;
	height: 36px;
	justify-content: center;
	align-items: center;
	z-index: 2;
}

.chat-input-toolbar-fullscreen {
	position: absolute;
	left: 15px;
	right: 15px;
	z-index: 3;
}



.chat-input-edit-tip {
	flex-direction: row;
	align-items: center;
	padding: 6px 10px;
	margin-bottom: 8px;
	background-color: var(--bg-secondary);
	border-radius: 8px;
}

.chat-input-edit-tip-text {
	flex: 1;
	font-size: 12px;
	color: var(--text-secondary);
}

.chat-input-edit-tip-cancel {
	flex-direction: row;
	align-items: center;
	margin-left: 8px;
	margin-right: -8px;
	padding: 4px 8px;
}

.chat-input-edit-tip-cancel-text {
	font-size: 12px;
	color: var(--accent-primary);
}

.chat-input-placeholder {
	color: var(--text-tertiary);
}

.chat-input-keyboard-cover {
	/* #ifdef APP-ANDROID */
	margin-bottom: 0;
	/* #endif */
	/* #ifndef APP-ANDROID */
	padding-bottom: env(safe-area-inset-bottom);
	/* #endif */
}

/* The keyboard already owns the bottom inset while it is visible. */
.chat-input-keyboard-cover-keyboard {
	/* #ifdef APP-ANDROID */
	margin-bottom: 0;
	/* #endif */
	/* #ifndef APP-ANDROID */
	padding-bottom: 0;
	/* #endif */
}

/* #ifdef APP-ANDROID */
.chat-input {
	position: relative;
	flex-shrink: 0;
}

.chat-input-fullscreen {
	position: fixed;
}
/* #endif */

/* #ifdef H5 */
.chat-input:not(.chat-input-fullscreen) {
	position: relative;
	flex-shrink: 0;
}

@media screen and (min-device-width:960px){
	.chat-input {
		border-radius: 24px;
		margin: 12px 20px 0;
		margin-top: 0;
	}
}
/* #endif */
</style>
