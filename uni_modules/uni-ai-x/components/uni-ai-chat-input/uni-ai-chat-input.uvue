<template>
	<view class="chat-input">
		<uni-ai-draft-images />
		<view v-if="isEditingMsg" class="chat-input-edit-tip">
			<text class="chat-input-edit-tip-text" flatten>正在编辑消息，发送后将替换该消息及之后的对话</text>
			<view class="chat-input-edit-tip-cancel" @click="cancelEdit">
				<text class="chat-input-edit-tip-cancel-text">取消</text>
			</view>
		</view>
		<textarea class="chat-input-textarea" v-model="chatInputContent" placeholder="给 uni-ai-x 发送消息"
			:adjust-position="false" @keyboardheightchange="onKeyboardheightchange" placeholder-class="chat-input-placeholder"
			@focus="scrollToLastMsg" :auto-height="true"
		></textarea>
		<input-tool-bar @scrollToLastMsg="scrollToLastMsg" @click.stop />
		<view class="chat-input-keyboard-cover" :style="{height: keyboardHeight + 'px'}"></view>
	</view>
</template>

<script lang="uts" setup>
	import uniAi from '@/uni_modules/uni-ai-x/sdk'
	import inputToolBar from '@/uni_modules/uni-ai-x/components/input-tool-bar.uvue'
	import uniAiDraftImages from '@/uni_modules/uni-ai-x/components/uni-ai-draft-images.uvue'

	const emit = defineEmits<{
		'scroll-to-last-msg': []
	}>()

	const keyboardHeight = ref<number>(0)
	const chatInputContent = computed<string>({
		get: (): string => {
			return uniAi.currentChat?.inputContent ?? ''
		},
		set: (value: string) => {
			if (uniAi.currentChat != null) {
				uniAi.currentChat!.inputContent = value
			}
		}
	})

	const isEditingMsg = computed<boolean>(() => {
		return uniAi.editingMsgId != ''
	})

	const cancelEdit = () => {
		uniAi.cancelEditMsg()
		if (uniAi.currentChat != null) {
			uniAi.currentChat!.inputContent = ''
		}
	}

	function scrollToLastMsg() {
		emit('scroll-to-last-msg')
	}

	function onKeyboardheightchange(res: UniInputKeyboardHeightChangeEvent) {
		keyboardHeight.value = res.detail.height
	}
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.chat-input {
	flex-direction: column;
	background-color: var(--bg-primary);
	padding: 15px 15px 5px 15px;
	border-radius: 15px 15px 0 0;
	border: 1px solid var(--border-secondary);
}

.chat-input-textarea {
	min-height: 50px;
	max-height: 200px;
	width: 100%;
}

.chat-input-edit-tip {
	flex-direction: row;
	align-items: center;
	padding: 6px 10px;
	margin-bottom: 8px;
	background-color: var(--bg-secondary);
	border-radius: 8px;
}

.chat-input-edit-tip-text {
	flex: 1;
	font-size: 12px;
	color: var(--text-secondary);
}

.chat-input-edit-tip-cancel {
	flex-direction: row;
	align-items: center;
	margin-left: 8px;
	margin-right: -8px;
	padding: 4px 8px;
}

.chat-input-edit-tip-cancel-text {
	font-size: 12px;
	color: var(--accent-primary);
}

.chat-input-placeholder {
	color: var(--text-disabled);
}

.chat-input-keyboard-cover {
	/* #ifdef APP-ANDROID */
	margin-bottom: env(safe-area-inset-bottom);
	/* #endif */
	/* #ifndef APP-ANDROID */
	padding-bottom: env(safe-area-inset-bottom);
	/* #endif */
}

/* #ifdef H5 */
@media screen and (min-device-width:960px){
	.chat-input {
		border-radius: 15px;
		margin: 10px;
		margin-top: 0;
	}
}
/* #endif */
</style>
