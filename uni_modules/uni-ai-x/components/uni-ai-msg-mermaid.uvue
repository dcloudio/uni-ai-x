<template>
	<view class="uni-mermaid-msg-root" :class="uiTheme == 'dark' ? 'uni-theme-dark' : 'uni-theme-light'">
		<uni-ai-generation-status v-if="!showSource && !imageReady" :style="hasPreparedLayout ? 'position:absolute;left:0;top:0;z-index:3;' : ''" :label="generationFailed ? tr('图表生成失败', 'Diagram generation failed') : tr('图表正在生成中', 'Generating diagram')" :pending="!generationFailed" :source="props.codeText" />
		<view v-if="showSource || hasPreparedLayout" class="uni-mermaid-msg-code-header" :style="!showSource && !imageReady ? 'opacity:0;' : ''">
			<view class="uni-mermaid-msg-switch" flatten>
				<text class="uni-mermaid-msg-switch-item" :class="!showSource ? 'uni-mermaid-msg-switch-item-active' : ''" @click.stop="sourceSelection = ''">{{tr('图表', 'Diagram')}}</text>
				<text class="uni-mermaid-msg-switch-item" :class="showSource ? 'uni-mermaid-msg-switch-item-active' : ''" @click.stop="sourceSelection = props.identity">{{tr('代码', 'Code')}}</text>
			</view>
			<view v-if="showSource" class="uni-mermaid-msg-copy-btn" @click.stop="copyCode">
				<uni-ai-icon name="copy-outline" size="12" :color="uiTheme == 'dark' ? '#f4f4f4' : '#334155'" />
				<text class="uni-mermaid-msg-copy-text" flatten>{{tr('复制代码', 'Copy code')}}</text>
			</view>
		</view>
		<view class="uni-mermaid-msg-stage" :class="showSource ? 'uni-mermaid-msg-stage-code' : ''" :style="!showSource && !hasPreparedLayout ? 'position:absolute;height:1px;padding:0;opacity:0;' : ''">
			<image v-if="!showSource && props.src.length > 0" :key="imageIdentity" class="uni-mermaid-msg-image" :style="imageStyle" :src="props.src" mode="aspectFit" @load="onImageSettled" @error="onImageFailed" @click.stop="previewMermaidImage" />
			<view v-else-if="showSource" class="uni-mermaid-msg-code-source">
				<text class="uni-mermaid-msg-code-text">{{props.codeText}}</text>
			</view>
		</view>
	</view>
</template>

<script lang="uts" setup>
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
import uniAiGenerationStatus from '@/uni_modules/uni-ai-x/components/uni-ai-generation-status.uvue'
import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'
import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'

import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'
import { mathWindowWidth } from '@/uni_modules/uni-ai-x/sdk/math-presentation.uts'
import { mermaidPreviewStyle } from '@/uni_modules/uni-ai-x/sdk/image-layout.uts'
import { useMessageRenderTask } from '@/uni_modules/uni-ai-x/sdk/message-render-tasks.uts'

const props = withDefaults(defineProps<{
	codeText?: string
	identity: string
	messageId?: string
	src?: string
	imageWidth?: number
	imageHeight?: number
	renderFailed?: boolean
}>(), {
	codeText: '',
	src: ''
})

// Only user interaction changes local state; a recycled row cannot inherit another block's tab.
const sourceSelection = ref<string>('')
const imageIdentity = computed<string>(() => props.identity + ':' + props.src)
const failedImage = ref<string>('')
const showSource = computed<boolean>(() => {
	return sourceSelection.value == props.identity
})
const generationFailed = computed<boolean>(() => props.renderFailed == true || failedImage.value == imageIdentity.value)
const imageReady = computed<boolean>(() => props.src.length > 0 && !generationFailed.value)
const hasPreparedLayout = computed<boolean>(() => props.src.length > 0 && (props.imageWidth ?? 0) > 0 && (props.imageHeight ?? 0) > 0)
function onImageSettled() {
	if (failedImage.value == imageIdentity.value) failedImage.value = ''
}
function onImageFailed() {
	failedImage.value = imageIdentity.value
}
useMessageRenderTask(() => props.messageId ?? '', () => 'mermaid-image:' + props.identity + ':' + props.src,
	() => false,
	() => props.src.length > 0 ? uiTheme.value + ':' + props.src : '')
const imageStyle = computed<string>(() => mermaidPreviewStyle(props.imageWidth ?? 0, props.imageHeight ?? 0,
	mathWindowWidth.value > 0 ? mathWindowWidth.value : uni.getWindowInfo().windowWidth))

function previewMermaidImage() {
	// #ifdef WEB
	if (window.navigator.userAgent.match(/Android|iPhone|iPad|iPod|Mobile/i) == null) return
	// #endif
	if (props.src.length == 0) return
	uni.previewImage({ urls: [props.src] as string[] })
}

function copyCode() {
	uni.setClipboardData({
		data: props.codeText,
		showToast: false,
		success: () => { utils.showCopySuccessToast() },
		fail: () => { utils.showCopyFailureToast() }
	})
}

</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.uni-mermaid-msg-root {
	position: relative;
	width: 100%;
	min-height: 32px;
	margin: 6px 0;
	background-color: var(--mermaid-surface);
	border: 1px solid var(--mermaid-border);
	border-radius: 12px;
	overflow: hidden;
}

.uni-mermaid-msg-root.uni-theme-light {
	--mermaid-surface: #fafafa;
	--mermaid-image-surface: #ffffff;
	--mermaid-border: #eeeeee;
	--mermaid-header: #fafafa;
	--mermaid-switch: #eeeeee;
	--mermaid-switch-text: #64748b;
	--mermaid-active: #ffffff;
	--mermaid-active-text: #0f172a;
	--mermaid-copy: #334155;
	--mermaid-code-surface: #fafafa;
	--mermaid-code-text: #1b1c24;
}

.uni-mermaid-msg-root.uni-theme-dark {
	--mermaid-surface: #171717;
	--mermaid-image-surface: #25282c;
	--mermaid-border: #374151;
	--mermaid-header: #171717;
	--mermaid-switch: #262626;
	--mermaid-switch-text: #a3a3a3;
	--mermaid-active: #f5f5f5;
	--mermaid-active-text: #171717;
	--mermaid-copy: #f4f4f4;
	--mermaid-code-surface: #171717;
	--mermaid-code-text: #f3f4f6;
}

.uni-mermaid-msg-code-header {
	position: relative;
	z-index: 2;
	width: 100%;
	height: 38px;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 4px 10px;
	background-color: var(--mermaid-header);
}

.uni-mermaid-msg-switch {
	height: 30px;
	flex-direction: row;
	padding: 2px;
	border-radius: 10px;
	background-color: var(--mermaid-switch);
}

.uni-mermaid-msg-switch-item {
	height: 26px;
	line-height: 26px;
	padding: 0 10px;
	border-radius: 8px;
	font-size: 12px;
	color: var(--mermaid-switch-text);
}

.uni-mermaid-msg-switch-item-active {
	background-color: var(--mermaid-active);
	color: var(--mermaid-active-text);
}

.uni-mermaid-msg-copy-btn {
	height: 30px;
	flex-direction: row;
	align-items: center;
	padding: 0 5px;
	border-radius: 4px;
}

.uni-mermaid-msg-copy-text {
	font-size: 11px;
	color: var(--mermaid-copy);
	margin-left: 3px;
}

.uni-mermaid-msg-image {
	width: 100%;
	background-color: var(--mermaid-image-surface);
}

.uni-mermaid-msg-stage {
	position: relative;
	width: 100%;
	padding: 16px;
	overflow: hidden;
	background-color: var(--mermaid-image-surface);
}

.uni-mermaid-msg-stage-code { background-color: var(--mermaid-code-surface); }

.uni-mermaid-msg-code-source {
	width: 100%;
	background-color: var(--mermaid-code-surface);
}

.uni-mermaid-msg-code-text {
	font-size: 14px;
	line-height: 22px;
	font-family: monospace;
	margin-left: 0;
	color: var(--mermaid-code-text);
	white-space: pre-wrap;
	word-break: break-all;
	align-self: flex-start;
}

</style>
