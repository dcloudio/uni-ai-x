	flex: 1;
	margin-bottom: 140px;
}

.chat-box-pending-loading {
	position: absolute;
	width: 16px;
	height: 16px;
	border-color: #aaaaaa;
	z-index: 15;
}

.chat-box-add-chat {
	position: absolute;
	bottom: 150px;
	left: 50%;
	margin-left: -55px;
	width: 110px;
	flex-direction: row;
	justify-content: center;
	z-index: 20;
}

.chat-box-welcome-msg-box {
	flex: 1;
	width: 100%;
	padding: 0 20px;
	box-sizing: border-box;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.chat-box-welcome-logo {
	width: 44px;
	height: 44px;
	margin-bottom: 18px;
}

.chat-box-welcome-title {
	font-size: 23px;
	font-weight: bold;
	color: var(--text-primary);
	margin-bottom: 10px;
}

.chat-box-welcome-text {
	width: 100%;
	box-sizing: border-box;
	padding: 0 10px;
	font-size: 16px;
	color: var(--text-secondary);
	text-align: center;
	line-height: 24px;
}

.chat-box-welcome-actions {
	width: 100%;
	max-width: 360px;
	margin-top: 20px;
	flex-direction: column;
}

.chat-box-welcome-demo-btn {
	width: 100%;
	min-height: 48px;
	margin: 5px 0;
	padding: 8px 12px;
	box-sizing: border-box;
	flex-direction: row;
	align-items: center;
	border: 1px solid var(--border-color);
	border-radius: 16px;
	background-color: var(--bg-primary);
}

