<template>
	<view class="chat-box uni-theme-root">
		<uni-ai-chat-nav @change-menu="changeMenu" />
		<view class="chat-box-chat" :class="showMenu ? 'chat-box-chat-showMenu' : ''" ref="chat">
			<view id="chat-scroll-box" class="chat-box-scroll-view-box">
				<view class="chat-box-welcome-msg-box" v-if="msgList.length == 0" flatten>
					<image class="chat-box-welcome-logo" src="@/uni_modules/uni-ai-x/static/uni-chat-logo.png" flatten/>
					<text class="chat-box-welcome-title" flatten>{{tr('嗨！我是 UNI-AI', 'Hi, I am UNI-AI')}}</text>
					<text class="chat-box-welcome-text" flatten>{{tr('问答、编程、翻译与创作。', 'Ask, code, translate, create.')}}</text>
					<view class="chat-box-welcome-actions">
						<view class="chat-box-welcome-demo-btn" @click="runMarkdownDemo()">
							<uni-ai-icon class="chat-box-welcome-demo-icon" name="checklist-outline" size="20" color="var(--accent-primary)" />
							<text class="chat-box-welcome-demo-btn-text">{{tr('体验完整Markdown示例', 'Explore the Markdown demo')}}</text>
							<uni-ai-icon name="chevron-right-outline" size="16" color="var(--text-tertiary)" />
						</view>
						<template v-if="showToolExamples">
							<view v-for="item in welcomePrompts" :key="item.label" class="chat-box-welcome-demo-btn" @click="sendWelcomePrompt(item.prompt)">
								<uni-ai-icon class="chat-box-welcome-demo-icon" :name="item.icon" size="20" color="var(--accent-primary)" />
								<text class="chat-box-welcome-demo-btn-text">{{ item.label }}</text>
								<uni-ai-icon name="chevron-right-outline" size="16" color="var(--text-tertiary)" />
							</view>
						</template>

					</view>
				</view>
				<list-view v-if="msgList.length > 0" :key="chatActiveId" direction="vertical" class="chat-box-msg-list" :scroll-top="scrollTop" id="msg-list"
					:initial-scroll-bottom="state != 'processing'" :style="{ opacity: initialPositioning ? 0 : 1 }"
					:scroll-with-animation="false" @scroll="onScroll" @scrollend="setIsInScrollBottom" @touchstart="cancelBottomScroll" @touchend="setIsInScrollBottom"
				>
					<list-item v-for="renderItem in renderItemList" :key="renderItem.key" :id="renderItem.id" @longpress="onlongTapMsg(renderItem.msg)" :type="renderItem.itemType">
						<uni-ai-x-msg v-if="renderItem.isAi" :msg="renderItem.msg" :parts="renderItem.parts" :toolbar="renderItem.toolbar ?? false"
							:is-first="renderItem.isFirst" @changeThinkContent="changeThinkContent" @source="openSource" @restore="restoreMessage"></uni-ai-x-msg>
						<uni-ai-user-msg v-else :msg="renderItem.msg" />
					</list-item>
					<list-item id="msg-list-bottom"><view :style="{height: bottomSpacerHeight + 'px', flexShrink: 0}" /></list-item>
				</list-view>
				<!-- #ifdef APP-HARMONY -->
				<loading v-if="showPendingLoading && pendingSpinnerVisible" class="chat-box-pending-loading" :style="pendingSpinnerStyle" :paused="false" />
				<!-- #endif -->

				<view v-if="msgList.length > 0 && showScrollToBottom" class="chat-box-scroll-to-bottom" :style="{bottom: '10px'}" @click="resumeBottomFollow">
					<uni-ai-icon name="chevron-down-outline" size="15" color="var(--text-secondary)" />
				</view>
			</view>
			<!-- 发测包禁用压测面板，保留欢迎页 Markdown 示例。 -->
			<!-- <uni-ai-chat-extension-input v-if="hasInputExtension" /> -->
			<uni-ai-chat-input @scroll-to-last-msg="onComposerScrollRequest" />
			<text v-if="showComposerTip" class="chat-box-tip" flatten>{{tr('内容由ai生成，仅供参考', 'AI generated content may be inaccurate')}}</text>
		</view>
		<view v-if="pendingCalendarMessage != null" class="calendar-confirmation-overlay" @click.stop="blockCalendarOverlay">
			<view class="calendar-confirmation-modal uni-theme-root" @click.stop="blockCalendarOverlay">
				<text class="calendar-confirmation-title" flatten>{{tr('创建日程提醒', 'Create calendar reminder')}}</text>
				<text class="calendar-confirmation-detail" flatten>{{pendingCalendarMessage!.toolConfirmation!.title}}</text>
				<text class="calendar-confirmation-detail" flatten>{{pendingCalendarMessage!.toolConfirmation!.startAt}} · {{pendingCalendarMessage!.toolConfirmation!.durationMinutes}} {{tr('分钟', 'minutes')}}</text>
				<text class="calendar-confirmation-detail" flatten>{{tr('提前', 'Remind')}} {{pendingCalendarMessage!.toolConfirmation!.alarmMinutesBefore}} {{tr('分钟提醒', 'minutes before')}}</text>
				<view class="calendar-confirmation-actions">
					<button class="calendar-confirmation-button calendar-confirmation-cancel" @click="resolveCalendar(false)">{{tr('取消', 'Cancel')}}</button>
					<button class="calendar-confirmation-button calendar-confirmation-open" @click="resolveCalendar(true)">{{tr('同意', 'Allow')}}</button>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts" setup>
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import type { ComputedRef } from 'vue'
	import {uniAi, MsgItem, uiTheme, calendarConfirmationRevision} from '@/uni_modules/uni-ai-x/sdk/'
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'
	import { llmModelMap, mcpServers } from '@/uni_modules/uni-ai-x/config.uts'
	import { MessageDisplayState, readMessageDisplay } from '@/uni_modules/uni-ai-x/sdk/message-display.uts'
	// #ifdef APP-HARMONY
	import { hasChangedCommittedBlocks } from '@/uni_modules/uni-ai-x/sdk/message-display.uts'
	// #endif
	import { hasMessageRenderTasks } from '@/uni_modules/uni-ai-x/sdk/message-render-tasks.uts'
	import { mathWindowWidth } from '@/uni_modules/uni-ai-x/sdk/math-presentation.uts'
	import type { MessageSearch } from '@/uni_modules/uni-ai-x/types.uts'
	import { MarkdownTextRenderBlock } from '@/uni_modules/uni-ai-x/sdk/markdown-text.uts'
	import { readMessagePresentation, readMessageLayoutRevision } from '@/uni_modules/uni-ai-x/sdk/message-presentation.uts'
	// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
	import {
		uniAiMdStreamApplyRebuild,
		uniAiMdStreamGetRevision,
		uniAiMdPresentationRevision,
		uniAiMdStreamGetBlocks,
		uniAiMdStreamIsSettled
	} from '@/uni_modules/uni-ai-x/sdk/uni-ai-md-stream-store.uts'
	import { setAiWorkerRebuildListener } from '@/uni_modules/uni-ai-x'
	import type { AiWorkerRebuildResult } from '@/uni_modules/uni-ai-x'
	import { parseAiWorkerOps } from '@/uni_modules/uni-ai-x/sdk/worker-ops.uts'
	// #endif
	// #ifdef APP-IOS
	import { takeAiWorkerRebuildResultsJson } from '@/uni_modules/uni-ai-x'
	// #endif
	import uniAiChatNav from '@/uni_modules/uni-ai-x/components/uni-ai-chat-nav.uvue'
	import uniAiChatInput from '@/uni_modules/uni-ai-x/components/uni-ai-chat-input/uni-ai-chat-input.uvue'
	// import uniAiChatExtensionInput from '@/uni_modules/uni-ai-x/components/uni-ai-chat-extension-input/uni-ai-chat-extension-input.uvue'
	import uniAiUserMsg from '@/uni_modules/uni-ai-x/components/uni-ai-user-msg.uvue'
	// import { getChatInputExtension } from '@/uni_modules/uni-ai-x/sdk/chat-extension.uts'
	import utils from '@/uni_modules/uni-ai-x/sdk/utils.uts'
	import { runFullMarkdownDemo } from '@/demo/markdown/run-full-markdown.uts'
	function openSource(messageId: string, id: number) {
		emit('source', messageId, id)
	}
	
	type UniAiChatProps = {
		showMenu?: boolean
	}
	
	const props = withDefaults(defineProps<UniAiChatProps>(), {
		showMenu: false
	})
	
	const emit = defineEmits<{
		'change-menu': []
		'close-menu': []
		'source': [messageId: string, id: number]
	}>()
	
	const scrollTop = ref<number>(0)
	let currentScrollTop = 0
	const scrollInBottom = ref<boolean>(true)
	const showScrollToBottom = ref<boolean>(false)
	const scrolling = ref<boolean>(false)
	// #ifdef MP-WEIXIN
	const chatInstance = getCurrentInstance()!.proxy!
	// #endif
	let scrollingT = 0
	let scrollBottomCheckQueued = false
	const hasInputExtension = false // 发测包不启用压测输入扩展
    let showComposerTip = true
    // #ifdef WEB || APP-ANDROID
    showComposerTip = hasInputExtension
    // #endif
    const bottomSpacerHeight = computed<number>(() => {
        // The composer owns its height in normal flow. Only message spacing belongs in the list.
        // #ifdef WEB || APP-ANDROID
        if (!hasInputExtension) return 16
        // #endif
        return 35
    })

	
	const state = computed<string>(() => {
		return uniAi.currentChat?.state ?? 'none'
	})

	const msgList = computed<MsgItem[]>(() => {
		return uniAi.currentChat?.msgList ?? []
	})
	const pendingCalendarMessage = computed<MsgItem | null>(() => {
		calendarConfirmationRevision.value
		for (let index = msgList.value.length - 1; index >= 0; index--) {
			const msg = msgList.value[index]
			if (msg.toolConfirmation?.state == 'pending') return msg
		}
		return null
	})
	function resolveCalendar(confirmed: boolean) {
		const msg = pendingCalendarMessage.value
		if (msg != null) uniAi.resolveToolConfirmation(msg._id, confirmed)
	}
	function blockCalendarOverlay() {}

	type MarkdownBlockCache = {
		theme: string
		uniAiMdRevision: number
		complete: boolean
		rebuildVersion: number
		blocks: MarkdownTextRenderBlock[]
	}
	const markdownBlockCache = new Map<string, MarkdownBlockCache>()
	// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
	const themeRebuilds = new Set<string>()
	// #endif

	// Worker 重建完成后递增版本号，驱动渲染缓存失效与列表重算
	const rebuildVersion = ref<number>(0)

	// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
	// Worker 重建完成回调：应用 ops 后驱动重算（页面环境无法调用 uni-ai-md，重建统一在 Worker 执行）
	const onRebuildResult = (result: AiWorkerRebuildResult) => {
		if (uniAiMdStreamApplyRebuild(result.msgId, parseAiWorkerOps(result.opsJson))) {
			rebuildVersion.value += 1
		}
	}
	// #endif
	// #ifdef APP-IOS
	let rebuildPollTimer = 0
	const pollRebuildResults = () => {
		const json = takeAiWorkerRebuildResultsJson()
		if (json.length == 0) return
		let results: AiWorkerRebuildResult[]
		try {
			results = JSON.parse<AiWorkerRebuildResult[]>(json) as AiWorkerRebuildResult[]
		} catch (error) {
			console.error('[uni-ai-x][rebuild] 解析重建结果失败', error)
			return
		}
		for (let i = 0; i < results.length; i++) {
			try {
				onRebuildResult(results[i])
			} catch (error) {
				console.error('[uni-ai-x][rebuild] 应用重建结果失败', error)
			}
		}
	}
	// #endif

	type ChatRenderItem = {
		key: string
		id: string
		itemType: number
		msg: MsgItem
		parts: AiMsgRenderPart[]
		toolbar?: boolean
		isAi: boolean
		isFirst: boolean
	}

	type AiMsgRenderPart = {
		key: string
		kind: string
		block?: MarkdownTextRenderBlock
		text?: string
		search?: MessageSearch | null
		ready?: boolean
	}

	type MessageRowCache = {
		msg: MsgItem
		structure: string
		search: MessageSearch | null
		lateSearch: MessageSearch | null
		blocks: MarkdownTextRenderBlock[]
		rows: ChatRenderItem[]
	}
	const messageRowCache = new Map<string, MessageRowCache>()
	const displayStates = new Map<string, MessageDisplayState>()
	const rowCache = new Map<string, ChatRenderItem>()
	const noBlocks = [] as MarkdownTextRenderBlock[]

	const RENDER_ITEM_TYPE_USER = 1
	const RENDER_ITEM_TYPE_AI_TABLE = 11
	const RENDER_ITEM_TYPE_AI_CODE = 13
	const RENDER_ITEM_TYPE_AI_MERMAID = 20
	const RENDER_ITEM_TYPE_AI_NORMAL = 21
	const RENDER_ITEM_TYPE_AI_SVG = 22
	const RENDER_ITEM_TYPE_AI_TEXT = 24
	const RENDER_ITEM_TYPE_AI_RULE = 25
	const RENDER_ITEM_TYPE_AI_MATH = 26
	const RENDER_ITEM_TYPE_AI_THINK = 27
	const RENDER_ITEM_TYPE_AI_PLAIN = 28
	const RENDER_ITEM_TYPE_AI_ERROR = 29
	const RENDER_ITEM_TYPE_AI_EMPTY = 30
	const RENDER_ITEM_TYPE_AI_TOOLBAR = 31
	const RENDER_ITEM_TYPE_AI_SEARCH = 32
	const RENDER_ITEM_TYPE_AI_SOURCES = 33
	const RENDER_ITEM_FIRST_OFFSET = 100

	function canRebuildMarkdownFromBody(msg: MsgItem): boolean {
		// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
		return msg.body.trim().length > 0
		// #endif
		// #ifndef APP-HARMONY || APP-ANDROID || APP-IOS
		return false
		// #endif
	}

	function getMarkdownBlocks(msg: MsgItem): MarkdownTextRenderBlock[] {
		// #ifndef APP-HARMONY || APP-ANDROID || APP-IOS
		return readMessagePresentation(msg._id)
		// #endif
		// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
		// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
		uniAiMdPresentationRevision.value
		// #endif
		const revision = msg.uniAiMdRevision ?? 0
			const version = uniAiMdStreamGetRevision(msg._id)
		const theme = uiTheme.value
		const cached = markdownBlockCache.get(msg._id)
		// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
		if (cached != null && cached.theme != theme) themeRebuilds.add(msg._id)
		if (cached != null && themeRebuilds.has(msg._id) && cached.rebuildVersion != version) {
			displayStates.delete(msg._id)
			if (uniAiMdStreamIsSettled(msg._id)) themeRebuilds.delete(msg._id)
		}
		// #endif
		if (cached != null && cached.theme == theme &&
			cached.uniAiMdRevision == revision && cached.complete == msg.rendered && cached.rebuildVersion == version) return cached.blocks
		const blocks = uniAiMdStreamGetBlocks(msg._id)
		markdownBlockCache.set(msg._id, {
			theme: theme, uniAiMdRevision: revision,
			complete: msg.rendered, rebuildVersion: version, blocks: blocks
		} as MarkdownBlockCache)
		return blocks
		// #endif
	}

    function restoreMessage(messageId: string) {
        const msg = msgList.value.find((item: MsgItem): boolean => item._id == messageId)
        if (msg != null) uniAi.prepareMessagePresentation(msg)
    }

	function markdownBlockItemType(block: MarkdownTextRenderBlock): number {
		if (block.kind == 'table') return RENDER_ITEM_TYPE_AI_TABLE
		// 代码块身份和消息直连引用负责处理复用切换，闭合状态不再改变 type，
		// 避免每个流式代码块完成时触发原生 list-item 重建。
		if (block.kind == 'mermaid') return RENDER_ITEM_TYPE_AI_MERMAID
		if (block.kind == 'code') return RENDER_ITEM_TYPE_AI_CODE
		return RENDER_ITEM_TYPE_AI_NORMAL
	}

	function appendAiRenderItem(items: ChatRenderItem[], msg: MsgItem, itemType: number,
		isFirst: boolean, suffix: string, parts: AiMsgRenderPart[]) {
		const key = msg._id + '-' + (msg.answerAttempt ?? 0).toString() + '-' + suffix
		const type = itemType + (isFirst ? RENDER_ITEM_FIRST_OFFSET : 0)
		const cached = rowCache.get(key)
		if (cached != null && cached.msg == msg && cached.itemType == type && cached.parts.length == parts.length) {
			let unchanged = true
			for (let i = 0; i < parts.length; i++) {
				const previous = cached.parts[i]
				const next = parts[i]
				if (previous.key != next.key || previous.kind != next.kind || previous.block != next.block || previous.text != next.text || previous.search != next.search || previous.ready != next.ready) {
					unchanged = false
					break
				}
			}
			if (unchanged) { items.push(cached); return }
		}
		const item: ChatRenderItem = {
			key: key,
			id: 'msg-item-' + msg._id + '-' + suffix,
			itemType: type,
			msg: msg,
			parts: parts,
			isAi: true,
			isFirst: isFirst
		} as ChatRenderItem
		rowCache.set(key, item)
		items.push(item)
	}

	function aiRenderPart(kind: string, key: string, block?: MarkdownTextRenderBlock): AiMsgRenderPart {
		return {
			key: key,
			kind: kind,
			block: block
		} as AiMsgRenderPart
	}

	function isRichTextListBlock(block: MarkdownTextRenderBlock): boolean {
		// Only table and code components own native rich-text nodes.
		return block.kind == 'table' || block.kind == 'code' || block.kind == 'mermaid' ||
			block.kind == 'html' || block.kind == 'image'
	}

	function normalPartsItemType(parts: AiMsgRenderPart[]): number {
		// Mixed paragraphs keep their grouping and spacing; do not create a pool per message.
		if (parts.length != 1) return RENDER_ITEM_TYPE_AI_NORMAL
		const part = parts[0]
		if (part.block != null) {
			if (part.block!.kind == 'hr') return RENDER_ITEM_TYPE_AI_RULE
			if (part.block!.kind == 'math') return RENDER_ITEM_TYPE_AI_MATH
			return RENDER_ITEM_TYPE_AI_TEXT
		}
		if (part.kind == 'think') return RENDER_ITEM_TYPE_AI_THINK
		if (part.kind == 'plain') return RENDER_ITEM_TYPE_AI_PLAIN
		if (part.kind == 'tool-status') return RENDER_ITEM_TYPE_AI_PLAIN
		if (part.kind == 'error') return RENDER_ITEM_TYPE_AI_ERROR
		if (part.kind == 'empty') {
			// #ifdef APP-HARMONY
			return RENDER_ITEM_TYPE_AI_NORMAL
			// #endif
			// #ifndef APP-HARMONY
			return RENDER_ITEM_TYPE_AI_EMPTY
			// #endif
		}
		return RENDER_ITEM_TYPE_AI_NORMAL
	}

	function buildMessageRows(msg: MsgItem): ChatRenderItem[] {
		const items: ChatRenderItem[] = []
			const emptyState = msg.from_uid == 'uni-ai' && uniAi.lastAiMsg?._id == msg._id ? state.value : ''
			const hasBody = msg.body.trim().length > 0
			const prepared = msg.from_uid == 'uni-ai' ? getMarkdownBlocks(msg) : noBlocks
			let finished = emptyState != 'processing' && (msg.rendered || msg.error_msg != null)
			// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
			if (msg.body.trim().length > 0 && !uniAiMdStreamIsSettled(msg._id)) finished = false
			// #endif
			if (hasMessageRenderTasks(msg._id)) finished = false
			let displayState = displayStates.get(msg._id)
			// #ifdef APP-HARMONY
			if (displayState != null && hasChangedCommittedBlocks(displayState, prepared)) {
				const wasStreaming = displayState.wasStreaming
				displayState = new MessageDisplayState()
				displayState.wasStreaming = wasStreaming
				displayStates.set(msg._id, displayState)
			}
			// #endif
			if (displayState == null) {
				displayState = new MessageDisplayState()
				displayStates.set(msg._id, displayState)
			}
			if (emptyState == 'processing') displayState.wasStreaming = true
			const display = readMessageDisplay(displayState, msg, prepared, finished, uiTheme.value, mathWindowWidth.value, displayState.wasStreaming)
			const blocks = display.blocks
			const hasMarkdown = blocks.length > 0 || (msg.markdownBlocks ?? '').length > 0 || (msg.markdownHtml ?? '').length > 0 || canRebuildMarkdownFromBody(msg)
			const structure = msg.from_uid + ':' + (msg.answerAttempt ?? 0).toString() + ':' + (msg.error_msg != null).toString()
				+ ':' + display.think + ':' + hasBody.toString()
				+ ':' + display.toolStatus
				+ ':' + (display.tailMessage.toolResultText ?? '') + ':' + (display.tailMessage.error_msg ?? '')
				+ ':' + ((msg.stressSvgSource ?? '').length > 0).toString() + ':' + hasMarkdown.toString()
				+ ':' + (msg.search?.status ?? '') + ':' + (msg.search?.sources.length ?? 0).toString() + ':' + msg.rendered.toString()
				+ ':' + emptyState + ':' + display.complete.toString()
				+ ':' + (display.search?.status ?? '') + ':' + (display.lateSearch?.status ?? '')
			const cached = messageRowCache.get(msg._id)
			if (cached != null && cached.msg == msg && cached.blocks == blocks && cached.structure == structure && cached.search == display.search && cached.lateSearch == display.lateSearch) {
				return cached.rows
			}
			const rowStart = items.length
			if (msg.from_uid != 'uni-ai') {
				items.push({
					key: msg._id,
					id: 'msg-item-' + msg._id,
					itemType: RENDER_ITEM_TYPE_USER,
					msg: msg,
					parts: [] as AiMsgRenderPart[],
					isAi: false,
					isFirst: true
				} as ChatRenderItem)
				messageRowCache.set(msg._id, { msg: msg, structure: structure, search: display.search, lateSearch: display.lateSearch, blocks: blocks, rows: items.slice(rowStart) } as MessageRowCache)
				return items
			}

			let hasAiSegment = false
			let normalSegmentIndex = 0
			let mermaidBlockIndex = 0
			const normalParts = [] as AiMsgRenderPart[]
			const appendNormalPart = (part: AiMsgRenderPart) => {
				normalParts.push(part)
			}
			const flushNormalParts = () => {
				if (normalParts.length == 0) return
				const suffix = 'normal-' + normalSegmentIndex.toString()
				appendAiRenderItem(items, msg, normalPartsItemType(normalParts), !hasAiSegment, suffix, normalParts.slice())
				normalParts.length = 0
				normalSegmentIndex += 1
				hasAiSegment = true
			}
			const appendRichTextBlock = (block: MarkdownTextRenderBlock) => {
				flushNormalParts()
				let blockKey = block.key
				// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
				if (block.kind == 'mermaid') {
					blockKey = 'mermaid-' + mermaidBlockIndex.toString()
					// #ifndef APP-ANDROID
					blockKey += block.isComplete ? '-c' : ''
					// #endif
					mermaidBlockIndex += 1
				}
				// #endif
				appendAiRenderItem(items, msg, markdownBlockItemType(block), !hasAiSegment, blockKey,
					[aiRenderPart(block.kind, blockKey, block)] as AiMsgRenderPart[])
				hasAiSegment = true
			}
			if (display.search != null) {
				const searchPart = aiRenderPart('search', 'search')
				searchPart.search = display.search
				appendAiRenderItem(items, msg, RENDER_ITEM_TYPE_AI_SEARCH, true, 'search', [searchPart])
				hasAiSegment = true
			}
			const stressSvgSource = msg.stressSvgSource ?? ''
			if (stressSvgSource.length > 0) {
				appendAiRenderItem(items, msg, RENDER_ITEM_TYPE_AI_SVG, !hasAiSegment, 'stress-svg',
					[aiRenderPart('stress-svg', 'stress-svg')] as AiMsgRenderPart[])
				hasAiSegment = true
			}
			if (display.think.length > 0) {
				const thought = aiRenderPart('think', 'think')
				thought.text = display.think
				appendNormalPart(thought)
			}
				if (hasMarkdown) {
					if (blocks.length > 0) {
						for (let blockIndex = 0; blockIndex < blocks.length; blockIndex++) {
							const block = blocks[blockIndex]
							if (isRichTextListBlock(block)) {
								appendRichTextBlock(block)
							} else {
								appendNormalPart(aiRenderPart(block.kind, block.key, block))
							}
						}
					} else if (hasBody) {
						// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
						appendNormalPart(aiRenderPart('restoring', 'restoring'))
						// #endif
						// #ifndef APP-ANDROID || APP-HARMONY || APP-IOS
						appendNormalPart(aiRenderPart(msg.rendered || msg.error_msg != null ? 'plain' : 'restoring', 'plain'))
						// #endif
					}
				} else if (hasBody) {
					// #ifdef APP-ANDROID
					appendNormalPart(aiRenderPart(msg.rendered || msg.error_msg != null ? 'plain' : 'restoring', 'plain'))
					// #endif
					// #ifndef APP-ANDROID
					appendNormalPart(aiRenderPart(msg.rendered || msg.error_msg != null ? 'plain' : 'restoring', 'plain'))
					// #endif
				} else if (msg.error_msg == null && emptyState != '' && emptyState != 'completed' && stressSvgSource.length == 0 && (msg.thinkContent ?? '').length == 0 && (msg.toolStatus ?? '').length == 0 && (msg.toolResultText ?? '').length == 0 && msg.search?.status != 'searching') {
					appendNormalPart(aiRenderPart('empty', 'empty'))
				}
			if (display.toolStatus.length > 0) appendNormalPart(aiRenderPart('tool-status', 'tool-status'))
			if (display.complete) {
				if ((display.tailMessage.toolResultText ?? '').length > 0) {
					const result = aiRenderPart('tool-result', 'tool-result')
					result.text = display.tailMessage.toolResultText ?? ''
					appendNormalPart(result)
				}
				if (display.tailMessage.error_msg != null) {
					const error = aiRenderPart('error', 'error')
					error.text = display.tailMessage.error_msg ?? ''
					appendNormalPart(error)
				}
			}
			if (normalParts.length > 0) flushNormalParts()
			if (display.complete && (display.tailMessage.search?.sources.length ?? 0) > 0) {
				appendAiRenderItem(items, display.tailMessage, RENDER_ITEM_TYPE_AI_SOURCES, false, 'sources', [aiRenderPart('sources', 'sources')])
			}
			if (display.complete && display.lateSearch != null) {
				const searchPart = aiRenderPart('search', 'late-search')
				searchPart.search = display.lateSearch
				appendAiRenderItem(items, msg, RENDER_ITEM_TYPE_AI_SEARCH, !hasAiSegment, 'late-search', [searchPart])
				hasAiSegment = true
			}
			if (hasAiSegment) {
				const toolbar = aiRenderPart('toolbar', 'toolbar')
				toolbar.ready = display.complete
				// #ifdef APP-ANDROID
				// Commit actions in the mounted tail row. A new virtual row created
				// during native stream completion can remain detached on Android.
				if (display.complete) {
					const tailIndex = items.length - 1
					const tail = items[tailIndex]
					items[tailIndex] = { ...tail, toolbar: true } as ChatRenderItem
				}
				// #endif
				// #ifndef APP-ANDROID
				appendAiRenderItem(items, msg, RENDER_ITEM_TYPE_AI_TOOLBAR, false, 'toolbar', [toolbar])
				// #endif
			}
			const rows = items.slice(rowStart)
			messageRowCache.set(msg._id, { msg: msg, structure: structure, search: display.search, lateSearch: display.lateSearch, blocks: blocks, rows: rows } as MessageRowCache)
			if (cached != null) {
				const liveKeys = new Set<string>()
				rows.forEach((row: ChatRenderItem) => { liveKeys.add(row.key) })
				cached.rows.forEach((row: ChatRenderItem) => { if (!liveKeys.has(row.key)) rowCache.delete(row.key) })
			}
		return items
	}

	const messageComputations = new Map<string, { msg: MsgItem, rows: ComputedRef<ChatRenderItem[]> }>()
	function createMessageRows(msg: MsgItem): ComputedRef<ChatRenderItem[]> {
		// UTS Web lowers for-of bindings to var. Capture an invocation parameter,
		// otherwise invalidated historical rows read the loop's final message.
		return computed<ChatRenderItem[]>(() => buildMessageRows(msg))
	}
	const renderItemList = computed<ChatRenderItem[]>(() => {
		const items: ChatRenderItem[] = []
		for (const msg of msgList.value) {
			let cached = messageComputations.get(msg._id)
			if (cached == null || cached.msg != msg) {
				cached = { msg: msg, rows: createMessageRows(msg) }
				messageComputations.set(msg._id, cached)
			}
			items.push(...cached.rows.value)
		}
		return items
	})
	
	const lastMsg = computed<MsgItem | null>(() => {
		return uniAi.lastAiMsg
	})

	// #ifdef APP-HARMONY
	const showPendingLoading = computed<boolean>(() => {
		const msg = lastMsg.value
		return state.value == 'processing' && msg != null && msg.body.length == 0
			&& (msg.thinkContent ?? '').length == 0 && (msg.toolStatus ?? '').length == 0
			&& (msg.toolResultText ?? '').length == 0 && msg.search?.status != 'searching'
	})
	const pendingSpinnerVisible = ref<boolean>(false)
	const pendingSpinnerStyle = ref<string>('')
	let pendingSpinnerMeasureTimer = 0

	function updatePendingSpinnerPosition(): void {
		if (!showPendingLoading.value || viewDisposed) {
			pendingSpinnerVisible.value = false
			return
		}
		const box = uni.getElementById('chat-scroll-box')?.getBoundingClientRect()
		const list = uni.getElementById('msg-list')?.getBoundingClientRect()
		const anchor = uni.getElementById('pending-spinner-anchor')?.getBoundingClientRect()
		if (box == null || list == null || anchor == null || anchor.width == 0) {
			pendingSpinnerVisible.value = false
			return
		}
		pendingSpinnerStyle.value = 'top:' + (anchor.top - box.top).toString() + 'px;left:' + (anchor.left - box.left).toString() + 'px;'
		pendingSpinnerVisible.value = anchor.bottom > list.top && anchor.top < list.bottom
	}

	watch(showPendingLoading, (visible: boolean) => {
		pendingSpinnerVisible.value = false
		pendingSpinnerMeasureTimer = clearTimer(pendingSpinnerMeasureTimer)
		if (!visible) return
		nextTick(() => {
			if (viewDisposed) return
			updatePendingSpinnerPosition()
			pendingSpinnerMeasureTimer = setTimeout(() => {
				pendingSpinnerMeasureTimer = 0
				updatePendingSpinnerPosition()
			}, 60)
		})
	})
	// #endif
	
	const chatActiveId = computed<string>(() => {
		return uniAi.chat.activeId
	})
	const initialPositioning = ref(true)
	let initializedScrollChatId = ''
	watch(renderItemList, (items: ChatRenderItem[]) => {
		const chatId = chatActiveId.value
		if (items.length == 0 || initializedScrollChatId == chatId) return
		initializedScrollChatId = chatId
		positionInitialHistory(chatId)
	}, { flush: 'post' })
	async function positionInitialHistory(chatId: string) {
		// A newly streaming reply belongs to the follow controller, not history positioning.
		if (state.value == 'processing') {
			initialPositioning.value = false
			return
		}
		const version = bottomScrollVersion
		// Only settle the first native layouts; never wait for rendering tasks or images.
		for (let frame = 0; frame < 3; frame++) {
			await nextTick()
			await new Promise<void>((resolve) => { setTimeout(resolve, 16) })
			if (viewDisposed || chatActiveId.value != chatId) return
			if (version != bottomScrollVersion) break
			// #ifndef MP-WEIXIN
			const list = uni.getElementById('msg-list')
			if (list != null) scrollTop.value = Math.max(0, list.scrollHeight - list.getBoundingClientRect().height)
			// #endif
		}
		initialPositioning.value = false
	}
	
	let bottomScrollVersion = 0
	// Limit catch-up as well as final settling; a large output batch must not cause a rush.
	const bottomFollowMaxSpeed = 1000
	let bottomFollowEnabled = false
	let followChatId = ''
	// #ifdef MP-WEIXIN
	let bottomFollowTimer = 0
	let bottomFollowBusy = false
	// #endif
	let followStableHeight = -1
	let followStableSince = 0
	let followFinalReady = false
	let enteredStreamingChat = false
	// #ifndef MP-WEIXIN
	let bottomFollowFrame = 0
	let bottomFollowLastTime = 0
	// #endif
	function cancelBottomScroll() {
		bottomScrollVersion += 1
		bottomFollowEnabled = false
		// #ifdef MP-WEIXIN
		if (bottomFollowTimer != 0) clearInterval(bottomFollowTimer)
		bottomFollowTimer = 0
		// #endif
		followStableHeight = -1
		followStableSince = 0
		followFinalReady = false
		// #ifndef MP-WEIXIN
		if (bottomFollowFrame != 0) cancelAnimationFrame(bottomFollowFrame)
		bottomFollowFrame = 0
		bottomFollowLastTime = 0
		// #endif
	}

	function bufferedFollowTarget(bottom: number, viewportHeight: number, timestamp: number): number {
		const msg = uniAi.lastAiMsg
		const finished = state.value == 'completed' && msg != null && msg.rendered == true
			&& displayStates.get(msg!._id)?.final != null && !hasMessageRenderTasks(msg!._id)
		if (!finished || Math.abs(bottom - followStableHeight) > 1) {
			followStableHeight = bottom
			followStableSince = timestamp
			followFinalReady = false
		} else if (timestamp - followStableSince >= 150) {
			followFinalReady = true
		}
		return followFinalReady ? bottom : Math.max(0, bottom - viewportHeight / 3)
	}

	// #ifndef MP-WEIXIN
	function advanceBottomFollow(timestamp: number) {
		bottomFollowFrame = 0
		if (!bottomFollowEnabled || viewDisposed || followChatId != chatActiveId.value) return
		const elapsed = bottomFollowLastTime == 0 ? 16 : Math.min(32, Math.max(1, timestamp - bottomFollowLastTime))
		bottomFollowLastTime = timestamp
		const list = uni.getElementById('msg-list')
		if (list != null && msgList.value.length > 0) {
			const top = list.scrollTop
			const viewportHeight = list.getBoundingClientRect().height
			const realBottom = Math.max(0, list.scrollHeight - viewportHeight)
			const bottom = bufferedFollowTarget(realBottom, viewportHeight, timestamp)
			const remaining = bottom - top
			if (remaining > 0) {
				// Follow the latest measured bottom without restarting a fixed-duration animation.
				const easedStep = remaining <= 1 ? remaining : Math.max(1, remaining * (1 - Math.exp(-elapsed / 60)))
				const step = Math.min(easedStep, bottomFollowMaxSpeed * elapsed / 1000)
				scrollTop.value = Math.min(bottom, top + step)
			}
			if (followFinalReady && remaining <= 1) {
				cancelBottomScroll()
				followChatId = ''
				return
			}
		}
		bottomFollowFrame = requestAnimationFrame(advanceBottomFollow)
	}
	// #endif

	function startBottomFollow() {
		if (bottomFollowEnabled || followChatId.length == 0 || followChatId != chatActiveId.value) return
		bottomFollowEnabled = true
		// #ifndef MP-WEIXIN
		bottomFollowLastTime = 0
		bottomFollowFrame = requestAnimationFrame(advanceBottomFollow)
		// #endif
		// #ifdef MP-WEIXIN
		// Mini-programs use selector queries to measure the same buffered target.
		bottomFollowTimer = setInterval(async () => {
			if (!bottomFollowEnabled || bottomFollowBusy || msgList.value.length == 0) return
			bottomFollowBusy = true
			try {
				await scrollToLastMsg()
			} finally {
				bottomFollowBusy = false
			}
		}, 80)
		// #endif
	}

	function resumeBottomFollow() {
		if (followChatId == chatActiveId.value
			&& (state.value == 'processing' || state.value == 'completed')) {
			startBottomFollow()
			return
		}
		scrollToLastMsg()
	}

	function onComposerScrollRequest() {
		// Focus/keyboard events must neither bypass the buffer nor resume an interrupted reply.
		if (followChatId == chatActiveId.value) return
		scrollToLastMsg()
	}

	async function positionSentUserMessage(messageId: string) {
		const chatId = chatActiveId.value
		// The processing-state watcher first installs the output follow controller.
		// Wait for that flush and the user's list-item before issuing the one-off jump.
		await nextTick()
		if (viewDisposed || chatActiveId.value != chatId || lastUserMessageId.value != messageId) return
		await scrollToLastMsg(true)
	}

	async function scrollToLastMsg(forceBottom: boolean = false) {
		bottomScrollVersion += 1
		const version = bottomScrollVersion
		const chatId = chatActiveId.value
		let bottomChecks = 0
		let positioned = false
		const targetMessage = uniAi.lastAiMsg
		const targetBody = targetMessage?.body ?? ''
		const waitForPreparedReply = targetMessage?.rendered == true
		const deadline = Date.now() + 16000
		// A single click owns this bounded operation. Newly mounted virtual items
		// can correct scrollHeight, so measure again instead of keeping a bottom anchor.
		while (Date.now() < deadline) {
			await nextTick()
			if (viewDisposed || version != bottomScrollVersion || chatId != chatActiveId.value || msgList.value.length == 0) return
			let remaining = 0
			let top = currentScrollTop
			let viewportHeight = 0
			// #ifndef MP-WEIXIN
			const list = uni.getElementById('msg-list')
			if (list == null) return
			top = list.scrollTop
			viewportHeight = list.getBoundingClientRect().height
			remaining = Math.max(0, list.scrollHeight - viewportHeight - top)
			// #endif
			// #ifdef MP-WEIXIN
			remaining = await new Promise<number>((resolve) => {
				const query = uni.createSelectorQuery().in(chatInstance)
				query.select('#msg-list').boundingClientRect()
				query.select('#msg-list-bottom').boundingClientRect()
				query.exec((result) => {
					const list = result[0] as NodeInfo | null
					const bottom = result[1] as NodeInfo | null
					viewportHeight = list?.height ?? 0
					resolve(Math.max(0, (bottom?.bottom ?? 0) - (list?.bottom ?? 0)))
				})
			})
			// #endif
			if (viewDisposed || version != bottomScrollVersion || chatId != chatActiveId.value) return
			const buffered = !forceBottom && followChatId == chatId && bottomFollowEnabled
			if (buffered) {
				const bottom = top + remaining
				remaining = Math.max(0, bufferedFollowTarget(bottom, viewportHeight, Date.now()) - top)
				if (followFinalReady && remaining <= 1) {
					cancelBottomScroll()
					followChatId = ''
					return
				}
			}
			// Finish a completed reply's pending presentation, but never follow new output.
			if ((uniAi.lastAiMsg?._id ?? '') != (targetMessage?._id ?? '')) break
			if ((targetMessage?.body ?? '') != targetBody && (!forceBottom || positioned)) break
			const presentationPending = waitForPreparedReply && targetMessage != null && displayStates.get(targetMessage!._id)?.final == null
			bottomChecks = remaining <= 1 && !presentationPending ? bottomChecks + 1 : 0
			if (bottomChecks >= 2) break
			if (remaining > 1) {
				scrollTop.value = top
				await nextTick()
				if (viewDisposed || version != bottomScrollVersion || chatId != chatActiveId.value) return
				scrollTop.value = top + (buffered ? Math.min(remaining, Math.max(1, remaining * (1 - Math.exp(-80 / 60)))) : remaining)
			}
			positioned = true
			await new Promise<void>((resolve) => { setTimeout(() => { resolve() }, presentationPending ? 50 : 16) })
		}
		setIsInScrollBottom()
	}

	function clearTimer(timer: number): number {
		if (timer != 0) {
			clearTimeout(timer)
		}
		return 0
	}

	watch(state, (value: string) => {
		if (value == 'processing') {
			// Opening an already streaming conversation is navigation, not a new send.
			if (enteredStreamingChat) return
			cancelBottomScroll()
			followChatId = chatActiveId.value
			startBottomFollow()
			return
		}
		enteredStreamingChat = false
		if (followChatId.length == 0) return
		// Keep the buffer until the completed reply finishes rendering and settles.
		if (value == 'completed' && bottomFollowEnabled) return
		cancelBottomScroll()
		followChatId = ''
	}, { flush: 'post' })

	const lastUserMessageId = computed<string>(() => {
		for (let index = msgList.value.length - 1; index >= 0; index--) {
			const msg = msgList.value[index]
			if (msg.from_uid != 'uni-ai') return msg._id
		}
		return ''
	})
	watch(lastUserMessageId, async (messageId: string) => {
		if (messageId.length == 0 || state.value != 'processing' || enteredStreamingChat) return
		await positionSentUserMessage(messageId)
	}, { flush: 'post' })

	function resetScrollStateForEmptyChat() {
		cancelBottomScroll()
		followChatId = ''
		currentScrollTop = 0
		scrollTop.value = 0
		scrollInBottom.value = true
		showScrollToBottom.value = false
	}
	
	function syncScrollToBottomBtn() {
		showScrollToBottom.value = msgList.value.length > 0 && !scrollInBottom.value
	}

	function updateScrollInBottom() {
		// #ifdef MP-WEIXIN
		const chatId = chatActiveId.value
		nextTick(() => {
			if (viewDisposed || msgList.value.length == 0) return
			const query = uni.createSelectorQuery().in(chatInstance)
			query.select('#msg-list').boundingClientRect()
			query.select('#msg-list-bottom').boundingClientRect()
			query.exec((result) => {
				if (viewDisposed || chatId != chatActiveId.value) return
				const list = result[0] as NodeInfo | null
				const bottom = result[1] as NodeInfo | null
				if (list == null || bottom == null) return
				const diff = (bottom.bottom ?? 0) - (list.bottom ?? 0)
				scrollInBottom.value = diff <= 1
				syncScrollToBottomBtn()
			})
		})
		// #endif
		// #ifndef MP-WEIXIN
		nextTick(() => {
			const scrollList = uni.getElementById('msg-list')
			if (scrollList != null) {
				const diff: number = scrollList.scrollHeight - scrollList.scrollTop - scrollList.offsetHeight
				const isInBottom = diff <= 1
				if (scrollInBottom.value != isInBottom) {
					scrollInBottom.value = isInBottom
				}
				syncScrollToBottomBtn()
			}
		})
		// #endif
	}

	function setIsInScrollBottom() {
		if (scrollBottomCheckQueued) return
		scrollBottomCheckQueued = true
		nextTick(() => {
			scrollBottomCheckQueued = false
			if (!viewDisposed) updateScrollInBottom()
		})
	}
	
	watch(chatActiveId, () => {
		cancelBottomScroll()
		enteredStreamingChat = state.value == 'processing'
		followChatId = ''
		initialPositioning.value = true
		initializedScrollChatId = ''
		displayStates.clear()
		messageComputations.clear()
		markdownBlockCache.clear()
		messageRowCache.clear()
		rowCache.clear()
		currentScrollTop = 0
		scrollTop.value = 0
		scrollInBottom.value = true
		showScrollToBottom.value = false
		nextTick(() => {
			if (lastMsg.value != null) lastMsg.value.rendered = true
			if (msgList.value.length > 0) {
				updateScrollInBottom()
			}
		})
	}, { deep: true, immediate: true })

	watch((): number => msgList.value.length, () => {
		if (msgList.value.length == 0) {
			resetScrollStateForEmptyChat()
		}
		const activeIds = new Set<string>()
		msgList.value.forEach((msg: MsgItem) => { activeIds.add(msg._id) })
		messageRowCache.forEach((cached: MessageRowCache, id: string) => {
			if (activeIds.has(id)) return
			displayStates.delete(id)
			messageComputations.delete(id)
			cached.rows.forEach((row: ChatRenderItem) => { rowCache.delete(row.key) })
			messageRowCache.delete(id)
			markdownBlockCache.delete(id)
		})
	})
	
	let scrollUpdateQueued = false
	let viewDisposed = false
	watch(() => {
		const msg = lastMsg.value
		return {
			id: msg?._id ?? '',
			// #ifndef APP-ANDROID
			body: msg?.body ?? '',
			// #endif
			// #ifdef APP-ANDROID
			presentation: msg != null ? uniAiMdStreamGetRevision(msg._id) : 0,
			// #endif
			html: msg?.markdownHtml ?? '',
			think: msg?.thinkContent ?? '',
			error: msg?.error_msg ?? '',
			rendered: msg?.rendered ?? false,
			// #ifndef APP-ANDROID
			uniAiMdRevision: msg?.uniAiMdRevision ?? 0,
			rebuildVersion: rebuildVersion.value,
			// #endif
			state: state.value,
			layout: msg != null ? readMessageLayoutRevision(msg._id) : 0
		}
	}, async () => {
		// #ifdef APP-ANDROID
		if (scrollUpdateQueued) return
		scrollUpdateQueued = true
		const chatId = chatActiveId.value
		await nextTick()
		scrollUpdateQueued = false
		if (viewDisposed || chatId != chatActiveId.value) return
		// #endif
		setIsInScrollBottom()
	})
	
	const changeThinkContent = (_hideThinkContent: boolean) => {
		setIsInScrollBottom()
	}
	
	const resolveCopyText = (item: MsgItem): string => {
		// 请求出错时错误信息存放于 error_msg，优先复制错误信息，便于用户反馈问题
		const errorMsg = item.error_msg
		if (errorMsg != null && errorMsg.length > 0) return errorMsg
		return item.body
	}
	
	const onlongTapMsg = (item: MsgItem) => {
		if (scrolling.value) {
			return
		}
		// AI rich-text handles copy/select through its native user-select menu.
		// Do not open the message action sheet for the same long-press gesture.
		if (item.from_uid == 'uni-ai') {
			return
		}
		const itemList = [tr('复制', 'Copy')] as string[]
		const isAiMsg = item.from_uid == 'uni-ai'
		itemList.push(isAiMsg ? tr('选择', 'Select') : tr('修改', 'Edit'))
		uni.showActionSheet({
			itemList,
			success: (res: ShowActionSheetSuccess) => {
				if (res.tapIndex == 0) {
					uni.setClipboardData({
						data: resolveCopyText(item),
						showToast: false,
						success: () => {
							nextTick(()=>{
								utils.showCopySuccessToast()
							})
						},
						fail: () => {
							nextTick(()=>{
								utils.showCopyFailureToast()
							})
						}
					})
				} else if (res.tapIndex == 1) {
					if (isAiMsg) {
						uni.navigateTo({
							url: '/uni_modules/uni-ai-x/pages/select-text/select-text?msgId=' + item._id,
							fail(err){
								console.error('err', err)
							}
						})
					} else {
						uniAi.startEditMsg(item)
					}
				}
			},
		})
	}
	
	const changeMenu = () => {
		emit('change-menu')
	}
	
	const closeMenu = () => {
		emit('close-menu')
	}
	
	const onScroll = (event: UniScrollEvent) => {

		currentScrollTop = event.detail.scrollTop
		// #ifdef APP-HARMONY
		if (showPendingLoading.value) updatePendingSpinnerPosition()
		// #endif
		setIsInScrollBottom()
		if (!scrolling.value) {
			scrolling.value = true
		}
		scrollingT = clearTimer(scrollingT)
		scrollingT = setTimeout(() => {
			scrollingT = 0
			scrolling.value = false
			updateScrollInBottom()
		}, 180)
	}

	const runMarkdownDemo = async () => {
		if (state.value == 'processing') return
		cancelBottomScroll()
		followChatId = ''
		try {
			await runFullMarkdownDemo()
		} catch (error) {
			cancelBottomScroll()
			followChatId = ''
			console.error('[uni-ai-x][Markdown示例] 运行失败', error)
		}
	}
	type WelcomePrompt = {
		label: string
		icon: string
		prompt: string
	}
	const welcomePrompts = computed<WelcomePrompt[]>(() => {
		const prompts: WelcomePrompt[] = []
	if (mcpServers.some((server): boolean =>
		server.id == 'weather' && server.url.length > 0 &&
		(server.tools == null || (server.tools.includes('openmeteo_search_locations') && server.tools.includes('openmeteo_get_forecast')))
	)) {
		prompts.push({ label: tr('MCP 示例：查天气', 'MCP example: Weather'), icon: 'search-outline', prompt: tr('帮我查一下北京现在的天气', 'What is the weather in Beijing right now?') })
	}
	// #ifdef APP-ANDROID || APP-IOS || APP-HARMONY
	prompts.push({ label: tr('工具调用示例：创建日程提醒', 'Tool example: Calendar reminder'), icon: 'alarm-clock-outline', prompt: tr('帮我在 15 分钟后创建一个“测试日程”提醒，持续 30 分钟，提前 5 分钟提醒', 'Create a test calendar reminder in 15 minutes, lasting 30 minutes, with an alert 5 minutes before.') })
	// #endif
		return prompts
	})
	const showToolExamples = computed<boolean>(() => {
		if (uniAi.llm.provider != 'qiniu' && uniAi.llm.provider != 'deepseek') return false
		const model = llmModelMap.get(uniAi.llm.provider)?.models.find((item) => item.modelId == uniAi.llm.model)
		return model?.toolCall == true
	})
	const sendWelcomePrompt = (prompt: string) => {
		if (state.value == 'processing' || uniAi.currentChat == null) return
		uniAi.sendMsg(prompt)
		uniAi.currentChat!.inputContent = ''
	}
	



	// #ifdef WEB
	let webScrollBox: HTMLElement | null = null
	// Desktop scrolling does not emit touchstart. Keep interruption local to this chat.
	function interruptWebFollow() {
		cancelBottomScroll()
	}
	// #endif

	onMounted(() => {
		// #ifdef WEB
		webScrollBox = document.getElementById('chat-scroll-box')
		webScrollBox?.addEventListener('wheel', interruptWebFollow, { passive: true })
		webScrollBox?.addEventListener('pointerdown', interruptWebFollow, { passive: true })
		// #endif
		// #ifdef APP-IOS
		pollRebuildResults()
		rebuildPollTimer = setInterval(pollRebuildResults, 100)
		// #endif
		// #ifndef APP-IOS
		// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
		setAiWorkerRebuildListener(onRebuildResult)
		// #endif
		// #endif

		// #ifdef MP-WEIXIN
		updateScrollInBottom()
		// #endif
	})

	onBeforeUnmount(() => {
		// #ifdef WEB
		webScrollBox?.removeEventListener('wheel', interruptWebFollow)
		webScrollBox?.removeEventListener('pointerdown', interruptWebFollow)
		webScrollBox = null
		// #endif
		viewDisposed = true
		cancelBottomScroll()
		displayStates.clear()
		messageComputations.clear()
		if (state.value == 'processing') uniAi.abortRequest()
		// #ifdef APP-IOS
		if (rebuildPollTimer != 0) clearInterval(rebuildPollTimer)
		rebuildPollTimer = 0
		// #endif
		// #ifndef APP-IOS
		// #ifdef APP-HARMONY || APP-ANDROID || APP-IOS
		setAiWorkerRebuildListener(null)
		// #endif
		// #endif
		scrollingT = clearTimer(scrollingT)
		// #ifdef APP-HARMONY
		pendingSpinnerMeasureTimer = clearTimer(pendingSpinnerMeasureTimer)
		// #endif
	})
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

