	align-items: center;
	background-color: var(--bg-primary);
	border: 1px solid var(--border-secondary);
	border-radius: 50px;
	padding: 5px;
	box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
	z-index: 10;
}

.chat-box-tip {
	display: none;
}

/* #ifdef MP-WEIXIN */
.chat-box {
	height: 100%;
	min-height: 0;
}

