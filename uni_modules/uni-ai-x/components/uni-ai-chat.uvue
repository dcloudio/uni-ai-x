<template>
	<view class="chat-box" :class="[`ui-theme-${uiTheme}`]">
		<uni-ai-chat-nav @change-menu="changeMenu" />
		<view class="chat-box-chat" :class="showMenu ? 'chat-box-chat-showMenu' : ''" ref="chat">
			<view class="chat-box-scroll-view-box">
				<scroll-view direction="vertical" class="chat-box-msg-list" :scroll-into-view="scrollIntoView" id="msg-list"
					:scroll-with-animation="scrollWithAnimation" @scroll="onScroll" @touchstart="setTouchState(true)" @touchend="setTouchState(false)"
				>
					<template v-for="item in msgList" :key="item._id">
						<uni-ai-x-msg v-if="item.from_uid == 'uni-ai'" :msg="item" @longpress="onlongTapMsg(item)" @changeThinkContent="changeThinkContent" :id="'msg-item-' + item._id"></uni-ai-x-msg>
						<uni-ai-user-msg v-else :msg="item" @longpress="onlongTapMsg(item)" />
					</template>
					<view class="chat-box-welcome-msg-box" v-if="msgList.length == 0">
						<image class="chat-box-welcome-logo" src="@/uni_modules/uni-ai-x/static/uni-chat-logo.png"/>
						<text class="chat-box-welcome-title">嗨！我是 UNI-AI</text>
						<text class="chat-box-welcome-text">我可以帮你回答问题、写代码、翻译、写诗等。</text>
					</view>
					<view style="height: 35px;" id="last-msg-a" v-show="bottomAnchorId == 'last-msg-a'"></view>
					<view style="height: 35px;" id="last-msg-b" v-show="bottomAnchorId == 'last-msg-b'"></view>
				</scroll-view>
				<add-chat-btn :style="{visibility: scrollInBottom && state != 'processing' ? 'visible' : 'hidden', position: 'absolute', bottom: '5px', left: '50%', transform: 'translateX(-50%)'}"/>
				<view :style="{visibility: showScrollToBottom ? 'visible' : 'hidden'}" class="chat-box-scroll-to-bottom" @click="scrollToLastMsg(true)">
					<uni-icons type="down" size="15" color="var(--text-secondary)"></uni-icons>
				</view>
			</view>
			<view class="chat-box-bottom" @click="markQA">
				<uni-ai-draft-images />
				<textarea class="chat-box-chat-input" v-model="chatInputContent" placeholder="给 uni-ai-x 发送消息"
					:adjust-position="false" @keyboardheightchange="onKeyboardheightchange" placeholder-class="chat-box-chat-input-placeholder"
					@focus="scrollToLastMsg(true)" :auto-height="true" :disabled="isDemo"
				></textarea>
				<input-tool-bar @scrollToLastMsg="scrollToLastMsg(true)" @click.stop />
				<view class="chat-box-keyboard-cover" :style="{height: keyboardHeight + 'px'}"></view>
			</view>
			<text class="chat-box-tip">内容由ai生成，仅供参考</text>
		</view>
		<view class="chat-box-mask" v-if="translateX != -260" @click="closeMenu" :style="{
			opacity: (translateX + 260) / 260,
			backgroundColor: `rgba(0,0,0,${0.3 * (translateX + 260) / 260})`
		}"></view>
	</view>
</template>

<script lang="uts" setup>
	import {uniAi, MsgItem, uiTheme, testMarkdownText} from '@/uni_modules/uni-ai-x/sdk/'
	import addChatBtn from '@/uni_modules/uni-ai-x/components/add-chat-btn.uvue'
	import inputToolBar from '@/uni_modules/uni-ai-x/components/input-tool-bar.uvue'
	import uniAiChatNav from '@/uni_modules/uni-ai-x/components/uni-ai-chat-nav.uvue'
	import uniAiUserMsg from '@/uni_modules/uni-ai-x/components/uni-ai-user-msg.uvue'
	import uniAiDraftImages from '@/uni_modules/uni-ai-x/components/uni-ai-draft-images.uvue'
	
	type UniAiChatProps = {
		showMenu?: boolean
		translateX?: number
	}
	
	const props = withDefaults(defineProps<UniAiChatProps>(), {
		showMenu: false,
		translateX: -260
	})
	
	const emit = defineEmits<{
		'change-menu': []
		'close-menu': []
	}>()
	
	const keyboardHeight = ref<number>(0)
	const scrollIntoView = ref<string>('')
	const bottomAnchorId = ref<string>('last-msg-a')
	const scrollInBottom = ref<boolean>(true)
	const showScrollToBottom = ref<boolean>(false)
	const scrollWithAnimation = ref<boolean>(false)
	const scrollTouch = ref<boolean>(false)
	const scrolling = ref<boolean>(false)
	let autoToLastMsg = false
	let scrollingT = 0
	let scrollBottomCheckTimer = 0
	let showScrollToBottomTimer = 0
	let mouseScroll = false
	let needSetLockAutoToLastMsg = true
	
	const state = computed<string>(() => {
		return uniAi.currentChat?.state ?? 'none'
	})
	
	const msgList = computed<MsgItem[]>(() => {
		return uniAi.currentChat?.msgList ?? []
	})
	
	const chatInputContent = computed<string>({
		get: (): string => {
			return uniAi.currentChat?.inputContent ?? ''
		},
		set: (value: string) => {
			if (uniAi.currentChat != null) {
				uniAi.currentChat!.inputContent = value
			}
		}
	})
	
	const lastMsg = computed<MsgItem | null>(() => {
		return uniAi.lastAiMsg
	})
	
	const chatActiveId = computed<string>(() => {
		return uniAi.chat.activeId
	})
	
	function scrollToLastMsg(userClick: boolean){
		autoToLastMsg = true
		scrollWithAnimation.value = userClick
		bottomAnchorId.value = bottomAnchorId.value == 'last-msg-a' ? 'last-msg-b' : 'last-msg-a'
		nextTick(() => {
			scrollIntoView.value = bottomAnchorId.value
			scrollInBottom.value = true
		})
	}
	
	const isDemo = computed<boolean>(() => testMarkdownText.length > 0)
	const demoPrompt = '给我 markdown 的各级标题，列表（含有序无序任务列表），简单的表格，引用，简单的 js 代码示例，链接，分割线，常见 LaTeX 数学公式，简单的流程图。注意：不要包裹在代码块里面'
	const autoDemoRequested = ref<boolean>(false)
	
	function markQA() {
		if (isDemo.value) {
			chatInputContent.value = demoPrompt
			uni.showModal({
				content: '已生成演示专用问题，且无法修改。\n 请点击右下角的发送按钮体验效果',
				showCancel: false
			});
		}
	}
	
	function syncScrollToBottomBtn() {
		const shouldShow = !scrollInBottom.value && !scrolling.value
		if (!shouldShow) {
			if (showScrollToBottomTimer != 0) {
				clearTimeout(showScrollToBottomTimer)
				showScrollToBottomTimer = 0
			}
			showScrollToBottom.value = false
			return
		}
		if (showScrollToBottom.value || showScrollToBottomTimer != 0) {
			return
		}
		showScrollToBottomTimer = setTimeout(() => {
			showScrollToBottom.value = true
			showScrollToBottomTimer = 0
		}, 180)
	}

	function updateScrollInBottom() {
		// #ifndef MP-WEIXIN
		nextTick(() => {
			const scrollList = uni.getElementById('msg-list')
			if (scrollList != null) {
				const diff: number = scrollList.scrollHeight - scrollList.scrollTop - scrollList.offsetHeight
				const isInBottom = scrollInBottom.value ? diff < 60 : diff < 30
				if (scrollInBottom.value != isInBottom) {
					scrollInBottom.value = isInBottom
				}
				if (scrollTouch.value || mouseScroll) {
					autoToLastMsg = !(diff > 3)
				}
				syncScrollToBottomBtn()
			}
		})
		// #endif
	}

	function setIsInScrollBottom() {
		if (scrollBottomCheckTimer != 0) {
			return
		}
		scrollBottomCheckTimer = setTimeout(() => {
			scrollBottomCheckTimer = 0
			updateScrollInBottom()
		}, 120)
	}
	
	watch(chatActiveId, () => {
		scrollToLastMsg(false)
		nextTick(() => {
			if (lastMsg.value != null) lastMsg.value.rendered = true
		})
	}, { deep: true, immediate: true })
	
	const lockAutoToLastMsg = () => {
		if (!needSetLockAutoToLastMsg) return
		const lastMsgEl: UniElement | null = uni.getElementById('msg-item-' + lastMsg.value?._id)
		const scrollList: UniElement | null = uni.getElementById('msg-list')
		if (lastMsgEl == null || scrollList == null) return 
		if (msgList.value.length < 3 || scrollList.offsetHeight < lastMsgEl.offsetHeight) {
			autoToLastMsg = false
			needSetLockAutoToLastMsg = false
		}
	}
	
	watch(lastMsg, async () => {
		setIsInScrollBottom()
		lockAutoToLastMsg()
		if (!scrollTouch.value && autoToLastMsg) {
			await nextTick()
			scrollToLastMsg(false)
		}
	}, { deep: true })
	
	const changeThinkContent = (_hideThinkContent: boolean) => {
		setIsInScrollBottom()
	}
	
	const onlongTapMsg = (item: MsgItem) => {
		if (scrolling.value) {
			return
		}
		const itemList = ['复制'] as string[]
		const isAiMsg = item.from_uid == 'uni-ai'
		itemList.push(isAiMsg ? '选择' : '修改')
		uni.showActionSheet({
			itemList,
			success: (res: ShowActionSheetSuccess) => {
				if (res.tapIndex == 0) {
					uni.setClipboardData({
						data: item.body,
						success: () => {
							nextTick(()=>{
								uni.showToast({
									title: '复制成功',
									icon: 'success'
								})
							})
						}
					})
				} else if (res.tapIndex == 1) {
					if (isAiMsg) {
						uni.navigateTo({
							url: '/uni_modules/uni-ai-x/pages/select-text/select-text?msgId=' + item._id,
							fail(err){
								console.error('err', err)
							}
						})
					} else {
						chatInputContent.value = item.body
					}
				}
			},
		})
	}
	
	const onKeyboardheightchange = (res: UniInputKeyboardHeightChangeEvent) => {
		keyboardHeight.value = res.detail.height
	}

	const changeMenu = () => {
		emit('change-menu')
	}
	
	const closeMenu = () => {
		emit('close-menu')
	}
	
	const onScroll = () => {
		setIsInScrollBottom()
		scrolling.value = true
		syncScrollToBottomBtn()
		if (scrollingT != 0) {
			clearTimeout(scrollingT)
		}
		scrollingT = setTimeout(() => {
			scrolling.value = false
			syncScrollToBottomBtn()
		}, 500)
	}

	let touchClearTimer: number = 0
	function setTouchState(state: boolean) {
		if (touchClearTimer != 0) {
			clearTimeout(touchClearTimer)
			touchClearTimer = 0
		}
		if (state) {
			scrollTouch.value = true
		} else {
			touchClearTimer = setTimeout(() => {
				scrollTouch.value = false
				touchClearTimer = 0
			}, 2000)
		}
	}

	function startDemoChat() {
		if (!isDemo.value || autoDemoRequested.value) return
		autoDemoRequested.value = true
		if (msgList.value.length > 0 || state.value != 'none') {
			uniAi.addChat(false)
		}
		chatInputContent.value = demoPrompt
		nextTick(() => {
			uniAi.sendMsg(demoPrompt)
			chatInputContent.value = ''
		})
	}
	
	onMounted(() => {
		startDemoChat()
		uniAi.onBeforeRequestAi(() => {
			autoToLastMsg = true
			needSetLockAutoToLastMsg = true
			scrollToLastMsg(false)
		})
		// #ifdef H5
		window.addEventListener('wheel', (e: WheelEvent) => {
			mouseScroll = true
			let clear: number = 0
			clear = setTimeout(() => {
				mouseScroll = false
				clearTimeout(clear)
			}, 1000)
		})
		// #endif

		// #ifdef MP-WEIXIN
		const observer = uni.createIntersectionObserver(getCurrentInstance().proxy,{});
		observer.relativeTo('#msg-list').observe('#last-msg-a', (result: any) => {
			scrollInBottom.value = result.intersectionRatio > 0
			syncScrollToBottomBtn()
		})
		// #endif
	})
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
.ui-theme-light {
	--mask-overlay: rgba(0, 0, 0, 0.05);
}
.ui-theme-dark {
	--mask-overlay: rgba(0, 0, 0, 0.2);
}

.chat-box {
	width: 750rpx;
	padding-top: env(safe-area-inset-top);
}

.chat-box-mask {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	background-color: var(--mask-overlay);
}

.chat-box-chat {
	flex: 1;
	background-color: var(--bg-primary);
}

.chat-box-scroll-view-box {
	flex: 1;
	position: relative;
}

.chat-box-msg-list {
	flex: 1;
}

.chat-box-welcome-msg-box {
	margin: auto 20px;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.chat-box-welcome-logo {
	width: 50px;
	height: 50px;
	margin-bottom: 20px;
}

.chat-box-welcome-title {
	font-size: 24px;
	font-weight: bold;
	color: var(--text-primary);
	margin-bottom: 10px;
}

.chat-box-welcome-text {
	font-size: 16px;
	color: var(--text-secondary);
	text-align: center;
	line-height: 24px;
	margin: 0 30px;
}

.chat-box-scroll-to-bottom {
	position: absolute;
	bottom: 10px;
	right: 10px;
	width: 35px;
	height: 35px;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	background-color: var(--bg-primary);
	border: 1px solid var(--border-color);
	border-radius: 50px;
	padding: 5px;
	box-shadow: 0 0 10px 0 var(--shadow);
	z-index: 10;
}

.chat-box-bottom {
	flex-direction: column;
	background-color: var(--bg-primary);
	padding: 15px 15px 5px 15px;
	border-radius: 15px 15px 0 0;
	border: 1px solid var(--border-secondary);
}

.chat-box-chat-input {
	min-height: 50px;
	max-height: 200px;
	width: 100%;
}

.chat-box-chat-input-placeholder {
	color: var(--text-disabled);
}

.chat-box-keyboard-cover {
	/* #ifdef APP-ANDROID */
	margin-bottom: env(safe-area-inset-bottom);
	/* #endif */
	/* #ifndef APP-ANDROID */
	padding-bottom: env(safe-area-inset-bottom);
	/* #endif */
}

.chat-box-tip {
	display: none;
}

/* #ifdef H5 */
@media screen and (min-device-width:960px){
	.chat-box {
		flex: 1;
	}
	.chat-box-chat {
		width: 100%;
		max-width: 800px;
		margin: 0 auto;
	}
	.chat-box-bottom {
		border-radius: 15px;
		margin: 10px;
		margin-top: 0;
	}
	.chat-box-tip {
		display: block;
		width: 100%;
		font-size: 12px;
		text-align: center;
		color: var(--text-tertiary);
		margin-bottom: 10px;
	}
	.chat-box-mask {
		display: none;
	}
}
/* #endif */
</style> 
