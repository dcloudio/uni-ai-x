<template>
	<view class="source-overlay uni-theme-root" :style="{ opacity: isReady ? 1 : 0 }">
		<view class="source-mask" :class="{ 'source-mask-visible': isReady }" @click="emit('close')"></view>
		<view class="source-sheet" :class="{ 'source-sheet-visible': isReady }">
			<view class="sheet-header">
				<text class="sheet-title">{{tr('搜索结果', 'Search results')}}</text>
				<view class="sheet-close" @click="emit('close')"><uni-ai-icon name="close-outline" size="20" color="#888" /></view>
			</view>
			<scroll-view id="source-sheet-scroll" class="sheet-scroll" direction="vertical" :scroll-into-view="scrollTarget" :scroll-with-animation="false">
				<view v-for="source in sources" :key="source.id" :id="'search-result-' + source.id" class="sheet-source" hover-class="sheet-source-pressed" @click="openWebLink(source.url)">
					<view class="source-meta">
						<view class="site-icon">
							<uni-ai-icon name="link-outline" size="18" color="#999" />
							<image v-if="!failedIcons.includes(source.id)" class="site-image" :src="siteOrigin(source.url) + '/favicon.ico'" mode="aspectFit" @error="iconFailed(source.id)" />
						</view>
						<text class="site-name" :max-lines="1">{{source.source.length > 0 ? source.source : siteName(source.url)}}</text>
						<text v-if="source.date.length > 0" class="source-date" :max-lines="1">{{source.date}}</text>
						<view class="meta-spacer"></view>
						<text class="source-number">{{source.id}}</text>
					</view>
					<text class="sheet-source-title" :max-lines="2">{{source.title}}</text>
					<view v-if="source.imageUrl != null" class="source-preview-slot">
						<text v-if="failedPreviews.includes(source.id)" class="source-preview-fallback">{{tr('图片暂不可用', 'Image unavailable')}}</text>
						<image v-else class="source-preview" :src="source.imageUrl!" mode="aspectFit" @error="previewFailed(source.id)" />
					</view>
					<text v-if="source.content.length > 0" class="sheet-summary" :max-lines="2">{{source.content}}</text>
				</view>
			</scroll-view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import { SearchSource } from '@/uni_modules/uni-ai-x/types.uts'
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'
	import { openWebLink } from '@/uni_modules/uni-ai-x/sdk/open-web-link.uts'
	const props = defineProps<{ sources: SearchSource[], selectedId: number }>()
	const emit = defineEmits<{ 'close': [] }>()
	const failedIcons = ref<number[]>([])
	const failedPreviews = ref<number[]>([])
	function previewFailed(id: number) { if (!failedPreviews.value.includes(id)) failedPreviews.value.push(id) }
	const scrollTarget = ref('')
	const isReady = ref(false)
	let positionFrame = 0
	let stableFrames = 0
	let positionRequested = false
	let positionChecks = 0
	// Keep the panel hidden until native layout and the initial scroll agree.
	// Rect differences also work while the whole panel is translated offscreen.
	function checkInitialPosition() {
		positionChecks++
		if (props.sources.length == 0) { isReady.value = true; return }
		const viewport = uni.getElementById('source-sheet-scroll')?.getBoundingClientRect()
		const first = uni.getElementById('search-result-' + props.sources[0].id)?.getBoundingClientRect()
		const last = uni.getElementById('search-result-' + props.sources[props.sources.length - 1].id)?.getBoundingClientRect()
		const targetId = props.sources.some((source: SearchSource): boolean => source.id == props.selectedId) ? props.selectedId : props.sources[0].id
		const target = uni.getElementById('search-result-' + targetId)?.getBoundingClientRect()
		if (viewport != null && first != null && last != null && target != null && viewport.height > 0 && target.height > 0) {
			const offset = target.top - first.top
			const contentHeight = last.bottom - first.top
			// Near the end, scrolling stops at the bottom rather than aligning the target to the top.
			const expectedScroll = Math.min(offset, Math.max(0, contentHeight - viewport.height))
			const expectedTop = offset - expectedScroll
			if (!positionRequested) {
				positionRequested = true
				scrollTarget.value = 'search-result-' + targetId
			}
			const positioned = Math.abs(target.top - viewport.top - expectedTop) < 1
			stableFrames = positioned ? stableFrames + 1 : 0
			if (stableFrames >= 2) {
				isReady.value = true
				return
			}
		}
		// A platform failing to expose geometry must not leave an invisible blocking overlay.
		if (positionChecks >= 120) {
			console.warn('[source-sheet] Initial position could not be confirmed')
			isReady.value = true
			return
		}
		positionFrame = requestAnimationFrame(checkInitialPosition)
	}
	function prepareInitialPosition() {
		cancelAnimationFrame(positionFrame)
		isReady.value = false
		stableFrames = 0
		positionRequested = false
		positionChecks = 0
		scrollTarget.value = ''
		positionFrame = requestAnimationFrame(checkInitialPosition)
	}
	onMounted(prepareInitialPosition)
	onUnmounted(() => { cancelAnimationFrame(positionFrame) })
	function siteOrigin(url: string): string {
		const match = /^https?:\/\/[^/?#]+/i.exec(url)
		return match == null ? '' : match[0]
	}
	function siteName(url: string): string { return siteOrigin(url).replace(/^https?:\/\//i, '') }
	function iconFailed(id: number) {
		if (!failedIcons.value.includes(id)) failedIcons.value.push(id)
	}
	watch(() => props.selectedId, prepareInitialPosition)
</script>

<style lang="scss">
	@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
	.source-overlay { position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 110; justify-content: flex-end; }
	.source-mask { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.35); opacity: 0; transition: opacity 260ms ease-out; }
	.source-mask-visible { opacity: 1; }
	.source-sheet { height: 90%; width: 100%; max-width: 720px; align-self: center; background-color: var(--bg-primary); border-top-left-radius: 8px; border-top-right-radius: 8px; padding-bottom: env(safe-area-inset-bottom); transform: translateY(100%); transition: transform 260ms ease-out; }
	.source-sheet-visible { transform: translateY(0); }
	.sheet-header { height: 64px; flex-shrink: 0; justify-content: center; align-items: center; padding: 0 60px; }
	.sheet-title { font-size: 18px; font-weight: bold; color: var(--text-primary); }
	.sheet-close { position: absolute; right: 12px; top: 12px; width: 40px; height: 40px; justify-content: center; align-items: center; }
	.sheet-scroll { flex: 1; min-height: 0; }
	.sheet-source { padding: 16px 16px 22px; }
	.sheet-source-pressed { background-color: var(--bg-secondary); }
	.source-meta { flex-direction: row; align-items: center; height: 24px; margin-bottom: 10px; }
	.site-icon { width: 20px; height: 20px; margin-right: 9px; justify-content: center; align-items: center; flex-shrink: 0; }
	.site-image { position: absolute; left: 0; top: 0; width: 20px; height: 20px; }
	.site-name { font-size: 14px; color: var(--text-primary); flex-shrink: 1; text-overflow: ellipsis; }
	.source-date { font-size: 13px; color: var(--text-tertiary); margin-left: 10px; max-width: 100px; text-overflow: ellipsis; flex-shrink: 1; }
	.meta-spacer { flex: 1; min-width: 8px; }
	.source-number { font-size: 11px; line-height: 20px; text-align: center; width: 22px; height: 20px; border-radius: 10px; background-color: var(--bg-secondary); color: var(--text-tertiary); flex-shrink: 0; }
	.sheet-source-title { font-size: 16px; line-height: 24px; color: var(--text-primary); text-overflow: ellipsis; }
	.sheet-summary { font-size: 14px; line-height: 23px; color: var(--text-tertiary); margin-top: 10px; text-overflow: ellipsis; }
	.source-preview-slot { width: 160px; height: 120px; margin-top: 10px; background-color: var(--bg-secondary); align-items: center; justify-content: center; }
	.source-preview { width: 160px; height: 120px; }
	.source-preview-fallback { color: var(--text-tertiary); font-size: 12px; }
	/* #ifdef WEB */
	.sheet-source { cursor: pointer; }
	.site-name, .source-date { display: block; min-width: 0; white-space: nowrap; overflow: hidden; }
	.sheet-source-title, .sheet-summary { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
	/* #endif */
</style>
