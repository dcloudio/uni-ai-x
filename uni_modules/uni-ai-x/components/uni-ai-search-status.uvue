<template>
	<view v-if="msg.search != null" class="search-status" @click="openSources">
		<template v-if="msg.search!.status == 'searching'">
			<!-- #ifdef APP-HARMONY -->
			<view class="search-spinner" />
			<!-- #endif -->
			<!-- #ifndef APP-HARMONY -->
			<loading class="search-spinner" :paused="loadingPaused" />
			<!-- #endif -->
		</template>
		<uni-icons v-else type="search" size="16" color="#6283a9" />
		<text class="search-label">{{label}}</text>
		<uni-icons v-if="msg.search!.sources.length > 0" type="right" size="14" color="#888" />
	</view>
</template>

<script setup lang="uts">
	import { MsgItem } from '@/uni_modules/uni-ai-x/types.uts'
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'
	const props = defineProps<{ msg: MsgItem }>()
	const emit = defineEmits<{ 'open': [id: number] }>()
	const msg = computed<MsgItem>(() => props.msg)
	const loadingPaused = ref<boolean>(true)
	onMounted(() => { nextTick(() => { loadingPaused.value = false }) })
	const label = computed<string>(() => {
		const search = props.msg.search
		if (search == null) return ''
		if (search.status == 'searching') return tr('正在搜索网页', 'Searching the web')
		if (search.status == 'cancelled') return tr('搜索已停止', 'Search stopped')
		if (search.status == 'failed') {
			if (search.error == '联网搜索失败，将直接回答') return tr('联网搜索失败，将直接回答', 'Web search failed. Answering directly.')
			if (search.error == '当前模型未配置搜索，将直接回答') return tr('当前模型未配置搜索，将直接回答', 'Search is unavailable for this model. Answering directly.')
			return search.error
		}
		if (search.status == 'empty') return tr('未找到相关网页', 'No relevant pages found')
		return tr('已检索 ', 'Found ') + search.sources.length.toString() + tr(' 个网页', ' pages')
	})
	function openSources() {
		if ((props.msg.search?.sources.length ?? 0) > 0) emit('open', 0)
	}
</script>

<style>
	.search-status { flex-direction: row; align-items: center; min-height: 36px; padding: 6px 0; }
	.search-label { flex: 1; font-size: 13px; line-height: 20px; margin-left: 7px; color: #6283a9; }
	.search-spinner { width: 16px; height: 16px; border-color: #aaaaaa; }
</style>
