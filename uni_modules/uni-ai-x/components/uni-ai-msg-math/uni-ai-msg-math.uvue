<template>
    <view class="math-el" :class="[`ui-theme-${uiTheme}`, hasImage ? 'math-el-image-ready' : 'math-el-source-pending']">
        <scroll-view class="math-el-scroll" :class="hasImage ? 'math-el-scroll-image-ready' : ''" direction="horizontal" :show-scrollbar="false">
            <image v-if="hasImage" :src="href" class="math-el-image" mode="scaleToFill"
                :style="{'width': mathWidth, 'height': mathHeight}"
            />
            <rich-text v-else class="math-el-source" :style="{width: sourceContentWidth}" :nodes="sourceRichNodes" mode="native" :selectable="true"></rich-text>
        </scroll-view>
    </view>
</template>

<script lang="uts" setup>
    import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
    import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'
    import { estimateMaxLineTextWidth } from '@/uni_modules/uni-ai-x/sdk/text-width.uts'
    import { markdownCodeTokenToRichTextNodes } from '@/uni_modules/uni-ai-x/sdk/markdown-rich-text.uts'
    const props = defineProps<{
        href?: string
        width?: number
        height?: number
        text?: string
        codeTokens?: MarkdownToken[][]
    }>()

    const hasImage = computed<boolean>(() => {
        return props.href != null && props.href!.length > 0
    })

    const sourceRichNodes = computed<UTSJSONObject[]>(() => {
        const token: MarkdownToken = {
            type: 'code_block',
            lang: 'math',
            text: props.text ?? '',
            codeTokens: props.codeTokens ?? [] as MarkdownToken[][]
        }
        return markdownCodeTokenToRichTextNodes(token)
    })

    const sourceContentWidth = computed<string>(() => {
        const sourceWidth = estimateMaxLineTextWidth((props.text ?? '').split('\n'), 14, 'mono') + 28
        return Math.max(1, sourceWidth).toString() + 'px'
    })

    const mathWidth = computed<string>(() => {
        return Math.max(1, Math.ceil(props.width ?? 1)).toString() + 'px'
    })

    const mathHeight = computed<string>(() => {
        return Math.max(1, Math.ceil(props.height ?? 1)).toString() + 'px'
    })

</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
    .math-el {
        width: 100%;
        min-height: 44px;
        margin: 6px 0;
        border-radius: 6px;
        overflow: hidden;
    }

    .math-el-source-pending {
        background-color: #111827;
    }

    .math-el-image-ready {
        background-color: var(--bg-primary);
    }

    .math-el-scroll {
        width: 100%;
        min-height: 44px;
    }

    .math-el-scroll-image-ready {
        padding: 10px 12px;
    }

    .math-el-image {
        align-self: flex-start;
        flex-shrink: 0;
    }

    .math-el-source {
        align-self: flex-start;
    }
</style>
