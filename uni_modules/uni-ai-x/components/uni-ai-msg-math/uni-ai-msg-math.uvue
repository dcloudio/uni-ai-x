<template>
    <scroll-view class="math-el uni-theme-root" :class="showMathPlaceholder ? 'math-el-source-pending' : 'math-el-image-ready math-el-scroll-image-ready'"
        :style="mathRootStyle"
        direction="horizontal" :show-scrollbar="false">
        <view class="math-el-content" :style="mathContentStyle" flatten>
            <image v-if="imageSource.length > 0 && (props.isClose ?? 0) == 1" :key="imageIdentity" :src="imageSource" class="math-el-image" mode="scaleToFill"
                :style="mathImageStyle" @load="onMathImageLoad" @error="onMathImageError" />
            <uni-ai-generation-status v-if="showMathPlaceholder" :label="mathImageLoadFailed ? tr('公式生成失败', 'Formula generation failed') : tr('公式正在生成中', 'Generating formula')"
                :pending="!mathImageLoadFailed" :source="props.text ?? ''" />
        </view>
    </scroll-view>
</template>

<script lang="uts" setup>
    import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
    import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'
    import { mathWindowWidth } from '@/uni_modules/uni-ai-x/sdk/math-presentation.uts'
    import uniAiGenerationStatus from '@/uni_modules/uni-ai-x/components/uni-ai-generation-status.uvue'
    import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'

    import { useMessageRenderTask } from '@/uni_modules/uni-ai-x/sdk/message-render-tasks.uts'
    const props = defineProps<{
        messageId?: string
        renderKey?: string
        href?: string
	        width?: number
	        height?: number
	        svgSource?: string
	        svgWidth?: number
	        svgHeight?: number
	        text?: string
	        codeTokens?: MarkdownToken[][]
	        renderTheme?: string
	        isClose?: number
    }>()

    const imageSource = computed<string>(() => (props.svgSource ?? '').length > 0 ? props.svgSource! : (props.href ?? ''))
    const imageIdentity = computed<string>(() => (props.messageId ?? '') + ':' + (props.renderKey ?? '') + ':' + imageSource.value)
    const failedImage = ref<string>('')
    const mathImageLoadFailed = computed<boolean>(() => imageSource.value.length > 0 && failedImage.value == imageIdentity.value)
    const showMathPlaceholder = computed<boolean>(() => {
        return (props.isClose ?? 0) != 1 || imageSource.value.length == 0 || mathImageLoadFailed.value
    })
    // Prepared dimensions belong to the block, not the recycled image instance.
    // Reserve them before @load so re-entering the viewport cannot collapse the row.
    const hasPreparedLayout = computed<boolean>(() => {
        if ((props.isClose ?? 0) != 1) return false
        return ((props.svgSource ?? '').length > 0 && (props.svgWidth ?? 0) > 0 && (props.svgHeight ?? 0) > 0) ||
            ((props.href ?? '').length > 0 && (props.width ?? 0) > 0 && (props.height ?? 0) > 0)
    })

    const mathBackgroundColor = computed<string>(() => {
        return uiTheme.value == 'dark' ? '#25282c' : '#ffffff'
    })

    const mathRootStyle = computed<string>(() => {
        const imagePadding = hasPreparedLayout.value ? 'padding-top:10px;padding-bottom:10px;padding-left:12px;padding-right:12px;' : ''
        return 'width:100%;min-height:32px;margin-top:6px;margin-bottom:6px;border-radius:6px;overflow:hidden;background-color:'
            + mathBackgroundColor.value + ';' + imagePadding
    })

    function visibleMathWidth(): number {
        const currentWindowWidth = mathWindowWidth.value > 0 ? mathWindowWidth.value : uni.getWindowInfo().windowWidth
        return Math.max(160, Math.min(currentWindowWidth, 800) - 90)
    }

    const mathWidth = computed<string>(() => {
        const width = (props.svgWidth ?? 0) > 0 ? props.svgWidth! : ((props.width ?? 0) > 0 ? props.width! : visibleMathWidth())
        return Math.max(1, Math.ceil(width)).toString() + 'px'
    })

    const mathHeight = computed<string>(() => {
        const height = (props.svgHeight ?? 0) > 0 ? props.svgHeight! : ((props.height ?? 0) > 0 ? props.height! : Math.max(44, (props.text ?? '').split('\n').length * 22))
        return Math.max(1, Math.ceil(height)).toString() + 'px'
    })

    const mathContentWidth = computed<string>(() => {
        return hasPreparedLayout.value ? Math.max(160, parseFloat(mathWidth.value)).toString() + 'px' : '100%'
    })

    const mathContentHeight = computed<string>(() => {
        return hasPreparedLayout.value ? Math.max(32, parseFloat(mathHeight.value)).toString() + 'px' : '32px'
    })

    const mathContentStyle = computed<string>(() => {
        return 'position:relative;align-self:flex-start;flex-shrink:0;width:' + mathContentWidth.value
            + ';height:' + mathContentHeight.value + ';background-color:' + mathBackgroundColor.value + ';'
    })

    const mathImageStyle = computed<string>(() => {
        return 'position:absolute;left:0;top:0;align-self:flex-start;flex-shrink:0;width:'
            + mathWidth.value + ';height:' + mathHeight.value + ';background-color:' + mathBackgroundColor.value + ';'
    })

    function onMathImageLoad(_event: ImageLoadEvent) {
        if (failedImage.value == imageIdentity.value) failedImage.value = ''
    }

    function onMathImageError(_event: ImageErrorEvent) {
        failedImage.value = imageIdentity.value
    }

    useMessageRenderTask(() => props.messageId ?? '', () => 'math-image:' + (props.renderKey ?? ''),
        () => false,
        () => imageSource.value.length > 0 && (props.isClose ?? 0) == 1
            ? uiTheme.value + ':' + (props.href ?? '') + ':' + (props.svgSource ?? '') + ':' + (props.text ?? '') : '')


</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
    .math-el {
        width: 100%;
        min-height: 32px;
        margin: 6px 0;
        border-radius: 6px;
        overflow: hidden;
    }

    .math-el-source-pending {
        background-color: var(--bg-primary);
    }

    .math-el-image-ready {
        background-color: var(--bg-primary);
    }

    .math-el-scroll-image-ready {
        padding: 10px 12px;
    }

    .math-el-content {
        position: relative;
        align-self: flex-start;
        flex-shrink: 0;
    }

    .math-el-image {
        position: absolute;
        left: 0;
        top: 0;
        align-self: flex-start;
        flex-shrink: 0;
    }


</style>
