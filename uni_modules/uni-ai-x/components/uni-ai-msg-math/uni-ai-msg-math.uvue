<template>
    <scroll-view class="math-el" :class="[`ui-theme-${uiTheme}`, hasImage ? 'math-el-image-ready math-el-scroll-image-ready' : 'math-el-source-pending']"
        direction="horizontal" :show-scrollbar="false">
        <image v-if="hasImage" :src="imageHref" class="math-el-image" mode="scaleToFill" flatten
            :style="{'width': mathWidth, 'height': mathHeight}"
        />
        <rich-text v-else class="math-el-source" :style="sourceRichTextStyle" :nodes="sourceRichNodes" mode="native"></rich-text>
    </scroll-view>
</template>

<script lang="uts" setup>
    import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
    import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'
    import { estimateMaxLineTextWidth } from '@/uni_modules/uni-ai-x/sdk/text-width.uts'
    import { markdownCodeTokenToRichTextNodes } from '@/uni_modules/uni-ai-x/sdk/markdown-rich-text.uts'
    import { renderMathSvgForTheme, ThemedSvgResult } from '@/uni_modules/uni-ai-x/sdk/themed-svg.uts'
    const props = defineProps<{
        href?: string
        width?: number
        height?: number
        text?: string
        codeTokens?: MarkdownToken[][]
        renderTheme?: string
    }>()

    const themedHref = ref<string>('')
    const themedWidth = ref<number>(0)
    const themedHeight = ref<number>(0)
    const themedImageTheme = ref<string>('')
    let mathRenderRequestKey = ''

    const imageHref = computed<string>(() => {
        if (themedImageTheme.value == uiTheme.value && themedHref.value.length > 0) return themedHref.value
        return props.href ?? ''
    })

    const hasImage = computed<boolean>(() => {
        return imageHref.value.length > 0
    })

    const sourceRichNodes = computed<UTSJSONObject[]>(() => {
        const token: MarkdownToken = {
            type: 'code_block',
            lang: 'math',
            text: props.text ?? '',
            codeTokens: props.codeTokens ?? [] as MarkdownToken[][]
        }
        return markdownCodeTokenToRichTextNodes(token)
    })

    const sourceContentWidth = computed<string>(() => {
        const sourceWidth = estimateMaxLineTextWidth((props.text ?? '').split('\n'), 14, 'mono') + 28
        return Math.max(1, sourceWidth).toString() + 'px'
    })

    const sourceRichTextStyle = computed<string>(() => {
        return 'width:' + sourceContentWidth.value + ';font-size:14px;line-height:22px;font-family:monospace;color:#d1fae5;'
    })

    const mathWidth = computed<string>(() => {
        const width = themedImageTheme.value == uiTheme.value && themedWidth.value > 0 ? themedWidth.value : (props.width ?? 1)
        return Math.max(1, Math.ceil(width)).toString() + 'px'
    })

    const mathHeight = computed<string>(() => {
        const height = themedImageTheme.value == uiTheme.value && themedHeight.value > 0 ? themedHeight.value : (props.height ?? 1)
        return Math.max(1, Math.ceil(height)).toString() + 'px'
    })

    function syncMathImageTheme() {
        const theme = uiTheme.value
        if ((props.renderTheme ?? '') == theme && (props.href ?? '').length > 0) {
            themedHref.value = ''
            themedWidth.value = 0
            themedHeight.value = 0
            themedImageTheme.value = ''
            return
        }
		if ((props.href ?? '').length == 0) return
        const mathText = (props.text ?? '').trim()
        if (mathText.length == 0) return
        const requestKey = theme + '\n' + mathText
        mathRenderRequestKey = requestKey
        renderMathSvgForTheme(mathText, theme, (result: ThemedSvgResult) => {
            if (mathRenderRequestKey != requestKey || uiTheme.value != theme || result.imageDataURL.length == 0) return
            themedHref.value = result.imageDataURL
            themedWidth.value = result.width
            themedHeight.value = result.height
            themedImageTheme.value = result.theme
        })
    }

    watch((): string => {
        return uiTheme.value + '\n' + (props.renderTheme ?? '') + '\n' + (props.text ?? '') + '\n' + ((props.href ?? '').length > 0 ? '1' : '0')
    }, () => {
        syncMathImageTheme()
    }, { immediate: true })

</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
    .math-el {
        width: 100%;
        min-height: 44px;
        margin: 6px 0;
        border-radius: 6px;
        overflow: hidden;
    }

    .math-el-source-pending {
        background-color: #111827;
    }

    .math-el-image-ready {
        background-color: var(--bg-primary);
    }

    .math-el-scroll-image-ready {
        padding: 10px 12px;
    }

    .math-el-image {
        align-self: flex-start;
        flex-shrink: 0;
    }

    .math-el-source {
        align-self: flex-start;
    }
</style>
