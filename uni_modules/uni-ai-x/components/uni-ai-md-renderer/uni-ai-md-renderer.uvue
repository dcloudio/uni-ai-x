<template>
	<view class="uni-ai-md-renderer" :class="[`ui-theme-${uiTheme}`]" flatten>
		<template v-for="block in renderBlocks" :key="block.key">
				<uni-ai-md-rich-text v-if="block.kind == 'rich'" :markdown-el-list="block.tokens" :rich-nodes="block.nodes" />
				<uni-ai-msg-quote v-else-if="block.kind == 'quote'" :quote-node="blockToken(block)" :rich-nodes="block.nodes" />
			<view v-else-if="block.kind == 'divider'" class="uni-ai-md-divider" flatten></view>
			<uni-ai-msg-table v-else-if="block.kind == 'table'" :table-node="blockToken(block)" />
			<uni-ai-msg-code v-else-if="block.kind == 'code' || block.kind == 'mermaid'"
				:code-tokens="codeTokensOf(blockToken(block))"
				:code-text="blockToken(block).text ?? ''"
				:language="blockToken(block).lang ?? 'text'"
				:href="blockToken(block).href"
				:render-theme="blockToken(block).renderTheme"
				:is-close="blockToken(block).isClose ?? 0"
			/>
			<uni-ai-msg-math v-else-if="block.kind == 'math'"
				:href="blockToken(block).href"
				:width="blockToken(block).width"
				:height="blockToken(block).height"
				:text="blockToken(block).text ?? ''"
				:render-theme="blockToken(block).renderTheme"
				:code-tokens="codeTokensOf(blockToken(block))"
			/>
				<uni-ai-md-rich-text v-else :markdown-el-list="block.tokens" :rich-nodes="block.nodes" />
		</template>
	</view>
</template>

<script lang="uts" setup>
		import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
		import { MarkdownRenderDescription } from '@/uni_modules/uni-ai-worker/utssdk/render-descriptions.uts'
		import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'
		import { buildMarkdownRenderBlocks, materializeMarkdownRenderBlocks, MarkdownRenderBlock } from '@/uni_modules/uni-ai-x/sdk/markdown-render-blocks.uts'
	import uniAiMdRichText from '@/uni_modules/uni-ai-x/components/uni-ai-md-rich-text/uni-ai-md-rich-text.uvue'
	import uniAiMsgQuote from '@/uni_modules/uni-ai-x/components/uni-ai-msg-quote/uni-ai-msg-quote.uvue'
	import uniAiMsgCode from '@/uni_modules/uni-ai-x/components/uni-ai-msg-code/uni-ai-msg-code.uvue'
	import uniAiMsgTable from '@/uni_modules/uni-ai-x/components/uni-ai-msg-table/uni-ai-msg-table.uvue'
	import uniAiMsgMath from '@/uni_modules/uni-ai-x/components/uni-ai-msg-math/uni-ai-msg-math.uvue'

	defineOptions({
		name: 'uni-ai-md-renderer'
	})

		type UniAiMdRendererProps = {
			markdownElList: MarkdownToken[]
			markdownRenderList?: MarkdownRenderDescription[]
			keyPrefix?: string
	}

	const props = withDefaults(defineProps<UniAiMdRendererProps>(), {
		keyPrefix: ''
	})

		let previousRenderBlocks = [] as MarkdownRenderBlock[]
		const renderBlocks = computed<MarkdownRenderBlock[]>(() => {
			const descriptions = props.markdownRenderList
			const blocks = descriptions != null && descriptions!.length > 0
				? materializeMarkdownRenderBlocks(props.markdownElList, descriptions!, props.keyPrefix, previousRenderBlocks)
				: buildMarkdownRenderBlocks(props.markdownElList, props.keyPrefix, previousRenderBlocks)
			previousRenderBlocks = blocks
		return blocks
	})

	function blockToken(block: MarkdownRenderBlock): MarkdownToken {
		return block.tokens[0]
	}

	function codeTokensOf(token: MarkdownToken): MarkdownToken[][] {
		return token.codeTokens ?? [] as MarkdownToken[][]
	}

</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.uni-ai-md-renderer {
	width: 100%;
}

.uni-ai-md-divider {
	width: 100%;
	height: 1px;
	margin: 12px 0;
	flex-shrink: 0;
	background-color: var(--border-primary);
}

</style>
