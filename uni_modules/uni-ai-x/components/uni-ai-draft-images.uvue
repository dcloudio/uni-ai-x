<template>
    <scroll-view class="draft-images" direction="horizontal" :show-scrollbar="false" v-show="uniAi.imgList.length > 0">
        <view class="draft-image-item" v-for="(img, index) in uniAi.imgList" :key="img.path">
            <image class="draft-image" :src="img.path" mode="aspectFill" />
            <text v-if="img.uploadPercent < 100" class="draft-image-progress">{{img.uploadPercent}}%</text>
            <view class="draft-image-close-btn" @click.stop="removeImg(index)"><uni-ai-icon name="close-outline" size="11" color="#ffffff" /></view>
        </view>
    </scroll-view>
</template>

<script lang="uts" setup>
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import uniAi from '@/uni_modules/uni-ai-x/sdk'
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'

	function removeImg(index: number) {
		uniAi.imgList.splice(index, 1)
	}
</script>

<style>
.draft-images { height: 80px; flex-direction: row; flex-shrink: 0; margin-bottom: 8px; }
.draft-image-item { width: 72px; height: 72px; margin-right: 8px; position: relative; flex-shrink: 0; }
.draft-image { width: 72px; height: 72px; border-radius: 13px; border: 1px solid var(--border-secondary); }
.draft-image-close-btn { position: absolute; right: 3px; top: 3px; width: 22px; height: 22px; border-radius: 12px; background-color: #62656a; align-items: center; justify-content: center; }
.draft-image-progress { position: absolute; left: 5px; bottom: 5px; padding: 2px 4px; color: #ffffff; font-size: 11px; background-color: #62656a; border-radius: 5px; }
</style>
