<template>
	<view class="uni-ai-msg-table" :class="[`ui-theme-${uiTheme}`]" flatten>
		<scroll-view ref="tableScroll" class="uni-ai-msg-table-scroll" direction="horizontal" :show-scrollbar="true" :style="{height: tableViewportHeight}">
			<rich-text class="uni-ai-msg-table-content" :style="tableRichTextStyle"
				:nodes="tableRichNodes" mode="native" @itemclick="onItemClick"></rich-text>
		</scroll-view>
		<view class="uni-ai-msg-table-scroll-vertical-border uni-ai-msg-table-scroll-left-border"></view>
		<view class="uni-ai-msg-table-scroll-vertical-border uni-ai-msg-table-scroll-right-border"></view>
	</view>
</template>

<script lang="uts" setup>
	import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
	import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'
	import { markdownTableContentHeight, markdownTableContentWidth, markdownTableTokenToRichTextNodes } from '@/uni_modules/uni-ai-x/sdk/markdown-rich-text.uts'

	const props = defineProps<{
		tableNode: MarkdownToken
	}>()

	const tableScroll = ref<UniScrollViewElement | null>(null)
	const tableViewportContentWidth = ref(0)

	const tableContentWidthValue = computed<number>(() => {
		return Math.max(1, markdownTableContentWidth(props.tableNode, tableViewportContentWidth.value))
	})

	const tableContentWidth = computed<string>(() => {
		return tableContentWidthValue.value.toString() + 'px'
	})

	const tableContentHeight = computed<string>(() => {
		return markdownTableContentHeight(props.tableNode, tableViewportContentWidth.value).toString() + 'px'
	})

	const tableViewportHeight = computed<string>(() => {
		return (markdownTableContentHeight(props.tableNode, tableViewportContentWidth.value) + 3).toString() + 'px'
	})

	const tableRichNodes = computed<UTSJSONObject[]>(() => {
		return markdownTableTokenToRichTextNodes(props.tableNode, tableViewportContentWidth.value)
	})

	const tableRichTextStyle = computed<string>(() => {
		const color = uiTheme.value == 'dark' ? '#ffffff' : '#333333'
		const backgroundColor = uiTheme.value == 'dark' ? '#25282c' : '#ffffff'
		return 'width:' + tableContentWidth.value + ';height:' + tableContentHeight.value + ';color:' + color + ';background-color:' + backgroundColor + ';'
	})

	onMounted(() => {
		nextTick(() => {
			tableScroll.value?.getBoundingClientRectAsync()?.then((rect: DOMRect) => {
				tableViewportContentWidth.value = Math.max(1, rect.width - 2)
			})
		})
	})

	function onItemClick(e: UniRichTextItemClickEvent) {
		if (e.detail.href != null && e.detail.href!.length > 0) {
			uni.navigateTo({
				url: '/uni_modules/uni-ai-x/pages/common/webview/webview?url=' + e.detail.href!,
				fail: (err) => {
					console.error(err)
				}
			})
			return
		}
		if (e.detail.src != null && e.detail.src!.length > 0) {
			uni.previewImage({ urls: [e.detail.src!] as string[] })
		}
	}
</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.uni-ai-msg-table {
	width: 100%;
	margin: 6px 0;
}

.uni-ai-msg-table-scroll {
	width: 100%;
	box-sizing: border-box;
	border: 1px solid var(--border-primary);
	background-color: var(--bg-primary);
}

.uni-ai-msg-table-scroll-vertical-border {
	position: absolute;
	top: 0;
	width: 1px;
	height: 100%;
	z-index: 1;
	background-color: var(--border-primary);
}

.uni-ai-msg-table-scroll-left-border {
	left: 0;
}

.uni-ai-msg-table-scroll-right-border {
	right: 0;
}

.uni-ai-msg-table-content {
	align-self: flex-start;
}
</style>
