<template>
	<view class="add-chat" @click="addChat">
		<uni-ai-icon class="icon" name="new-chat-outline" :color="canAddChat ? 'var(--text-primary)':'var(--text-disabled)'" :size="size" />
		<slot></slot>
	</view>
</template>

<script lang="uts" setup>
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import uniAi from '../sdk';
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'
	
	type AddChatProps = {
		size?: string
	}
	
	const props = withDefaults(defineProps<AddChatProps>(), {
		size: '20'
	})
	
	const canAddChat = computed<boolean>(() => {
		return (uniAi.currentChat?.msgList.length ?? 0) != 0
	})
	
	const addChat = () => {
		if (!canAddChat.value) {
			uni.showToast({
				title: tr('当前已在新对话中', 'Already in a new chat'),
				icon: 'none',
				duration: 2000
			})
		} else {
			// 添加新对话
			uniAi.addChat();
		}
	}
</script>

<style lang="scss">
.add-chat {
	flex-direction: row;
	align-items: center;
}
</style>
