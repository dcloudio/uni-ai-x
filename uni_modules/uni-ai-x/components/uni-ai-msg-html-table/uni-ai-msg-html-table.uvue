<template>
	<view class="uni-ai-msg-html-table uni-theme-root" :style="tableContainerStyle">
		<scroll-view ref="tableScroll" class="uni-ai-msg-html-table-scroll"
			direction="horizontal" :show-scrollbar="false" :style="tableScrollStyle"
			>
			<rich-text :disable-split-screen-render="true" class="uni-ai-msg-html-table-content" :style="tableRichTextStyle"
				:nodes="tableHtml" mode="native" @itemclick="onItemClick"></rich-text>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
	import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'
	import {
		applyMarkdownTableTheme,
		applyMarkdownTableColumnWidths,
		markdownTableContentHeight,
		markdownTableContentWidth,
		markdownTableThemeColors,
		MarkdownTableColors,
		resolveMarkdownTableColumnWidths
	} from '@/uni_modules/uni-ai-worker/utssdk/markdown-html.uts'

	type UniAiMsgHtmlTableProps = {
		html: string
		columnWidths: number[]
		rowTextWidths: number[][]
	}

	const props = defineProps<UniAiMsgHtmlTableProps>()
	const tableScroll = ref<UniScrollViewElement | null>(null)
	const windowInfo = uni.getWindowInfo()
	const initialWindowWidth = windowInfo.windowWidth > 0 ? windowInfo.windowWidth : windowInfo.screenWidth
	const tableViewportContentWidth = ref(Math.max(1, Math.floor(initialWindowWidth - 92)))

	const renderColumnWidths = computed<number[]>(() => {
		return resolveMarkdownTableColumnWidths(props.columnWidths, tableViewportContentWidth.value)
	})
	const tableContentWidth = computed<number>(() => {
		return markdownTableContentWidth(renderColumnWidths.value)
	})
	const tableContentHeight = computed<number>(() => {
		return markdownTableContentHeight(props.rowTextWidths, renderColumnWidths.value)
	})
	const tableViewportHeight = computed<string>(() => {
		return tableContentHeight.value.toString() + 'px'
	})
	const tablePalette = computed<MarkdownTableColors>(() => {
		return markdownTableThemeColors(uiTheme.value)
	})
	const tableHtml = computed<string>(() => {
		const sizedHtml = applyMarkdownTableColumnWidths(props.html, renderColumnWidths.value)
		return applyMarkdownTableTheme(sizedHtml, uiTheme.value)
	})
	const tableRenderWidth = computed<number>(() => {
		return Math.max(tableContentWidth.value, tableViewportContentWidth.value)
	})
	const tableContainerStyle = computed<string>(() => {
		const colors = tablePalette.value
		return 'width:100%;margin-top:6px;margin-bottom:6px;box-sizing:border-box;border-top-width:1px;border-right-width:1px;border-bottom-width:0;border-left-width:1px;border-style:solid;border-color:'
			+ colors.border + ';background-color:' + colors.background + ';'
	})
	const tableScrollStyle = computed<string>(() => {
		const colors = tablePalette.value
		return 'width:100%;height:' + tableViewportHeight.value
			+ ';box-sizing:border-box;flex-direction:row;background-color:' + colors.background + ';'
	})
	const tableRichTextStyle = computed<string>(() => {
		const colors = tablePalette.value
		return 'width:' + tableRenderWidth.value.toString() + 'px;height:' + tableContentHeight.value.toString() + 'px;font-size:14px;line-height:22px;color:'
			+ colors.text + ';background-color:' + colors.background + ';'
	})

	function refreshTableViewportWidth() {
		nextTick(() => {
			tableScroll.value?.getBoundingClientRectAsync()?.then((rect: DOMRect) => {
				tableViewportContentWidth.value = Math.max(1, Math.floor(rect.width))
			})
		})
	}

	onMounted(() => {
		refreshTableViewportWidth()
	})

	onResize(() => {
		refreshTableViewportWidth()
	})

	function onItemClick(e: UniRichTextItemClickEvent) {
		if (e.detail.href != null && e.detail.href!.length > 0) {
			uni.navigateTo({
				url: '/uni_modules/uni-ai-x/pages/common/webview/webview?url=' + e.detail.href!,
				fail: (err) => {
					console.error(err)
				}
			})
			return
		}
		if (e.detail.src != null && e.detail.src!.length > 0) {
			uni.previewImage({ urls: [e.detail.src!] as string[] })
		}
	}
</script>

<style lang="scss" scoped>
	@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

	.uni-ai-msg-html-table {
		position: relative;
		width: 100%;
		margin: 6px 0;
		box-sizing: border-box;
	}

	.uni-ai-msg-html-table-scroll {
		width: 100%;
		box-sizing: border-box;
		flex-direction: row;
	}

	.uni-ai-msg-html-table-content {
		align-self: flex-start;
		flex-shrink: 0;
	}
</style>
