<template>
	<view class="uni-ai-msg-html-table uni-theme-root" :style="props.presentation.containerStyle">
		<scroll-view class="uni-ai-msg-html-table-scroll"
			direction="horizontal" :show-scrollbar="false" :style="props.presentation.scrollStyle"
			>
			<rich-text :disable-split-screen-render="true" class="uni-ai-msg-html-table-content" :user-select="true" :style="props.presentation.richTextStyle"
				:nodes="props.presentation.html" mode="native" @itemclick="onItemClick"></rich-text>
		</scroll-view>
	</view>
</template>

<script lang="uts" setup>
	import { TablePresentation } from '@/uni_modules/uni-ai-x/sdk/table-presentation.uts'

	type UniAiMsgHtmlTableProps = {
		presentation: TablePresentation
	}

	const props = defineProps<UniAiMsgHtmlTableProps>()

	function onItemClick(e: UniRichTextItemClickEvent) {
		if (e.detail.href != null && e.detail.href!.length > 0) {
			uni.navigateTo({
				url: '/uni_modules/uni-ai-x/pages/common/webview/webview?url=' + e.detail.href!,
				fail: (err) => {
					console.error(err)
				}
			})
			return
		}
		if (e.detail.src != null && e.detail.src!.length > 0) {
			uni.previewImage({ urls: [e.detail.src!] as string[] })
		}
	}
</script>

<style lang="scss" scoped>
	@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

	.uni-ai-msg-html-table {
		position: relative;
		width: 100%;
		margin: 6px 0;
		box-sizing: border-box;
	}

	.uni-ai-msg-html-table-scroll {
		width: 100%;
		box-sizing: border-box;
		flex-direction: row;
	}

	.uni-ai-msg-html-table-content {
		align-self: flex-start;
		flex-shrink: 0;
	}
</style>
