<template>
    <view class="katex-el" :class="[`ui-theme-${uiTheme}`, hasImage ? 'katex-el-image-ready' : 'katex-el-source-pending']">
        <scroll-view class="katex-el-scroll" direction="horizontal" :show-scrollbar="false">
            <image v-if="hasImage" :src="href" class="katex-el-katex-image" mode="heightFix"
                :style="{'height': katexHeight}" @click="previewFormula"
            />
            <rich-text v-else class="katex-el-source" :style="{width: sourceContentWidth}" :nodes="sourceRichNodes" mode="native" :selectable="true"></rich-text>
        </scroll-view>
    </view>
</template>

<script lang="uts" setup>
    import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'
    import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'
    import { estimateMaxLineTextWidth } from '@/uni_modules/uni-ai-x/sdk/text-width.uts'
    import { markdownCodeTokenToRichTextNodes } from '@/uni_modules/uni-ai-x/sdk/markdown-rich-text.uts'
    const props = defineProps<{
        href?: string
        width?: number
        height?: number
        text?: string
        codeTokens?: MarkdownToken[][]
    }>()

    const hasImage = computed<boolean>(() => {
        return props.href != null && props.href!.length > 0
    })

    const sourceRichNodes = computed<UTSJSONObject[]>(() => {
        const token: MarkdownToken = {
            type: 'code_block',
            lang: 'math',
            text: props.text ?? '',
            codeTokens: props.codeTokens ?? [] as MarkdownToken[][]
        }
        return markdownCodeTokenToRichTextNodes(token)
    })

    const sourceContentWidth = computed<string>(() => {
        const sourceWidth = estimateMaxLineTextWidth((props.text ?? '').split('\n'), 14, 'mono') + 28
        return Math.max(1, sourceWidth).toString() + 'px'
    })

    const katexHeight = computed(() => {
        if (props.height == null || props.width == null) return 'auto'
        // 比例
        const ratio = props.height / props.width
        // 减去 90 的边距，90 = 45 * 2
        return uni.rpx2px(ratio * 750) - (90 * ratio) + 'px'
    })

    function previewFormula() {
        if (!hasImage.value) return
        uni.previewImage({ urls: [props.href!] as string[] })
    }
</script>

<style lang="scss" scoped>
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
    .katex-el {
        width: 100%;
        min-height: 44px;
        margin: 6px 0;
        border-radius: 6px;
        overflow: hidden;
    }

    .katex-el-source-pending {
        background-color: #111827;
    }

    .katex-el-image-ready {
        background-color: #ffffff;
    }

    .katex-el-scroll {
        width: 100%;
        min-height: 44px;
    }

    .katex-el-katex-image {
        align-self: flex-start;
        background-color: #ffffff;
    }

    .katex-el-source {
        align-self: flex-start;
    }
</style>
