<template>
	<view class="chat-nav">
		<view class="chat-nav-action" @click="changeMenu"><uni-ai-icon name="menu-outline" color="var(--text-primary)" size="20" /></view>
		<text class="chat-nav-title" :max-lines="1" flatten>{{title}}</text>
		<!-- #ifndef MP-WEIXIN -->
		<add-chat class="chat-nav-action" />
		<!-- #endif -->
		<!-- #ifdef MP-WEIXIN -->
		<view></view>
		<!-- #endif -->
	</view>
</template>

<script lang="uts" setup>
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import addChat from '@/uni_modules/uni-ai-x/components/add-chat.uvue'
	import { uniAi } from '@/uni_modules/uni-ai-x/sdk'
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'

	const emit = defineEmits<{
		'change-menu': []
	}>()

	const title = computed<string>(() => {
		if (uniAi.llm.provider == 'openClaw') {
			return tr('与 ', 'Chat with ') + uniAi.llm.provider + tr(' 对话', '')
		}
		const chatTitle = (uniAi.currentChat?.title ?? '').replace(/\r\n|\n|\r/g, ' ').trim()
		if (chatTitle == '新对话') return tr('新对话', 'New chat')
		if (chatTitle.length > 0) {
			return chatTitle
		}
		return tr('新对话', 'New chat')
	})

	function changeMenu() {
		emit('change-menu')
	}
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.chat-nav {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	padding: 4px 8px;
	min-height: 48px;
}

.chat-nav-action { width: 40px; height: 40px; align-items: center; justify-content: center; flex-shrink: 0; }

.chat-nav-title {
	flex: 1;
	margin: 0 4px;
	font-size: 16px;
	font-weight: 400;
	color: var(--text-primary);
	text-align: left;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* #ifdef MP-WEIXIN */
.chat-nav {
	padding-top: var(--status-bar-height);
}
/* #endif */
</style>
