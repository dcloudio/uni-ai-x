<template>
	<view class="msg-segment uni-theme-root" :class="isFirst ? 'msg-segment-first' : ''" :style="msgSegmentStyle">
		<template v-for="(part, partIndex) in parts" :key="partRenderKey(part, partIndex)">
		<uni-ai-search-status v-if="part.kind == 'search'" :search="part.search" @open="openSource" />
		<uni-ai-search-sources v-else-if="part.kind == 'sources'" :msg="msg" @open="openSource" />
		<image v-else-if="part.kind == 'stress-svg'" class="msg-stress-svg" :src="msg.stressSvgSource!" mode="aspectFit" flatten />
		<template v-else-if="part.kind == 'think'">
			<view class="msg-segment-think-content">
				<view class="msg-root-think-content-header" @click.stop="changeThinkContent">
					<text class="msg-root-think-content-title" flatten>{{tr('深度思考', 'Thinking')}}</text>
					<uni-ai-icon :name="hideThinkContent ? 'chevron-down-outline' : 'chevron-up-outline'" size="14" color="#888" />
				</view>
				<view class="msg-root-think-content-text-box" :class="hideThinkContent ? 'msg-root-think-content-text-box-hide' : ''">
					<text class="msg-root-think-content-text" flatten>{{part.text ?? msg.thinkContent}}</text>
				</view>
			</view>
		</template>
		<view v-else-if="part.kind == 'error' && isToolErrorCard" class="weather-tool-card weather-tool-card-error" flatten>
			<view class="weather-tool-card-heading" flatten>
				<uni-ai-icon name="info-outline" size="18" color="#d95b55" />
				<text class="weather-tool-card-title" flatten>{{isWeatherToolError ? tr('天气查询失败', 'Weather lookup failed') : tr('MCP 服务失败', 'MCP service failed')}}</text>
			</view>
			<text class="weather-tool-card-detail" flatten>{{weatherErrorText}}</text>
			<view v-if="isLastAiMsg" class="weather-tool-card-retry" @click.stop="retryWeather">
				<uni-ai-icon name="refresh-outline" size="16" color="#ffffff" />
				<text class="weather-tool-card-retry-text" flatten>{{tr('重试', 'Retry')}}</text>
			</view>
		</view>
		<text v-else-if="part.kind == 'error'" class="msg-root-error-msg" flatten>{{part.text ?? msg.error_msg}}</text>
		<uni-ai-generation-status v-else-if="part.block != null && (part.block.kind == 'math-fallback' || part.block.kind == 'mermaid-fallback')"
			:label="part.block.kind == 'math-fallback' ? tr('公式未能生成', 'Formula unavailable') : tr('图表未能生成', 'Diagram unavailable')" :pending="false" :source="part.block.text" />
		<uni-ai-msg-html-table v-else-if="part.block != null && part.block.kind == 'table'"
			:presentation="part.block.table ?? emptyTablePresentation" @citation="openSource" @footnote="openFootnote" />
		<uni-ai-msg-code v-else-if="part.block != null && part.block.kind == 'code'"
			:code-text="part.block.text" :prepared-html="part.block.codeHtml ?? ''" :prepared-content-height="part.block.codeContentHeight ?? '22px'" :prepared-height="part.block.codeHeight ?? '38px'" :language="part.block.language" />
		<uni-ai-msg-mermaid v-else-if="part.block != null && part.block.kind == 'mermaid'"
			:message-id="msg._id" :src="part.block.mermaidImageSource" :identity="msg._id + ':' + part.key" :code-text="part.block.text" :image-width="part.block.svgWidth" :image-height="part.block.svgHeight" :render-failed="part.block.mermaidRenderFailed" />
		<uni-ai-msg-math v-else-if="part.block != null && part.block.kind == 'math'"
			:message-id="msg._id" :render-key="part.key"
			:text="part.block.text" :is-close="part.block.isComplete ? 1 : 0"
			:href="part.block.math?.src ?? ''" :width="part.block.math?.width ?? 0" :height="part.block.math?.height ?? 0" :render-theme="uiTheme"
			:svg-source="part.block.svgSource" :svg-width="part.block.svgWidth" :svg-height="part.block.svgHeight" />
		<image v-else-if="part.block != null && part.block.kind == 'image'" :src="part.block.svgSource" mode="aspectFit" :style="blockImageStyle(part.block)" />
		<text v-else-if="part.block != null && part.block.kind == 'data-text'" class="msg-root-plain-text">{{part.block.text}}</text>
		<uni-ai-md-html v-else-if="part.block != null && part.block.kind == 'html'" :key="htmlThemeKey(part.block.html)"
			:html="part.block.html" :is-complete="part.block.isComplete" @citation="openSource" @footnote="openFootnote" />
		<uni-ai-md-text v-else-if="part.block != null" :block="part.block" @citation="openSource" @footnote="openFootnote" />
		<text v-else-if="part.kind == 'plain'" class="msg-root-plain-text" flatten>{{msg.body}}</text>
		<view v-else-if="part.kind == 'tool-status' && isToolStatusCard" class="weather-tool-card weather-tool-card-progress-card" flatten>
			<view class="weather-tool-card-heading" flatten>
				<loading class="weather-tool-card-spinner" :paused="loadingPaused" />
				<text class="weather-tool-card-step" flatten>{{toolStatusStep}}</text>
			</view>
			<text v-if="toolStatusDetail.length > 0" class="weather-tool-card-progress" flatten>{{toolStatusDetail}}</text>
			<text class="weather-tool-card-source" flatten>{{toolStatusSource}}</text>
		</view>
		<text v-else-if="part.kind == 'tool-status'" class="msg-root-plain-text" flatten>{{msg.toolStatus}}</text>
		<text v-else-if="part.kind == 'tool-result'" class="msg-root-plain-text" flatten>{{part.text ?? msg.toolResultText}}</text>
		<view v-else-if="part.kind == 'restoring'" style="height:44px;justify-content:center;"><loading class="msg-root-loging-icon" :paused="loadingPaused" /></view>
		<template v-else-if="part.kind == 'empty'">
			<text v-if="state == 'stop'" class="msg-root-stop-text" flatten>{{tr('回答被终止', 'Response stopped')}}</text>
			<text v-else-if="state == 'none'" class="msg-root-stop-text" flatten>{{tr('回答已中断', 'Response interrupted')}}</text>
			<template v-else-if="state == 'processing' && msg.search?.status != 'searching'">
				<!-- #ifdef APP-HARMONY -->
				<view id="pending-spinner-anchor" class="msg-root-loading-placeholder" />
				<!-- #endif -->
				<!-- #ifndef APP-HARMONY -->
				<loading class="msg-root-loging-icon" :paused="loadingPaused" />
				<!-- #endif -->
			</template>
		</template>
		</template>
		<msg-tool-bar v-if="isToolbarSegment" :msg="msg" :visible="shouldShowToolBar" />
	</view>
</template>

<script lang="uts" setup>
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import uniAiGenerationStatus from '@/uni_modules/uni-ai-x/components/uni-ai-generation-status.uvue'
	import {uniAi, MsgItem, messageToolBarVisible, calendarConfirmationRevision, uiTheme} from '@/uni_modules/uni-ai-x/sdk'
	import type { MessageSearch } from '@/uni_modules/uni-ai-x/types.uts'
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'
	import { MarkdownTextRenderBlock } from '@/uni_modules/uni-ai-x/sdk/markdown-text.uts'
	import { messageImageStyle } from '@/uni_modules/uni-ai-x/sdk/image-layout.uts'
	import { hasMessageRenderTasks, messageRenderTaskRevision } from '@/uni_modules/uni-ai-x/sdk/message-render-tasks.uts'
	import { readMessagePresentationRevision } from '@/uni_modules/uni-ai-x/sdk/message-presentation.uts'
	import { uniAiMdStreamGetRevision, uniAiMdStreamIsSettled } from '@/uni_modules/uni-ai-x/sdk/uni-ai-md-stream-store.uts'
	import { mathWindowWidth } from '@/uni_modules/uni-ai-x/sdk/math-presentation.uts'
	const loadingPaused = ref<boolean>(true)
	onMounted(() => {
		nextTick(() => { loadingPaused.value = false })
	})
	function blockImageStyle(block: MarkdownTextRenderBlock): string {
		return messageImageStyle(block.svgWidth, block.svgHeight,
			mathWindowWidth.value > 0 ? mathWindowWidth.value : uni.getWindowInfo().windowWidth)
	}
	import msgToolBar from '@/uni_modules/uni-ai-x/components/msg-tool-bar.uvue'
	import uniAiMsgHtmlTable from '@/uni_modules/uni-ai-x/components/uni-ai-msg-html-table/uni-ai-msg-html-table.uvue'
	import { emptyTablePresentation } from '@/uni_modules/uni-ai-x/sdk/table-presentation.uts'
	import uniAiMsgCode from '@/uni_modules/uni-ai-x/components/uni-ai-msg-code/uni-ai-msg-code.uvue'
	import uniAiMsgMermaid from '@/uni_modules/uni-ai-x/components/uni-ai-msg-mermaid.uvue'
	import uniAiMsgMath from '@/uni_modules/uni-ai-x/components/uni-ai-msg-math/uni-ai-msg-math.uvue'
	import uniAiMdHtml from '@/uni_modules/uni-ai-x/components/uni-ai-md-html/uni-ai-md-html.uvue'
	import uniAiMdText from '@/uni_modules/uni-ai-x/components/uni-ai-md-text.uvue'
	import { footnoteLabel, markdownFootnotes } from '@/uni_modules/uni-ai-x/sdk/markdown-footnotes.uts'
	import uniAiSearchStatus from '@/uni_modules/uni-ai-x/components/uni-ai-search-status.uvue'
	import uniAiSearchSources from '@/uni_modules/uni-ai-x/components/uni-ai-search-sources.uvue'
	// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
	const isUniAiMdPlatform = true
	// #endif
	// #ifndef APP-ANDROID || APP-HARMONY || APP-IOS
	const isUniAiMdPlatform = false
	// #endif

	type UniAiXMsgProps = {
		msg: MsgItem
		parts: AiMsgRenderPart[]
		toolbar?: boolean
		isFirst?: boolean
	}

	type AiMsgRenderPart = {
		key: string
		kind: string
		block?: MarkdownTextRenderBlock
		text?: string
		search?: MessageSearch | null
		ready?: boolean
	}

	const props = withDefaults(defineProps<UniAiXMsgProps>(), {
		isFirst: false,
		toolbar: false
	})
	const msg = computed<MsgItem>(() => props.msg)
	const parts = computed<AiMsgRenderPart[]>(() => props.parts)
	function htmlThemeKey(html: string): string {
		// #ifdef APP-HARMONY
		return uiTheme.value + ':' + html.includes('#f3f4f6').toString()
		// #endif
		// #ifndef APP-HARMONY
		return 'html'
		// #endif
	}
	function partRenderKey(part: AiMsgRenderPart, index: number): string {
		// Android bytecode keyed replacement can leave recycled message content stale.
		// Keep the render slot alive; branch selection and child props carry its content.
		// #ifdef APP-ANDROID
		return 'slot:' + index.toString()
		// #endif
		// #ifndef APP-ANDROID
		return parts.value.length == 1 && part.block != null && (part.block.kind == 'rich' || part.block.kind == 'html' || (part.block.kind == 'mermaid' && !isUniAiMdPlatform)) ? 'display:' + part.block.kind : part.key
		// #endif
	}
	const isFirst = computed<boolean>(() => props.isFirst)
	const emit = defineEmits<{
		'changeThinkContent': [hideThinkContent: boolean]
		'source': [messageId: string, id: number]
		'restore': [messageId: string]
	}>()
	watch(() => props.msg._id + ':' + parts.value.some((part: AiMsgRenderPart): boolean => part.kind == 'restoring').toString(), () => {
		if (!parts.value.some((part: AiMsgRenderPart): boolean => part.kind == 'restoring')) return
		const id = props.msg._id
		nextTick(() => { if (props.msg._id == id) emit('restore', id) })
	}, { immediate: true })
	const hideThinkContent = ref<boolean>(false)
	watch(() => props.msg._id, () => { hideThinkContent.value = false })
	function openSource(id: number) { emit('source', props.msg._id, id) }
	function openFootnote(href: string) {
		const label = footnoteLabel(href)
		const content = markdownFootnotes(props.msg.body).get(label)
		if (content == null) return
		uni.showModal({ title: tr('脚注 [', 'Footnote [') + label + ']', content: content, showCancel: false })
	}

	const state = computed<string>(() => {
		return uniAi.currentChat!.state
	})

	const isLastAiMsg = computed<boolean>(() => {
		return uniAi.lastAiMsg?._id == msg.value._id
	})
	const isWeatherToolStatus = computed<boolean>(() => (msg.value.toolStatus ?? '').startsWith('天气查询工具'))
	const isToolStatusCard = computed<boolean>(() => isWeatherToolStatus.value || (msg.value.toolStatus ?? '').startsWith('MCP '))
	const toolStatusParts = computed<string[]>(() => (msg.value.toolStatus ?? '').split(' · '))
	const toolStatusStep = computed<string>(() => toolStatusParts.value.length >= 2
		? toolStatusParts.value[1]
		: (msg.value.toolStatus ?? '').replace('天气查询工具', '').trim())
	const toolStatusDetail = computed<string>(() => toolStatusParts.value.length >= 3 ? toolStatusParts.value[2] : '')
	const toolStatusSource = computed<string>(() => isWeatherToolStatus.value ? tr('天气查询工具 · MCP', 'Weather tool · MCP') : tr('MCP 工具', 'MCP tool'))
	const terminalErrorText = computed<string>(() => parts.value.find((part: AiMsgRenderPart): boolean => part.kind == 'error')?.text ?? msg.value.error_msg ?? '')
	const isWeatherToolError = computed<boolean>(() => {
		const error = terminalErrorText.value
		return error.includes('天气查询工具连续三次调用失败') || error.includes('天气查询超时')
	})
	const isToolErrorCard = computed<boolean>(() => {
		const error = terminalErrorText.value
		return isWeatherToolError.value || error.includes('MCP 请求超时') || error.includes('MCP 服务连续三次连接失败') || error.includes('MCP 工具连续三次调用失败')
	})
	const weatherErrorText = computed<string>(() => terminalErrorText.value.replace('Error: ', ''))
	const retryWeather = () => {
		if (!isLastAiMsg.value || state.value == 'processing') return
		uniAi.resetMsg(msg.value)
		uniAi.answerQuestion(msg.value)
	}

	const toolbarDelayReady = ref<boolean>(false)
	let toolbarDelayTimer = 0
	let toolbarDelayVersion = 0
	const isToolbarSegment = computed<boolean>(() => props.toolbar || parts.value.some((part: AiMsgRenderPart): boolean => part.kind == 'toolbar'))
	const toolbarPresentationStamp = computed<string>(() => {
		// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
		return uniAiMdStreamGetRevision(msg.value._id).toString() + ':' + uniAiMdStreamIsSettled(msg.value._id).toString()
		// #endif
		// #ifndef APP-ANDROID || APP-HARMONY || APP-IOS
		return readMessagePresentationRevision(msg.value._id).toString()
		// #endif
	})
	const toolbarCanSettle = computed<boolean>(() => {
		if (parts.value.some((part: AiMsgRenderPart): boolean => part.kind == 'toolbar' && part.ready == false)) return false
		if (state.value == 'processing' || msg.value.toolConfirmation != null || (msg.value.toolStatus ?? '').length > 0 || !messageToolBarVisible.value || hasMessageRenderTasks(msg.value._id)) return false
		if (!msg.value.rendered && msg.value.error_msg == null && (msg.value.toolResultText ?? '').length == 0) return false
		// Tool-only and error replies have no Markdown presentation to settle.
		// #ifdef APP-ANDROID || APP-HARMONY || APP-IOS
		if (msg.value.body.trim().length > 0 && msg.value.error_msg == null && !uniAiMdStreamIsSettled(msg.value._id)) return false
		// #endif
		return true
	})
	// Watch content directly, without serializing the message or Markdown AST.
	watch(() => {
		// Only the toolbar row subscribes to streaming content and task revisions.
		if (!isToolbarSegment.value) return [] as string[]
		return [msg.value._id, msg.value.body, msg.value.thinkContent ?? '', msg.value.error_msg ?? '',
		msg.value.toolStatus ?? '', msg.value.toolResultText ?? '', msg.value.rendered.toString(), state.value,
		msg.value.search?.status ?? '', msg.value.search?.error ?? '', (msg.value.search?.sources.length ?? 0).toString(),
		isLastAiMsg.value.toString(), calendarConfirmationRevision.value.toString(), uiTheme.value,
		toolbarPresentationStamp.value, messageRenderTaskRevision(msg.value._id).toString(), toolbarCanSettle.value.toString()]
	}, () => {
		const version = ++toolbarDelayVersion
		if (toolbarDelayTimer != 0) {
			clearTimeout(toolbarDelayTimer)
			toolbarDelayTimer = 0
		}
		toolbarDelayReady.value = false
		if (!isToolbarSegment.value) return
		if (!isLastAiMsg.value) {
			toolbarDelayReady.value = !parts.value.some((part: AiMsgRenderPart): boolean => part.kind == 'toolbar' && part.ready == false)
			return
		}
		if (!toolbarCanSettle.value) return
		// Start the quiet period after Vue has committed the final presentation.
		nextTick(() => {
			if (version != toolbarDelayVersion || !toolbarCanSettle.value) return
			toolbarDelayTimer = setTimeout(() => {
				if (version != toolbarDelayVersion) return
				toolbarDelayTimer = 0
				if (toolbarCanSettle.value) toolbarDelayReady.value = true
			}, 1000)
		})
	}, { immediate: true })
	onUnmounted(() => {
		toolbarDelayVersion += 1
		if (toolbarDelayTimer != 0) clearTimeout(toolbarDelayTimer)
	})

	const shouldShowToolBar = computed<boolean>(() => {
		calendarConfirmationRevision.value
		return !parts.value.some((part: AiMsgRenderPart): boolean => part.kind == 'toolbar' && part.ready == false) && msg.value.toolConfirmation == null && messageToolBarVisible.value && toolbarDelayReady.value && (!isLastAiMsg.value || state.value == 'stop' || (state.value != 'processing' && (msg.value.rendered || msg.value.error_msg != null || (msg.value.toolResultText ?? '').length > 0)))
	})

	// A zero-height pending row can be recycled before its quiet-period timer fires.
	// Reserve the final toolbar height so readiness does not depend on list visibility.
	const msgSegmentStyle = computed<string>(() => 'width:100%;min-height:' + (isToolbarSegment.value && parts.value.length == 1 ? '42px' : '0') + ';box-sizing:border-box;padding-left:24px;padding-right:24px;')

	const changeThinkContent = () => {
		hideThinkContent.value = !hideThinkContent.value
		emit('changeThinkContent', hideThinkContent.value)
	}

</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
	.msg-segment {
		width: 100%;
		min-height: 0;
		padding: 0 20px;
		/* #ifdef WEB */
		user-select: text;
		/* #endif */
	}

.msg-segment-first {
	min-height: 31px;
}

.msg-segment-avatar {
	position: absolute;
	top: 0;
	left: 10px;
	width: 25px;
	height: 25px;
	padding: 3px;
	border-radius: 50px;
	border: 1px solid var(--border-secondary);
}

.msg-stress-svg {
	width: 300px;
	height: 120px;
	margin-bottom: 8px;
}

.msg-segment-think-content {
	width: 100%;
	margin: 5px 0;
}

.msg-root-think-content-header {
	flex-direction: row;
}

.msg-root-think-content-title {
	color: var(--text-tertiary);
	margin-right: 4px;
}

.msg-root-think-content-text-box {
	margin-top: 10px;
	border-left: 3px solid var(--bg-tertiary);
	padding-left: 10px;
	width: 100%;
	margin: 5px 0;
}

.msg-root-think-content-text-box-hide {
	margin-top: 0;
	height: 0;
}

.msg-root-think-content-text {
	text-align: left;
	color: var(--text-tertiary);
}

.msg-root-error-msg,
.msg-root-stop-text,
.msg-root-need-try,
.msg-root-plain-text {
	text-align: left;
	width: 100%;
}

.msg-root-plain-text {
	white-space: pre-wrap;
	line-height: 24px;
	color: var(--text-primary);
	padding: 4px 0;
}

.msg-root-error-msg {
	color: var(--error);
	font-size: 14px;
	line-height: 26px;
}

.weather-tool-card {
	width: 100%;
	max-width: 440px;
	box-sizing: border-box;
	padding: 12px;
	margin: 4px 0;
	border: 1px solid var(--border-secondary);
	border-left: 3px solid var(--accent-primary);
	border-radius: 6px;
	background-color: var(--bg-secondary);
}

.weather-tool-card-error {
	border-left-color: var(--error);
}

.weather-tool-card-progress-card {
	min-height: 82px;
}

.weather-tool-card-heading {
	flex-direction: row;
	align-items: center;
}

.weather-tool-card-spinner {
	width: 18px;
	height: 18px;
	border-color: var(--accent-primary);
}

.weather-tool-card-title {
	margin-left: 6px;
	font-size: 14px;
	font-weight: 600;
	color: var(--text-primary);
}

.weather-tool-card-step {
	margin-left: 6px;
	font-size: 15px;
	font-weight: 600;
	color: var(--text-primary);
}

.weather-tool-card-progress {
	margin-top: 5px;
	font-size: 12px;
	line-height: 18px;
	color: var(--text-secondary);
}

.weather-tool-card-source {
	width: 100%;
	margin-top: 5px;
	font-size: 11px;
	line-height: 16px;
	text-align: right;
	color: var(--text-secondary);
}

.weather-tool-card-detail {
	margin-top: 8px;
	font-size: 13px;
	line-height: 20px;
	color: var(--text-secondary);
}

.weather-tool-card-retry {
	width: 76px;
	height: 34px;
	margin-top: 12px;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	border-radius: 6px;
	background-color: var(--accent-primary);
}

.weather-tool-card-retry-text {
	margin-left: 5px;
	font-size: 13px;
	color: #ffffff;
}

.msg-root-loging-icon {
	border-color: #aaaaaa;
	margin-top: 10px;
	width: 16px;
	height: 16px;
}

.msg-root-loading-placeholder {
	margin-top: 10px;
	width: 16px;
	height: 16px;
}

.msg-root-stop-text {
	color: var(--text-disabled);
	font-size: 14px;
	padding: 10px 0;
}

.msg-root-need-try {
	color: var(--error);
	font-size: 14px;
	padding: 10px;
}

</style>
