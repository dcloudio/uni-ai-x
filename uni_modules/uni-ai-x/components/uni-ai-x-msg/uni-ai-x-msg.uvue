<template>
	<view class="msg-root" :class="[`ui-theme-${uiTheme}`]" flatten>
		<image class="msg-root-avatar" src="@/uni_modules/uni-ai-x/static/uni-chat-logo.png" flatten/>
		<text v-if="msg.error_msg != null" class="msg-root-error-msg" flatten>{{msg.error_msg}}</text>
		<template v-else>
			<view class="msg-root-think-content" v-if="msg.thinkContent != null && msg.thinkContent!.length > 0" flatten>
				<view class="msg-root-think-content-header" @click.stop="changeThinkContent">
					<text class="msg-root-think-content-title" flatten>深度思考 &nbsp;</text>
					<uni-icons :type="hideThinkContent ? 'down' : 'up'" size="14" color="#888"></uni-icons>
				</view>
				<view class="msg-root-think-content-text-box" :class="hideThinkContent ? 'msg-root-think-content-text-box-hide' : ''" flatten>
					<text class="msg-root-think-content-text" flatten>{{msg.thinkContent}}</text>
				</view>
			</view>
			<text v-if="showPlainText" class="msg-root-plain-text" flatten>{{msg.body}}</text>
				<uni-ai-md-renderer v-else :markdown-el-list="msg.markdownElList"
					:markdown-render-list="msg.markdownRenderList" />
			<template v-if="isLastAiMsg && msg.body == ''">
				<text v-if="state == 'stop'" class="msg-root-stop-text" flatten>回答被终止</text>
				<text v-if="state == 'none'" class="msg-root-need-try" flatten>错误：未回复</text>
				<uni-rotate-icon v-if="state == 'processing'" class="msg-root-loging-icon" />
			</template>
		</template>
		<msg-tool-bar v-if="!isLastAiMsg || state == 'stop' || (state != 'processing' && msg.rendered)" :msg="msg" />
	</view>
</template>

<script lang="uts" setup>
	import {uniAi, MsgItem, uiTheme} from '@/uni_modules/uni-ai-x/sdk'
	import msgToolBar from '@/uni_modules/uni-ai-x/components/msg-tool-bar.uvue'
	import uniAiMdRenderer from '@/uni_modules/uni-ai-x/components/uni-ai-md-renderer/uni-ai-md-renderer.uvue'

	type UniAiXMsgProps = {
		msg: MsgItem
	}

	const props = defineProps<UniAiXMsgProps>()
	const msg = computed<MsgItem>(() => props.msg)
	const emit = defineEmits<{
		'changeThinkContent': [hideThinkContent: boolean]
	}>()
	const hideThinkContent = ref<boolean>(false)

	const state = computed<string>(() => {
		return uniAi.currentChat!.state
	})

	const isLastAiMsg = computed<boolean>(() => {
		return uniAi.lastAiMsg?._id == msg.value._id
	})

	const showPlainText = computed<boolean>(() => {
		return msg.value.body.length > 0 && msg.value.markdownElList.length == 0
	})

	const changeThinkContent = () => {
		hideThinkContent.value = !hideThinkContent.value
		emit('changeThinkContent', hideThinkContent.value)
	}
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
/* #ifdef WEB */
.msg-root * {
	user-select: text;
}
/* #endif */
.msg-root {
	flex-direction: row;
	flex-wrap: wrap;
	background-color: var(--bg-primary);
	padding: 0 45px;
	min-height: 45px;
}

.msg-root-avatar {
	position: absolute;
	top: 0;
	left: 10px;
	width: 25px;
	height: 25px;
	padding: 3px;
	border-radius: 50px;
	border: 1px solid var(--border-secondary);
}

.msg-root-think-content-header {
	flex-direction: row;
}

.msg-root-think-content-title {
	color: var(--text-tertiary);
}

.msg-root-think-content-text-box {
	margin-top: 10px;
	border-left: 3px solid var(--bg-tertiary);
	padding-left: 10px;
	width: 100%;
	margin: 5px 0;
}

.msg-root-think-content-text-box-hide {
	margin-top: 0;
	height: 0;
}

.msg-root-think-content-text {
	text-align: left;
	color: var(--text-tertiary);
}

.msg-root-error-msg,
.msg-root-stop-text,
.msg-root-need-try,
.msg-root-plain-text {
	text-align: left;
	width: 100%;
}

.msg-root-plain-text {
	white-space: pre-wrap;
	line-height: 24px;
	color: var(--text-primary);
	padding: 4px 0;
}

.msg-root-error-msg {
	color: var(--error);
	font-size: 14px;
	line-height: 26px;
}

.msg-root-loging-icon {
	margin-top: 10px;
	width: 16px;
	height: 16px;
}

.msg-root-stop-text {
	color: var(--text-disabled);
	font-size: 14px;
	padding: 10px 0;
}

.msg-root-need-try {
	color: var(--error);
	font-size: 14px;
	padding: 10px;
}

.msg-root-think-content {
	width: 100%;
	margin: 5px 0;
}
</style>
