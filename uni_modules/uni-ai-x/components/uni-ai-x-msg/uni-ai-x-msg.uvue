<template>
	<view class="msg-segment uni-theme-root" :class="isFirst ? 'msg-segment-first' : ''">
		<image v-if="isFirst" class="msg-segment-avatar" src="@/uni_modules/uni-ai-x/static/uni-chat-logo.png" flatten/>
		<template v-for="part in parts" :key="part.key">
		<template v-if="part.kind == 'think'">
			<view class="msg-segment-think-content" flatten>
				<view class="msg-root-think-content-header" @click.stop="changeThinkContent">
					<text class="msg-root-think-content-title" flatten>深度思考 &nbsp;</text>
					<uni-icons :type="hideThinkContent ? 'down' : 'up'" size="14" color="#888"></uni-icons>
				</view>
				<view class="msg-root-think-content-text-box" :class="hideThinkContent ? 'msg-root-think-content-text-box-hide' : ''" flatten>
					<text class="msg-root-think-content-text" flatten>{{msg.thinkContent}}</text>
				</view>
			</view>
		</template>
		<text v-else-if="part.kind == 'error'" class="msg-root-error-msg" flatten>{{msg.error_msg}}</text>
		<uni-ai-msg-html-table v-else-if="part.block != null && part.block.kind == 'table'"
			:html="part.block.html" :column-widths="part.block.columnWidths" :row-text-widths="part.block.rowTextWidths" />
		<uni-ai-msg-quote v-else-if="part.block != null && part.block.kind == 'quote'" :html="part.block.html" />
		<uni-ai-msg-code v-else-if="part.block != null && (part.block.kind == 'code' || part.block.kind == 'mermaid')"
			:code-text="part.block.text" :language="part.block.language" :is-close="part.block.isComplete ? 1 : 0" />
		<uni-ai-msg-math v-else-if="part.block != null && part.block.kind == 'math'"
			:text="part.block.text" :is-close="part.block.isComplete ? 1 : 0" />
		<rich-text v-else-if="part.block != null && part.block.kind == 'rich'" class="msg-segment-rich-text" :style="richTextStyle"
			:nodes="part.block.html" mode="native" @itemclick="onItemClick"></rich-text>
		<text v-else-if="part.kind == 'plain'" class="msg-root-plain-text" flatten>{{msg.body}}</text>
		<template v-else-if="part.kind == 'empty'">
			<text v-if="state == 'stop'" class="msg-root-stop-text" flatten>回答被终止</text>
			<text v-else-if="state == 'none'" class="msg-root-need-try" flatten>错误：未回复</text>
			<uni-rotate-icon v-else-if="state == 'processing'" class="msg-root-loging-icon" />
		</template>
		<msg-tool-bar v-else-if="part.kind == 'toolbar' && shouldShowToolBar" :msg="msg" />
		</template>
	</view>
</template>

<script lang="uts" setup>
	import {uniAi, MsgItem, uiTheme} from '@/uni_modules/uni-ai-x/sdk'
	import { MarkdownHtmlBlock } from '@/uni_modules/uni-ai-worker/utssdk/markdown-html.uts'
	import msgToolBar from '@/uni_modules/uni-ai-x/components/msg-tool-bar.uvue'
	import uniAiMsgHtmlTable from '@/uni_modules/uni-ai-x/components/uni-ai-msg-html-table/uni-ai-msg-html-table.uvue'
	import uniAiMsgQuote from '@/uni_modules/uni-ai-x/components/uni-ai-msg-quote/uni-ai-msg-quote.uvue'
	import uniAiMsgCode from '@/uni_modules/uni-ai-x/components/uni-ai-msg-code/uni-ai-msg-code.uvue'
	import uniAiMsgMath from '@/uni_modules/uni-ai-x/components/uni-ai-msg-math/uni-ai-msg-math.uvue'

	type UniAiXMsgProps = {
		msg: MsgItem
		parts: AiMsgRenderPart[]
		isFirst?: boolean
	}

	type AiMsgRenderPart = {
		key: string
		kind: string
		block?: MarkdownHtmlBlock
	}

	const props = withDefaults(defineProps<UniAiXMsgProps>(), {
		isFirst: false
	})
	const msg = computed<MsgItem>(() => props.msg)
	const parts = computed<AiMsgRenderPart[]>(() => props.parts)
	const isFirst = computed<boolean>(() => props.isFirst)
	const emit = defineEmits<{
		'changeThinkContent': [hideThinkContent: boolean]
	}>()
	const hideThinkContent = ref<boolean>(false)

	const state = computed<string>(() => {
		return uniAi.currentChat!.state
	})

	const isLastAiMsg = computed<boolean>(() => {
		return uniAi.lastAiMsg?._id == msg.value._id
	})

	const shouldShowToolBar = computed<boolean>(() => {
		return !isLastAiMsg.value || state.value == 'stop' || (state.value != 'processing' && msg.value.rendered)
	})

	const richTextStyle = computed<string>(() => {
		const color = uiTheme.value == 'dark' ? '#ffffff' : '#333333'
		const backgroundColor = uiTheme.value == 'dark' ? '#25282c' : '#ffffff'
		return 'font-size:16px;line-height:1.625;color:' + color + ';background-color:' + backgroundColor + ';'
	})

	const changeThinkContent = () => {
		hideThinkContent.value = !hideThinkContent.value
		emit('changeThinkContent', hideThinkContent.value)
	}

	function onItemClick(e: UniRichTextItemClickEvent) {
		if (e.detail.href != null && e.detail.href!.length > 0) {
			uni.navigateTo({
				url: '/uni_modules/uni-ai-x/pages/common/webview/webview?url=' + e.detail.href!,
				fail: (err) => {
					console.error(err)
				}
			})
			return
		}
		if (e.detail.src != null && e.detail.src!.length > 0) {
			uni.previewImage({ urls: [e.detail.src!] as string[] })
		}
	}
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
	.msg-segment {
		width: 100%;
		min-height: 0;
		background-color: var(--bg-primary);
		padding: 0 45px;
	}

.msg-segment-first {
	min-height: 31px;
}

.msg-segment-avatar {
	position: absolute;
	top: 0;
	left: 10px;
	width: 25px;
	height: 25px;
	padding: 3px;
	border-radius: 50px;
	border: 1px solid var(--border-secondary);
}

.msg-segment-think-content {
	width: 100%;
	margin: 5px 0;
}

.msg-root-think-content-header {
	flex-direction: row;
}

.msg-root-think-content-title {
	color: var(--text-tertiary);
}

.msg-root-think-content-text-box {
	margin-top: 10px;
	border-left: 3px solid var(--bg-tertiary);
	padding-left: 10px;
	width: 100%;
	margin: 5px 0;
}

.msg-root-think-content-text-box-hide {
	margin-top: 0;
	height: 0;
}

.msg-root-think-content-text {
	text-align: left;
	color: var(--text-tertiary);
}

.msg-root-error-msg,
.msg-root-stop-text,
.msg-root-need-try,
.msg-root-plain-text {
	text-align: left;
	width: 100%;
}

.msg-segment-rich-text {
	width: 100%;
}

.msg-root-plain-text {
	white-space: pre-wrap;
	line-height: 24px;
	color: var(--text-primary);
	padding: 4px 0;
}

.msg-root-error-msg {
	color: var(--error);
	font-size: 14px;
	line-height: 26px;
}

.msg-root-loging-icon {
	margin-top: 10px;
	width: 16px;
	height: 16px;
}

.msg-root-stop-text {
	color: var(--text-disabled);
	font-size: 14px;
	padding: 10px 0;
}

.msg-root-need-try {
	color: var(--error);
	font-size: 14px;
	padding: 10px;
}

</style>
