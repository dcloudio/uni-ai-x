<template>
	<view v-if="node.type == 'heading'" class="uni-ai-md-node uni-ai-md-heading"
		:class="'uni-ai-md-heading-' + headingLevel">
		<uni-ai-md-inline v-for="(child, index) in childrenOf(node)" :key="index" :node="child" />
	</view>
	<view v-else-if="node.type == 'paragraph' || node.type == 'text'" class="uni-ai-md-node uni-ai-md-paragraph">
		<uni-ai-md-inline v-for="(child, index) in childrenOf(node)" :key="index" :node="child" />
	</view>
	<view v-else-if="node.type == 'block_quote'" class="uni-ai-md-node uni-ai-md-block-quote">
		<uni-ai-md-node v-for="(child, index) in childrenOf(node)" :key="index" :node="child" />
	</view>
	<view v-else-if="node.type == 'list'" class="uni-ai-md-node uni-ai-md-list">
		<view v-for="(item, index) in listItems" :key="index" class="uni-ai-md-list-item">
			<text class="uni-ai-md-list-marker" :class="isTaskItem(item) ? 'uni-ai-md-list-task' : ''">{{listMarker(item, index)}}</text>
			<view class="uni-ai-md-list-content">
				<uni-ai-md-node v-for="(child, childIndex) in childrenOf(item)" :key="childIndex" :node="child" />
			</view>
		</view>
	</view>
	<view v-else-if="node.type == 'thematic_break'" class="uni-ai-md-node uni-ai-md-hr"></view>
	<view v-else-if="node.type == 'code_block'" class="uni-ai-md-node uni-ai-md-code">
		<uni-ai-msg-math v-if="codeIsMath" :text="codeText" :is-close="codeComplete ? 1 : 0" />
		<uni-ai-msg-code v-else :code-text="codeText" :language="codeLanguage" :is-close="codeComplete ? 1 : 0" />
	</view>
	<view v-else-if="node.type == 'html_block'" class="uni-ai-md-node uni-ai-md-paragraph">
		<text class="uni-ai-md-inline">{{node.literal ?? ''}}</text>
	</view>
	<view v-else class="uni-ai-md-node uni-ai-md-paragraph">
		<uni-ai-md-inline :node="node" />
	</view>
</template>

<script lang="uts" setup>
	import { MarkdownAstNode } from '@/uni_modules/uni-ai-worker/utssdk/markdown-ast.uts'
	import uniAiMsgCode from '@/uni_modules/uni-ai-x/components/uni-ai-msg-code/uni-ai-msg-code.uvue'
	import uniAiMsgMath from '@/uni_modules/uni-ai-x/components/uni-ai-msg-math/uni-ai-msg-math.uvue'

	type UniAiMdNodeProps = {
		node: MarkdownAstNode
	}

	defineOptions({
		name: 'uni-ai-md-node'
	})
	const props = defineProps<UniAiMdNodeProps>()

	const headingLevel = computed<number>(() => Math.max(1, Math.min(props.node.level ?? 1, 6)))

	const listItems = computed<MarkdownAstNode[]>(() => props.node.children ?? [] as MarkdownAstNode[])

	const codeInfo = computed<string>(() => (props.node.info ?? '').split(' ')[0])
	const codeIsMath = computed<boolean>(() => codeInfo.value == 'math' || codeInfo.value == 'math-pending')
	const codeComplete = computed<boolean>(() => codeInfo.value.indexOf('pending') < 0)
	const codeText = computed<string>(() => (props.node.literal ?? '').replace(/\n$/, ''))
	const codeLanguage = computed<string>(() => codeInfo.value.length > 0 ? codeInfo.value : 'text')

	function childrenOf(node: MarkdownAstNode): MarkdownAstNode[] {
		return node.children ?? [] as MarkdownAstNode[]
	}

	function isTaskItem(item: MarkdownAstNode): boolean {
		return item.tasklist == true
	}

	function listMarker(item: MarkdownAstNode, index: number): string {
		if (isTaskItem(item)) return item.checked == true ? '☑' : '☐'
		if (props.node.listType == 'ordered') {
			const start = props.node.start ?? 1
			return (start + index).toString() + '.'
		}
		return '•'
	}
</script>

<style lang="scss">
	@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

	.uni-ai-md-node {
		width: 100%;
	}

	.uni-ai-md-paragraph {
		flex-direction: row;
		flex-wrap: wrap;
		margin: 4px 0;
	}

	.uni-ai-md-heading {
		flex-direction: row;
		flex-wrap: wrap;
		font-weight: 700;
		margin: 8px 0 6px;
	}

	.uni-ai-md-heading-1 { font-size: 30px; line-height: 36px; }
	.uni-ai-md-heading-2 { font-size: 26px; line-height: 34px; }
	.uni-ai-md-heading-3 { font-size: 22px; line-height: 32px; }
	.uni-ai-md-heading-4 { font-size: 20px; line-height: 30px; }
	.uni-ai-md-heading-5 { font-size: 18px; line-height: 28px; }
	.uni-ai-md-heading-6 { font-size: 16px; line-height: 24px; color: var(--text-tertiary); }

	.uni-ai-md-block-quote {
		border-left: 4px solid var(--border-primary);
		padding-left: 10px;
		margin: 6px 0;
	}

	.uni-ai-md-list {
		margin: 4px 0;
	}

	.uni-ai-md-list-item {
		flex-direction: row;
		align-items: flex-start;
		width: 100%;
	}

	.uni-ai-md-list-marker {
		margin-right: 8px;
		font-size: 18px;
		line-height: 28px;
		color: var(--text-secondary);
	}

	.uni-ai-md-list-task {
		margin-right: 6px;
	}

	.uni-ai-md-list-content {
		flex: 1;
	}

	.uni-ai-md-code {
		margin: 5px 0;
	}

	.uni-ai-md-hr {
		height: 1px;
		background: var(--border-primary);
		margin: 10px 0;
	}
</style>
