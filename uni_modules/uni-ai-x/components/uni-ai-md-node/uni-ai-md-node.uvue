<template>
	<view v-if="node.type == 'heading'" class="uni-ai-md-node uni-ai-md-heading" :class="'uni-ai-md-heading-' + (node.depth ?? 1)">
		<uni-ai-md-inline class="uni-ai-md-heading-text" :class="'uni-ai-md-heading-text-' + (node.depth ?? 1)" v-for="(child, index) in childrenOf(node)" :key="nodeKey(child, index)" :node="child" />
	</view>
	<view v-else-if="node.type == 'paragraph'" class="uni-ai-md-node uni-ai-md-paragraph">
		<uni-ai-md-inline v-for="(child, index) in childrenOf(node)" :key="nodeKey(child, index)" :node="child" />
	</view>
	<view v-else-if="node.type == 'block_quote'" class="uni-ai-md-node uni-ai-md-block-quote">
		<uni-ai-md-node v-for="(child, index) in childrenOf(node)" :key="nodeKey(child, index)" :node="child" />
	</view>
	<view v-else-if="node.type == 'list' || node.type == 'tasklist'" class="uni-ai-md-node uni-ai-md-list">
		<view v-for="(item, index) in listItems" :key="nodeKey(item, index)" class="uni-ai-md-list-item">
			<text v-if="isOrderedList" class="uni-ai-md-list-marker">{{orderedMarker(index)}}</text>
			<view v-else-if="isTaskList || isTaskItem(item)" class="uni-ai-md-list-icon-marker">
				<uni-ai-icon :code="taskIcon(item)" :color="item.checked == 1 ? 'var(--text-primary)' : 'var(--text-secondary)'" size="16" />
			</view>
			<view v-else class="uni-ai-md-list-icon-marker">
				<uni-ai-icon code="ec1e" color="var(--text-primary)" size="14" />
			</view>
			<view class="uni-ai-md-list-content">
				<uni-ai-md-node v-for="(child, childIndex) in childrenOf(item)" :key="nodeKey(child, childIndex)" :node="child" />
			</view>
		</view>
	</view>
	<uni-ai-msg-table v-else-if="node.type == 'table'" class="uni-ai-md-node uni-ai-md-table" :table-node="node" />
	<uni-ai-msg-code v-else-if="node.type == 'code_block'" class="uni-ai-md-node uni-ai-md-code" :codeTokens="node.codeTokens ?? []" :codeText="node.text" :language="node.lang" :href="node.href" />
	<katex-el v-else-if="node.type == 'math'" :html="node.html" :href="node.href" :width="node.width" :height="node.height" />
	<view v-else-if="node.type == 'thematic_break'" class="uni-ai-md-node uni-ai-md-hr"></view>
	<view v-else class="uni-ai-md-node uni-ai-md-paragraph">
		<uni-ai-md-inline :node="node" />
	</view>
</template>

<script lang="uts" setup>
	import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'

	type UniAiMdNodeProps = {
		node: MarkdownToken
	}
	defineOptions({
		name: 'uni-ai-md-node'
	})
	const props = defineProps<UniAiMdNodeProps>()

	const listItems = computed<MarkdownToken[]>(() => {
		return props.node.items ?? props.node.tokens ?? [] as MarkdownToken[]
	})

	const isOrderedList = computed<boolean>(() => {
		return props.node.ordered == 1
	})

	const isTaskList = computed<boolean>(() => {
		return props.node.type == 'tasklist'
	})

	function childrenOf(node: MarkdownToken): MarkdownToken[] {
		return node.tokens ?? node.items ?? [] as MarkdownToken[]
	}

	function nodeKey(node: MarkdownToken, index: number): string {
		return node.uniqueId ?? ((node.type ?? 'node') + '-' + index)
	}

	function orderedMarker(index: number): string {
		const start = typeof props.node.start == 'number' ? props.node.start as number : 1
		return (start + index).toString() + '.'
	}

	function taskIcon(item: MarkdownToken): string {
		return item.checked == 1 ? 'e607' : 'e608'
	}

	function isTaskItem(item: MarkdownToken): boolean {
		return item.type == 'tasklist' || item.task == 1
	}
</script>

<style lang="scss">
	@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

	.uni-ai-md-node {
		width: 100%;
	}

	.uni-ai-md-paragraph {
		flex-direction: row;
		flex-wrap: wrap;
		margin: 4px 0;
	}

	.uni-ai-md-heading {
		flex-direction: row;
		flex-wrap: wrap;
		font-weight: 700;
		margin: 8px 0 6px;
	}

	.uni-ai-md-heading-1 { font-size: 30px; line-height: 36px; }
	.uni-ai-md-heading-2 { font-size: 26px; line-height: 34px; }
	.uni-ai-md-heading-3 { font-size: 22px; line-height: 32px; }
	.uni-ai-md-heading-4 { font-size: 20px; line-height: 30px; }
	.uni-ai-md-heading-5 { font-size: 18px; line-height: 28px; }
	.uni-ai-md-heading-6 { font-size: 16px; line-height: 24px; color: var(--text-tertiary); }

	.uni-ai-md-heading-text {
		font-weight: 700;
	}

	.uni-ai-md-heading-text-1 { font-size: 30px; line-height: 36px; }
	.uni-ai-md-heading-text-2 { font-size: 26px; line-height: 34px; }
	.uni-ai-md-heading-text-3 { font-size: 22px; line-height: 32px; }
	.uni-ai-md-heading-text-4 { font-size: 20px; line-height: 30px; }
	.uni-ai-md-heading-text-5 { font-size: 18px; line-height: 28px; }
	.uni-ai-md-heading-text-6 { font-size: 16px; line-height: 24px; color: var(--text-tertiary); }

	.uni-ai-md-block-quote {
		border-left: 4px solid var(--border-primary);
		padding-left: 10px;
		margin: 6px 0;
	}

	.uni-ai-md-list {
		margin: 4px 0;
	}

	.uni-ai-md-list-item {
		flex-direction: row;
		align-items: flex-start;
		width: 100%;
	}

	.uni-ai-md-list-marker {
		margin-right: 8px;
		font-size: 16px;
		line-height: 28px;
		color: var(--text-secondary);
	}

	.uni-ai-md-list-icon-marker {
		width: 16px;
		height: 28px;
		margin-right: 6px;
		align-items: center;
		justify-content: center;
	}

	.uni-ai-md-list-content {
		flex: 1;
	}

	.uni-ai-md-table,
	.uni-ai-md-code {
		margin: 5px 0;
	}

	.uni-ai-md-hr {
		height: 1px;
		background: var(--border-primary);
		margin: 10px 0;
	}
</style>
