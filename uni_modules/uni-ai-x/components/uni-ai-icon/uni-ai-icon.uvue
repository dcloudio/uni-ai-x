<template>
	<image class="uni-ai-icon" :src="source" :style="{ width: iconSize, height: iconSize }"
		mode="aspectFit" @click="onClick" />
</template>

<script setup lang="uts">
	import { artwork } from './artwork.uts'
	import { uiTheme } from '@/uni_modules/uni-ai-x/sdk'

	const props = withDefaults(defineProps<{
		name?: string
		code?: string
		size?: string
		color?: string
	}>(), { name: '', code: '', size: '16', color: 'var(--text-primary)' })
	const emit = defineEmits<{ 'click': [event: UniEvent] }>()
	const onClick = (event: UniEvent) => { emit('click', event) }
	const iconSize = computed<string>(() => {
		return /^[0-9.]+$/.test(props.size) ? props.size + 'px' : props.size
	})
	// Existing code callers remain supported; named icons take precedence.
	const legacyNames = new Map<string, string>([
		['e639', 'think-outline'], ['e797', 'globe-outline'],
		['e691', 'stop-fill'], ['e627', 'send-outline'],
		['e622', 'panel-left-outline'], ['e907', 'new-chat-outline'],
		['e60c', 'copy-outline'], ['e633', 'refresh-outline']
	])
	const source = computed<string>(() => {
		const dark = uiTheme.value == 'dark'
		let color = props.color
		// SVG images cannot inherit CSS variables; resolve the app's icon palette here.
		if (color == 'var(--text-primary)') color = dark ? '#ffffff' : '#333333'
		if (color == 'var(--text-secondary)') color = dark ? '#e0e0e0' : '#666666'
		if (color == 'var(--text-tertiary)') color = dark ? '#b0b0b0' : '#999999'
		if (color == 'var(--text-disabled)') color = dark ? '#666666' : '#cccccc'
		if (color == 'var(--accent-primary)') color = dark ? '#4d94ff' : '#0066cc'
		const name = props.name.length > 0 ? props.name : (legacyNames.get(props.code) ?? '')
		const svg = (artwork.get(name) ?? '').replaceAll('currentColor', color)
		if (svg.length == 0) return ''
		// #ifdef APP-HARMONY
		const bytes = new TextEncoder().encode(svg)
		return 'data:image/svg+xml;base64,' + uni.arrayBufferToBase64(bytes.buffer as ArrayBuffer)
		// #endif
		// #ifndef APP-HARMONY
		return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg)
		// #endif
	})
</script>

<style>
.uni-ai-icon {
	flex-shrink: 0;
}
</style>
