<template>
	<view class="chat-extension-input">
		<view class="chat-extension-input-actions">
			<view v-for="action in actions" :key="action.id"
				class="chat-extension-input-action"
				:class="[activeActionId == action.id ? 'chat-extension-input-action-active' : '', aiState == 'processing' ? 'chat-extension-input-action-disabled' : '']"
				@click.stop="runAction(action.id)">
				<text class="chat-extension-input-action-text"
					:class="activeActionId == action.id ? 'chat-extension-input-action-text-active' : ''">{{action.label}}</text>
			</view>
			<view class="chat-extension-input-action chat-extension-input-clear"
				:class="aiState == 'processing' ? 'chat-extension-input-action-disabled' : ''"
				@click.stop="clear">
				<text class="chat-extension-input-clear-text">清空</text>
			</view>
		</view>
		<view class="chat-extension-input-stress-actions">
			<view class="chat-extension-input-stress-button" :class="!canCopyMessages ? 'chat-extension-input-action-disabled' : ''" @click.stop="copyMessages">
				<text class="chat-extension-input-stress-button-text">复制100条消息</text>
			</view>
			<view class="chat-extension-input-stress-button" :class="!canCopyChats ? 'chat-extension-input-action-disabled' : ''" @click.stop="copyChats">
				<text class="chat-extension-input-stress-button-text">复制500个会话</text>
			</view>
		</view>
		<view class="chat-extension-input-status-row">
			<text class="chat-extension-input-status-text">{{statusText}}</text>
			<view class="chat-extension-input-stop-slot">
				<view class="chat-extension-input-stop" :style="{visibility: aiState == 'processing' ? 'visible' : 'hidden'}" @click.stop="stop">
					<uni-ai-icon code="e691" color="#FFF" size="14"></uni-ai-icon>
				</view>
			</view>
		</view>
		<view class="chat-extension-input-safe-area"></view>
		<view v-if="copyingChats" class="chat-extension-input-copy-mask">
			<text class="chat-extension-input-copy-mask-text">正在复制会话 {{copiedChats}} / 500</text>
		</view>
	</view>
</template>

<script lang="uts" setup>
	import uniAi from '@/uni_modules/uni-ai-x/sdk'
	import { getChatInputExtension } from '@/uni_modules/uni-ai-x/sdk/chat-extension.uts'

	const extension = getChatInputExtension()!
	const actions = extension.actions
	const aiState = computed<string>(() => uniAi.currentChat?.state ?? 'none')
	const activeActionId = computed<string>(() => extension.activeActionId())
	const statusText = computed<string>(() => extension.statusText())
	const copyingChats = ref<boolean>(false)
	const copiedChats = ref<number>(0)
	let targetCopiedChats = 0
	let completedChatCount = 0
	let copyProgressTimer: number | null = null
	let stressCopyRunId = ''
	const canCopyMessages = computed<boolean>(() => {
		return !copyingChats.value && aiState.value != 'processing' && uniAi.lastAiMsg != null
	})
	const canCopyChats = computed<boolean>(() => {
		return !copyingChats.value && aiState.value != 'processing' && (uniAi.currentChat?.msgList.length ?? 0) > 0
	})

	function runAction(actionId: string) {
		if (aiState.value == 'processing') return
		extension.runAction(actionId)
	}

	function clear() {
		if (aiState.value == 'processing') return
		extension.clear()
	}

	function stop() {
		extension.stop()
	}

	function copyMessages() {
		if (!canCopyMessages.value) return
		uniAi.copyLastMessageForStress(100)
	}

	function copyChats() {
		if (!canCopyChats.value) return
		copyingChats.value = true
		copiedChats.value = 0
		completedChatCount = 0
		targetCopiedChats = 500
		stressCopyRunId = Date.now().toString(36)
		startCopyProgressSampling()
		copyNextChat()
	}

	function startCopyProgressSampling() {
		if (copyProgressTimer != null) clearInterval(copyProgressTimer)
		copyProgressTimer = setInterval(() => {
			copiedChats.value = completedChatCount
		}, 250) as number
	}

	function stopCopyProgressSampling() {
		if (copyProgressTimer != null) {
			clearInterval(copyProgressTimer)
			copyProgressTimer = null
		}
		copiedChats.value = completedChatCount
	}

	const copyNextChat = async () => {
		if (completedChatCount >= targetCopiedChats) {
			uniAi.saveChatList2Storage()
			stopCopyProgressSampling()
			copyingChats.value = false
			return
		}
		const error = await uniAi.createCurrentChatStressCopy(stressCopyRunId, completedChatCount)
		if (error.length > 0) {
			uniAi.saveChatList2Storage()
			stopCopyProgressSampling()
			copyingChats.value = false
			return
		}
		completedChatCount += 1
		setTimeout(() => copyNextChat(), 0)
	}

	watch((): string => uniAi.chat.activeId, () => {
		extension.onChatChanged()
	})

	onBeforeUnmount(() => {
		stopCopyProgressSampling()
		extension.dispose()
	})
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';

.chat-extension-input {
	width: 100%;
	flex-direction: column;
	background-color: var(--bg-primary);
	padding: 15px 15px 5px 15px;
	border-radius: 15px 15px 0 0;
	border: 1px solid var(--border-secondary);
}

.chat-extension-input-actions {
	width: 100%;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
}

.chat-extension-input-action {
	height: 32px;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	padding: 0 12px;
	margin-right: 8px;
	margin-bottom: 8px;
	border-radius: 6px;
	border: 1px solid var(--border-primary);
	background-color: var(--bg-secondary);
}

.chat-extension-input-action-active {
	border-color: var(--accent-primary);
	background-color: var(--bg-tertiary);
}

.chat-extension-input-action-disabled {
	opacity: 0.45;
}

.chat-extension-input-action-text {
	font-size: 13px;
	color: var(--text-secondary);
}

.chat-extension-input-action-text-active {
	color: var(--accent-primary);
}

.chat-extension-input-clear {
	border-color: var(--error);
}

.chat-extension-input-clear-text {
	font-size: 13px;
	color: var(--error);
}

.chat-extension-input-status-row {
	width: 100%;
	height: 34px;
	flex-direction: row;
	align-items: center;
}

.chat-extension-input-stress-actions {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 6px;
}

.chat-extension-input-stress-button {
	height: 30px;
	padding: 0 10px;
	margin-right: 12px;
	border: 1px solid var(--border-primary);
	border-radius: 4px;
	background-color: var(--bg-secondary);
	justify-content: center;
}

.chat-extension-input-stress-button-text {
	font-size: 12px;
	color: var(--text-secondary);
}

.chat-extension-input-copy-mask {
	position: fixed;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;
	z-index: 500;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	background-color: rgba(0, 0, 0, 0.35);
}

.chat-extension-input-copy-mask-text {
	padding: 12px 16px;
	border-radius: 6px;
	background-color: var(--bg-primary);
	font-size: 14px;
	color: var(--text-primary);
}

.chat-extension-input-status-text {
	flex: 1;
	font-size: 11px;
	line-height: 18px;
	color: var(--text-tertiary);
}

.chat-extension-input-stop-slot {
	width: 34px;
	height: 34px;
	margin-left: 8px;
	align-items: center;
	justify-content: center;
}

.chat-extension-input-stop {
	width: 30px;
	height: 30px;
	align-items: center;
	justify-content: center;
	border-radius: 100px;
	background-color: var(--accent-primary);
}

.chat-extension-input-safe-area {
	/* #ifdef APP-ANDROID */
	margin-bottom: env(safe-area-inset-bottom);
	/* #endif */
	/* #ifndef APP-ANDROID */
	padding-bottom: env(safe-area-inset-bottom);
	/* #endif */
}

/* #ifdef H5 */
@media screen and (min-device-width:960px){
	.chat-extension-input {
		border-radius: 15px;
		margin: 10px;
		margin-top: 0;
	}
}
/* #endif */
</style>
