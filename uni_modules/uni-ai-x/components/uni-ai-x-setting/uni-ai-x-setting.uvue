<template>
	<view class="uni-im-setting uni-theme-root" :class="settingsPage ? 'uni-im-setting-page' : ''">
		<view v-if="settingsPage" class="uni-im-setting-header">
			<view class="uni-im-setting-back-slot" @click="back">
				<view class="uni-im-setting-back">
					<uni-ai-icon name="chevron-left-outline" size="22" color="var(--text-primary)" />
				</view>
			</view>
			<text class="uni-im-setting-title">{{tr('设置', 'Settings')}}</text>
			<view class="uni-im-setting-header-spacer"></view>
		</view>
		<scroll-view v-if="settingsPage" direction="vertical" class="uni-im-setting-scroll" :show-scrollbar="false">
			<view class="uni-im-setting-content">
				<text class="uni-im-setting-section-title">{{tr('应用', 'App')}}</text>
				<view class="uni-im-setting-card">
					<view class="uni-im-setting-item" hover-class="uni-im-setting-item-active" @click="openLanguagePicker">
						<uni-ai-icon name="globe-outline" size="22" />
						<text class="uni-im-setting-label">{{tr('语言', 'Language')}}</text>
						<text class="uni-im-setting-value">{{uniAi.setting.language == 'en-US' ? 'English' : '简体中文'}}</text>
						<uni-ai-icon name="chevron-right-outline" size="16" color="var(--text-tertiary)" />
					</view>
					<view class="uni-im-setting-item" hover-class="uni-im-setting-item-active" @click="openThemePicker">
						<uni-ai-icon :name="appearanceIcon" size="22" />
						<text class="uni-im-setting-label">{{tr('外观', 'Appearance')}}</text>
						<text class="uni-im-setting-value">{{themeLabel}}</text>
						<uni-ai-icon name="chevron-right-outline" size="16" color="var(--text-tertiary)" />
					</view>
					<view class="uni-im-setting-item" hover-class="uni-im-setting-item-active" @click="changeModel">
						<uni-ai-icon name="sparkle" size="22" />
						<text class="uni-im-setting-label">{{tr('大语言模型', 'AI model')}}</text>
						<text class="uni-im-setting-value">{{currentModel}}</text>
						<uni-ai-icon name="chevron-right-outline" size="16" color="var(--text-tertiary)" />
					</view>
				</view>
				<!-- #ifdef APP -->
				<text class="uni-im-setting-section-title">{{tr('关于', 'About')}}</text>
				<view class="uni-im-setting-card">
					<view class="uni-im-setting-item" hover-class="uni-im-setting-item-active" @click="checkForUpdate">
						<uni-ai-icon name="info-outline" size="22" />
						<text class="uni-im-setting-label">{{tr('检查更新', 'Check for updates')}}</text>
						<text class="uni-im-setting-value">{{checkingUpdate ? tr('检查中...', 'Checking...') : currentAppVersion}}</text>
						<uni-ai-icon name="chevron-right-outline" size="16" color="var(--text-tertiary)" />
					</view>
				</view>
				<!-- #endif -->
			</view>
		</scroll-view>
		<uni-popup ref="choicePopupRef" @close="choicePopupClosed">
			<view class="uni-im-setting-choice-dialog">
				<view class="uni-im-setting-choice-header" :class="choiceKind == 'theme' ? 'uni-im-setting-choice-header-plain' : ''">
					<uni-ai-icon v-if="choiceKind == 'language'" name="globe-outline" size="20" />
					<text class="uni-im-setting-choice-title" :class="choiceKind == 'theme' ? 'uni-im-setting-choice-title-plain' : ''">{{choiceKind == 'language' ? tr('语言', 'Language') : tr('外观', 'Appearance')}}</text>
				</view>
				<scroll-view direction="vertical" class="uni-im-setting-choice-options">
					<view v-for="option in choiceOptions" :key="option.value" class="uni-im-setting-choice-row" hover-class="uni-im-setting-item-active" @click="pendingChoice = option.value">
						<view class="uni-im-setting-choice-radio" :class="pendingChoice == option.value ? 'uni-im-setting-choice-radio-selected' : ''">
							<view class="uni-im-setting-choice-dot" :style="{ opacity: pendingChoice == option.value ? 1 : 0 }"></view>
						</view>
						<text class="uni-im-setting-choice-label">{{option.label}}</text>
					</view>
				</scroll-view>
				<!-- #ifndef APP -->
				<text v-if="choiceKind == 'theme'" class="uni-im-setting-choice-note">{{tr('当前平台外观跟随系统设置', 'Appearance follows your system settings on this platform')}}</text>
				<!-- #endif -->
				<view class="uni-im-setting-choice-confirm" hover-class="uni-im-setting-item-active" @click="confirmChoice">
					<text class="uni-im-setting-choice-confirm-text">{{tr('确认', 'Confirm')}}</text>
				</view>
			</view>
		</uni-popup>
		<uni-popup ref="modelPopupRef" @close="modelPopupVisible = false">
            <view class="model-picker">
                <view class="model-picker-header">
                    <text class="model-picker-title">{{tr('选择 AI 模型', 'Choose AI model')}}</text>
                    <text class="model-picker-subtitle">{{tr('选择适合当前任务的模型', 'Choose a model for your task')}}</text>
                    <view class="model-picker-close" @click="closeModelPopup"><uni-ai-icon name="close-outline" size="18" color="var(--text-tertiary)" /></view>
                </view>
                <scroll-view direction="vertical" class="model-picker-scroll" :style="{height: modelListHeight}" :show-scrollbar="false">
                    <view v-for="provider in providerNameList" :key="provider" class="model-picker-group">
                        <text class="model-picker-provider">{{providerLabel(provider)}}</text>
                        <view v-for="model in llmModelMap.get(provider)!.models" :key="model.modelId" class="model-picker-card" :class="isSelectedModel(provider, model.modelId) ? 'model-picker-card-selected' : ''" @click="radioChange(provider, model.modelId)">
                            <view class="model-picker-main">
                                <view class="model-picker-info">
                                    <text class="model-picker-name">{{model.name ?? model.modelId}}</text>
                                    <text class="model-picker-description">{{modelDescription(model.modelId)}}</text>
                                </view>
                                <view class="model-picker-radio" :class="isSelectedModel(provider, model.modelId) ? 'model-picker-radio-selected' : ''"><view class="model-picker-dot" :style="{opacity: isSelectedModel(provider, model.modelId) ? 1 : 0}" /></view>
                            </view>
                            <view v-if="model.thinking || model.image || model.toolCall" class="model-picker-tags">
                                <text v-if="model.thinking" class="model-picker-tag">{{tr('深度思考', 'Reasoning')}}</text>
                                <text v-if="model.image" class="model-picker-tag">{{tr('图片理解', 'Vision')}}</text>
                                <text v-if="model.toolCall" class="model-picker-tag">{{tr('工具调用', 'Tools')}}</text>
                            </view>
                        </view>
                    </view>
                </scroll-view>
                <view class="model-picker-footer"><text class="model-picker-footer-text">{{tr('选择后立即生效', 'Your selection takes effect immediately')}}</text></view>
            </view>
        </uni-popup>
	</view>
</template>

<script lang="uts" setup>
	import uniAiIcon from '@/uni_modules/uni-ai-x/components/uni-ai-icon/uni-ai-icon.uvue'
	import {uniAi, uiTheme, getLlmDisplayName} from '@/uni_modules/uni-ai-x/sdk';
	import {Theme} from '@/uni_modules/uni-ai-x/types.uts';
	import { tr } from '@/uni_modules/uni-ai-x/sdk/locale.uts'
	// #ifdef APP
	import checkUpdate from '@/uni_modules/uni-upgrade-center-app/utils/check-update'
	// #endif
	
	import {llmModelMap, providerNameList} from '@/uni_modules/uni-ai-x/config';
	
	const props = defineProps({
		settingsPage: { type: Boolean, default: false }
	})
	const back = () => {
		if (!dismissPopup()) uni.navigateBack()
	}
	const modelPopupRef = ref<ComponentPublicInstance | null>(null)
	const modelPopupVisible = ref(false)
	const choicePopupRef = ref<ComponentPublicInstance | null>(null)
	const choicePopupVisible = ref(false)
	const choiceKind = ref('language')
	const pendingChoice = ref('')
	type ChoiceOption = { value: string, label: string }
	const appearanceIcon = computed<string>(() => uiTheme.value == 'dark' ? 'dark-outline' : 'light-outline')
	const choiceOptions = computed<ChoiceOption[]>(() => {
		if (choiceKind.value == 'language') {
			return [{ value: 'zh-CN', label: '简体中文' }, { value: 'en-US', label: 'English' }]
		}
		const options: ChoiceOption[] = [{ value: 'auto', label: tr('跟随系统', 'System') }]
		// #ifdef APP
		options.push({ value: 'light', label: tr('浅色', 'Light') })
		options.push({ value: 'dark', label: tr('深色', 'Dark') })
		// #endif
		return options
	})
	const choicePopupClosed = () => { choicePopupVisible.value = false }
	const openChoice = () => {
		choicePopupVisible.value = true
		choicePopupRef.value?.$callMethod('open')
	}
	const openLanguagePicker = () => {
		choiceKind.value = 'language'
		pendingChoice.value = uniAi.setting.language
		openChoice()
	}
	const openThemePicker = () => {
		choiceKind.value = 'theme'
		pendingChoice.value = 'auto'
		// #ifdef APP
		pendingChoice.value = uniAi.setting.theme
		// #endif
		openChoice()
	}
	const closeChoice = () => { choicePopupRef.value?.$callMethod('close') }
	const dismissPopup = (): boolean => {
		if (choicePopupVisible.value) { closeChoice(); return true }
		if (modelPopupVisible.value) { closeModelPopup(); return true }
		return false
	}
	const confirmChoice = () => {
		if (choiceKind.value == 'language') {
			if (pendingChoice.value != 'zh-CN' && pendingChoice.value != 'en-US') return
			uniAi.setLanguage(pendingChoice.value as 'zh-CN' | 'en-US')
			if (uniAi.setting.language == pendingChoice.value) closeChoice()
			return
		}
		// #ifdef APP
		selectTheme(pendingChoice.value as Theme)
		// #endif
		// #ifndef APP
		closeChoice()
		// #endif
	}
	const themeLabel = computed<string>(() => {
		// #ifdef APP
		if (uniAi.setting.theme == 'dark') return tr('深色', 'Dark')
		if (uniAi.setting.theme == 'light') return tr('浅色', 'Light')
		// #endif
		return tr('跟随系统', 'System')
	})

	const currentModel = computed<string>(() => {
		return getLlmDisplayName(uniAi.llm)
	})

	// #ifdef APP
	const checkingUpdate = ref<boolean>(false)
	const currentAppVersion = uni.getAppBaseInfo().appVersion
	// #endif

    const modelListHeight = ref('360px')
    const isSelectedModel = (provider: string, modelId: string): boolean => uniAi.llm.provider == provider && uniAi.llm.model == modelId
    const providerLabel = (provider: string): string => {
        if (provider == 'deepseek') return tr('DeepSeek 官方', 'DeepSeek Official')
        if (provider == 'qiniu') return tr('uni AI 网关', 'uni AI Gateway')
        return provider
    }
    const modelDescription = (modelId: string): string => {
        if (modelId.toLowerCase().includes('flash')) return tr('日常问答与快速响应', 'Everyday questions and quick responses')
        if (modelId.toLowerCase().includes('pro')) return tr('复杂任务与深入分析', 'Complex tasks and detailed analysis')
        return tr('问答、创作与任务处理', 'Questions, writing and tasks')
    }

	const openModelPopup = () => {
        let count = 0
        providerNameList.forEach((provider: string) => { count += llmModelMap.get(provider)?.models.length ?? 0 })
        modelListHeight.value = Math.min(count * 112 + providerNameList.length * 36, Math.floor(uni.getWindowInfo().windowHeight * 0.56)) + 'px'
		modelPopupVisible.value = true
		modelPopupRef.value?.$callMethod('open')
	}

	const closeModelPopup = () => {
		modelPopupVisible.value = false
		modelPopupRef.value?.$callMethod('close')
	}
	
	// #ifdef APP
	const selectTheme = (theme: Theme) => {
		uni.setAppTheme({
			theme,
			success: () => { uniAi.setting.theme = theme; closeChoice() },
			fail: (error: IAppThemeFail) => {
				uni.showToast({ title: tr('外观切换失败', 'Could not change appearance'), icon: 'none' })
				console.error('主题切换失败', error.errMsg)
			}
		})
	}
	// #endif
	
	const changeModel = () => {
		openModelPopup()
	}

	// #ifdef APP
	const checkForUpdate = () => {
		if (checkingUpdate.value) return
		checkingUpdate.value = true
		checkUpdate().then((result) => {
			if (result.code <= 0) {
				uni.showToast({
					title: tr('当前已是最新版本', 'You are up to date'),
					icon: 'none'
				})
			}
		}).catch((error) => {
			const result = error as any
			if (result != null && (result.code == 0 || result.code == -101)) {
				uni.showToast({
					title: tr('当前已是最新版本', 'You are up to date'),
					icon: 'none'
				})
			} else {
				uni.showToast({
					title: tr('检查更新失败', 'Could not check for updates'),
					icon: 'none'
				})
			}
		}).finally(() => {
			checkingUpdate.value = false
		})
	}
	// #endif

	const radioChange = (provider: string, modelId: string) => {
		uniAi.llm.provider = provider
		uniAi.llm.model = modelId
		nextTick(()=>{closeModelPopup()})
	}
	
	defineExpose({
		openModelPopup,
		dismissPopup
	})
</script>

<style lang="scss">
@import '@/uni_modules/uni-ai-x/static/css/variables.scss';
/* 蒸汽模式：仅单层 class */
.uni-im-setting-page { flex: 1; height: 100%; background-color: var(--bg-secondary); }
.uni-im-setting-header { padding-top: var(--status-bar-height); flex-direction: row; align-items: center; }
.uni-im-setting-back-slot, .uni-im-setting-header-spacer { width: 60px; height: 56px; align-items: center; justify-content: center; }
.uni-im-setting-back { width: 36px; height: 36px; border-radius: 18px; background-color: var(--bg-tertiary); align-items: center; justify-content: center; }
.uni-im-setting-title { flex: 1; text-align: center; font-size: 19px; font-weight: 600; color: var(--text-primary); }
.uni-im-setting-scroll { flex: 1; }
.uni-im-setting-content { padding: 4px 16px 24px; padding-bottom: env(safe-area-inset-bottom); }
.uni-im-setting-section-title { font-size: 13px; color: var(--text-tertiary); margin: 20px 16px 10px; }
.uni-im-setting-card { border-radius: 16px; background-color: var(--bg-primary); overflow: hidden; }
.uni-im-setting-item { height: 52px; flex-shrink: 0; box-sizing: border-box; flex-direction: row; align-items: center; padding: 0 16px; }
.uni-im-setting-item-active { background-color: var(--bg-tertiary); }
.uni-im-setting-label { margin-left: 14px; margin-right: 16px; font-size: 16px; color: var(--text-primary); flex-shrink: 0; }
.uni-im-setting-value { flex: 1; font-size: 15px; color: var(--text-tertiary); margin-right: 8px; text-align: right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.uni-im-setting-choice-dialog { width: 530rpx; max-width: 320px; border-radius: 20px; background-color: var(--bg-primary); overflow: hidden; }
.uni-im-setting-choice-header { height: 80px; box-sizing: border-box; flex-shrink: 0; align-items: center; justify-content: center; border-bottom: 1px solid var(--border-secondary); }
.uni-im-setting-choice-header-plain { height: 56px; }
.uni-im-setting-choice-title { font-size: 16px; line-height: 22px; font-weight: 500; color: var(--text-primary); margin-top: 8px; }
.uni-im-setting-choice-title-plain { margin-top: 0; }
.uni-im-setting-choice-options { max-height: 360px; }
.uni-im-setting-choice-row { height: 50px; box-sizing: border-box; flex-shrink: 0; padding: 0 18px; flex-direction: row; align-items: center; }
.uni-im-setting-choice-radio { width: 18px; height: 18px; border-radius: 9px; border: 1.5px solid var(--text-secondary); justify-content: center; align-items: center; flex-shrink: 0; }
.uni-im-setting-choice-radio-selected { border-color: var(--text-primary); }
.uni-im-setting-choice-dot { width: 10px; height: 10px; border-radius: 5px; background-color: var(--text-primary); }
.uni-im-setting-choice-label { flex: 1; font-size: 15px; line-height: 22px; color: var(--text-primary); margin-left: 16px; }
.uni-im-setting-choice-note { padding: 0 20px 16px; font-size: 13px; color: var(--text-secondary); }
.uni-im-setting-choice-confirm { height: 48px; box-sizing: border-box; flex-shrink: 0; align-items: center; justify-content: center; border-top: 1px solid var(--border-secondary); }
.uni-im-setting-choice-confirm-text { font-size: 16px; font-weight: 500; color: var(--accent-primary); }

.model-picker { width: 686rpx; max-width: 440px; border-radius: 24px; background-color: var(--bg-primary); overflow: hidden; }
.model-picker-header { position: relative; align-items: center; padding: 24px 42px 18px; flex-shrink: 0; }
.model-picker-title { font-size: 19px; line-height: 26px; font-weight: 600; color: var(--text-primary); text-align: center; }
.model-picker-subtitle { font-size: 13px; line-height: 20px; margin-top: 6px; color: var(--text-tertiary); text-align: center; }
.model-picker-close { position: absolute; top: 12px; right: 10px; width: 36px; height: 36px; align-items: center; justify-content: center; }
.model-picker-scroll { padding: 0 20px; box-sizing: border-box; flex-shrink: 0; }
.model-picker-group { padding-bottom: 8px; }
.model-picker-provider { font-size: 13px; line-height: 20px; font-weight: 500; color: var(--text-secondary); margin: 0 4px 10px; }
.model-picker-card { padding: 14px; margin-bottom: 10px; border: 1px solid var(--border-secondary); border-radius: 14px; background-color: var(--bg-primary); box-sizing: border-box; }
.model-picker-card-selected { border-color: var(--accent-primary); background-color: var(--input-btn-active-bg); }
.model-picker-main { flex-direction: row; align-items: center; }
.model-picker-info { flex: 1; min-width: 0; }
.model-picker-name { font-size: 16px; line-height: 22px; font-weight: 600; color: var(--text-primary); }
.model-picker-description { font-size: 12px; line-height: 18px; margin-top: 3px; color: var(--text-tertiary); }
.model-picker-radio { width: 19px; height: 19px; border: 1.5px solid var(--text-tertiary); border-radius: 10px; margin-left: 10px; flex-shrink: 0; align-items: center; justify-content: center; }
.model-picker-radio-selected { border-color: var(--accent-primary); }
.model-picker-dot { width: 11px; height: 11px; border-radius: 6px; background-color: var(--accent-primary); }
.model-picker-tags { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.model-picker-tag { font-size: 11px; line-height: 16px; padding: 1px 6px; margin-right: 5px; margin-bottom: 2px; border: 1px solid var(--border-secondary); border-radius: 5px; color: var(--accent-primary); }
.model-picker-footer { height: 44px; align-items: center; justify-content: center; flex-shrink: 0; }
.model-picker-footer-text { font-size: 12px; color: var(--text-tertiary); }
</style>
