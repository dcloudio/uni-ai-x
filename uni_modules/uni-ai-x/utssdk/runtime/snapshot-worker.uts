// #ifdef APP-ANDROID || APP-HARMONY
// #ifdef APP-HARMONY
import { realHarmonyAssetPath } from './app-harmony/asset-path.ets'
// #endif
let worker: Worker | null = null
let ready = false
// iOS 上 Worker 不是 Equatable，无法用 worker != created 判断归属：用代际计数替代。
let workerGeneration = 0
let sequence = 0
let pending: UTSJSONObject[] = []
const callbacks = new Map<number, (result: UTSJSONObject) => void>()
const timers = new Map<number, number>()

@UTSJS.keepAlive
export function requestSnapshotWork(request: UTSJSONObject, callback: (result: UTSJSONObject) => void) {
	// #ifdef APP-HARMONY
	request['assetRoot'] = realHarmonyAssetPath(uni.env.USER_DATA_PATH + '/ai-render-assets/')
	request['assetDisplayRoot'] = uni.env.USER_DATA_PATH + '/ai-render-assets/'
	request['assetCacheRoot'] = realHarmonyAssetPath(uni.env.CACHE_PATH)
	// #endif
	if (worker == null) {
		const created = uni.createWorker('uni_modules/uni-ai-x/workers/aiSnapshotWorkerTask.uts')
		worker = created
		const generation = ++workerGeneration
		created.onMessage((message: any) => {
			if (generation != workerGeneration) return
			const result = message as UTSJSONObject
			if (result.getString('action') == 'ready') {
				ready = true
				const queue = pending
				pending = []
				for (const task of queue) { created.postMessage(task, null) }
				return
			}
			const id = result.getNumber('id') ?? 0
			const timer = timers.get(id)
			if (timer != null) clearTimeout(timer!)
			timers.delete(id)
			const receive = callbacks.get(id)
			callbacks.delete(id)
			receive?.(result)
		})
		created.onError((_error: any) => {
			if (generation != workerGeneration) return
			let detail = ''
			try { detail = JSON.stringify(_error) ?? 'null' } catch (_stringifyError) { detail = 'unstringifiable' }
			console.error('[render-snapshot] snapshot worker onError: ' + detail)
			workerGeneration += 1
			worker = null
			ready = false
			pending = []
			const waiting: ((result: UTSJSONObject) => void)[] = []
			callbacks.forEach((receive: (result: UTSJSONObject) => void) => { waiting.push(receive) })
			callbacks.clear()
			timers.forEach((timer: number) => { clearTimeout(timer) })
			timers.clear()
			created.terminate()
			for (const receive of waiting) { receive({ snapshot: null } as UTSJSONObject) }
		})
	}
	request['id'] = ++sequence
	callbacks.set(sequence, callback)
	const id = sequence
	timers.set(id, setTimeout(() => {
		const receive = callbacks.get(id)
		callbacks.delete(id)
		timers.delete(id)
		pending = pending.filter((task: UTSJSONObject): boolean => (task.getNumber('id') ?? -1) != id)
		receive?.({ snapshot: null } as UTSJSONObject)
	}, 30000))
	if (ready) worker!.postMessage(request, null)
	else pending.push(request)
}
// #endif
