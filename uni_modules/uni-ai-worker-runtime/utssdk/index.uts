import {
	AiWorkerMarkdownStartOptions,
	AiWorkerStartOptions,
	AppendAiWorkerMarkdown,
	CancelAiWorkerRequest,
	CompleteAiWorkerMarkdown,
	CreateAiWorkerRuntime,
	DestroyAiWorkerRuntime,
	ReadAiWorkerSnapshot,
	StartAiWorkerMarkdown,
	StartAiWorkerRequest
} from './interface.uts'

// #ifdef MP-WEIXIN
import { initMd2html, isMd2htmlAvailable, md2html } from '../../uni-cmark/utssdk/mp-weixin/index.uts'
import {
	MarkdownPreprocessor,
	prepareMarkdownHtml
} from '../../uni-ai-worker/utssdk/index.uts'
// #endif

export * from './interface.uts'

// #ifndef MP-WEIXIN
const WORKER_RENDER_PROTOCOL_VERSION = 3
let worker: Worker | null = null
let workerReady = false
let pendingStart: AiWorkerStartOptions | null = null
let pendingMarkdownStart: AiWorkerMarkdownStartOptions | null = null
let pendingMarkdownContent = ''
let pendingMarkdownReasoning = ''
let pendingMarkdownComplete = false
let latestSnapshotJson = ''
let currentRequestVersion = 0
let runtimeGeneration = 0

function readMessageString(message: UTSJSONObject, key: string, defaultValue: string = ''): string {
	const value = message[key] as string | null
	return value == null ? defaultValue : value as string
}

function postStart(options: AiWorkerStartOptions): void {
	if (worker == null || !workerReady) return
	const message = new UTSJSONObject()
	message.action = 'start'
	message.renderProtocolVersion = WORKER_RENDER_PROTOCOL_VERSION
	message.requestVersion = options.requestVersion
	message.provider = options.provider
	message.model = options.model
	message.url = options.url
	message.authorization = options.authorization
	message.bodyJson = options.bodyJson
	message.renderInterval = options.renderInterval ?? 300
	message.timeout = options.timeout ?? 90000
	worker!.postMessage(message, null)
}

function postMarkdownStart(options: AiWorkerMarkdownStartOptions): void {
	if (worker == null || !workerReady) return
	worker!.postMessage({
		action: 'start-markdown',
		renderProtocolVersion: WORKER_RENDER_PROTOCOL_VERSION,
		requestVersion: options.requestVersion,
		renderInterval: options.renderInterval ?? 300
	} as UTSJSONObject, null)
	if (pendingMarkdownContent.length > 0 || pendingMarkdownReasoning.length > 0) {
		postMarkdownChunk(options.requestVersion, pendingMarkdownContent, pendingMarkdownReasoning)
		pendingMarkdownContent = ''
		pendingMarkdownReasoning = ''
	}
	if (pendingMarkdownComplete) {
		pendingMarkdownComplete = false
		postMarkdownComplete(options.requestVersion)
	}
}

function postMarkdownChunk(requestVersion: number, content: string, reasoningContent: string): void {
	worker?.postMessage({
		action: 'append-markdown',
		requestVersion: requestVersion,
		content: content,
		reasoningContent: reasoningContent
	} as UTSJSONObject, null)
}

function postMarkdownComplete(requestVersion: number): void {
	worker?.postMessage({
		action: 'complete-markdown',
		requestVersion: requestVersion
	} as UTSJSONObject, null)
}

function createWorkerNow(generation: number): void {
	if (generation != runtimeGeneration || worker != null) return
	workerReady = false
	latestSnapshotJson = ''
	worker = uni.createWorker('workers/aiRequestWorkerTask.uts')
	worker!.onMessage((message: any) => {
		if (generation != runtimeGeneration) return
		const result = message as UTSJSONObject
		const phase = readMessageString(result, 'phase')
		if (phase == 'ready') {
			workerReady = true
			if (pendingMarkdownStart != null) {
				const options = pendingMarkdownStart!
				pendingMarkdownStart = null
				postMarkdownStart(options)
			} else if (pendingStart != null) {
				const options = pendingStart!
				pendingStart = null
				postStart(options)
			}
			return
		}
		if (phase == 'init-error') {
			pendingStart = null
			pendingMarkdownStart = null
			pendingMarkdownContent = ''
			pendingMarkdownReasoning = ''
			pendingMarkdownComplete = false
			latestSnapshotJson = JSON.stringify({
				requestVersion: currentRequestVersion,
				snapshotVersion: 1,
				phase: 'error',
				errCode: 'markdown_html_unavailable',
				errMsg: readMessageString(result, 'errMsg', 'Markdown HTML Worker 初始化失败')
			} as UTSJSONObject) ?? ''
			return
		}
		const snapshotJson = readMessageString(result, 'snapshotJson')
		if (snapshotJson.length > 0) latestSnapshotJson = snapshotJson
	})
	worker!.onError((_error: any) => {
		if (generation != runtimeGeneration) return
		latestSnapshotJson = JSON.stringify({
			requestVersion: currentRequestVersion,
			snapshotVersion: 0,
			phase: 'error',
			errCode: 'worker_error',
			errMsg: 'Worker 运行失败'
		} as UTSJSONObject) ?? ''
	})
}

export const createAiWorkerRuntime: CreateAiWorkerRuntime = function (): void {
	if (worker != null) return
	runtimeGeneration += 1
	const generation = runtimeGeneration
	workerReady = false
	latestSnapshotJson = ''
	createWorkerNow(generation)
}

export const startAiWorkerRequest: StartAiWorkerRequest = function (options: AiWorkerStartOptions): void {
	createAiWorkerRuntime()
	currentRequestVersion = options.requestVersion
	latestSnapshotJson = ''
	pendingMarkdownStart = null
	if (!workerReady) {
		pendingStart = options
		return
	}
	postStart(options)
}

export const startAiWorkerMarkdown: StartAiWorkerMarkdown = function (options: AiWorkerMarkdownStartOptions): void {
	createAiWorkerRuntime()
	currentRequestVersion = options.requestVersion
	latestSnapshotJson = ''
	pendingStart = null
	pendingMarkdownContent = ''
	pendingMarkdownReasoning = ''
	pendingMarkdownComplete = false
	if (!workerReady) {
		pendingMarkdownStart = options
		return
	}
	postMarkdownStart(options)
}

export const appendAiWorkerMarkdown: AppendAiWorkerMarkdown = function (
	requestVersion: number,
	content: string,
	reasoningContent: string
): void {
	if (!workerReady || pendingMarkdownStart != null) {
		pendingMarkdownContent += content
		pendingMarkdownReasoning += reasoningContent
		return
	}
	postMarkdownChunk(requestVersion, content, reasoningContent)
}

export const completeAiWorkerMarkdown: CompleteAiWorkerMarkdown = function (requestVersion: number): void {
	if (!workerReady || pendingMarkdownStart != null) {
		pendingMarkdownComplete = true
		return
	}
	postMarkdownComplete(requestVersion)
}

export const readAiWorkerSnapshot: ReadAiWorkerSnapshot = function (): string {
	return latestSnapshotJson
}

export const cancelAiWorkerRequest: CancelAiWorkerRequest = function (requestVersion: number): void {
	if (pendingStart?.requestVersion == requestVersion) pendingStart = null
	if (pendingMarkdownStart?.requestVersion == requestVersion) pendingMarkdownStart = null
	pendingMarkdownContent = ''
	pendingMarkdownReasoning = ''
	pendingMarkdownComplete = false
	if (worker == null || !workerReady) return
	worker!.postMessage({
		action: 'cancel',
		requestVersion: requestVersion
	} as UTSJSONObject, null)
}

export const destroyAiWorkerRuntime: DestroyAiWorkerRuntime = function (): void {
	const previousWorker = worker
	runtimeGeneration += 1
	worker = null
	workerReady = false
	pendingStart = null
	pendingMarkdownStart = null
	pendingMarkdownContent = ''
	pendingMarkdownReasoning = ''
	pendingMarkdownComplete = false
	latestSnapshotJson = ''
	currentRequestVersion = 0
	if (previousWorker != null) {
		setTimeout(() => {
			previousWorker!.terminate()
		}, 500)
	}
}
// #endif

// #ifdef MP-WEIXIN
let mpRuntimeCreated = false
let mpMarkdownReady = false
let mpRuntimeGeneration = 0
let mpCurrentRequestVersion = 0
let mpSnapshotVersion = 0
let mpRenderInterval = 300
let mpRenderTimer = 0
let mpStartedAt = 0
let mpContent = ''
let mpReasoningContent = ''
let mpEventCount = 0
let mpNetworkChunkCount = 0
let mpReceivedBytes = 0
let mpCompletionPending = false
let mpActive = false
let mpFinished = true
let mpLatestSnapshotJson = ''
let mpPreprocessor = new MarkdownPreprocessor()

function mpClearRenderTimer(): void {
	if (mpRenderTimer != 0) clearTimeout(mpRenderTimer)
	mpRenderTimer = 0
}

function mpSetError(code: string, message: string): void {
	mpClearRenderTimer()
	mpFinished = true
	mpActive = false
	mpSnapshotVersion += 1
	mpLatestSnapshotJson = JSON.stringify({
		requestVersion: mpCurrentRequestVersion,
		snapshotVersion: mpSnapshotVersion,
		phase: 'error',
		msgBody: mpContent,
		thinkContent: mpReasoningContent.trim(),
		renderMode: '',
		html: '',
		htmlLength: 0,
		isDone: false,
		eventCount: mpEventCount,
		networkChunkCount: mpNetworkChunkCount,
		receivedBytes: mpReceivedBytes,
		terminalSource: 'external',
		elapsed: Date.now() - mpStartedAt,
		errCode: code,
		errMsg: message
	} as UTSJSONObject) ?? ''
}

function mpPublishSnapshot(isDone: boolean): void {
	if (mpContent.length == 0 && !isDone) return
	const processedMarkdownValue = mpPreprocessor.process(mpContent, isDone)
	if (processedMarkdownValue == null) return
	if (!isMd2htmlAvailable()) {
		mpSetError('markdown_html_unavailable', 'cmark-gfm Markdown HTML 转换器不可用')
		return
	}
	try {
		const rawHtmlValue = md2html(processedMarkdownValue!) as string | null
		const rawHtml = rawHtmlValue ?? ''
		if (processedMarkdownValue!.length > 0 && rawHtml.length == 0) {
			mpSetError('markdown_html_failed', 'cmark-gfm Markdown HTML 转换失败')
			return
		}
		const preparedHtmlValue = prepareMarkdownHtml(rawHtml, isDone) as string | null
		const html = preparedHtmlValue ?? ''
		if (processedMarkdownValue!.length > 0 && html.length == 0) {
			mpSetError('markdown_html_failed', 'Markdown HTML 后处理失败')
			return
		}
		mpSnapshotVersion += 1
		mpLatestSnapshotJson = JSON.stringify({
			requestVersion: mpCurrentRequestVersion,
			snapshotVersion: mpSnapshotVersion,
			phase: isDone ? 'complete' : 'snapshot',
			msgBody: mpContent,
			thinkContent: mpReasoningContent.trim(),
			renderMode: 'html',
			html: html,
			htmlLength: html.length,
			isDone: isDone,
			eventCount: mpEventCount,
			networkChunkCount: mpNetworkChunkCount,
			receivedBytes: mpReceivedBytes,
			terminalSource: 'external',
			elapsed: Date.now() - mpStartedAt,
			errCode: '',
			errMsg: ''
		} as UTSJSONObject) ?? ''
	} catch (error) {
		mpSetError('markdown_html_failed', error.message as string)
	}
}

function mpScheduleSnapshot(): void {
	if (!mpActive || mpFinished || !mpMarkdownReady || mpRenderTimer != 0) return
	mpRenderTimer = setTimeout(() => {
		mpRenderTimer = 0
		mpPublishSnapshot(false)
	}, mpRenderInterval)
}

function mpCompleteNow(): void {
	if (!mpActive || mpFinished) return
	mpFinished = true
	mpCompletionPending = false
	mpClearRenderTimer()
	if (!mpContent.endsWith('\n')) mpContent += '\n'
	mpPublishSnapshot(true)
}

function mpInitializeMarkdown(generation: number): void {
	initMd2html().then(() => {
		if (generation != mpRuntimeGeneration || !mpRuntimeCreated) return
		mpMarkdownReady = true
		if (!mpActive) return
		if (mpCompletionPending) {
			mpCompleteNow()
		} else if (mpContent.length > 0) {
			mpScheduleSnapshot()
		}
	}).catch((error: any | null) => {
		if (generation != mpRuntimeGeneration || !mpRuntimeCreated) return
		mpSetError(
			'markdown_html_unavailable',
			error instanceof Error ? error.message : 'cmark-gfm WebAssembly 初始化失败'
		)
	})
}

export const createAiWorkerRuntime: CreateAiWorkerRuntime = function (): void {
	if (mpRuntimeCreated) return
	mpRuntimeCreated = true
	mpMarkdownReady = false
	mpLatestSnapshotJson = ''
	mpRuntimeGeneration += 1
	mpInitializeMarkdown(mpRuntimeGeneration)
}

export const startAiWorkerRequest: StartAiWorkerRequest = function (options: AiWorkerStartOptions): void {
	createAiWorkerRuntime()
	mpCurrentRequestVersion = options.requestVersion
	mpSnapshotVersion = 0
	mpStartedAt = Date.now()
	mpLatestSnapshotJson = ''
	mpSetError('worker_network_unsupported', '微信小程序仅在主线程处理网络请求')
}

export const startAiWorkerMarkdown: StartAiWorkerMarkdown = function (options: AiWorkerMarkdownStartOptions): void {
	createAiWorkerRuntime()
	mpClearRenderTimer()
	mpCurrentRequestVersion = options.requestVersion
	mpSnapshotVersion = 0
	mpRenderInterval = options.renderInterval ?? 300
	mpStartedAt = Date.now()
	mpContent = ''
	mpReasoningContent = ''
	mpEventCount = 0
	mpNetworkChunkCount = 0
	mpReceivedBytes = 0
	mpCompletionPending = false
	mpActive = true
	mpFinished = false
	mpLatestSnapshotJson = ''
	mpPreprocessor = new MarkdownPreprocessor()
}

export const appendAiWorkerMarkdown: AppendAiWorkerMarkdown = function (
	requestVersion: number,
	content: string,
	reasoningContent: string
): void {
	if (!mpActive || mpFinished || requestVersion != mpCurrentRequestVersion) return
	if (content.length > 0) mpContent += content
	if (reasoningContent.length > 0) mpReasoningContent += reasoningContent
	mpEventCount += 1
	mpNetworkChunkCount += 1
	mpReceivedBytes += content.length + reasoningContent.length
	if (content.length > 0) mpScheduleSnapshot()
}

export const completeAiWorkerMarkdown: CompleteAiWorkerMarkdown = function (requestVersion: number): void {
	if (!mpActive || mpFinished || requestVersion != mpCurrentRequestVersion) return
	if (!mpMarkdownReady) {
		mpCompletionPending = true
		return
	}
	mpCompleteNow()
}

export const readAiWorkerSnapshot: ReadAiWorkerSnapshot = function (): string {
	return mpLatestSnapshotJson
}

export const cancelAiWorkerRequest: CancelAiWorkerRequest = function (requestVersion: number): void {
	if (requestVersion != mpCurrentRequestVersion) return
	mpClearRenderTimer()
	mpCompletionPending = false
	mpActive = false
	mpFinished = true
}

export const destroyAiWorkerRuntime: DestroyAiWorkerRuntime = function (): void {
	mpClearRenderTimer()
	mpRuntimeGeneration += 1
	mpRuntimeCreated = false
	mpMarkdownReady = false
	mpCompletionPending = false
	mpActive = false
	mpFinished = true
	mpLatestSnapshotJson = ''
	mpCurrentRequestVersion = 0
}
// #endif
