export type AiWorkerStartOptions = {
	requestVersion: number,
	provider: string,
	model: string,
	url: string,
	authorization: string,
	bodyJson: string,
	renderInterval?: number,
	timeout?: number
}

export type AiWorkerDemoStartOptions = {
	requestVersion: number,
	scenarioId: string,
	renderInterval?: number,
	streamInterval?: number,
	batchSize?: number,
	blockInterval?: number
}

export type AiWorkerMarkdownStartOptions = {
	requestVersion: number,
	renderInterval?: number
}
