export type AiWorkerStartOptions = {
	requestVersion: number,
	provider: string,
	model: string,
	url: string,
	authorization: string,
	bodyJson: string,
	renderInterval?: number,
	timeout?: number
}

export type AiWorkerMarkdownStartOptions = {
	requestVersion: number,
	renderInterval?: number
}

export type CreateAiWorkerRuntime = () => void
export type StartAiWorkerRequest = (options: AiWorkerStartOptions) => void
export type StartAiWorkerMarkdown = (options: AiWorkerMarkdownStartOptions) => void
export type AppendAiWorkerMarkdown = (
	requestVersion: number,
	content: string,
	reasoningContent: string
) => void
export type CompleteAiWorkerMarkdown = (requestVersion: number) => void
export type ReadAiWorkerSnapshot = () => string
export type ReadAiWorkerState = () => UTSJSONObject | null
export type AiWorkerOp = {
	op: number,
	kind: string,
	content: string,
	index: number,
	unchanged: boolean
}
export type TakeAiWorkerOps = () => AiWorkerOp[]
export type IsLibmarkOpsSupported = () => boolean
export type CancelAiWorkerRequest = (requestVersion: number) => void
export type DestroyAiWorkerRuntime = () => void
export type AiWorkerDataListener = () => void
export type SetAiWorkerDataListener = (listener: AiWorkerDataListener | null) => void

// 页面冷启动恢复历史消息：请求 Worker 用 libmark 从原文重建渲染 ops
export type AiWorkerRebuildRequest = {
	msgId: string,
	content: string
}
export type AiWorkerRebuildResult = {
	msgId: string,
	ops: AiWorkerOp[]
}
export type AiWorkerRebuildListener = (result: AiWorkerRebuildResult) => void
export type RequestAiWorkerMarkdownRebuild = (msgId: string, content: string) => void
export type SetAiWorkerRebuildListener = (listener: AiWorkerRebuildListener | null) => void
