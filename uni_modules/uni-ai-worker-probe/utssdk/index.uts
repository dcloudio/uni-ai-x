import {
	WorkerProbeErrorOptions,
	WorkerProbeErrorSuccess,
	WorkerProbeMessageOptions,
	WorkerProbeMessageSuccess,
	WorkerProbeSendOptions
} from './interface.uts'

export * from './interface.uts'

let worker: Worker | null = null
let messageOptions: WorkerProbeMessageOptions | null = null
let errorOptions: WorkerProbeErrorOptions | null = null
let currentScenario = ''
let latestSnapshotJson = ''

export function createWorkerProbe(): void {
	destroyWorkerProbe()
	latestSnapshotJson = ''
	worker = uni.createWorker('workers/markdownWorkerTask.uts')
}

export function onWorkerProbeMessage(options: WorkerProbeMessageOptions): void {
	if (worker == null) return
	messageOptions = options
	worker!.onMessage((message: any) => {
		const result = message as UTSJSONObject
		const phase = result.getString('phase', '')
		if (currentScenario == 'render-descriptions' && phase.indexOf('render-descriptions') == 0) {
			console.log('[WorkerCapabilityRepro] plugin-message', phase,
				result.getNumber('snapshotVersion', 0),
				result.getNumber('descriptionCount', result.getNumber('extendedDescriptionCount', 0)))
		} else {
			console.log('[WorkerCapabilityRepro] plugin-message', JSON.stringify(message))
		}
		if ((currentScenario == 'full-chain' &&
			(phase == 'full-chain-snapshot' || phase == 'full-chain-success' || phase == 'full-chain-fail')) ||
			(currentScenario == 'render-descriptions' && phase.indexOf('render-descriptions') == 0) ||
			(currentScenario == 'cancel-restart' && phase.indexOf('cancel-restart') == 0) ||
			(currentScenario == 'real-ai' && phase.indexOf('real-ai') == 0)) {
			latestSnapshotJson = JSON.stringify(result) ?? ''
		}
		const isTerminal = currentScenario == 'local'
			? phase == 'local'
			: currentScenario == 'sse-fragments'
				? phase == 'sse-fragments-success' || phase == 'sse-fragments-fail'
			: currentScenario == 'stream-core'
				? phase == 'stream-core-success' || phase == 'stream-core-fail'
			: currentScenario == 'full-chain'
				? phase == 'full-chain-success' || phase == 'full-chain-fail'
			: currentScenario == 'render-descriptions'
				? phase == 'render-descriptions-success' || phase == 'render-descriptions-fail'
			: currentScenario == 'cancel-restart'
				? phase == 'cancel-restart-success' || phase == 'cancel-restart-fail'
			: currentScenario == 'real-ai'
				? phase == 'real-ai-success' || phase == 'real-ai-fail'
			: currentScenario == 'cmark'
				? phase == 'cmark-success' || phase == 'cmark-fail'
				: phase == 'request-success' || phase == 'request-fail'
		if (!isTerminal) return
		if (messageOptions?.success == null) return
		const event: WorkerProbeMessageSuccess = {
			result: result
		}
		messageOptions!.success!(event)
		messageOptions = null
	})
}

export function readWorkerProbeSnapshot(): string {
	return latestSnapshotJson
}

export function onWorkerProbeError(options: WorkerProbeErrorOptions): void {
	if (worker == null) return
	errorOptions = options
	worker!.onError((_error: any) => {
		if (errorOptions?.success == null) return
		const event: WorkerProbeErrorSuccess = {
			message: 'worker error'
		}
		errorOptions!.success!(event)
	})
}

export function sendWorkerProbeMessage(options: WorkerProbeSendOptions): void {
	if (worker == null) return
	currentScenario = options.scenario
	const message = new UTSJSONObject()
	message.action = options.command ?? options.scenario
	message.scenario = options.scenario
	message.sentAt = options.sentAt ?? 0
	message.provider = options.provider ?? ''
	message.model = options.model ?? ''
	message.url = options.url ?? ''
	message.authorization = options.authorization ?? ''
	message.bodyJson = options.bodyJson ?? ''
	message.requireReasoning = options.requireReasoning ?? false
	message.minContentLength = options.minContentLength ?? 0
	console.log('[WorkerCapabilityRepro] plugin-post', options.scenario, message.action)
	worker!.postMessage(message, null)
}

export function destroyWorkerProbe(): void {
	worker?.terminate()
	worker = null
	messageOptions = null
	errorOptions = null
	currentScenario = ''
	latestSnapshotJson = ''
}
