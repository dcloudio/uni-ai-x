export type WorkerProbeMessageSuccess = {
	result: UTSJSONObject
}

export type WorkerProbeMessageCallback = (event: WorkerProbeMessageSuccess) => void

export type WorkerProbeMessageOptions = {
	success?: WorkerProbeMessageCallback
}

export type WorkerProbeErrorSuccess = {
	message: string
}

export type WorkerProbeErrorCallback = (event: WorkerProbeErrorSuccess) => void

export type WorkerProbeErrorOptions = {
	success?: WorkerProbeErrorCallback
}

export type WorkerProbeSendOptions = {
	scenario: string,
	command?: string,
	sentAt?: number,
	provider?: string,
	model?: string,
	url?: string,
	authorization?: string,
	bodyJson?: string,
	requireReasoning?: boolean,
	minContentLength?: number
}
