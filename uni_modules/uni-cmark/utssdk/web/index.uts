// @ts-ignore
import createCmarkGfmModule from './cmark-gfm-md2html.mjs'

type Md2htmlFunction = (markdown: string, markdownLength: number, htmlLengthPointer: number) => number

type CmarkGfmModule = {
	cwrap: (name: string, returnType: string, argumentTypes: string[]) => Md2htmlFunction,
	UTF8ToString: (pointer: number) => string,
	_uni_cmark_free_html: (pointer: number) => void
}

let cmarkModule: CmarkGfmModule | null = null
let convertMarkdown: Md2htmlFunction | null = null
let initialization: Promise<void> | null = null

function utf8ByteLength(text: string): number {
	let length = 0
	for (let index = 0; index < text.length; index++) {
		const code = text.charCodeAt(index)
		if (code < 0x80) {
			length += 1
		} else if (code < 0x800) {
			length += 2
		} else if (code >= 0xd800 && code <= 0xdbff && index + 1 < text.length) {
			const next = text.charCodeAt(index + 1)
			if (next >= 0xdc00 && next <= 0xdfff) {
				length += 4
				index += 1
			} else {
				length += 3
			}
		} else {
			length += 3
		}
	}
	return length
}

export function initMd2html(): Promise<void> {
	if (cmarkModule != null && convertMarkdown != null) return Promise.resolve()
	if (initialization != null) return initialization!
	// @ts-ignore
	initialization = createCmarkGfmModule().then((module: CmarkGfmModule) => {
		cmarkModule = module
		convertMarkdown = module.cwrap(
			'uni_cmark_markdown_to_html',
			'number',
			['string', 'number', 'number']
		)
	})
	return initialization!
}

export function isMd2htmlAvailable(): boolean {
	return cmarkModule != null && convertMarkdown != null
}

export function md2html(markdown: string): string {
	if (cmarkModule == null || convertMarkdown == null) {
		throw new Error('cmark-gfm WebAssembly module is not initialized')
	}
	const htmlPointer = convertMarkdown!(markdown, utf8ByteLength(markdown), 0)
	if (htmlPointer == 0) throw new Error('cmark-gfm failed to convert Markdown to HTML')
	try {
		return cmarkModule!.UTF8ToString(htmlPointer)
	} finally {
		cmarkModule!._uni_cmark_free_html(htmlPointer)
	}
}
