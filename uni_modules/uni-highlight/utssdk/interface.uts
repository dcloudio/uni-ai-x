/**
 * interface.uts
 * uts插件接口定义文件，按规范定义接口文件可以在HBuilderX中更好的做到语法提示
 */
// #ifdef APP-IOS
// iOS returns data records across the native/JS bridge, not NSObject instances.
export type IToken = {
  startIndex: number
  endIndex: number
  scopes: string[]
}

export type ILineTokens = {
  tokens: IToken[]
}
// #endif

// #ifndef APP-IOS
export class IToken {
  readonly startIndex: number;
  readonly endIndex: number;
  readonly scopes: string[];

  constructor(startIndex: number, endIndex: number, scopes: string[]) {
    this.startIndex = startIndex;
    this.endIndex = endIndex;
    this.scopes = scopes;
  }
}
// #endif


export type AndroidToken = {
	start: number,
	end: number,
	token: string
}


// export interface ILineTokens{
// 	readonly tokens: IToken[],
// 	state:any
// }

// #ifndef APP-IOS
export class ILineTokens {
  constructor(readonly tokens: IToken[]) {}
}
// #endif

export type HighLighterOptions = {
	languages: UTSJSONObject
}


export type CreateHighLighter = (options: HighLighterOptions) => Promise<CreateHighLighterRes>


export type CreateHighLighterRes = {
	tokenizeLines(sessionId: string, langId: string, lines: string[], reset: boolean): Promise<ILineTokens[]>
	releaseSession(sessionId: string): void
	tokenizeFullText(langId: string, fullCodeText:string): Promise<ILineTokens[]>
	tokenizeLine(langId: string, lineText: string, state: any): Promise<ILineTokens | null>
}
