// Default mini-program API. The full WeChat build temporarily replaces this
// file with index-textmate.uts and stages its Oniguruma WASM via build-mp-weixin.mjs.
import basicHighlighter from './basic-code-tokenizer.js'

export interface IToken {
	readonly startIndex: number
	readonly endIndex: number
	readonly scopes: string[]
}

export interface ILineTokens {
	readonly tokens: IToken[]
	state: any
}

export type HighLighterOptions = {
	languages: Record<string, any>
}

export type CreateHighLighterRes = {
	tokenizeLines(sessionId: string, langId: string, lines: string[], reset: boolean): Promise<ILineTokens[]>
	releaseSession(sessionId: string): void
	tokenizeFullText(langId: string, fullCodeText: string): Promise<ILineTokens[]>
	tokenizeLine(langId: string, lineText: string, state: any): Promise<ILineTokens | null>
}

function tokenize(source: string, language: string): ILineTokens[] {
	const rows = basicHighlighter.tokenizeCode(source, language) as { text: string, className: string }[][]
	return rows.map((row: { text: string, className: string }[]) => {
		let offset = 0
		const tokens = row.map((part: { text: string, className: string }) => {
			const startIndex = offset
			offset += part.text.length
			return { startIndex, endIndex: offset, scopes: part.className == '' ? [] : [part.className] } as IToken
		})
		return { tokens, state: null } as ILineTokens
	})
}

export async function createHighLighter(_options: HighLighterOptions): Promise<CreateHighLighterRes> {
	return {
		releaseSession(_sessionId: string): void {},
		async tokenizeLines(_sessionId: string, langId: string, lines: string[], _reset: boolean): Promise<ILineTokens[]> {
			return tokenize(lines.join('\n'), langId)
		},
		async tokenizeFullText(langId: string, fullCodeText: string): Promise<ILineTokens[]> {
			return tokenize(fullCodeText, langId)
		},
		async tokenizeLine(langId: string, lineText: string, _state: any): Promise<ILineTokens | null> {
			return tokenize(lineText, langId)[0]
		}
	}
}
