<template>
	<view class="page">
		<text class="title">生产 Worker 七牛回归</text>
		<text class="description">验证生产 RequestAiRunner 的取消隔离、流式解析和最终富化。</text>
		<text class="status">{{status}}</text>
		<text class="summary">{{summary}}</text>
		<scroll-view class="result-list" direction="vertical" :show-scrollbar="true">
			<text v-for="(item, index) in results" :key="index" class="result-line">{{item}}</text>
		</scroll-view>
		<web-view class="proxy-web" id="proxy-web" src="/uni_modules/uni-ai-x/static/proxy-web/proxy-web.html" @message="proxyWebMsg"></web-view>
	</view>
</template>

<script lang="uts" setup>
	import RequestAiRunner, { RequestAiRunnerCallbacks } from '@/uni_modules/uni-ai-x/sdk/requestAiRunner.uts'
	import proxyWeb from '@/uni_modules/uni-ai-x/sdk/proxy-web.uts'
	import { Llm, RequestAiCoMessage } from '@/uni_modules/uni-ai-x/types.uts'
	import { MarkdownToken } from '@/uni_modules/uni-cmark/utssdk/interface.uts'

	const CASE_TIMEOUT = 120000
	const status = ref('准备自动测试')
	const summary = ref('等待开始')
	const results = ref<string[]>([])
	const llm: Llm = {
		provider: 'qiniu',
		model: 'deepseek-v3',
		webSearch: false
	}
	const cancelPrompt = '只输出一篇至少 1500 个中文字符的 Markdown 长文，包含多个标题、列表和表格，不要解释。'
	const completePrompt = '只输出 Markdown，不要解释，也不要用代码围栏包住整篇文档。生成一篇 1200 到 1800 个中文字符的移动端渲染测试文档，依次包含二级标题、普通段落、无序列表、有序列表、任务列表、引用、三列表格、JavaScript 代码块、行内公式 $a^2+b^2=c^2$ 和块级公式 $$\\int_0^1 x^2 dx=\\frac{1}{3}$$。只有 JavaScript 示例使用代码围栏，内容必须完整，不要省略。'

	let runnerA: RequestAiRunner | null = null
	let runnerB: RequestAiRunner | null = null
	let timeoutId: number = 0
	let startedAt = 0
	let cancelIssued = false
	let lateCallbacksA = 0
	let lastTokenCount = 0
	let finalTokens: MarkdownToken[] = [] as MarkdownToken[]
	let completedSeen = false
	let finishedTest = false

	function appendResult(label: string, detail: string) {
		const line = label + ' | ' + (Date.now() - startedAt).toString() + 'ms | ' + detail
		results.value.push(line)
		console.log('[WorkerRealAiRepro]', line)
	}

	function countTokens(tokenList: MarkdownToken[], type: string, lang: string = ''): number {
		let count = 0
		for (let i = 0; i < tokenList.length; i++) {
			const token = tokenList[i]
			if ((token.type ?? '') == type && (lang.length == 0 || (token.lang ?? '') == lang)) count += 1
			count += countTokens(token.tokens ?? [] as MarkdownToken[], type, lang)
			count += countTokens(token.items ?? [] as MarkdownToken[], type, lang)
		}
		return count
	}

	function countRenderedMath(tokenList: MarkdownToken[]): number {
		let count = 0
		for (let i = 0; i < tokenList.length; i++) {
			const token = tokenList[i]
			if ((token.type ?? '') == 'code_block' && (token.lang ?? '') == 'math' && (token.href ?? '').length > 0) count += 1
			count += countRenderedMath(token.tokens ?? [] as MarkdownToken[])
			count += countRenderedMath(token.items ?? [] as MarkdownToken[])
		}
		return count
	}

	function countHighlightedCode(tokenList: MarkdownToken[]): number {
		let count = 0
		for (let i = 0; i < tokenList.length; i++) {
			const token = tokenList[i]
			if ((token.type ?? '') == 'code_block' && (token.lang ?? '') == 'javascript' && (token.codeTokens?.length ?? 0) > 0) count += 1
			count += countHighlightedCode(token.tokens ?? [] as MarkdownToken[])
			count += countHighlightedCode(token.items ?? [] as MarkdownToken[])
		}
		return count
	}

	function evaluateCompletion() {
		if (!completedSeen || finishedTest) return
		const typeNames = ['heading', 'list', 'block_quote', 'table', 'code_block']
		const missingTypes: string[] = []
		for (let i = 0; i < typeNames.length; i++) {
			if (countTokens(finalTokens, typeNames[i]) == 0) missingTypes.push(typeNames[i])
		}
		const mathCount = countTokens(finalTokens, 'code_block', 'math')
		const renderedMathCount = countRenderedMath(finalTokens)
		const highlightedCodeCount = countHighlightedCode(finalTokens)
		if (renderedMathCount < 2 || highlightedCodeCount < 1) {
			status.value = '等待公式 SVG 与代码高亮'
			return
		}
		const passed = finalTokens.length > 0 && missingTypes.length == 0 && mathCount >= 2 && lateCallbacksA == 0
		finish(passed, 'tokens=' + finalTokens.length.toString() +
			' math=' + mathCount.toString() +
			' renderedMath=' + renderedMathCount.toString() +
			' highlightedCode=' + highlightedCodeCount.toString() +
			' missing=' + missingTypes.join(',') +
			' lateA=' + lateCallbacksA.toString())
	}

	function finish(passed: boolean, detail: string) {
		if (finishedTest) return
		finishedTest = true
		if (timeoutId != 0) clearTimeout(timeoutId)
		timeoutId = 0
		status.value = passed ? '全部完成' : '测试失败'
		summary.value = detail
		appendResult('final', (passed ? 'gate-success ' : 'gate-fail ') + detail)
	}

	function startRequestB() {
		status.value = '请求 B：生产完整链路'
		appendResult('request-B', 'start')
		const callbacks: RequestAiRunnerCallbacks = {
			onMarkdownElList: (tokenList: MarkdownToken[]) => {
				finalTokens = tokenList
				if (tokenList.length != lastTokenCount) {
					lastTokenCount = tokenList.length
					appendResult('request-B', 'render-tokens=' + tokenList.length.toString())
				}
				evaluateCompletion()
			},
			onThinkContent: (_thinkContent: string) => {},
			onMsgBody: (msgBody: string) => {
				status.value = '请求 B：已接收 ' + msgBody.length.toString() + ' 字符'
			},
			onState: (nextState: string) => {
				if (nextState != 'completed') return
				completedSeen = true
				evaluateCompletion()
			},
			onErrorMsg: (errorMsg: string) => {
				finish(false, 'request-B error=' + errorMsg)
			},
			onRendered: (_rendered: boolean) => {},
			onChatTitle: (_title: string) => {}
		}
		runnerB = new RequestAiRunner(callbacks)
		const messages = [{ role: 'user', content: completePrompt }] as RequestAiCoMessage[]
		runnerB!.requestRemoteAi(messages, llm, 'worker-production-repro-b')
	}

	function startRequestA() {
		status.value = '请求 A：等待首批内容后取消'
		appendResult('request-A', 'start')
		const callbacks: RequestAiRunnerCallbacks = {
			onMarkdownElList: (_tokenList: MarkdownToken[]) => {
				if (cancelIssued) lateCallbacksA += 1
			},
			onThinkContent: (_thinkContent: string) => {
				if (cancelIssued) lateCallbacksA += 1
			},
			onMsgBody: (msgBody: string) => {
				if (cancelIssued) {
					lateCallbacksA += 1
					return
				}
				if (msgBody.length == 0) return
				cancelIssued = true
				appendResult('request-A', 'cancel content=' + msgBody.length.toString())
				runnerA?.abortRequest()
				setTimeout(() => { startRequestB() }, 50)
			},
			onState: (nextState: string) => {
				if (cancelIssued && nextState != 'stop') lateCallbacksA += 1
			},
			onErrorMsg: (errorMsg: string) => {
				if (!cancelIssued) finish(false, 'request-A error=' + errorMsg)
			},
			onRendered: (_rendered: boolean) => {
				if (cancelIssued) lateCallbacksA += 1
			},
			onChatTitle: (_title: string) => {}
		}
		runnerA = new RequestAiRunner(callbacks)
		const messages = [{ role: 'user', content: cancelPrompt }] as RequestAiCoMessage[]
		runnerA!.requestRemoteAi(messages, llm, 'worker-production-repro-a')
	}

	function runAll() {
		startedAt = Date.now()
		results.value = []
		cancelIssued = false
		lateCallbacksA = 0
		lastTokenCount = 0
		finalTokens = [] as MarkdownToken[]
		completedSeen = false
		finishedTest = false
		status.value = '开始测试'
		summary.value = '临时令牌仅保存在内存中'
		timeoutId = setTimeout(() => {
			finish(false, 'host-timeout limit=' + CASE_TIMEOUT.toString())
		}, CASE_TIMEOUT)
		startRequestA()
	}

	function proxyWebMsg(event: UniWebViewMessageEvent) {
		proxyWeb.onWebMsg(event)
	}

	onMounted(() => {
		// #ifdef APP
		const proxyWebContext = uni.getElementById('proxy-web')
		proxyWeb.init(proxyWebContext!)
		// #endif
		setTimeout(() => { runAll() }, 800)
	})

	onUnmounted(() => {
		if (timeoutId != 0) clearTimeout(timeoutId)
		runnerA?.abortRequest()
		runnerB?.abortRequest()
	})
</script>

<style>
.page {
	flex: 1;
	padding: 24px 20px;
	background-color: #f5f6f7;
}

.title {
	font-size: 22px;
	font-weight: 700;
	color: #1f2328;
}

.description,
.summary {
	margin-top: 8px;
	font-size: 13px;
	line-height: 20px;
	color: #59636e;
}

.status {
	margin-top: 18px;
	font-size: 16px;
	font-weight: 600;
	color: #0969da;
}

.result-list {
	flex: 1;
	margin-top: 14px;
	padding: 12px;
	border-width: 1px;
	border-style: solid;
	border-color: #d0d7de;
	background-color: #ffffff;
}

.result-line {
	margin-bottom: 8px;
	font-size: 12px;
	line-height: 18px;
	color: #1f2328;
}

.proxy-web {
	width: 0;
	height: 0;
	opacity: 0;
}
</style>
