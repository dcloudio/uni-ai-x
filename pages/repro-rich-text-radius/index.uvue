<template>
	<view class="page">
		<text class="title">RichText 圆角裁剪最小复现</text>
		<text class="description">每组只改变父容器是否 flatten；绿色描边是应生效的裁剪边界。</text>

		<text class="case-title">1. 非 flatten + RichText（对照）</text>
		<view class="clip-host">
			<rich-text class="rich-fill" :nodes="richTextNodes" mode="native"></rich-text>
		</view>

		<text class="case-title">2. flatten 父容器 + RichText</text>
		<view class="clip-host" flatten>
			<rich-text class="rich-fill" :nodes="richTextNodes" mode="native"></rich-text>
		</view>

		<text class="case-title">3. 非 flatten + ScrollView + 宽 RichText（对照）</text>
		<view class="clip-host">
			<scroll-view class="rich-scroll" direction="horizontal">
				<rich-text class="wide-rich-fill" :nodes="wideRichTextNodes" mode="native"></rich-text>
			</scroll-view>
		</view>

		<text class="case-title">4. flatten + ScrollView + 宽 RichText</text>
		<view class="clip-host" flatten>
			<scroll-view class="rich-scroll" direction="horizontal">
				<rich-text class="wide-rich-fill" :nodes="wideRichTextNodes" mode="native"></rich-text>
			</scroll-view>
		</view>

		<text class="case-title">5. flatten + 子级/节点 CSS 圆角</text>
		<view class="clip-host" flatten>
			<scroll-view class="rich-scroll rich-scroll-rounded" direction="horizontal">
				<rich-text class="wide-rich-fill wide-rich-fill-rounded" :nodes="wideRoundedNode" mode="native"></rich-text>
			</scroll-view>
		</view>
	</view>
</template>

<script lang="uts" setup>
	const contentStyle = 'height:72px;padding:20px 16px;box-sizing:border-box;background-color:#e5484d;color:#ffffff;font-size:16px;line-height:24px;'
	const richTextNodes = '<div style="' + contentStyle + '">原生 RichText</div>'
	const wideContentStyle = 'width:560px;' + contentStyle
	const wideRichTextNodes = '<div style="' + wideContentStyle + '">ScrollView 内的宽 RichText</div>'
	const wideRoundedNode = '<div style="' + wideContentStyle + 'border-radius:17px;overflow:hidden;">ScrollView 与 RichText CSS 圆角</div>'
</script>

