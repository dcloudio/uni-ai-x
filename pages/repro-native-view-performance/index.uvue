<template>
	<view class="page">
		<view class="header">
			<text class="title">原生 View 追加性能复现</text>
			<text class="phase">{{phaseLabel}}</text>
		</view>

		<view class="toolbar">
			<button class="command" size="mini" :disabled="isRunning" @click="runSequence">重跑对照</button>
			<button class="command" size="mini" :disabled="isRunning" @click="runNativeOnly">仅追加 RichText</button>
			<button class="stop-command" size="mini" :disabled="!isRunning" @click="stopTest">停止</button>
		</view>

		<view class="metrics">
			<text class="metric-title">每 100ms 追加普通文本 View</text>
			<text class="metric-value">{{plainResult}}</text>
			<text class="metric-title metric-gap">每 100ms 追加原生 RichText</text>
			<text class="metric-value">{{nativeResult}}</text>
		</view>

		<view class="list-header">
			<text class="list-title">当前挂载节点</text>
			<text class="list-count">{{plainItems.length + nativeItems.length}}</text>
		</view>
		<scroll-view class="test-list" direction="vertical" :show-scrollbar="true">
			<view v-for="item in plainItems" :key="'plain-' + item" class="plain-row">
				<text class="plain-text">Plain View {{item}}：固定文本用于追加和布局对照。</text>
			</view>
			<rich-text v-for="item in nativeItems" :key="'native-' + item.id" class="native-row"
				:nodes="item.nodes" mode="native"></rich-text>
		</scroll-view>

		<text class="scope-note">已有节点不会更新；两阶段只追加新节点。</text>
	</view>
</template>

<script lang="uts" setup>
	type NativeItem = {
		id: number
		nodes: string
	}

	const TEST_DURATION = 5000
	const APPEND_INTERVAL = 100
	const PREPARE_DELAY = 800

	const phaseLabel = ref('准备自动测试')
	const plainResult = ref('等待运行')
	const nativeResult = ref('等待运行')
	const isRunning = ref(false)
	const plainItems = ref<number[]>([])
	const nativeItems = ref<NativeItem[]>([])

	let intervalId: number | null = null
	let phaseTimerId: number | null = null
	let animationId = -1
	let runVersion = 0
	let sampleActive = false
	let sampleFirstFrame = 0
	let sampleLastFrame = 0
	let sampleFrameCount = 0
	let sampleMaxDelta = 0
	let sampleOver16 = 0
	let sampleOver32 = 0

	function buildNodes(index: number): string {
		return `<div style="width:100%;padding:10px 12px;box-sizing:border-box;background-color:#ffffff;color:#1f2328;font-size:16px;line-height:24px;"><strong>Native RichText ${index}</strong><p>Static Markdown-like paragraph for native view creation and layout measurement.</p><p>Each block is mounted once and never receives another nodes update.</p></div>`
	}

	function resetSample() {
		sampleFirstFrame = 0
		sampleLastFrame = 0
		sampleFrameCount = 0
		sampleMaxDelta = 0
		sampleOver16 = 0
		sampleOver32 = 0
	}

	let trackFrame = (timestamp: number) => {}
	trackFrame = (timestamp: number) => {
		if (sampleActive) {
			if (sampleFirstFrame == 0) {
				sampleFirstFrame = timestamp
			} else {
				const delta = timestamp - sampleLastFrame
				sampleMaxDelta = Math.max(sampleMaxDelta, delta)
				if (delta > 16.7) sampleOver16++
				if (delta > 32) sampleOver32++
			}
			sampleLastFrame = timestamp
			sampleFrameCount++
		}
		animationId = requestAnimationFrame(trackFrame)
	}

	function formatResult(appendCount: number): string {
		const duration = Math.max(1, sampleLastFrame - sampleFirstFrame)
		const fps = sampleFrameCount * 1000 / duration
		return `${appendCount} 次 | ${fps.toFixed(1)} FPS | max ${sampleMaxDelta.toFixed(1)}ms | >16.7ms ${sampleOver16} | >32ms ${sampleOver32}`
	}

	function clearPhaseTasks() {
		if (intervalId != null) {
			clearInterval(intervalId!)
			intervalId = null
		}
		if (phaseTimerId != null) {
			clearTimeout(phaseTimerId!)
			phaseTimerId = null
		}
		sampleActive = false
	}

	function preparePhase(label: string, version: number, start: () => void) {
		clearPhaseTasks()
		phaseLabel.value = `${label}：准备`
		phaseTimerId = setTimeout(() => {
			if (version != runVersion) return
			resetSample()
			sampleActive = true
			phaseLabel.value = `${label}：运行中`
			start()
		}, PREPARE_DELAY)
	}

	function runPlainPhase(version: number, continueSequence: boolean) {
		plainItems.value = []
		nativeItems.value = []
		preparePhase('追加普通 View', version, () => {
			let appendCount = 0
			console.log('[NativeViewPerfRepro] plain-start')
			intervalId = setInterval(() => {
				appendCount++
				plainItems.value.push(appendCount)
			}, APPEND_INTERVAL)
			phaseTimerId = setTimeout(() => {
				if (version != runVersion) return
				clearPhaseTasks()
				plainResult.value = formatResult(appendCount)
				console.log('[NativeViewPerfRepro] plain', plainResult.value)
				if (continueSequence) {
					runNativePhase(version)
				} else {
					finishSequence()
				}
			}, TEST_DURATION)
		})
	}

	function runNativePhase(version: number) {
		plainItems.value = []
		nativeItems.value = []
		preparePhase('追加原生 RichText', version, () => {
			let appendCount = 0
			console.log('[NativeViewPerfRepro] native-start')
			intervalId = setInterval(() => {
				appendCount++
				nativeItems.value.push({
					id: appendCount,
					nodes: buildNodes(appendCount)
				} as NativeItem)
			}, APPEND_INTERVAL)
			phaseTimerId = setTimeout(() => {
				if (version != runVersion) return
				clearPhaseTasks()
				nativeResult.value = formatResult(appendCount)
				console.log('[NativeViewPerfRepro] native', nativeResult.value)
				finishSequence()
			}, TEST_DURATION)
		})
	}

	function finishSequence() {
		isRunning.value = false
		phaseLabel.value = '测试完成'
	}

	function stopTest() {
		runVersion++
		clearPhaseTasks()
		isRunning.value = false
		phaseLabel.value = '已停止'
	}

	function runSequence() {
		stopTest()
		const version = runVersion
		isRunning.value = true
		plainResult.value = '运行中'
		nativeResult.value = '等待运行'
		runPlainPhase(version, true)
	}

	function runNativeOnly() {
		stopTest()
		const version = runVersion
		isRunning.value = true
		nativeResult.value = '运行中'
		runNativePhase(version)
	}

	onMounted(() => {
		animationId = requestAnimationFrame(trackFrame)
		phaseTimerId = setTimeout(() => {
			runSequence()
		}, 800)
	})

	onUnmounted(() => {
		stopTest()
		if (animationId != -1) {
			cancelAnimationFrame(animationId)
			animationId = -1
		}
	})
</script>

<style>
.page {
	flex: 1;
	padding: 20px;
	background-color: #f5f6f7;
}

.header {
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.title {
	font-size: 20px;
	font-weight: 700;
	color: #1f2328;
}

.phase {
	font-size: 13px;
	color: #0969da;
}

.toolbar {
	margin-top: 14px;
	flex-direction: row;
	align-items: center;
}

.command,
.stop-command {
	margin-left: 0;
	margin-right: 10px;
	border-radius: 4px;
	font-size: 13px;
}

.stop-command {
	color: #b42318;
}

.metrics {
	margin-top: 14px;
	padding: 12px;
	border-width: 1px;
	border-style: solid;
	border-color: #d0d7de;
	background-color: #ffffff;
}

.metric-title {
	font-size: 13px;
	font-weight: 600;
	color: #57606a;
}

.metric-gap {
	margin-top: 10px;
}

.metric-value {
	margin-top: 3px;
	font-size: 14px;
	line-height: 20px;
	color: #1f2328;
}

.list-header {
	margin-top: 14px;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.list-title,
.list-count {
	font-size: 13px;
	font-weight: 600;
	color: #57606a;
}

.test-list {
	margin-top: 6px;
	width: 100%;
	height: 410px;
	border-width: 1px;
	border-style: solid;
	border-color: #8c959f;
	background-color: #ffffff;
}

.plain-row {
	min-height: 88px;
	padding: 10px 12px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #d8dee4;
	background-color: #ffffff;
}

.plain-text {
	font-size: 16px;
	line-height: 24px;
	color: #1f2328;
}

.native-row {
	width: 100%;
	min-height: 112px;
	border-bottom-width: 1px;
	border-bottom-style: solid;
	border-bottom-color: #d8dee4;
	background-color: #ffffff;
}

.scope-note {
	margin-top: 10px;
	font-size: 13px;
	color: #57606a;
}
</style>
