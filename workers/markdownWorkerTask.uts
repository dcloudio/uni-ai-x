// #ifdef APP-ANDROID
import { md2json } from '../uni_modules/uni-cmark/utssdk/app-android/index.uts'
import { ParseMdRes } from '../uni_modules/uni-cmark/utssdk/interface.uts'
// #endif
import { SSEStreamDecoder } from '../uni_modules/uni-ai-worker/utssdk/index.uts'
import { WorkerStreamRequest } from '../uni_modules/uni-ai-worker/utssdk/index.uts'

type WorkerAiDelta = {
	content?: string,
	reasoning_content?: string
}

type WorkerAiChoice = {
	delta?: WorkerAiDelta
}

type WorkerAiChunk = {
	choices?: WorkerAiChoice[]
}

export class MarkdownWorkerTask extends WorkerTaskImpl {
	private requestTask: RequestTask | null = null
	private decoder: TextDecoder = new TextDecoder()
	private chunkCount = 0
	private decodedLength = 0
	private streamRequest : WorkerStreamRequest | null = null
	private restartRequestA : WorkerStreamRequest | null = null
	private restartRequestB : WorkerStreamRequest | null = null
	private restartScenarioActive = false
	private restartFinished = false
	private restartStartedAt = 0
	private restartIssuedAt = 0
	private restartControlSentAt = 0
	private restartBStartedAt = 0
	private restartSnapshotVersion = 0
	private restartAEventCount = 0
	private restartAEventCountAtCancel = 0
	private restartALateEventCount = 0
	private restartALateTerminalCount = 0
	private restartBEventCount = 0
	private restartBNetworkChunkCount = 0
	private restartBReceivedBytes = 0
	private restartBContents : string[] = []
	private restartObservationTimer : number | null = null

	constructor() {
		super()
	}

	override entry() {
		console.log('[WorkerCapabilityRepro] worker-entry')
		setTimeout(() => {
			console.log('[WorkerCapabilityRepro] worker-ready-post')
			const ready = new UTSJSONObject()
			ready.phase = 'worker-ready'
			this.postMessage(ready)
			console.log('[WorkerCapabilityRepro] worker-ready-post-return')
		}, 50)
	}

	override onMessage(message: any) {
		const payload = message as UTSJSONObject
		const action = payload.getString('action', '')
		console.log('[WorkerCapabilityRepro] worker-message', action)
		if (action == 'restart-request') {
			this.restartWithRequestB(payload.getNumber('sentAt', 0))
			return
		}
		if (action == 'cancel') {
			this.requestTask?.abort()
			this.streamRequest?.abort()
			this.restartRequestA?.abort()
			this.restartRequestB?.abort()
			if (this.restartObservationTimer != null) clearTimeout(this.restartObservationTimer!)
			this.requestTask = null
			this.streamRequest = null
			this.restartRequestA = null
			this.restartRequestB = null
			this.restartObservationTimer = null
			this.restartScenarioActive = false
			return
		}
		if (action != 'local' && action != 'request' && action != 'stream' && action != 'cmark' && action != 'sse-fragments' && action != 'stream-core' && action != 'full-chain' && action != 'cancel-restart' && action != 'real-ai') return

		const received = new UTSJSONObject()
		received.scenario = action
		received.phase = 'message-received'
		this.postMessage(received)
		console.log('[WorkerCapabilityRepro] worker-message-post-return', action)

		console.log('[WorkerCapabilityRepro] worker-decode-start', action)
		const bytes = new Uint8Array([87, 111, 114, 107, 101, 114])
		const decoded = this.decoder.decode(bytes.buffer!)
		console.log('[WorkerCapabilityRepro] worker-decode-return', action, decoded)
		const localResult = new UTSJSONObject()
		localResult.scenario = action
		localResult.phase = 'local'
		localResult.textDecoder = decoded
		this.postMessage(localResult)
		console.log('[WorkerCapabilityRepro] worker-local-post-return', action)
		if (action == 'local') return

		if (action == 'sse-fragments') {
			this.runSSEFragmentScenario(action)
			return
		}
		if (action == 'stream-core') {
			this.runStreamCoreScenario(action)
			return
		}
		if (action == 'full-chain') {
			// #ifdef APP-ANDROID
			this.runFullChainScenario(action)
			return
			// #endif
		}
		if (action == 'cancel-restart') {
			this.runCancelRestartScenario(action)
			return
		}
		if (action == 'real-ai') {
			// #ifdef APP-ANDROID
			this.runRealAiScenario(action, payload)
			return
			// #endif
		}

		if (action == 'cmark') {
			// #ifdef APP-ANDROID
			const parseResult = md2json('# Worker CMark\n\n- first\n- second') as ParseMdRes
			const tokenCount = parseResult.data.length
			const firstType = tokenCount > 0 ? parseResult.data[0].type ?? '' : ''
			this.postMessage({
				scenario: action,
				phase: parseResult.errorMsg.length == 0 ? 'cmark-success' : 'cmark-fail',
				tokenCount: tokenCount,
				firstType: firstType,
				detail: parseResult.errorMsg
			} as UTSJSONObject)
			return
			// #endif
		}

		this.postMessage({
			scenario: action,
			phase: 'request-call-start'
		} as UTSJSONObject)
		setTimeout(() => {
			this.postMessage({
				scenario: action,
				phase: 'worker-watchdog',
				chunkCount: this.chunkCount,
				decodedLength: this.decodedLength
			} as UTSJSONObject)
		}, 5000)

		if (action == 'request') {
			this.requestTask = uni.request({
				url: 'https://request.dcloud.net.cn/api/http/method/get',
				method: 'GET',
				timeout: 8000,
				success: (_response) => {
					this.postMessage({ scenario: action, phase: 'request-success' } as UTSJSONObject)
				},
				fail: (error) => {
					this.postMessage({
						scenario: action,
						phase: 'request-fail',
						detail: error.errMsg
					} as UTSJSONObject)
				},
				complete: () => {
					this.requestTask = null
				}
			})
			this.postMessage({ scenario: action, phase: 'request-created' } as UTSJSONObject)
			return
		}

		this.requestTask = uni.request({
			url: 'https://request.dcloud.net.cn/api/http/contentType/eventStream?limit=3',
			method: 'POST',
			enableChunked: true,
			timeout: 8000,
			success: (_response) => {
				this.postMessage({
					scenario: action,
					phase: 'request-success',
					chunkCount: this.chunkCount,
					decodedLength: this.decodedLength
				} as UTSJSONObject)
			},
			fail: (error) => {
				this.postMessage({
					scenario: action,
					phase: 'request-fail',
					detail: error.errMsg
				} as UTSJSONObject)
			},
			complete: () => {
				this.requestTask = null
			}
		})
		this.postMessage({ scenario: action, phase: 'request-created' } as UTSJSONObject)
		this.requestTask!.onChunkReceived((chunk: RequestTaskOnChunkReceivedListenerResult) => {
			const chunkText = this.decoder.decode(chunk.data)
			this.chunkCount += 1
			this.decodedLength += chunkText.length
			this.postMessage({
				scenario: action,
				phase: 'chunk',
				chunkCount: this.chunkCount,
				decodedLength: this.decodedLength
			} as UTSJSONObject)
		})
	}

	private runSSEFragmentScenario(action : string) : void {
		const source = new Uint8Array([
			58, 32, 107, 101, 101, 112, 97, 108, 105, 118, 101, 13, 10,
			100, 97, 116, 97, 58, 32, 123, 34, 99, 111, 110, 116, 101, 110, 116, 34, 58, 34,
			231, 172, 172, 228, 184, 128, 230, 157, 161, 34, 125, 13, 10, 13, 10,
			100, 97, 116, 97, 58, 32, 123, 34, 99, 111, 110, 116, 101, 110, 116, 34, 58, 34,
			231, 172, 172, 228, 186, 140, 230, 157, 161, 34, 125, 10, 10,
			100, 97, 116, 97, 58, 32, 91, 68, 79, 78, 69, 93, 13, 10, 13, 10
		])
		const fragmentSizes = [4, 8, 3, 17, 3, 10, 3, 18, 11, 15, 1]
		const events : string[] = []
		let doneCount = 0
		const streamDecoder = new SSEStreamDecoder(
			(data : string) => { events.push(data) },
			() => { doneCount += 1 }
		)
		let offset = 0
		fragmentSizes.forEach((size : number) => {
			streamDecoder.push(source.slice(offset, offset + size).buffer! as ArrayBuffer)
			offset += size
		})
		streamDecoder.finish()

		const finishEvents : string[] = []
		const finishDecoder = new SSEStreamDecoder(
			(data : string) => { finishEvents.push(data) },
			() => {}
		)
		finishDecoder.push(new Uint8Array([100, 97, 116, 97, 58, 32, 116, 97, 105, 108]).buffer! as ArrayBuffer)
		finishDecoder.finish()

		const multilineEvents : string[] = []
		const multilineDecoder = new SSEStreamDecoder(
			(data : string) => { multilineEvents.push(data) },
			() => {}
		)
		multilineDecoder.push(new Uint8Array([
			100, 97, 116, 97, 58, 32, 102, 105, 114, 115, 116, 10,
			100, 97, 116, 97, 58, 32, 115, 101, 99, 111, 110, 100, 10, 10
		]).buffer! as ArrayBuffer)
		multilineDecoder.finish()

		const firstExpected = '{"content":"第一条"}'
		const secondExpected = '{"content":"第二条"}'
		const passed = offset == source.length &&
			events.length == 2 && events[0] == firstExpected && events[1] == secondExpected &&
			doneCount == 1 && streamDecoder.eventCount() == 2 && streamDecoder.doneCount() == 1 &&
			streamDecoder.pendingByteLength() == 0 && streamDecoder.pendingTextLength() == 0 &&
			finishEvents.length == 1 && finishEvents[0] == 'tail' &&
			multilineEvents.length == 1 && multilineEvents[0] == 'first\nsecond'
		this.postMessage({
			scenario: action,
			phase: passed ? 'sse-fragments-success' : 'sse-fragments-fail',
			fragmentSizes: fragmentSizes.join(','),
			sourceBytes: source.length,
			eventCount: events.length,
			firstEvent: events.length > 0 ? events[0] : '',
			secondEvent: events.length > 1 ? events[1] : '',
			doneCount: doneCount,
			pendingBytes: streamDecoder.pendingByteLength(),
			pendingText: streamDecoder.pendingTextLength(),
			finishEvent: finishEvents.length > 0 ? finishEvents[0] : '',
			multilineEvent: multilineEvents.length > 0 ? multilineEvents[0] : ''
		} as UTSJSONObject)
	}

	private runStreamCoreScenario(action : string) : void {
		const startedAt = Date.now()
		const events : string[] = []
		this.streamRequest = new WorkerStreamRequest(
			(data : string) => {
				events.push(data)
			},
			(code : string, message : string) => {
				this.postMessage({
					scenario: action,
					phase: 'stream-core-fail',
					code: code,
					detail: message,
					elapsed: Date.now() - startedAt,
					eventCount: events.length
				} as UTSJSONObject)
				this.streamRequest = null
			},
			(source : string, networkChunkCount : number, receivedBytes : number) => {
				let firstContent = ''
				let lastContent = ''
				if (events.length > 0) {
					firstContent = (JSON.parse<UTSJSONObject>(events[0]) as UTSJSONObject).getString('content', '')
					lastContent = (JSON.parse<UTSJSONObject>(events[events.length - 1]) as UTSJSONObject).getString('content', '')
				}
				const passed = events.length == 3 && networkChunkCount == 3 && receivedBytes == 177 &&
					firstContent == '这是第1条消息' && lastContent == '这是第3条消息'
				this.postMessage({
					scenario: action,
					phase: passed ? 'stream-core-success' : 'stream-core-fail',
					elapsed: Date.now() - startedAt,
					terminalSource: source,
					networkChunkCount: networkChunkCount,
					receivedBytes: receivedBytes,
					eventCount: events.length,
					firstContent: firstContent,
					lastContent: lastContent
				} as UTSJSONObject)
				this.streamRequest = null
			}
		)
		this.streamRequest!.start(
			'https://request.dcloud.net.cn/api/http/contentType/eventStream?limit=3',
			'',
			'{}',
			8000
		)
	}

	private runCancelRestartScenario(action : string) : void {
		this.restartRequestA?.abort()
		this.restartRequestB?.abort()
		if (this.restartObservationTimer != null) clearTimeout(this.restartObservationTimer!)
		this.restartRequestA = null
		this.restartRequestB = null
		this.restartObservationTimer = null
		this.restartScenarioActive = true
		this.restartFinished = false
		this.restartStartedAt = Date.now()
		this.restartIssuedAt = 0
		this.restartControlSentAt = 0
		this.restartBStartedAt = 0
		this.restartSnapshotVersion = 0
		this.restartAEventCount = 0
		this.restartAEventCountAtCancel = 0
		this.restartALateEventCount = 0
		this.restartALateTerminalCount = 0
		this.restartBEventCount = 0
		this.restartBNetworkChunkCount = 0
		this.restartBReceivedBytes = 0
		this.restartBContents = []

		this.restartRequestA = new WorkerStreamRequest(
			(data : string) => {
				this.restartAEventCount += 1
				if (this.restartIssuedAt > 0) this.restartALateEventCount += 1
				this.postRestartSnapshot(action, 'A', this.restartAEventCount, this.readEventContent(data))
			},
			(code : string, message : string) => {
				if (this.restartIssuedAt > 0) {
					this.restartALateTerminalCount += 1
					return
				}
				this.finishCancelRestart(action, false, 'request A failed before restart: ' + code + ' ' + message)
			},
			(_source : string, _networkChunkCount : number, _receivedBytes : number) => {
				if (this.restartIssuedAt > 0) {
					this.restartALateTerminalCount += 1
					return
				}
				this.finishCancelRestart(action, false, 'request A completed before restart')
			}
		)
		this.restartRequestA!.start(
			'https://request.dcloud.net.cn/api/http/contentType/eventStream?limit=6',
			'',
			'{}',
			12000
		)
	}

	private restartWithRequestB(controlSentAt : number) : void {
		if (!this.restartScenarioActive || this.restartFinished || this.restartIssuedAt > 0) return
		if (this.restartAEventCount == 0) {
			this.finishCancelRestart('cancel-restart', false, 'restart arrived before request A produced data')
			return
		}

		this.restartControlSentAt = controlSentAt
		this.restartIssuedAt = Date.now()
		this.restartAEventCountAtCancel = this.restartAEventCount
		this.restartRequestA?.abort()
		this.restartBStartedAt = Date.now()
		this.postMessage({
			scenario: 'cancel-restart',
			phase: 'cancel-restart-issued',
			aEventCountAtCancel: this.restartAEventCountAtCancel,
			controlDeliveryMs: controlSentAt > 0 ? this.restartIssuedAt - controlSentAt : -1,
			restartDelayMs: this.restartBStartedAt - this.restartIssuedAt
		} as UTSJSONObject)

		this.restartRequestB = new WorkerStreamRequest(
			(data : string) => {
				this.restartBEventCount += 1
				const content = this.readEventContent(data)
				this.restartBContents.push(content)
				this.postRestartSnapshot('cancel-restart', 'B', this.restartBEventCount, content)
			},
			(code : string, message : string) => {
				this.finishCancelRestart('cancel-restart', false, 'request B failed: ' + code + ' ' + message)
			},
			(_source : string, networkChunkCount : number, receivedBytes : number) => {
				this.restartBNetworkChunkCount = networkChunkCount
				this.restartBReceivedBytes = receivedBytes
				this.postMessage({
					scenario: 'cancel-restart',
					phase: 'cancel-restart-observing',
					observationWindowMs: 1500,
					bEventCount: this.restartBEventCount
				} as UTSJSONObject)
				this.restartObservationTimer = setTimeout(() => {
					this.restartObservationTimer = null
					const passed = this.restartAEventCountAtCancel >= 1 &&
						this.restartALateEventCount == 0 && this.restartALateTerminalCount == 0 &&
						this.restartBEventCount == 3 && this.restartBNetworkChunkCount == 3 &&
						this.restartBReceivedBytes == 177 && this.restartBContents.join('|') ==
							'这是第1条消息|这是第2条消息|这是第3条消息'
					this.finishCancelRestart('cancel-restart', passed,
						passed ? '' : 'cancel/restart assertions failed')
				}, 1500)
			}
		)
		this.restartRequestB!.start(
			'https://request.dcloud.net.cn/api/http/contentType/eventStream?limit=3',
			'',
			'{}',
			8000
		)
	}

	private postRestartSnapshot(action : string, requestId : string, requestEventCount : number, content : string) : void {
		this.restartSnapshotVersion += 1
		this.postMessage({
			scenario: action,
			phase: 'cancel-restart-snapshot',
			snapshotVersion: this.restartSnapshotVersion,
			requestId: requestId,
			requestEventCount: requestEventCount,
			content: content,
			afterRestart: this.restartIssuedAt > 0,
			elapsed: Date.now() - this.restartStartedAt
		} as UTSJSONObject)
	}

	private finishCancelRestart(action : string, passed : boolean, detail : string) : void {
		if (this.restartFinished) return
		this.restartFinished = true
		this.restartScenarioActive = false
		if (this.restartObservationTimer != null) clearTimeout(this.restartObservationTimer!)
		this.restartObservationTimer = null
		this.restartRequestA?.abort()
		this.restartRequestB?.abort()
		this.postMessage({
			scenario: action,
			phase: passed ? 'cancel-restart-success' : 'cancel-restart-fail',
			detail: detail,
			elapsed: Date.now() - this.restartStartedAt,
			restartIssued: this.restartIssuedAt > 0,
			aEventCount: this.restartAEventCount,
			aEventCountAtCancel: this.restartAEventCountAtCancel,
			aLateEventCount: this.restartALateEventCount,
			aLateTerminalCount: this.restartALateTerminalCount,
			bEventCount: this.restartBEventCount,
			bNetworkChunkCount: this.restartBNetworkChunkCount,
			bReceivedBytes: this.restartBReceivedBytes,
			bContents: this.restartBContents.join('|'),
			controlDeliveryMs: this.restartControlSentAt > 0 ? this.restartIssuedAt - this.restartControlSentAt : -1,
			restartDelayMs: this.restartBStartedAt > 0 ? this.restartBStartedAt - this.restartIssuedAt : -1,
			observationWindowMs: 1500
		} as UTSJSONObject)
		this.restartRequestA = null
		this.restartRequestB = null
	}

	private readEventContent(data : string) : string {
		try {
			return (JSON.parse<UTSJSONObject>(data) as UTSJSONObject).getString('content', '')
		} catch (_error) {
			return ''
		}
	}

	// #ifdef APP-ANDROID
	private runRealAiScenario(action : string, payload : UTSJSONObject) : void {
		const startedAt = Date.now()
		const provider = payload.getString('provider', '')
		const model = payload.getString('model', '')
		const url = payload.getString('url', '')
		const authorization = payload.getString('authorization', '')
		const bodyJson = payload.getString('bodyJson', '')
		const requireReasoning = payload.getBoolean('requireReasoning', false)
		const minContentLength = payload.getNumber('minContentLength', 0)
		if (provider.length == 0 || model.length == 0 || url.length == 0 ||
			authorization.length == 0 || bodyJson.length == 0) {
			this.postMessage({
				scenario: action,
				phase: 'real-ai-fail',
				provider: provider,
				model: model,
				detail: 'missing real AI request parameter'
			} as UTSJSONObject)
			return
		}

		let content = ''
		let reasoningContent = ''
		let eventCount = 0
		let contentEventCount = 0
		let reasoningEventCount = 0
		let emptyEventCount = 0
		let snapshotCount = 0
		let lastSnapshotContentLength = 0
		let tokenCount = 0
		let tokenTypes = ''
		let parseError = ''
		let finished = false

		const emitSnapshot = (force : boolean) : void => {
			if (content.length == 0) return
			if (!force && content.length - lastSnapshotContentLength < 256) return
			const parseResult = md2json(content) as ParseMdRes
			tokenCount = parseResult.data.length
			parseError = parseResult.errorMsg
			const types : string[] = []
			parseResult.data.forEach((token) => {
				types.push(token.type ?? '')
			})
			tokenTypes = types.join(',')
			lastSnapshotContentLength = content.length
			snapshotCount += 1
			this.postMessage({
				scenario: action,
				phase: 'real-ai-snapshot',
				provider: provider,
				model: model,
				snapshotVersion: snapshotCount,
				contentLength: content.length,
				reasoningLength: reasoningContent.length,
				tokenCount: tokenCount,
				tokenTypes: tokenTypes,
				parseError: parseError,
				elapsed: Date.now() - startedAt
			} as UTSJSONObject)
		}

		const failScenario = (detail : string) : void => {
			if (finished) return
			finished = true
			this.streamRequest?.abort()
			this.postMessage({
				scenario: action,
				phase: 'real-ai-fail',
				provider: provider,
				model: model,
				detail: detail,
				elapsed: Date.now() - startedAt,
				eventCount: eventCount,
				contentEventCount: contentEventCount,
				reasoningEventCount: reasoningEventCount,
				contentLength: content.length,
				reasoningLength: reasoningContent.length,
				snapshotCount: snapshotCount
			} as UTSJSONObject)
			this.streamRequest = null
		}

		this.streamRequest = new WorkerStreamRequest(
			(data : string) => {
				if (finished) return
				let raw : UTSJSONObject
				let chunk : WorkerAiChunk
				try {
					raw = JSON.parse<UTSJSONObject>(data) as UTSJSONObject
					chunk = JSON.parse<WorkerAiChunk>(data) as WorkerAiChunk
				} catch (_error) {
					failScenario('AI SSE JSON parse failed')
					return
				}
				const error = raw.getJSON('error')
				if (error != null) {
					failScenario('provider error: ' + error.getString('code', 'unknown') + ' ' +
						error.getString('message', 'unknown'))
					return
				}
				eventCount += 1
				const contentDelta = chunk.choices?.[0]?.delta?.content ?? ''
				const reasoningDelta = chunk.choices?.[0]?.delta?.reasoning_content ?? ''
				if (contentDelta.length > 0) {
					content += contentDelta
					contentEventCount += 1
				}
				if (reasoningDelta.length > 0) {
					reasoningContent += reasoningDelta
					reasoningEventCount += 1
				}
				if (contentDelta.length == 0 && reasoningDelta.length == 0) emptyEventCount += 1
				emitSnapshot(false)
			},
			(code : string, message : string) => {
				failScenario('request failed: ' + code + ' ' + message)
			},
			(source : string, networkChunkCount : number, receivedBytes : number) => {
				if (finished) return
				emitSnapshot(true)
				const passed = source == 'done-sentinel' && eventCount > 0 &&
					content.length >= minContentLength && tokenCount > 0 && parseError.length == 0 &&
					(!requireReasoning || reasoningContent.length > 0)
				finished = true
				this.postMessage({
					scenario: action,
					phase: passed ? 'real-ai-success' : 'real-ai-fail',
					provider: provider,
					model: model,
					detail: passed ? '' : 'real AI assertions failed',
					elapsed: Date.now() - startedAt,
					terminalSource: source,
					networkChunkCount: networkChunkCount,
					receivedBytes: receivedBytes,
					eventCount: eventCount,
					contentEventCount: contentEventCount,
					reasoningEventCount: reasoningEventCount,
					emptyEventCount: emptyEventCount,
					contentLength: content.length,
					reasoningLength: reasoningContent.length,
					snapshotCount: snapshotCount,
					tokenCount: tokenCount,
					tokenTypes: tokenTypes,
					parseError: parseError,
					contentPreview: content.substring(0, Math.min(120, content.length)),
					contentTail: content.substring(Math.max(0, content.length - 120)),
					reasoningPreview: reasoningContent.substring(0, Math.min(80, reasoningContent.length))
				} as UTSJSONObject)
				this.streamRequest = null
			}
		)
		this.streamRequest!.start(url, authorization, bodyJson, 90000)
	}
	// #endif

	// #ifdef APP-ANDROID
	private runFullChainScenario(action : string) : void {
		const startedAt = Date.now()
		let markdownText = ''
		let eventCount = 0
		let snapshotCount = 0
		let firstContent = ''
		let lastContent = ''
		let tokenCount = 0
		let descriptionCount = 0
		let descriptionJson = '[]'
		let descriptionKeys = ''
		let stableKeys = true
		let previousKeys : string[] = []

		this.streamRequest = new WorkerStreamRequest(
			(data : string) => {
				let content = ''
				try {
					content = (JSON.parse<UTSJSONObject>(data) as UTSJSONObject).getString('content', '')
				} catch (error) {
					this.postMessage({
						scenario: action,
						phase: 'full-chain-fail',
						detail: 'event JSON parse failed',
						elapsed: Date.now() - startedAt
					} as UTSJSONObject)
					this.streamRequest?.abort()
					this.streamRequest = null
					return
				}
				if (content.length == 0) return
				eventCount += 1
				if (firstContent.length == 0) firstContent = content
				lastContent = content
				markdownText += '## ' + content + '\n\n'

				const parseResult = md2json(markdownText) as ParseMdRes
				const descriptions : UTSJSONObject[] = []
				const currentKeys : string[] = []
				parseResult.data.forEach((token, index : number) => {
					const tokenType = token.type ?? ''
					const key = index.toString() + ':' + tokenType
					currentKeys.push(key)
					descriptions.push({
						key: key,
						kind: tokenType == 'image' ? 'image' : 'rich',
						tokenType: tokenType
					} as UTSJSONObject)
				})
				for (let index = 0; index < previousKeys.length; index++) {
					if (index >= currentKeys.length || previousKeys[index] != currentKeys[index]) {
						stableKeys = false
						break
					}
				}
				previousKeys = currentKeys
				tokenCount = parseResult.data.length
				descriptionCount = descriptions.length
				descriptionJson = JSON.stringify(descriptions)
				descriptionKeys = currentKeys.join(',')
				snapshotCount += 1
				this.postMessage({
					scenario: action,
					phase: 'full-chain-snapshot',
					snapshotVersion: snapshotCount,
					eventCount: eventCount,
					markdownLength: markdownText.length,
					tokenCount: tokenCount,
					descriptionCount: descriptionCount,
					descriptionKeys: descriptionKeys,
					descriptionJson: descriptionJson,
					stableKeys: stableKeys
				} as UTSJSONObject)
			},
			(code : string, message : string) => {
				this.postMessage({
					scenario: action,
					phase: 'full-chain-fail',
					code: code,
					detail: message,
					elapsed: Date.now() - startedAt,
					eventCount: eventCount,
					snapshotCount: snapshotCount
				} as UTSJSONObject)
				this.streamRequest = null
			},
			(source : string, networkChunkCount : number, receivedBytes : number) => {
				const expectedKeys = '0:heading,1:heading,2:heading,3:heading,4:heading,5:heading'
				const passed = eventCount == 6 && snapshotCount == 6 && tokenCount == 6 &&
					descriptionCount == 6 && stableKeys && descriptionKeys == expectedKeys &&
					firstContent == '这是第1条消息' && lastContent == '这是第6条消息'
				this.postMessage({
					scenario: action,
					phase: passed ? 'full-chain-success' : 'full-chain-fail',
					elapsed: Date.now() - startedAt,
					terminalSource: source,
					networkChunkCount: networkChunkCount,
					receivedBytes: receivedBytes,
					eventCount: eventCount,
					snapshotCount: snapshotCount,
					markdownLength: markdownText.length,
					tokenCount: tokenCount,
					descriptionCount: descriptionCount,
					descriptionKeys: descriptionKeys,
					descriptionJson: descriptionJson,
					stableKeys: stableKeys,
					firstContent: firstContent,
					lastContent: lastContent
				} as UTSJSONObject)
				this.streamRequest = null
			}
		)
		this.streamRequest!.start(
			'https://request.dcloud.net.cn/api/http/contentType/eventStream?limit=6',
			'',
			'{}',
			12000
		)
	}
	// #endif
}
