// #ifdef APP-ANDROID
import { md2json } from '../uni_modules/uni-cmark/utssdk/app-android/index.uts'
import { ParseMdRes } from '../uni_modules/uni-cmark/utssdk/interface.uts'
// #endif
import { SSEStreamDecoder } from '../uni_modules/uni-ai-worker/utssdk/index.uts'
import { WorkerStreamRequest } from '../uni_modules/uni-ai-worker/utssdk/index.uts'

export class MarkdownWorkerTask extends WorkerTaskImpl {
	private requestTask: RequestTask | null = null
	private decoder: TextDecoder = new TextDecoder()
	private chunkCount = 0
	private decodedLength = 0
	private streamRequest : WorkerStreamRequest | null = null

	constructor() {
		super()
	}

	override entry() {
		console.log('[WorkerCapabilityRepro] worker-entry')
		setTimeout(() => {
			console.log('[WorkerCapabilityRepro] worker-ready-post')
			const ready = new UTSJSONObject()
			ready.phase = 'worker-ready'
			this.postMessage(ready)
			console.log('[WorkerCapabilityRepro] worker-ready-post-return')
		}, 50)
	}

	override onMessage(message: any) {
		const action = (message as UTSJSONObject).getString('action', '')
		console.log('[WorkerCapabilityRepro] worker-message', action)
		if (action == 'cancel') {
			this.requestTask?.abort()
			this.streamRequest?.abort()
			this.requestTask = null
			this.streamRequest = null
			return
		}
		if (action != 'local' && action != 'request' && action != 'stream' && action != 'cmark' && action != 'sse-fragments' && action != 'stream-core' && action != 'full-chain') return

		const received = new UTSJSONObject()
		received.scenario = action
		received.phase = 'message-received'
		this.postMessage(received)
		console.log('[WorkerCapabilityRepro] worker-message-post-return', action)

		console.log('[WorkerCapabilityRepro] worker-decode-start', action)
		const bytes = new Uint8Array([87, 111, 114, 107, 101, 114])
		const decoded = this.decoder.decode(bytes.buffer!)
		console.log('[WorkerCapabilityRepro] worker-decode-return', action, decoded)
		const localResult = new UTSJSONObject()
		localResult.scenario = action
		localResult.phase = 'local'
		localResult.textDecoder = decoded
		this.postMessage(localResult)
		console.log('[WorkerCapabilityRepro] worker-local-post-return', action)
		if (action == 'local') return

		if (action == 'sse-fragments') {
			this.runSSEFragmentScenario(action)
			return
		}
		if (action == 'stream-core') {
			this.runStreamCoreScenario(action)
			return
		}
		if (action == 'full-chain') {
			// #ifdef APP-ANDROID
			this.runFullChainScenario(action)
			return
			// #endif
		}

		if (action == 'cmark') {
			// #ifdef APP-ANDROID
			const parseResult = md2json('# Worker CMark\n\n- first\n- second') as ParseMdRes
			const tokenCount = parseResult.data.length
			const firstType = tokenCount > 0 ? parseResult.data[0].type ?? '' : ''
			this.postMessage({
				scenario: action,
				phase: parseResult.errorMsg.length == 0 ? 'cmark-success' : 'cmark-fail',
				tokenCount: tokenCount,
				firstType: firstType,
				detail: parseResult.errorMsg
			} as UTSJSONObject)
			return
			// #endif
		}

		this.postMessage({
			scenario: action,
			phase: 'request-call-start'
		} as UTSJSONObject)
		setTimeout(() => {
			this.postMessage({
				scenario: action,
				phase: 'worker-watchdog',
				chunkCount: this.chunkCount,
				decodedLength: this.decodedLength
			} as UTSJSONObject)
		}, 5000)

		if (action == 'request') {
			this.requestTask = uni.request({
				url: 'https://request.dcloud.net.cn/api/http/method/get',
				method: 'GET',
				timeout: 8000,
				success: (_response) => {
					this.postMessage({ scenario: action, phase: 'request-success' } as UTSJSONObject)
				},
				fail: (error) => {
					this.postMessage({
						scenario: action,
						phase: 'request-fail',
						detail: error.errMsg
					} as UTSJSONObject)
				},
				complete: () => {
					this.requestTask = null
				}
			})
			this.postMessage({ scenario: action, phase: 'request-created' } as UTSJSONObject)
			return
		}

		this.requestTask = uni.request({
			url: 'https://request.dcloud.net.cn/api/http/contentType/eventStream?limit=3',
			method: 'POST',
			enableChunked: true,
			timeout: 8000,
			success: (_response) => {
				this.postMessage({
					scenario: action,
					phase: 'request-success',
					chunkCount: this.chunkCount,
					decodedLength: this.decodedLength
				} as UTSJSONObject)
			},
			fail: (error) => {
				this.postMessage({
					scenario: action,
					phase: 'request-fail',
					detail: error.errMsg
				} as UTSJSONObject)
			},
			complete: () => {
				this.requestTask = null
			}
		})
		this.postMessage({ scenario: action, phase: 'request-created' } as UTSJSONObject)
		this.requestTask!.onChunkReceived((chunk: RequestTaskOnChunkReceivedListenerResult) => {
			const chunkText = this.decoder.decode(chunk.data)
			this.chunkCount += 1
			this.decodedLength += chunkText.length
			this.postMessage({
				scenario: action,
				phase: 'chunk',
				chunkCount: this.chunkCount,
				decodedLength: this.decodedLength
			} as UTSJSONObject)
		})
	}

	private runSSEFragmentScenario(action : string) : void {
		const source = new Uint8Array([
			58, 32, 107, 101, 101, 112, 97, 108, 105, 118, 101, 13, 10,
			100, 97, 116, 97, 58, 32, 123, 34, 99, 111, 110, 116, 101, 110, 116, 34, 58, 34,
			231, 172, 172, 228, 184, 128, 230, 157, 161, 34, 125, 13, 10, 13, 10,
			100, 97, 116, 97, 58, 32, 123, 34, 99, 111, 110, 116, 101, 110, 116, 34, 58, 34,
			231, 172, 172, 228, 186, 140, 230, 157, 161, 34, 125, 10, 10,
			100, 97, 116, 97, 58, 32, 91, 68, 79, 78, 69, 93, 13, 10, 13, 10
		])
		const fragmentSizes = [4, 8, 3, 17, 3, 10, 3, 18, 11, 15, 1]
		const events : string[] = []
		let doneCount = 0
		const streamDecoder = new SSEStreamDecoder(
			(data : string) => { events.push(data) },
			() => { doneCount += 1 }
		)
		let offset = 0
		fragmentSizes.forEach((size : number) => {
			streamDecoder.push(source.slice(offset, offset + size).buffer! as ArrayBuffer)
			offset += size
		})
		streamDecoder.finish()

		const finishEvents : string[] = []
		const finishDecoder = new SSEStreamDecoder(
			(data : string) => { finishEvents.push(data) },
			() => {}
		)
		finishDecoder.push(new Uint8Array([100, 97, 116, 97, 58, 32, 116, 97, 105, 108]).buffer! as ArrayBuffer)
		finishDecoder.finish()

		const multilineEvents : string[] = []
		const multilineDecoder = new SSEStreamDecoder(
			(data : string) => { multilineEvents.push(data) },
			() => {}
		)
		multilineDecoder.push(new Uint8Array([
			100, 97, 116, 97, 58, 32, 102, 105, 114, 115, 116, 10,
			100, 97, 116, 97, 58, 32, 115, 101, 99, 111, 110, 100, 10, 10
		]).buffer! as ArrayBuffer)
		multilineDecoder.finish()

		const firstExpected = '{"content":"第一条"}'
		const secondExpected = '{"content":"第二条"}'
		const passed = offset == source.length &&
			events.length == 2 && events[0] == firstExpected && events[1] == secondExpected &&
			doneCount == 1 && streamDecoder.eventCount() == 2 && streamDecoder.doneCount() == 1 &&
			streamDecoder.pendingByteLength() == 0 && streamDecoder.pendingTextLength() == 0 &&
			finishEvents.length == 1 && finishEvents[0] == 'tail' &&
			multilineEvents.length == 1 && multilineEvents[0] == 'first\nsecond'
		this.postMessage({
			scenario: action,
			phase: passed ? 'sse-fragments-success' : 'sse-fragments-fail',
			fragmentSizes: fragmentSizes.join(','),
			sourceBytes: source.length,
			eventCount: events.length,
			firstEvent: events.length > 0 ? events[0] : '',
			secondEvent: events.length > 1 ? events[1] : '',
			doneCount: doneCount,
			pendingBytes: streamDecoder.pendingByteLength(),
			pendingText: streamDecoder.pendingTextLength(),
			finishEvent: finishEvents.length > 0 ? finishEvents[0] : '',
			multilineEvent: multilineEvents.length > 0 ? multilineEvents[0] : ''
		} as UTSJSONObject)
	}

	private runStreamCoreScenario(action : string) : void {
		const startedAt = Date.now()
		const events : string[] = []
		this.streamRequest = new WorkerStreamRequest(
			(data : string) => {
				events.push(data)
			},
			(code : string, message : string) => {
				this.postMessage({
					scenario: action,
					phase: 'stream-core-fail',
					code: code,
					detail: message,
					elapsed: Date.now() - startedAt,
					eventCount: events.length
				} as UTSJSONObject)
				this.streamRequest = null
			},
			(source : string, networkChunkCount : number, receivedBytes : number) => {
				let firstContent = ''
				let lastContent = ''
				if (events.length > 0) {
					firstContent = (JSON.parse<UTSJSONObject>(events[0]) as UTSJSONObject).getString('content', '')
					lastContent = (JSON.parse<UTSJSONObject>(events[events.length - 1]) as UTSJSONObject).getString('content', '')
				}
				const passed = events.length == 3 && networkChunkCount == 3 && receivedBytes == 177 &&
					firstContent == '这是第1条消息' && lastContent == '这是第3条消息'
				this.postMessage({
					scenario: action,
					phase: passed ? 'stream-core-success' : 'stream-core-fail',
					elapsed: Date.now() - startedAt,
					terminalSource: source,
					networkChunkCount: networkChunkCount,
					receivedBytes: receivedBytes,
					eventCount: events.length,
					firstContent: firstContent,
					lastContent: lastContent
				} as UTSJSONObject)
				this.streamRequest = null
			}
		)
		this.streamRequest!.start(
			'https://request.dcloud.net.cn/api/http/contentType/eventStream?limit=3',
			'',
			'{}',
			8000
		)
	}

	// #ifdef APP-ANDROID
	private runFullChainScenario(action : string) : void {
		const startedAt = Date.now()
		let markdownText = ''
		let eventCount = 0
		let snapshotCount = 0
		let firstContent = ''
		let lastContent = ''
		let tokenCount = 0
		let descriptionCount = 0
		let descriptionJson = '[]'
		let descriptionKeys = ''
		let stableKeys = true
		let previousKeys : string[] = []

		this.streamRequest = new WorkerStreamRequest(
			(data : string) => {
				let content = ''
				try {
					content = (JSON.parse<UTSJSONObject>(data) as UTSJSONObject).getString('content', '')
				} catch (error) {
					this.postMessage({
						scenario: action,
						phase: 'full-chain-fail',
						detail: 'event JSON parse failed',
						elapsed: Date.now() - startedAt
					} as UTSJSONObject)
					this.streamRequest?.abort()
					this.streamRequest = null
					return
				}
				if (content.length == 0) return
				eventCount += 1
				if (firstContent.length == 0) firstContent = content
				lastContent = content
				markdownText += '## ' + content + '\n\n'

				const parseResult = md2json(markdownText) as ParseMdRes
				const descriptions : UTSJSONObject[] = []
				const currentKeys : string[] = []
				parseResult.data.forEach((token, index : number) => {
					const tokenType = token.type ?? ''
					const key = index.toString() + ':' + tokenType
					currentKeys.push(key)
					descriptions.push({
						key: key,
						kind: tokenType == 'image' ? 'image' : 'rich',
						tokenType: tokenType
					} as UTSJSONObject)
				})
				for (let index = 0; index < previousKeys.length; index++) {
					if (index >= currentKeys.length || previousKeys[index] != currentKeys[index]) {
						stableKeys = false
						break
					}
				}
				previousKeys = currentKeys
				tokenCount = parseResult.data.length
				descriptionCount = descriptions.length
				descriptionJson = JSON.stringify(descriptions)
				descriptionKeys = currentKeys.join(',')
				snapshotCount += 1
				this.postMessage({
					scenario: action,
					phase: 'full-chain-snapshot',
					snapshotVersion: snapshotCount,
					eventCount: eventCount,
					markdownLength: markdownText.length,
					tokenCount: tokenCount,
					descriptionCount: descriptionCount,
					descriptionKeys: descriptionKeys,
					descriptionJson: descriptionJson,
					stableKeys: stableKeys
				} as UTSJSONObject)
			},
			(code : string, message : string) => {
				this.postMessage({
					scenario: action,
					phase: 'full-chain-fail',
					code: code,
					detail: message,
					elapsed: Date.now() - startedAt,
					eventCount: eventCount,
					snapshotCount: snapshotCount
				} as UTSJSONObject)
				this.streamRequest = null
			},
			(source : string, networkChunkCount : number, receivedBytes : number) => {
				const expectedKeys = '0:heading,1:heading,2:heading,3:heading,4:heading,5:heading'
				const passed = eventCount == 6 && snapshotCount == 6 && tokenCount == 6 &&
					descriptionCount == 6 && stableKeys && descriptionKeys == expectedKeys &&
					firstContent == '这是第1条消息' && lastContent == '这是第6条消息'
				this.postMessage({
					scenario: action,
					phase: passed ? 'full-chain-success' : 'full-chain-fail',
					elapsed: Date.now() - startedAt,
					terminalSource: source,
					networkChunkCount: networkChunkCount,
					receivedBytes: receivedBytes,
					eventCount: eventCount,
					snapshotCount: snapshotCount,
					markdownLength: markdownText.length,
					tokenCount: tokenCount,
					descriptionCount: descriptionCount,
					descriptionKeys: descriptionKeys,
					descriptionJson: descriptionJson,
					stableKeys: stableKeys,
					firstContent: firstContent,
					lastContent: lastContent
				} as UTSJSONObject)
				this.streamRequest = null
			}
		)
		this.streamRequest!.start(
			'https://request.dcloud.net.cn/api/http/contentType/eventStream?limit=6',
			'',
			'{}',
			12000
		)
	}
	// #endif
}
