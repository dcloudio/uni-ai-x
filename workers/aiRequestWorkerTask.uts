// #ifdef APP-ANDROID
import { isMd2htmlAvailable, md2html } from '../uni_modules/uni-cmark/utssdk/app-android/index.uts'
// #endif
import {
	createDemoMarkdownBlock,
	MarkdownPreprocessor,
	WorkerStreamRequest
} from '../uni_modules/uni-ai-worker/utssdk/index.uts'

type WorkerAiDelta = {
	content?: string,
	reasoning_content?: string
}

type WorkerAiChoice = {
	delta?: WorkerAiDelta
}

type WorkerAiChunk = {
	choices?: WorkerAiChoice[]
}

export class AiRequestWorkerTask extends WorkerTaskImpl {
	private streamRequest: WorkerStreamRequest | null = null
	private renderTimer: number = 0
	private requestVersion: number = 0
	private snapshotVersion: number = 0
	private renderInterval: number = 300
	private startedAt: number = 0
	private content: string = ''
	private reasoningContent: string = ''
	private hasThinkContent: boolean = false
	private eventCount: number = 0
	private networkChunkCount: number = 0
	private receivedBytes: number = 0
	private terminalSource: string = ''
	private finished: boolean = false
	private preprocessor: MarkdownPreprocessor = new MarkdownPreprocessor()
	private demoStreamTimer: number = 0
	private demoScenarioId: string = ''
	private demoStreamInterval: number = 100
	private demoBatchSize: number = 10
	private demoBlockInterval: number = 300
	private demoBlockText: string = ''
	private demoBlockOffset: number = 0
	private demoBlockIndex: number = 0
	private demoBlockCount: number = 0
	private demoNextBlockAt: number = 0

	constructor() {
		super()
	}

	override entry() {
		this.postMessage({ phase: 'ready' } as UTSJSONObject)
	}

	override onMessage(message: any) {
		const payload = message as UTSJSONObject
		const action = payload.getString('action', '')
		if (action == 'cancel') {
			if (payload.getNumber('requestVersion', 0) == this.requestVersion) this.cancelCurrent()
			return
		}
		if (action == 'append-markdown') {
			if (payload.getNumber('requestVersion', 0) == this.requestVersion) {
				this.appendExternalMarkdown(
					payload.getString('content', ''),
					payload.getString('reasoningContent', '')
				)
			}
			return
		}
		if (action == 'complete-markdown') {
			if (payload.getNumber('requestVersion', 0) == this.requestVersion) this.complete()
			return
		}
		if (action == 'start') {
			this.startRequest(payload)
			return
		}
		if (action == 'start-demo') {
			this.startDemo(payload)
			return
		}
		if (action == 'start-markdown') this.startMarkdown(payload)
	}

	private resetState(requestVersion: number, renderInterval: number) {
		this.cancelCurrent()
		this.requestVersion = requestVersion
		this.snapshotVersion = 0
		this.renderInterval = renderInterval
		this.startedAt = Date.now()
		this.content = ''
		this.reasoningContent = ''
		this.hasThinkContent = false
		this.eventCount = 0
		this.networkChunkCount = 0
		this.receivedBytes = 0
		this.terminalSource = ''
		this.finished = false
		this.preprocessor = new MarkdownPreprocessor()
		this.demoScenarioId = ''
		this.demoBlockText = ''
		this.demoBlockOffset = 0
		this.demoBlockIndex = 0
		this.demoBlockCount = 0
		this.demoNextBlockAt = 0
	}

	private startRequest(payload: UTSJSONObject) {
		const requestVersion = payload.getNumber('requestVersion', 0)
		const url = payload.getString('url', '')
		const authorization = payload.getString('authorization', '')
		const bodyJson = payload.getString('bodyJson', '')
		const timeout = payload.getNumber('timeout', 90000)
		this.resetState(requestVersion, payload.getNumber('renderInterval', 300))
		if (requestVersion <= 0 || url.length == 0 || authorization.length == 0 || bodyJson.length == 0) {
			this.fail('invalid_request', 'Worker 请求参数不完整')
			return
		}

		this.streamRequest = new WorkerStreamRequest(
			(data: string) => { this.handleSseEvent(data) },
			(code: string, message: string) => { this.fail(code, message) },
			(source: string, networkChunkCount: number, receivedBytes: number) => {
				this.networkChunkCount = networkChunkCount
				this.receivedBytes = receivedBytes
				this.terminalSource = source
				this.complete()
			}
		)
		this.streamRequest!.start(url, authorization, bodyJson, timeout)
	}

	private startDemo(payload: UTSJSONObject) {
		const requestVersion = payload.getNumber('requestVersion', 0)
		const scenarioId = payload.getString('scenarioId', '')
		this.resetState(requestVersion, payload.getNumber('renderInterval', 300))
		if (requestVersion <= 0 || scenarioId.length == 0) {
			this.fail('invalid_demo_request', 'Worker Markdown 压测参数不完整')
			return
		}
		this.demoScenarioId = scenarioId
		this.demoStreamInterval = payload.getNumber('streamInterval', 100)
		this.demoBatchSize = payload.getNumber('batchSize', 10)
		this.demoBlockInterval = payload.getNumber('blockInterval', 300)
		this.terminalSource = 'demo'
		this.demoStreamTimer = setInterval(() => {
			this.emitDemoChunk()
		}, this.demoStreamInterval)
	}

	private emitDemoChunk() {
		if (this.finished || Date.now() < this.demoNextBlockAt) return
		if (this.demoBlockOffset >= this.demoBlockText.length) {
			this.demoBlockIndex += 1
			this.demoBlockText = createDemoMarkdownBlock(this.demoScenarioId, this.demoBlockIndex)
			this.demoBlockOffset = 0
		}
		const chunkSize = this.demoScenarioId == 'math' ? this.demoBlockText.length : this.demoBatchSize
		const endIndex = Math.min(this.demoBlockOffset + chunkSize, this.demoBlockText.length)
		const chunkText = this.demoBlockText.slice(this.demoBlockOffset, endIndex)
		this.demoBlockOffset = endIndex
		this.content += chunkText
		this.eventCount += 1
		this.networkChunkCount += 1
		this.receivedBytes += chunkText.length
		this.scheduleHtmlSnapshot()
		if (this.demoBlockOffset >= this.demoBlockText.length) {
			this.demoBlockCount += 1
			this.demoNextBlockAt = Date.now() + (this.demoScenarioId == 'math' ? 500 : this.demoBlockInterval)
		}
	}

	private startMarkdown(payload: UTSJSONObject) {
		const requestVersion = payload.getNumber('requestVersion', 0)
		this.resetState(requestVersion, payload.getNumber('renderInterval', 300))
		if (requestVersion <= 0) {
			this.fail('invalid_markdown_request', 'Worker Markdown 请求参数不完整')
			return
		}
		this.terminalSource = 'external'
	}

	private appendExternalMarkdown(contentDelta: string, reasoningDelta: string) {
		if (this.finished) return
		if (contentDelta.length > 0) this.content += contentDelta
		if (reasoningDelta.length > 0) this.reasoningContent += reasoningDelta
		this.eventCount += 1
		this.networkChunkCount += 1
		this.receivedBytes += contentDelta.length + reasoningDelta.length
		if (contentDelta.length > 0) this.scheduleHtmlSnapshot()
	}

	private handleSseEvent(data: string) {
		if (this.finished) return
		let raw: UTSJSONObject
		let chunk: WorkerAiChunk
		try {
			raw = JSON.parse<UTSJSONObject>(data) as UTSJSONObject
			chunk = JSON.parse<WorkerAiChunk>(data) as WorkerAiChunk
		} catch (_error) {
			this.fail('invalid_sse_json', 'AI 流数据解析失败')
			return
		}
		const error = raw.getJSON('error')
		if (error != null) {
			this.fail(error.getString('code', 'provider_error'), error.getString('message', '模型服务请求失败'))
			return
		}

		this.eventCount += 1
		let contentDelta = chunk.choices?.[0]?.delta?.content ?? ''
		let reasoningDelta = chunk.choices?.[0]?.delta?.reasoning_content ?? ''
		if (this.content.length == 0 && contentDelta == '<think>') {
			this.hasThinkContent = true
			contentDelta = ''
		}
		if (this.hasThinkContent) {
			if (contentDelta == '</think>') {
				this.hasThinkContent = false
			} else {
				reasoningDelta = contentDelta
			}
			contentDelta = ''
		}
		if (contentDelta.length > 0) this.content += contentDelta
		if (reasoningDelta.length > 0) this.reasoningContent += reasoningDelta
		if (contentDelta.length > 0) this.scheduleHtmlSnapshot()
	}

	private scheduleHtmlSnapshot() {
		if (this.renderTimer != 0 || this.finished) return
		this.renderTimer = setTimeout(() => {
			this.renderTimer = 0
			this.publishSnapshot(false)
		}, this.renderInterval)
	}

	private complete() {
		if (this.finished) return
		this.finished = true
		if (this.renderTimer != 0) clearTimeout(this.renderTimer)
		this.renderTimer = 0
		if (!this.content.endsWith('\n')) this.content += '\n'
		this.publishSnapshot(true)
		this.streamRequest = null
	}

	private publishSnapshot(isDone: boolean) {
		if (this.content.length == 0 && !isDone) return
		const processedMarkdown = this.preprocessor.process(this.content, isDone)
		if (processedMarkdown == null) return
		// #ifdef APP-ANDROID
		if (isMd2htmlAvailable() == false) {
			this.fail('markdown_html_unavailable', '当前 Android 基座未安装 libcmarkhtml.so')
			return
		}
		let html = ''
		try {
			html = md2html(processedMarkdown)
		} catch (error) {
			this.fail('markdown_html_failed', error.message as string)
			return
		}
		this.snapshotVersion += 1
		const snapshot = {
			requestVersion: this.requestVersion,
			snapshotVersion: this.snapshotVersion,
			phase: isDone ? 'complete' : 'snapshot',
			msgBody: this.content,
			thinkContent: this.reasoningContent.trim(),
			renderMode: 'html',
			html: html,
			htmlLength: html.length,
			demoBlockCount: this.demoBlockCount,
			isDone: isDone,
			eventCount: this.eventCount,
			networkChunkCount: this.networkChunkCount,
			receivedBytes: this.receivedBytes,
			terminalSource: this.terminalSource,
			elapsed: Date.now() - this.startedAt,
			errCode: '',
			errMsg: ''
		} as UTSJSONObject
		this.postMessage({
			phase: 'snapshot',
			snapshotJson: JSON.stringify(snapshot)
		} as UTSJSONObject)
		return
		// #endif
		// #ifndef APP-ANDROID
		this.fail('unsupported_platform', '当前平台暂未启用 AI Worker Markdown HTML 转换')
		// #endif
	}

	private fail(code: string, message: string) {
		if (this.finished && code != 'markdown_html_unavailable' && code != 'markdown_html_failed') return
		this.finished = true
		if (this.renderTimer != 0) clearTimeout(this.renderTimer)
		if (this.demoStreamTimer != 0) clearInterval(this.demoStreamTimer)
		this.renderTimer = 0
		this.demoStreamTimer = 0
		this.streamRequest?.abort()
		this.streamRequest = null
		this.snapshotVersion += 1
		const snapshot = {
			requestVersion: this.requestVersion,
			snapshotVersion: this.snapshotVersion,
			phase: 'error',
			msgBody: this.content,
			thinkContent: this.reasoningContent.trim(),
			renderMode: '',
			html: '',
			htmlLength: 0,
			demoBlockCount: this.demoBlockCount,
			isDone: false,
			eventCount: this.eventCount,
			networkChunkCount: this.networkChunkCount,
			receivedBytes: this.receivedBytes,
			terminalSource: this.terminalSource,
			elapsed: Date.now() - this.startedAt,
			errCode: code,
			errMsg: message
		} as UTSJSONObject
		this.postMessage({
			phase: 'snapshot',
			snapshotJson: JSON.stringify(snapshot)
		} as UTSJSONObject)
	}

	private cancelCurrent() {
		if (this.renderTimer != 0) clearTimeout(this.renderTimer)
		if (this.demoStreamTimer != 0) clearInterval(this.demoStreamTimer)
		this.renderTimer = 0
		this.demoStreamTimer = 0
		this.finished = true
		this.streamRequest?.abort()
		this.streamRequest = null
	}
}
