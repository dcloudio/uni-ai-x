// #ifdef APP-ANDROID || APP-HARMONY
import { RenderSnapshot, renderContentKey, persistRenderAssets, restoreRenderAssets, deleteRenderAssets } from '@/uni_modules/uni-ai-worker'
// #endif

export class AiSnapshotWorkerTask extends WorkerTaskImpl {
	constructor() { super() }
	override entry() { this.postMessage({ action: 'ready' } as UTSJSONObject) }
	override onMessage(message: any) {
		// #ifdef APP-ANDROID || APP-HARMONY
		const request = message as UTSJSONObject
		const id = request['id'] as number
		// #ifdef APP-HARMONY
		const assetRoot = request['assetRoot'] as string
		const assetDisplayRoot = request['assetDisplayRoot'] as string
		const assetCacheRoot = request['assetCacheRoot'] as string
		// #endif
		// #ifndef APP-HARMONY
		const assetRoot: string | null = null
		const assetDisplayRoot: string | null = null
		const assetCacheRoot: string | null = null
		// #endif
		try {
			const action = request['action'] as string
			if (action == 'delete') {
				deleteRenderAssets(request['messageId'] as string, assetRoot)
				this.postMessage({ id: id, ok: true } as UTSJSONObject)
				return
			}
			if (action == 'save-message' || action == 'add-message') {
				const value = request['message'] as UTSJSONObject
				const messageId = value['_id'] as string
				uni.setStorageSync('uni-ai-msg-' + messageId, JSON.stringify(value))
				if (action == 'add-message') {
					const indexKey = 'uni-ai-chat-' + (value['chat_id'] as string) + '-msgIds'
					const raw = uni.getStorageSync(indexKey) as string
					const ids = raw.length > 0 ? (JSON.parse<string[]>(raw) ?? []) : []
					if (!ids.includes(messageId)) ids.push(messageId)
					uni.setStorageSync(indexKey, JSON.stringify(ids))
				}
				this.postMessage({ id: id, ok: true } as UTSJSONObject)
				return
			}
			if (action == 'remove-messages' || action == 'remove-chat') {
				const indexKey = 'uni-ai-chat-' + (request['chatId'] as string) + '-msgIds'
				const raw = uni.getStorageSync(indexKey) as string
				const ids = raw.length > 0 ? (JSON.parse<string[]>(raw) ?? []) : []
				const removed = action == 'remove-chat' ? ids : request['messageIds'] as string[]
				for (const messageId of removed) {
					uni.removeStorageSync('uni-ai-msg-' + messageId)
					deleteRenderAssets(messageId, assetRoot)
				}
				if (action == 'remove-chat') uni.removeStorageSync(indexKey)
				else uni.setStorageSync(indexKey, JSON.stringify(ids.filter((messageId: string): boolean => !removed.includes(messageId))))
				this.postMessage({ id: id, ok: true } as UTSJSONObject)
				return
			}
			if (action == 'history') {
				const rawIds = uni.getStorageSync('uni-ai-chat-' + (request['chatId'] as string) + '-msgIds') as string
				const ids = rawIds.length > 0 ? (JSON.parse<string[]>(rawIds) ?? []) : []
				const messages: UTSJSONObject[] = []
				for (const messageId of ids) {
					const raw = uni.getStorageSync('uni-ai-msg-' + messageId) as string
					if (raw.length == 0) continue
					const value = JSON.parse<UTSJSONObject>(raw)
					if (value == null) continue
					value['uniAiMdRevision'] = 0
					if (value['from_uid'] == 'uni-ai' && ((value['body'] as string | null) ?? '').length > 0) value['rendered'] = true
					const search = value['search'] as UTSJSONObject | null
					if (search?.['status'] == 'searching') search!['status'] = 'cancelled'
					messages.push(value)
				}
				messages.sort((a: UTSJSONObject, b: UTSJSONObject): number => (a['create_time'] as number) - (b['create_time'] as number))
				this.postMessage({ id: id, messages: messages } as UTSJSONObject)
				return
			}
			const snapshot = JSON.parse<RenderSnapshot>(JSON.stringify(request['snapshot']))!
			const body = request['body'] as string
			if (action == 'persist') {
				snapshot.bodyKey = renderContentKey(body)
				const stored = persistRenderAssets(request['messageId'] as string, snapshot, assetRoot, assetCacheRoot)
				if (stored.assets.length > 0) console.info('[render-snapshot] assets saved: message=' + (request['messageId'] as string) + ' count=' + stored.assets.length)
				this.postMessage({ id: id, snapshot: stored } as UTSJSONObject)
			} else {
				const restored = restoreRenderAssets(snapshot, body, assetRoot, assetDisplayRoot)
				if (restored != null && restored.assets.length > 0) console.info('[render-snapshot] assets restored: count=' + restored.assets.length)
				this.postMessage({ id: id, snapshot: restored } as UTSJSONObject)
			}
		} catch (error) {
			console.error('[render-snapshot] ' + error)
			this.postMessage({ id: id, snapshot: null } as UTSJSONObject)
		}
		// #endif
	}
}
